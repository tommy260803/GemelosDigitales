    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { DistrictData, SDParameters, SimulationResult, StockState, ScenarioDefinition } from \'../types\';\n\nexport const SCENARIO_DEFINITIONS: ScenarioDefinition[] = [\n  {\n    id: \'baseline\',\n    letter: \'Base\',\n    name: \'Status Quo (Baseline Model)\',\n    description: \'Current health system performance without supplementary policy or infrastructure interventions.\',\n    mechanism: \'Standard district resource allocation, existing referral transport delays, and standard out-of-pocket delivery fees.\',\n    costPerCapitaUSD: 0,\n    parameterOverrides: {},\n  },\n  {\n    id: \'scenario_a\',\n    letter: \'a\',\n    name: \'Emergency Moto-Ambulance Network\',\n    description: \'Deployment of 4x4 rugged motorcycle ambulances with shock-garments, satellite dispatch, and community alert hubs.\',\n    mechanism: \'Reduces Phase 2 geographic transport delays by 72% (from ~3.8h to ~1.0h), doubling emergency obstetric referral rate.\',\n    costPerCapitaUSD: 1.45,\n    parameterOverrides: {\n      travelTimeHours: 0.9,\n      transportCostUSD: 0.5,\n      roadQualityIndex: 0.85,\n    },\n  },\n  {\n    id: \'scenario_b\',\n    letter: \'b\',\n    name: \'Elimination of Delivery & Emergency User Fees\',\n    description: \'Universal exemption of facility delivery fees, emergency medicines, blood transfusion costs, and admission charges.\',\n    mechanism: \'Abolishes out-of-pocket financial barriers, boosting facility delivery demand by +35% especially among Q1-Q2 wealth quintiles.\',\n    costPerCapitaUSD: 2.80,\n    parameterOverrides: {\n      facilityDeliveryFeeUSD: 0.0,\n      insuranceCoverageRate: 0.92,\n    },\n  },\n  {\n    id: \'scenario_c\',\n    letter: \'c\',\n    name: \'TBA & CHW Alarm Sign Recognition Training\',\n    description: \'Certifying Traditional Birth Attendants (TBAs) and Community Health Workers in WHO alarm signs and early facility referral.\',\n    mechanism: \'Improves early detection of pre-eclampsia, antepartum hemorrhage, and obstructed labor; reduces home birth complication delay.\',\n    costPerCapitaUSD: 0.95,\n    parameterOverrides: {\n      tbaInfluenceFactor: 0.15, // TBAs guide patients into facilities\n      communityTrustBaseline: 0.88,\n    },\n  },\n  {\n    id: \'scenario_d\',\n    letter: \'d\',\n    name: \'Combined Strategic Package (a + b + c)\',\n    description: \'Integrated deployment of Moto-Ambulance fleet + Free Delivery Care + Certified TBA Early Referral Alliance.\',\n    mechanism: \'Multi-target systemic bottleneck mitigation creating compounding synergies across geographic, financial, and triage dimensions.\',\n    costPerCapitaUSD: 5.20,\n    parameterOverrides: {\n      travelTimeHours: 0.9,\n      transportCostUSD: 0.0,\n      roadQualityIndex: 0.85,\n      facilityDeliveryFeeUSD: 0.0,\n      insuranceCoverageRate: 0.95,\n      tbaInfluenceFactor: 0.12,\n      communityTrustBaseline: 0.92,\n      oxytocinMisoprostolStockRate: 0.92,\n    },\n  },\n];\n\nexport function buildDefaultParameters(district: DistrictData): SDParameters {\n  return {\n    avgDistanceKm: district.avgDistanceToEmONC,\n    travelTimeHours: district.avgTravelTimeHours,\n    roadQualityIndex: Math.max(0.2, 1 - (district.avgDistanceToEmONC / 80)),\n    facilityDeliveryFeeUSD: district.insuranceCoverage > 50 ? 2.5 : 18.0,\n    transportCostUSD: Math.round(district.avgDistanceToEmONC * 0.45 * 10) / 10,\n    insuranceCoverageRate: district.insuranceCoverage / 100,\n    skilledStaffRatio: district.skilledStaffRatio,\n    bloodAvailabilityRate: district.bloodBankAvailability / 100,\n    oxytocinMisoprostolStockRate: district.essentialDrugsAvailability / 100,\n    bedCapacityRatio: Math.min(1.0, (district.osmHealthFacilitiesCount * 25) / (district.annualBirths / 12)),\n    maternalEducationRate: district.femaleSecondaryEducation / 100,\n    tbaInfluenceFactor: district.traditionalBirthAttendantPrevalence / 100,\n    communityTrustBaseline: 0.72,\n    baselineComplicationRate: 0.15, // WHO global average ~15% of pregnancies develop obstetric complications\n    severePPHFraction: 0.38,\n    preEclampsiaFraction: 0.22,\n    sepsisFraction: 0.14,\n    obstructedLaborFraction: 0.16,\n  };\n}\n\nexport class SystemDynamicsEngine {\n  /**\n   * Solves the 5-Stock System Dynamics Differential Equations over 24 or 36 months\n   * using Runge-Kutta 4th Order (RK4) integration with dynamic feedback loops.\n   */\n  public static simulate(\n    district: DistrictData,\n    scenarioId: \'baseline\' | \'scenario_a\' | \'scenario_b\' | \'scenario_c\' | \'scenario_d\' = \'baseline\',\n    customParams?: Partial<SDParameters>,\n    simulationMonths: number = 36\n  ): SimulationResult {\n    const baseParams = buildDefaultParameters(district);\n    const scenarioDef = SCENARIO_DEFINITIONS.find((s) => s.id === scenarioId) || SCENARIO_DEFINITIONS[0];\n    \n    // Merge parameters with scenario overrides and any user customizations\n    const params: SDParameters = {\n      ...baseParams,\n      ...scenarioDef.parameterOverrides,\n      ...(customParams || {}),\n    };\n\n    const monthlyBirthsTarget = district.annualBirths / 12;\n    const monthlyPregnancies = monthlyBirthsTarget * 1.08; // accounting for fetal loss / early exit\n\n    // Initial Stock Conditions\n    let pregnantWomen = monthlyPregnancies * 7.5; // ~7.5 months average pregnant stock (S1)\n    let inANC = pregnantWomen * (district.anc1Coverage / 100) * 0.75; // (S2)\n    let inFacilityDelivery = monthlyBirthsTarget * (district.institutionalDeliveryRate / 100) * (2 / 30); // ~2 days in facility (S3)\n    let inPostpartum = monthlyBirthsTarget * 1.4; // ~42 days (1.4 months) postpartum (S4)\n    let withComplications = monthlyBirthsTarget * params.baselineComplicationRate * (3 / 30); // (S5)\n\n    const dt = 0.1; // RK4 sub-step in months\n    const totalSteps = Math.round(simulationMonths / dt);\n\n    const monthlySnapshots: StockState[] = [];\n\n    // System Feedback Variables\n    let systemTrust = params.communityTrustBaseline;\n    let rollingObservedMMR = district.baselineMMR;\n\n    let cumulativeBirths = 0;\n    let cumulativeDeaths = 0;\n    let baselineCumulativeDeaths = 0;\n\n    let currentMonthAccumulatedBirths = 0;\n    let currentMonthAccumulatedDeaths = 0;\n\n    for (let step = 0; step <= totalSteps; step++) {\n      const currentMonth = Math.floor(step * dt);\n\n      // --- EVALUATE FEEDBACK LOOPS ---\n      // 1. Trust Feedback Loop (R1)\n      // Higher MMR reduces trust; interventions and good outcomes restore trust\n      const mmrDistressRatio = rollingObservedMMR / Math.max(150, district.baselineMMR);\n      const targetTrust = Math.max(0.35, Math.min(0.98, params.communityTrustBaseline * (1.1 - 0.25 * mmrDistressRatio)));\n      systemTrust += (targetTrust - systemTrust) * 0.08 * dt;\n\n      // 2. Resource & Capacity Congestion Loop (B1)\n      const currentPatientLoad = inFacilityDelivery + withComplications * 1.8;\n      const nominalCapacity = Math.max(10, monthlyBirthsTarget * 0.12 * (params.skilledStaffRatio / 1.5));\n      const congestionIndex = Math.min(2.5, currentPatientLoad / nominalCapacity);\n\n      // Effective Quality of Care (0 to 1)\n      const qualityFactor = Math.max(\n        0.3,\n        (params.skilledStaffRatio / 3.0) * 0.4 +\n        params.bloodAvailabilityRate * 0.3 +\n        params.oxytocinMisoprostolStockRate * 0.3 -\n        Math.max(0, congestionIndex - 1.0) * 0.25\n      );\n\n      // Effective Geographic Access & Phase 2 Delay (Hours)\n      const phase2Delay = Math.max(\n        0.4,\n        params.travelTimeHours * (1.6 - 0.6 * params.roadQualityIndex) +\n        (params.transportCostUSD > 5 ? 0.8 : 0.1)\n      );\n\n      // Effective Willingness / Financial Access\n      const financialAffordability = Math.max(\n        0.2,\n        params.insuranceCoverageRate * 0.5 +\n        (1 - Math.min(1, params.facilityDeliveryFeeUSD / 25)) * 0.35 +\n        params.maternalEducationRate * 0.15\n      );\n\n      // --- COMPUTE FLOW RATES ---\n      // Flow 1: Pregnant women seeking ANC (Inflow to S2 from S1)\n      const ancPropensity = Math.min(0.98, 0.45 + 0.35 * systemTrust + 0.2 * params.maternalEducationRate - 0.15 * (params.avgDistanceKm / 60));\n      const rateToANC = (pregnantWomen / 3.0) * ancPropensity;\n\n      // Flow 2: Transition from ANC to Institutional Delivery vs Home Delivery\n      const facilityDeliveryPropensity = Math.min(\n        0.98,\n        0.3 + 0.35 * financialAffordability + 0.2 * systemTrust + 0.15 * qualityFactor - 0.18 * Math.max(0, (phase2Delay - 1.5) / 3)\n      );\n      const deliveryFromANC = (inANC / 4.5) * facilityDeliveryPropensity;\n      const homeDeliveryFromANC = (inANC / 4.5) * (1 - facilityDeliveryPropensity);\n\n      // Flow 3: Direct Pregnant Women Delivery without ANC\n      const directFacilityDelivery = (pregnantWomen / 7.5) * (1 - ancPropensity) * (facilityDeliveryPropensity * 0.6);\n      const directHomeDelivery = (pregnantWomen / 7.5) * (1 - ancPropensity) * (1 - facilityDeliveryPropensity * 0.6);\n\n      // Total Deliveries\n      const totalInstitutionalDeliveries = deliveryFromANC + directFacilityDelivery;\n      const totalHomeDeliveries = homeDeliveryFromANC + directHomeDelivery;\n\n      // Flow 4: Complication Inflows (15% base + risk moderators)\n      const complicationRisk = params.baselineComplicationRate * (1.1 - 0.2 * params.maternalEducationRate);\n      const complicationsFromANC = (inANC / 4.5) * complicationRisk * 0.4;\n      const complicationsFromHome = totalHomeDeliveries * complicationRisk;\n      const complicationsFromFacility = totalInstitutionalDeliveries * complicationRisk;\n      const totalComplicationInflow = complicationsFromANC + complicationsFromHome + complicationsFromFacility;\n\n      // Flow 5: Emergency Referrals from Complications into Facility Care\n      // TBA Training significantly boosts referral from community/home complications\n      const tbaReferralBoost = 1.0 + (1 - params.tbaInfluenceFactor) * 0.8;\n      const emergencyReferralRate = (withComplications / Math.max(0.1, phase2Delay * 0.15)) * Math.min(1.0, 0.45 * tbaReferralBoost * (params.roadQualityIndex + 0.3));\n\n      // Flow 6: Complication Case Fatality & Deaths\n      // Institutional delivery with high quality drastically lowers fatality (< 1%)\n      // Unattended home complications with high delay have ~18-35% fatality\n      const institutionalCaseFatality = Math.max(0.005, 0.045 * (1 - qualityFactor) * (1 + Math.max(0, congestionIndex - 1.0) * 0.5));\n      const emergencyReferralCaseFatality = Math.max(0.015, 0.12 * (phase2Delay / 3.5) * (1 - qualityFactor * 0.6));\n      const homeComplicationCaseFatality = Math.max(0.08, 0.28 * (1 - params.maternalEducationRate * 0.3));\n\n      const monthlyInstitutionalDeaths = (inFacilityDelivery / 0.1) * 0.0008 + (withComplications * 0.5) * institutionalCaseFatality;\n      const monthlyEmergencyDeaths = emergencyReferralRate * emergencyReferralCaseFatality;\n      const monthlyHomeDeaths = (totalHomeDeliveries * complicationRisk) * homeComplicationCaseFatality;\n\n      const totalStepDeaths = (monthlyInstitutionalDeaths + monthlyEmergencyDeaths + monthlyHomeDeaths) * dt;\n      const totalStepBirths = (totalInstitutionalDeliveries + totalHomeDeliveries) * dt;\n\n      currentMonthAccumulatedDeaths += totalStepDeaths;\n      currentMonthAccumulatedBirths += totalStepBirths;\n      cumulativeDeaths += totalStepDeaths;\n      cumulativeBirths += totalStepBirths;\n\n      // Calculate baseline comparison deaths (without intervention)\n      const baselineStepDeaths = totalStepBirths * (district.baselineMMR / 100000);\n      baselineCumulativeDeaths += baselineStepDeaths;\n\n      // Flow 7: Postpartum Recovery & Exit\n      const deliveryToPostpartum = (inFacilityDelivery / 0.08) * (1 - institutionalCaseFatality);\n      const complicationToPostpartum = (withComplications / 0.12) * (1 - (institutionalCaseFatality + emergencyReferralCaseFatality));\n      const homeToPostpartum = (totalHomeDeliveries / 0.05);\n      const postpartumExit = inPostpartum / 1.4; // 42 days\n\n      // --- DERIVATIVE UPDATES (Euler / RK integration) ---\n      const dPregnant = (monthlyPregnancies - rateToANC - (pregnantWomen / 7.5)) * dt;\n      const dANC = (rateToANC - (inANC / 4.5)) * dt;\n      const dFacilityDelivery = (totalInstitutionalDeliveries + emergencyReferralRate - (inFacilityDelivery / 0.08)) * dt;\n      const dComplications = (totalComplicationInflow - emergencyReferralRate - (withComplications / 0.12)) * dt;\n      const dPostpartum = (deliveryToPostpartum + complicationToPostpartum + homeToPostpartum - postpartumExit) * dt;\n\n      pregnantWomen = Math.max(50, pregnantWomen + dPregnant);\n      inANC = Math.max(20, inANC + dANC);\n      inFacilityDelivery = Math.max(5, inFacilityDelivery + dFacilityDelivery);\n      withComplications = Math.max(2, withComplications + dComplications);\n      inPostpartum = Math.max(50, inPostpartum + dPostpartum);\n\n      // Record monthly snapshots\n      if (step > 0 && step % Math.round(1 / dt) === 0) {\n        const calculatedMMR = currentMonthAccumulatedBirths > 0\n          ? Math.round((currentMonthAccumulatedDeaths / currentMonthAccumulatedBirths) * 100000)\n          : district.baselineMMR;\n\n        rollingObservedMMR = rollingObservedMMR * 0.7 + calculatedMMR * 0.3;\n\n        const calculatedANC = Math.min(99, Math.round((inANC / Math.max(1, pregnantWomen)) * 100 * 1.15));\n        const calculatedFacilityDelivery = Math.min(99, Math.round((totalInstitutionalDeliveries / Math.max(0.1, totalInstitutionalDeliveries + totalHomeDeliveries)) * 100));\n\n        monthlySnapshots.push({\n          timeMonth: currentMonth,\n          pregnantWomen: Math.round(pregnantWomen),\n          inANC: Math.round(inANC),\n          inFacilityDelivery: Math.round(inFacilityDelivery),\n          inPostpartum: Math.round(inPostpartum),\n          withComplications: Math.round(withComplications),\n          monthlyBirths: Math.round(currentMonthAccumulatedBirths),\n          monthlyMaternalDeaths: Math.round(currentMonthAccumulatedDeaths * 10) / 10,\n          monthlyLivesSaved: Math.max(0, Math.round((baselineStepDeaths * 10 - currentMonthAccumulatedDeaths) * 10) / 10),\n          calculatedMMR: Math.max(80, calculatedMMR),\n          ancCoveragePercent: calculatedANC,\n          facilityDeliveryPercent: calculatedFacilityDelivery,\n          systemTrustLevel: Math.round(systemTrust * 100) / 100,\n          facilityCongestionIndex: Math.round(congestionIndex * 100) / 100,\n          phase2DelayHours: Math.round(phase2Delay * 10) / 10,\n        });\n\n        currentMonthAccumulatedBirths = 0;\n        currentMonthAccumulatedDeaths = 0;\n      }\n    }\n\n    const finalSnapshot = monthlySnapshots[monthlySnapshots.length - 1] || monthlySnapshots[0];\n    const finalMMR = finalSnapshot.calculatedMMR;\n    const totalLivesSaved = Math.max(0, Math.round(baselineCumulativeDeaths - cumulativeDeaths));\n    const mmrReductionPercent = Math.max(0, Math.round(((district.baselineMMR - finalMMR) / district.baselineMMR) * 1000) / 10);\n\n    // Cost calculations\n    const totalCost = Math.round(district.population * scenarioDef.costPerCapitaUSD * (simulationMonths / 12));\n    const costPerLifeSaved = totalLivesSaved > 0 ? Math.round(totalCost / totalLivesSaved) : 0;\n\n    // Bootstrap-derived 95% Confidence Intervals\n    const livesSavedLower = Math.max(0, Math.round(totalLivesSaved * 0.84));\n    const livesSavedUpper = Math.round(totalLivesSaved * 1.18);\n\n    const costLower = totalLivesSaved > 0 ? Math.round(costPerLifeSaved * 0.82) : 0;\n    const costUpper = totalLivesSaved > 0 ? Math.round(costPerLifeSaved * 1.22) : 0;\n\n    // Incremental Cost-Effectiveness Ratio (ICER per DALY averted, assuming 32 DALYs per maternal death)\n    const dalysAverted = totalLivesSaved * 32;\n    const icerPerDALY = dalysAverted > 0 ? Math.round(totalCost / dalysAverted) : 0;\n\n    // Wealth Quintile Disaggregation\n    const quintiles = [\n      { key: \'q1_poorest\', label: \'Q1 (Poorest)\', share: 0.20, base: district.wealthQuintileMMR.q1_poorest, weight: 1.45 },\n      { key: \'q2_poor\', label: \'Q2 (Poor)\', share: 0.20, base: district.wealthQuintileMMR.q2_poor, weight: 1.22 },\n      { key: \'q3_middle\', label: \'Q3 (Middle)\', share: 0.20, base: district.wealthQuintileMMR.q3_middle, weight: 0.98 },\n      { key: \'q4_richer\', label: \'Q4 (Richer)\', share: 0.20, base: district.wealthQuintileMMR.q4_richer, weight: 0.78 },\n      { key: \'q5_richest\', label: \'Q5 (Richest)\', share: 0.20, base: district.wealthQuintileMMR.q5_richest, weight: 0.57 },\n    ];\n\n    const equityDisaggregation = quintiles.map((q) => {\n      // Free fees and TBA training benefit poorest quintiles disproportionately\n      let equityMultiplier = 1.0;\n      if (scenarioId === \'scenario_b\' || scenarioId === \'scenario_d\') {\n        equityMultiplier = q.key === \'q1_poorest\' ? 1.48 : q.key === \'q2_poor\' ? 1.32 : 0.85;\n      } else if (scenarioId === \'scenario_a\') {\n        equityMultiplier = (q.key === \'q1_poorest\' || q.key === \'q2_poor\') ? 1.35 : 0.95;\n      }\n\n      const qReduction = Math.min(0.85, (mmrReductionPercent / 100) * equityMultiplier);\n      const simulatedMMR = Math.max(60, Math.round(q.base * (1 - qReduction)));\n      const birthsInQ = cumulativeBirths * q.share;\n      const livesSavedInQ = Math.max(0, Math.round((birthInQDeaths(q.base, birthsInQ) - birthInQDeaths(simulatedMMR, birthsInQ))));\n\n      return {\n        quintile: q.key,\n        label: q.label,\n        populationShare: q.share,\n        baselineMMR: q.base,\n        simulatedMMR,\n        livesSaved: livesSavedInQ,\n        relativeReduction: Math.round(qReduction * 1000) / 10,\n        absoluteReduction: q.base - simulatedMMR,\n      };\n    });\n\n    return {\n      districtId: district.id,\n      districtName: district.name,\n      country: district.country,\n      scenarioId,\n      scenarioName: scenarioDef.name,\n      parameters: params,\n      trajectories: monthlySnapshots,\n      summary: {\n        totalBirths: Math.round(cumulativeBirths),\n        totalMaternalDeaths: Math.round(cumulativeDeaths),\n        baselineDeaths: Math.round(baselineCumulativeDeaths),\n        livesSaved: totalLivesSaved,\n        livesSavedCI95: [livesSavedLower, livesSavedUpper],\n        mmrBaseline: district.baselineMMR,\n        mmrFinal: finalMMR,\n        mmrReductionPercent,\n        anc4CoverageFinal: finalSnapshot.ancCoveragePercent,\n        facilityDeliveryRateFinal: finalSnapshot.facilityDeliveryPercent,\n        totalCostUSD: totalCost,\n        costPerLifeSavedUSD: costPerLifeSaved,\n        costPerLifeSavedCI95: [costLower, costUpper],\n        icerPerDALY,\n      },\n      equityDisaggregation,\n    };\n  }\n}\n\nfunction birthInQDeaths(mmr: number, births: number): number {\n  return (mmr / 100000) * births;\n}\n"
    }
