        }
        lines {
          text: "      const staffDeficit = Math.max(0, (1 - Math.min(1.2, params.skilledStaffRatio / 2.0)) * 1.5);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      const phase3Delay = Math.max("
