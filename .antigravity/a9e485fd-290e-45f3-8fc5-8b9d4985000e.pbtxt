    instruction: "Update CausalLoopView.tsx to High Density theme with sharp slate-800 borders, sky accents, and high-density typography"
    replacement_infos {
      original_chunk {
        target_content: "  return (\n    <div className=\"space-y-6\">\n      \n      {/* Navigation and Concept Header */}\n      <div className=\"bg-slate-900/90 border border-slate-800 rounded-xl p-5 shadow-sm\">\n        <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n          <div>\n            <h2 className=\"text-base font-bold text-white flex items-center space-x-2\">\n              <GitMerge className=\"w-5 h-5 text-teal-400\" />\n              <span>System Dynamics Structural Architecture: Continuum of Care</span>\n            </h2>\n            <p className=\"text-xs text-slate-400 mt-1\">\n              5-Stock Non-linear Differential Equation Model with Endogenous Feedback Loops (R1, B1, B2)\n            </p>\n          </div>\n\n          <div className=\"flex items-center space-x-1 bg-slate-950 p-1 rounded-lg border border-slate-800 text-xs\">\n            <button\n              onClick={() => setActiveTab(\'stock_flow\')}\n              className={`px-3 py-1.5 rounded font-medium transition ${\n                activeTab === \'stock_flow\' ? \'bg-teal-600 text-white\' : \'text-slate-400 hover:text-white\'\n              }`}\n            >\n              Stock & Flow Topology\n            </button>\n            <button\n              onClick={() => setActiveTab(\'causal_loops\')}\n              className={`px-3 py-1.5 rounded font-medium transition ${\n                activeTab === \'causal_loops\' ? \'bg-teal-600 text-white\' : \'text-slate-400 hover:text-white\'\n              }`}\n            >\n              Causal Feedback Loops\n            </button>\n            <button\n              onClick={() => setActiveTab(\'equations\')}\n              className={`px-3 py-1.5 rounded font-medium transition ${\n                activeTab === \'equations\' ? \'bg-teal-600 text-white\' : \'text-slate-400 hover:text-white\'\n              }`}\n            >\n              Mathematical ODEs\n            </button>\n          </div>\n        </div>\n      </div>\n\n      {/* VIEW TAB 1: STOCK AND FLOW TOPOLOGY */}\n      {activeTab === \'stock_flow\' && (\n        <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n          \n          {/* Interactive Visual Canvas (2 Cols) */}\n          <div className=\"lg:col-span-2 bg-slate-900/90 border border-slate-800 rounded-xl p-5 shadow-sm space-y-4\">\n            <div className=\"flex items-center justify-between border-b border-slate-800 pb-2 text-xs\">\n              <span className=\"font-semibold text-slate-200\">INTERACTIVE CONTINUOUS FLOW MAP</span>\n              <span className=\"text-slate-400\">Click any stock compartment to inspect equations & live flows</span>\n            </div>\n\n            {/* SVG Diagram Canvas */}\n            <div className=\"relative w-full h-96 bg-slate-950/80 rounded-xl border border-slate-800 p-4 flex flex-col justify-between overflow-hidden\">\n              \n              {/* Inflow Label */}\n              <div className=\"absolute top-8 left-4 flex items-center space-x-1 text-slate-500 text-xs\">\n                <span className=\"animate-pulse w-2 h-2 rounded-full bg-teal-400\" />\n                <span>Fertility & Pregnancies</span>\n              </div>\n\n              {/* Five Stock Boxes Row */}\n              <div className=\"grid grid-cols-5 gap-2 my-auto z-10\">\n                {[\n                  { id: \'S1\', name: \'S1: Pregnant\', color: \'border-sky-500 bg-sky-950/40 text-sky-300\' },\n                  { id: \'S2\', name: \'S2: In ANC\', color: \'border-emerald-500 bg-emerald-950/40 text-emerald-300\' },\n                  { id: \'S3\', name: \'S3: Facility Del.\', color: \'border-indigo-500 bg-indigo-950/40 text-indigo-300\' },\n                  { id: \'S4\', name: \'S4: Postpartum\', color: \'border-amber-500 bg-amber-950/40 text-amber-300\' },\n                  { id: \'S5\', name: \'S5: Complications\', color: \'border-rose-500 bg-rose-950/40 text-rose-300\' },\n                ].map((s) => {\n                  const isSelected = selectedElement === s.id;\n                  return (\n                    <button\n                      key={s.id}\n                      onClick={() => setSelectedElement(s.id)}\n                      className={`p-3 rounded-lg border-2 text-center transition cursor-pointer flex flex-col items-center justify-between h-32 ${s.color} ${\n                        isSelected ? \'ring-2 ring-white scale-105 shadow-lg\' : \'opacity-90 hover:opacity-100\'\n                      }`}\n                    >\n                      <span className=\"text-xs font-bold\">{s.id}</span>\n                      <span className=\"text-[11px] font-semibold leading-tight\">{s.name.split(\':\')[1]}</span>\n                      <span className=\"text-[9px] px-1.5 py-0.5 rounded bg-slate-900/80 text-slate-300 font-mono\">\n                        Active Stock\n                      </span>\n                    </button>\n                  );\n                })}\n              </div>\n\n              {/* Dynamic Flow Arrows & Valves */}\n              <div className=\"absolute inset-0 pointer-events-none flex items-center justify-around px-8\">\n                <ArrowRight className=\"w-5 h-5 text-teal-400/80 animate-pulse\" />\n                <ArrowRight className=\"w-5 h-5 text-emerald-400/80 animate-pulse\" />\n                <ArrowRight className=\"w-5 h-5 text-indigo-400/80 animate-pulse\" />\n                <ArrowRight className=\"w-5 h-5 text-amber-400/80 animate-pulse\" />\n              </div>\n\n              {/* Feedback Loop Connectors Banner */}\n              <div className=\"bg-slate-900/90 border border-slate-800 rounded-lg p-2.5 flex items-center justify-between text-xs text-slate-300 z-10\">\n                <div className=\"flex items-center space-x-2\">\n                  <RotateCw className=\"w-4 h-4 text-teal-400\" />\n                  <span><strong>R1 Loop:</strong> System Trust Reinforcing Loop</span>\n                </div>\n                <div className=\"flex items-center space-x-2\">\n                  <ShieldAlert className=\"w-4 h-4 text-amber-400\" />\n                  <span><strong>B1 Loop:</strong> Clinical Congestion Balancing Loop</span>\n                </div>\n                <div className=\"flex items-center space-x-2\">\n                  <Zap className=\"w-4 h-4 text-rose-400\" />\n                  <span><strong>B2 Loop:</strong> Phase 2 Transport Delay Loop</span>\n                </div>\n              </div>\n\n            </div>\n\n            <div className=\"text-xs text-slate-400 bg-slate-950 p-3 rounded-lg border border-slate-800\">\n              \360\237\222\241 <strong>System Dynamics Rule:</strong> Stock variables represent accumulations of individuals over time, while flow rates (valves) represent rates of transfer determined by maternal education, distance, clinic fees, and SBA capacity.\n            </div>\n          </div>\n\n          {/* Element Inspector Drawer (1 Col) */}\n          <div className=\"bg-slate-900/90 border border-slate-800 rounded-xl p-5 shadow-sm space-y-4\">\n            {selectedElement && stockDetails[selectedElement] ? (\n              <div className=\"space-y-4\">\n                <div className=\"border-b border-slate-800 pb-3\">\n                  <span className=\"text-[10px] font-bold px-2 py-0.5 rounded bg-teal-500/20 text-teal-300 uppercase\">\n                    {stockDetails[selectedElement].type}\n                  </span>\n                  <h3 className=\"text-base font-bold text-white mt-1.5\">\n                    {stockDetails[selectedElement].title}\n                  </h3>\n                </div>\n\n                <div className=\"space-y-3 text-xs\">\n                  <div>\n                    <label className=\"text-slate-400 block mb-1\">Differential Equation (ODE):</label>\n                    <div className=\"p-2.5 rounded bg-slate-950 font-mono text-teal-300 text-[11px] border border-slate-800\">\n                      {stockDetails[selectedElement].formula}\n                    </div>\n                  </div>\n\n                  <div>\n                    <label className=\"text-slate-400 block mb-1\">Current District Magnitude:</label>\n                    <div className=\"text-sm font-semibold text-slate-100\">\n                      {stockDetails[selectedElement].currentVal}\n                    </div>\n                  </div>\n\n                  <div>\n                    <label className=\"text-slate-400 block mb-1\">Clinical & Behavioral Role:</label>\n                    <p className=\"text-slate-300 leading-relaxed\">\n                      {stockDetails[selectedElement].description}\n                    </p>\n                  </div>\n\n                  <div className=\"p-3 rounded-lg bg-teal-950/30 border border-teal-500/30 text-teal-200\">\n                    <span className=\"font-bold block mb-0.5\">Key Calibration Driver:</span>\n                    <span>Modulated by {district.name}\'s baseline SBA ratio ({district.skilledStaffRatio} per 1k) and ANC4 coverage ({district.anc4Coverage}%).</span>\n                  </div>\n                </div>\n              </div>\n            ) : (\n              <div className=\"h-full flex items-center justify-center text-xs text-slate-500\">\n                Select a stock component to view mathematical formulation\n              </div>\n            )}\n          </div>\n\n        </div>\n      )}\n\n      {/* VIEW TAB 2: CAUSAL FEEDBACK LOOPS */}\n      {activeTab === \'causal_loops\' && (\n        <div className=\"grid grid-cols-1 md:grid-cols-3 gap-6\">\n          {feedbackLoops.map((loop) => (\n            <div \n              key={loop.id}\n              className=\"bg-slate-900/90 border border-slate-800 rounded-xl p-5 shadow-sm space-y-4 flex flex-col justify-between\"\n            >\n              <div>\n                <div className=\"flex items-center justify-between mb-2\">\n                  <span className={`text-xs font-bold px-2 py-0.5 rounded ${\n                    loop.type.includes(\'Reinforcing\') \n                      ? \'bg-teal-500/20 text-teal-300 border border-teal-500/30\' \n                      : \'bg-rose-500/20 text-rose-300 border border-rose-500/30\'\n                  }`}>\n                    {loop.type}\n                  </span>\n                  <RotateCw className=\"w-4 h-4 text-slate-400\" />\n                </div>\n                <h3 className=\"text-sm font-bold text-white\">{loop.name}</h3>\n\n                <div className=\"mt-4 space-y-2 text-xs\">\n                  {loop.steps.map((step, idx) => (\n                    <div key={idx} className=\"flex items-start space-x-2 text-slate-300\">\n                      <span className=\"w-4 h-4 rounded-full bg-slate-800 text-teal-400 flex items-center justify-center shrink-0 text-[10px] font-bold\">\n                        {idx + 1}\n                      </span>\n                      <span>{step}</span>\n                    </div>\n                  ))}\n                </div>\n              </div>\n\n              <div className=\"pt-3 border-t border-slate-800 text-xs\">\n                <span className=\"text-slate-400 block text-[11px] mb-0.5\">Mitigating Scenario:</span>\n                <span className=\"font-semibold text-teal-300\">{loop.interventions}</span>\n              </div>\n            </div>\n          ))}\n        </div>\n      )}\n\n      {/* VIEW TAB 3: MATHEMATICAL ODES */}\n      {activeTab === \'equations\' && (\n        <div className=\"bg-slate-900/90 border border-slate-800 rounded-xl p-6 shadow-sm space-y-4\">\n          <h3 className=\"text-base font-bold text-white\">Full Non-Linear Differential Equation System</h3>\n          <p className=\"text-xs text-slate-400\">\n            Solved using Runge-Kutta 4th Order (RK4) integration with numerical time-step $\\Delta t = 0.1$ months:\n          </p>\n\n          <div className=\"space-y-3 font-mono text-xs text-teal-300 bg-slate-950 p-5 rounded-xl border border-slate-800 overflow-x-auto\">\n            <div className=\"p-2 border-b border-slate-900\">\n              <span className=\"text-slate-500\">// 1. Pregnant Women Stock</span>\n              <div>dW/dt = Inflow_Pregnancies - Flow_ANC(W, Trust, Distance) - Flow_Direct_Home(W) - Flow_Direct_Del(W)</div>\n            </div>\n            <div className=\"p-2 border-b border-slate-900\">\n              <span className=\"text-slate-500\">// 2. Antenatal Care Stock</span>\n              <div>dA/dt = Flow_ANC(W) - Flow_ANC_to_Facility(A, Fees, Quality) - Flow_ANC_to_Home(A)</div>\n            </div>\n            <div className=\"p-2 border-b border-slate-900\">\n              <span className=\"text-slate-500\">// 3. Facility Delivery Stock</span>\n              <div>dD/dt = Flow_ANC_to_Facility + Flow_Direct_Del + Flow_Emergency_Referral(C, MotoAmbulance) - (D / \317\204_delivery)</div>\n            </div>\n            <div className=\"p-2 border-b border-slate-900\">\n              <span className=\"text-slate-500\">// 4. Obstetric Complications Stock</span>\n              <div>dC/dt = Flow_Onset_Complications(Deliveries, Pre-eclampsia) - Flow_Emergency_Referral - Flow_Fatalities(C, Delay)</div>\n            </div>\n            <div className=\"p-2\">\n              <span className=\"text-slate-500\">// 5. Postpartum Monitoring Stock</span>\n              <div>dP/dt = Flow_Recovered_Facility + Flow_Recovered_Complications + Flow_Recovered_Home - (P / \317\204_postpartum)</div>\n            </div>\n          </div>\n        </div>\n      )}\n\n    </div>\n  );"
        replacement_content: "  return (\n    <div className=\"space-y-4\">\n      \n      {/* Navigation and Concept Header */}\n      <div className=\"bg-slate-900/50 border border-slate-800 rounded-lg p-3.5 shadow-sm\">\n        <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n          <div>\n            <div className=\"flex items-center space-x-2\">\n              <span className=\"w-2 h-2 rounded-full bg-sky-500\"></span>\n              <h2 className=\"text-xs font-bold text-white uppercase tracking-wider flex items-center space-x-1.5\">\n                <span>SYSTEM DYNAMICS CONTINUUM TOPOLOGY &amp; FEEDBACK LOOPS</span>\n              </h2>\n            </div>\n            <p className=\"text-[10px] text-slate-500 font-mono mt-0.5\">\n              5-Stock Non-linear Differential Equation Model with Endogenous Feedback Loops (R1, B1, B2)\n            </p>\n          </div>\n\n          <div className=\"flex items-center space-x-1 bg-[#0c0e12] p-1 rounded border border-slate-800 text-xs font-mono\">\n            <button\n              onClick={() => setActiveTab(\'stock_flow\')}\n              className={`px-2.5 py-1 rounded font-bold transition cursor-pointer ${\n                activeTab === \'stock_flow\' ? \'bg-sky-600 text-white shadow-md shadow-sky-900/30\' : \'text-slate-400 hover:text-white\'\n              }`}\n            >\n              Stock &amp; Flow Topology\n            </button>\n            <button\n              onClick={() => setActiveTab(\'causal_loops\')}\n              className={`px-2.5 py-1 rounded font-bold transition cursor-pointer ${\n                activeTab === \'causal_loops\' ? \'bg-sky-600 text-white shadow-md shadow-sky-900/30\' : \'text-slate-400 hover:text-white\'\n              }`}\n            >\n              Feedback Loops (R1, B1, B2)\n            </button>\n            <button\n              onClick={() => setActiveTab(\'equations\')}\n              className={`px-2.5 py-1 rounded font-bold transition cursor-pointer ${\n                activeTab === \'equations\' ? \'bg-sky-600 text-white shadow-md shadow-sky-900/30\' : \'text-slate-400 hover:text-white\'\n              }`}\n            >\n              Mathematical ODEs\n            </button>\n          </div>\n        </div>\n      </div>\n\n      {/* VIEW TAB 1: STOCK AND FLOW TOPOLOGY */}\n      {activeTab === \'stock_flow\' && (\n        <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-4\">\n          \n          {/* Interactive Visual Canvas (2 Cols) */}\n          <div className=\"lg:col-span-2 bg-slate-900/50 border border-slate-800 rounded-lg p-4 shadow-sm space-y-3\">\n            <div className=\"flex items-center justify-between border-b border-slate-800 pb-2 text-xs font-mono\">\n              <span className=\"font-bold text-slate-300 uppercase\">INTERACTIVE CONTINUOUS FLOW MAP</span>\n              <span className=\"text-slate-500 text-[11px]\">Click any compartment to inspect ODE parameters</span>\n            </div>\n\n            {/* SVG Diagram Canvas */}\n            <div className=\"relative w-full h-80 bg-[#131a26] rounded-lg border border-slate-800 p-4 flex flex-col justify-between overflow-hidden\">\n              \n              {/* Inflow Label */}\n              <div className=\"absolute top-4 left-4 flex items-center space-x-1.5 text-slate-400 text-[10px] font-mono\">\n                <span className=\"animate-pulse w-2 h-2 rounded-full bg-sky-400\" />\n                <span>FERTILITY &amp; PREGNANCIES INFLOW</span>\n              </div>\n\n              {/* Five Stock Boxes Row */}\n              <div className=\"grid grid-cols-5 gap-2 my-auto z-10 font-mono\">\n                {[\n                  { id: \'S1\', name: \'S1: Pregnant\', color: \'border-sky-500/80 bg-sky-950/40 text-sky-300\' },\n                  { id: \'S2\', name: \'S2: In ANC\', color: \'border-emerald-500/80 bg-emerald-950/40 text-emerald-300\' },\n                  { id: \'S3\', name: \'S3: Facility Del.\', color: \'border-indigo-500/80 bg-indigo-950/40 text-indigo-300\' },\n                  { id: \'S4\', name: \'S4: Postpartum\', color: \'border-amber-500/80 bg-amber-950/40 text-amber-300\' },\n                  { id: \'S5\', name: \'S5: Complications\', color: \'border-rose-500/80 bg-rose-950/40 text-rose-300\' },\n                ].map((s) => {\n                  const isSelected = selectedElement === s.id;\n                  return (\n                    <button\n                      key={s.id}\n                      onClick={() => setSelectedElement(s.id)}\n                      className={`p-2.5 rounded border text-center transition cursor-pointer flex flex-col items-center justify-between h-28 ${s.color} ${\n                        isSelected ? \'ring-2 ring-sky-400 scale-105 shadow-lg shadow-sky-900/40\' : \'opacity-90 hover:opacity-100\'\n                      }`}\n                    >\n                      <span className=\"text-xs font-bold\">{s.id}</span>\n                      <span className=\"text-[10px] font-bold leading-tight\">{s.name.split(\':\')[1]}</span>\n                      <span className=\"text-[8px] px-1 py-0.5 rounded bg-[#0c0e12] text-slate-300 font-mono\">\n                        ACTIVE STOCK\n                      </span>\n                    </button>\n                  );\n                })}\n              </div>\n\n              {/* Dynamic Flow Arrows & Valves */}\n              <div className=\"absolute inset-0 pointer-events-none flex items-center justify-around px-8\">\n                <ArrowRight className=\"w-4 h-4 text-sky-400/80 animate-pulse\" />\n                <ArrowRight className=\"w-4 h-4 text-emerald-400/80 animate-pulse\" />\n                <ArrowRight className=\"w-4 h-4 text-indigo-400/80 animate-pulse\" />\n                <ArrowRight className=\"w-4 h-4 text-amber-400/80 animate-pulse\" />\n              </div>\n\n              {/* Feedback Loop Connectors Banner */}\n              <div className=\"bg-[#0c0e12]/90 border border-slate-800 rounded p-2 flex items-center justify-between text-[10px] font-mono text-slate-300 z-10\">\n                <div className=\"flex items-center space-x-1.5\">\n                  <RotateCw className=\"w-3.5 h-3.5 text-sky-400\" />\n                  <span><strong>R1:</strong> Trust Loop</span>\n                </div>\n                <div className=\"flex items-center space-x-1.5\">\n                  <ShieldAlert className=\"w-3.5 h-3.5 text-amber-400\" />\n                  <span><strong>B1:</strong> Workload Balancing</span>\n                </div>\n                <div className=\"flex items-center space-x-1.5\">\n                  <Zap className=\"w-3.5 h-3.5 text-rose-400\" />\n                  <span><strong>B2:</strong> Phase 2 Transport Delay</span>\n                </div>\n              </div>\n\n            </div>\n\n            <div className=\"text-[10px] text-slate-400 bg-[#0c0e12] p-2.5 rounded border border-slate-800 font-mono\">\n              \360\237\222\241 <strong>System Dynamics Rule:</strong> Stock variables accumulate individuals over time, while flow rates (valves) represent rates of transfer determined by maternal education, distance, clinic fees, and SBA capacity.\n            </div>\n          </div>\n\n          {/* Element Inspector Drawer (1 Col) */}\n          <div className=\"bg-slate-900/50 border border-slate-800 rounded-lg p-4 shadow-sm space-y-3\">\n            {selectedElement && stockDetails[selectedElement] ? (\n              <div className=\"space-y-3 font-mono\">\n                <div className=\"border-b border-slate-800 pb-2\">\n                  <span className=\"text-[9px] font-bold px-1.5 py-0.5 rounded bg-sky-500/20 text-sky-300 uppercase border border-sky-500/30\">\n                    {stockDetails[selectedElement].type}\n                  </span>\n                  <h3 className=\"text-sm font-bold text-white mt-1\">\n                    {stockDetails[selectedElement].title}\n                  </h3>\n                </div>\n\n                <div className=\"space-y-2.5 text-xs\">\n                  <div>\n                    <label className=\"text-[10px] text-slate-500 uppercase font-bold block mb-1\">Differential Equation (ODE):</label>\n                    <div className=\"p-2 rounded bg-[#0c0e12] font-mono text-sky-300 text-[10px] border border-slate-800\">\n                      {stockDetails[selectedElement].formula}\n                    </div>\n                  </div>\n\n                  <div>\n                    <label className=\"text-[10px] text-slate-500 uppercase font-bold block mb-1\">District Magnitude:</label>\n                    <div className=\"text-xs font-bold text-slate-100\">\n                      {stockDetails[selectedElement].currentVal}\n                    </div>\n                  </div>\n\n                  <div>\n                    <label className=\"text-[10px] text-slate-500 uppercase font-bold block mb-1\">Behavioral Role:</label>\n                    <p className=\"text-slate-300 font-sans text-xs leading-relaxed\">\n                      {stockDetails[selectedElement].description}\n                    </p>\n                  </div>\n\n                  <div className=\"p-2.5 rounded bg-sky-950/30 border border-sky-500/30 text-sky-200 text-xs\">\n                    <span className=\"font-bold block mb-0.5 text-[10px] uppercase\">Calibration Driver:</span>\n                    <span>Modulated by {district.name}\'s baseline SBA ratio ({district.skilledStaffRatio}/1k) &amp; ANC4 coverage ({district.anc4Coverage}%).</span>\n                  </div>\n                </div>\n              </div>\n            ) : (\n              <div className=\"h-full flex items-center justify-center text-xs text-slate-500 font-mono\">\n                Select a stock component to view mathematical formulation\n              </div>\n            )}\n          </div>\n\n        </div>\n      )}\n\n      {/* VIEW TAB 2: CAUSAL FEEDBACK LOOPS */}\n      {activeTab === \'causal_loops\' && (\n        <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n          {feedbackLoops.map((loop) => (\n            <div \n              key={loop.id}\n              className=\"bg-slate-900/50 border border-slate-800 rounded-lg p-4 shadow-sm space-y-3 flex flex-col justify-between\"\n            >\n              <div>\n                <div className=\"flex items-center justify-between mb-2\">\n                  <span className={`text-[10px] font-mono font-bold px-2 py-0.5 rounded ${\n                    loop.type.includes(\'Reinforcing\') \n                      ? \'bg-sky-500/20 text-sky-300 border border-sky-500/30\' \n                      : \'bg-rose-500/20 text-rose-300 border border-rose-500/30\'\n                  }`}>\n                    {loop.type}\n                  </span>\n                  <RotateCw className=\"w-3.5 h-3.5 text-slate-500\" />\n                </div>\n                <h3 className=\"text-xs font-bold text-white uppercase\">{loop.name}</h3>\n\n                <div className=\"mt-3 space-y-1.5 text-xs\">\n                  {loop.steps.map((step, idx) => (\n                    <div key={idx} className=\"flex items-start space-x-2 text-slate-300\">\n                      <span className=\"w-3.5 h-3.5 rounded bg-slate-800 text-sky-400 flex items-center justify-center shrink-0 text-[9px] font-mono font-bold\">\n                        {idx + 1}\n                      </span>\n                      <span className=\"text-[11px]\">{step}</span>\n                    </div>\n                  ))}\n                </div>\n              </div>\n\n              <div className=\"pt-2.5 border-t border-slate-800 text-xs font-mono\">\n                <span className=\"text-slate-500 block text-[10px] uppercase font-bold mb-0.5\">Mitigating Scenario:</span>\n                <span className=\"font-bold text-sky-400 text-[11px]\">{loop.interventions}</span>\n              </div>\n            </div>\n          ))}\n        </div>\n      )}\n\n      {/* VIEW TAB 3: MATHEMATICAL ODES */}\n      {activeTab === \'equations\' && (\n        <div className=\"bg-slate-900/50 border border-slate-800 rounded-lg p-4 shadow-sm space-y-3\">\n          <h3 className=\"text-xs font-bold text-white uppercase tracking-wider\">Full Non-Linear Differential Equation System</h3>\n          <p className=\"text-[11px] text-slate-400 font-mono\">\n            Solved using Runge-Kutta 4th Order (RK4) numerical integration with time-step &Delta;t = 0.1 months:\n          </p>\n\n          <div className=\"space-y-2 font-mono text-[11px] text-sky-300 bg-[#0c0e12] p-4 rounded border border-slate-800 overflow-x-auto\">\n            <div className=\"p-1.5 border-b border-slate-900\">\n              <span className=\"text-slate-500 block text-[10px]\">// 1. Pregnant Women Stock (S1)</span>\n              <div>dW/dt = Inflow_Pregnancies - Flow_ANC(W, Trust, Distance) - Flow_Direct_Home(W) - Flow_Direct_Del(W)</div>\n            </div>\n            <div className=\"p-1.5 border-b border-slate-900\">\n              <span className=\"text-slate-500 block text-[10px]\">// 2. Antenatal Care Stock (S2)</span>\n              <div>dA/dt = Flow_ANC(W) - Flow_ANC_to_Facility(A, Fees, Quality) - Flow_ANC_to_Home(A)</div>\n            </div>\n            <div className=\"p-1.5 border-b border-slate-900\">\n              <span className=\"text-slate-500 block text-[10px]\">// 3. Facility Delivery Stock (S3)</span>\n              <div>dD/dt = Flow_ANC_to_Facility + Flow_Direct_Del + Flow_Emergency_Referral(C, MotoAmbulance) - (D / &tau;_delivery)</div>\n            </div>\n            <div className=\"p-1.5 border-b border-slate-900\">\n              <span className=\"text-slate-500 block text-[10px]\">// 4. Obstetric Complications Stock (S5)</span>\n              <div>dC/dt = Flow_Onset_Complications(Deliveries, Pre-eclampsia) - Flow_Emergency_Referral - Flow_Fatalities(C, Delay)</div>\n            </div>\n            <div className=\"p-1.5\">\n              <span className=\"text-slate-500 block text-[10px]\">// 5. Postpartum Monitoring Stock (S4)</span>\n              <div>dP/dt = Flow_Recovered_Facility + Flow_Recovered_Complications + Flow_Recovered_Home - (P / &tau;_postpartum)</div>\n            </div>\n          </div>\n        </div>\n      )}\n\n    </div>\n  );"
      }
