          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      q5_richest: Math.round(district.baselineMMR * 0.53),"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    };"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const quintiles = ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      { key: \'q1_poorest\', label: \'Q1 (Poorest)\', share: 0.20, base: district.wealthQuintileMMR.q1_poorest, weight: 1.45 },"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "      { key: \'q2_poor\', label: \'Q2 (Poor)\', share: 0.20, base: district.wealthQuintileMMR.q2_poor, weight: 1.22 },"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "      { key: \'q3_middle\', label: \'Q3 (Middle)\', share: 0.20, base: district.wealthQuintileMMR.q3_middle, weight: 0.98 },"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "      { key: \'q4_richer\', label: \'Q4 (Richer)\', share: 0.20, base: district.wealthQuintileMMR.q4_richer, weight: 0.78 },"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
