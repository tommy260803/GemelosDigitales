        lines {
          text: "                  ? \'Modo Escala Dual: S3 (\303\2276) y S5 (\303\22712) reescaladas visualmente para observar simult\303\241neamente din\303\241micas comunitarias e intrahospitalarias.\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                  : \'Dual Scale Mode: S3 (\303\2276) and S5 (\303\22712) visually amplified for concurrent community and facility dynamic tracking.\')}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                {scaleMode === \'linear\' && (language === \'es\' "
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                  ? \'Modo Lineal 1:1: Todos los stocks graficados en escala f\303\255sica absoluta real sin multiplicadores.\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                  : \'Linear 1:1 Mode: All stocks plotted on exact true physical units with zero visual scaling.\')}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                {scaleMode === \'logarithmic\' && (language === \'es\' "
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                  ? \'Modo Logar\303\255tmico Log\342\202\201\342\202\200: Permite comparar magnitudes dispares (S1 ~10\342\201\264 vs S5 ~10\302\262) en la misma escala continua.\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                  : \'Log\342\202\201\342\202\200 Mode: Enables direct visual tracking of disparate magnitudes (S1 ~10\342\201\264 vs S5 ~10\302\262) continuously.\')}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              </span>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
