          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "      { key: \'Q3\', id: \'q3_middle\', label: \'Middle\', share: 0.20, base: wq.q3_middle ?? Math.round(district.baselineMMR * 0.95), weight: 0.98 },"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "      { key: \'Q4\', id: \'q4_richer\', label: \'Richer\', share: 0.20, base: wq.q4_richer ?? Math.round(district.baselineMMR * 0.76), weight: 0.78 },"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "      { key: \'Q5\', id: \'q5_richest\', label: \'Richest 20%\', share: 0.20, base: wq.q5_richest ?? Math.round(district.baselineMMR * 0.53), weight: 0.57 },"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
