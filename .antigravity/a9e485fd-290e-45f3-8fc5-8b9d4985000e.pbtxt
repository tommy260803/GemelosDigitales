        }
        lines {
          text: "    let inFacilityDelivery = monthlyBirthsTarget * (district.institutionalDeliveryRate / 100) * (2 / 30); // ~2 days in facility (S3)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    let inPostpartum = monthlyBirthsTarget * 1.4; // ~42 days (1.4 months) postpartum (S4)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    let withComplications = monthlyBirthsTarget * params.baselineComplicationRate * (3 / 30); // (S5)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const dt = 0.1; // RK4 sub-step in months"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const totalSteps = Math.round(simulationMonths / dt);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const monthlySnapshots: StockState[] = [];"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // System Feedback Variables"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    let systemTrust = params.communityTrustBaseline;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    let rollingObservedMMR = district.baselineMMR;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    let cumulativeBirths = 0;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    let cumulativeDeaths = 0;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    let baselineCumulativeDeaths = 0;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    let currentMonthAccumulatedBirths = 0;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    let currentMonthAccumulatedDeaths = 0;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    for (let step = 0; step <= totalSteps; step++) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const currentMonth = Math.floor(step * dt);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      // --- EVALUATE FEEDBACK LOOPS ---"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      // 1. Trust Feedback Loop (R1)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      // Higher MMR reduces trust; interventions and good outcomes restore trust"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const mmrDistressRatio = rollingObservedMMR / Math.max(150, district.baselineMMR);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const targetTrust = Math.max(0.35, Math.min(0.98, params.communityTrustBaseline * (1.1 - 0.25 * mmrDistressRatio)));"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      systemTrust += (targetTrust - systemTrust) * 0.08 * dt;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      // 2. Resource & Capacity Congestion Loop (B1)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const currentPatientLoad = inFacilityDelivery + withComplications * 1.8;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const nominalCapacity = Math.max(10, monthlyBirthsTarget * 0.12 * (params.skilledStaffRatio / 1.5));"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const congestionIndex = Math.min(2.5, currentPatientLoad / nominalCapacity);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      // Effective Quality of Care (0 to 1)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const qualityFactor = Math.max("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        0.3,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        (params.skilledStaffRatio / 3.0) * 0.4 +"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        params.bloodAvailabilityRate * 0.3 +"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        params.oxytocinMisoprostolStockRate * 0.3 -"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        Math.max(0, congestionIndex - 1.0) * 0.25"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      );"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      // Effective Geographic Access & Phase 2 Delay (Hours)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const phase2Delay = Math.max("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        0.4,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        params.travelTimeHours * (1.6 - 0.6 * params.roadQualityIndex) +"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        (params.transportCostUSD > 5 ? 0.8 : 0.1)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      );"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      // Effective Willingness / Financial Access"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const financialAffordability = Math.max("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        0.2,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        params.insuranceCoverageRate * 0.5 +"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        (1 - Math.min(1, params.facilityDeliveryFeeUSD / 25)) * 0.35 +"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        params.maternalEducationRate * 0.15"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      );"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      // --- COMPUTE FLOW RATES ---"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      // Flow 1: Pregnant women seeking ANC (Inflow to S2 from S1)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const ancPropensity = Math.min(0.98, 0.45 + 0.35 * systemTrust + 0.2 * params.maternalEducationRate - 0.15 * (params.avgDistanceKm / 60));"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const rateToANC = (pregnantWomen / 3.0) * ancPropensity;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      // Flow 2: Transition from ANC to Institutional Delivery vs Home Delivery"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const facilityDeliveryPropensity = Math.min("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        0.98,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        0.3 + 0.35 * financialAffordability + 0.2 * systemTrust + 0.15 * qualityFactor - 0.18 * Math.max(0, (phase2Delay - 1.5) / 3)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      );"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const deliveryFromANC = (inANC / 4.5) * facilityDeliveryPropensity;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const homeDeliveryFromANC = (inANC / 4.5) * (1 - facilityDeliveryPropensity);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      // Flow 3: Direct Pregnant Women Delivery without ANC"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const directFacilityDelivery = (pregnantWomen / 7.5) * (1 - ancPropensity) * (facilityDeliveryPropensity * 0.6);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const directHomeDelivery = (pregnantWomen / 7.5) * (1 - ancPropensity) * (1 - facilityDeliveryPropensity * 0.6);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      // Total Deliveries"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const totalInstitutionalDeliveries = deliveryFromANC + directFacilityDelivery;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const totalHomeDeliveries = homeDeliveryFromANC + directHomeDelivery;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      // Flow 4: Complication Inflows (15% base + risk moderators)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const complicationRisk = params.baselineComplicationRate * (1.1 - 0.2 * params.maternalEducationRate);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const complicationsFromANC = (inANC / 4.5) * complicationRisk * 0.4;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const complicationsFromHome = totalHomeDeliveries * complicationRisk;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const complicationsFromFacility = totalInstitutionalDeliveries * complicationRisk;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const totalComplicationInflow = complicationsFromANC + complicationsFromHome + complicationsFromFacility;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      // Flow 5: Emergency Referrals from Complications into Facility Care"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      // TBA Training significantly boosts referral from community/home complications"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const tbaReferralBoost = 1.0 + (1 - params.tbaInfluenceFactor) * 0.8;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const emergencyReferralRate = (withComplications / Math.max(0.1, phase2Delay * 0.15)) * Math.min(1.0, 0.45 * tbaReferralBoost * (params.roadQualityIndex + 0.3));"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      // Flow 6: Complication Case Fatality & Deaths"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      // Institutional delivery with high quality drastically lowers fatality (< 1%)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      // Unattended home complications with high delay have ~18-35% fatality"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const institutionalCaseFatality = Math.max(0.005, 0.045 * (1 - qualityFactor) * (1 + Math.max(0, congestionIndex - 1.0) * 0.5));"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const emergencyReferralCaseFatality = Math.max(0.015, 0.12 * (phase2Delay / 3.5) * (1 - qualityFactor * 0.6));"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const homeComplicationCaseFatality = Math.max(0.08, 0.28 * (1 - params.maternalEducationRate * 0.3));"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const monthlyInstitutionalDeaths = (inFacilityDelivery / 0.1) * 0.0008 + (withComplications * 0.5) * institutionalCaseFatality;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const monthlyEmergencyDeaths = emergencyReferralRate * emergencyReferralCaseFatality;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const monthlyHomeDeaths = (totalHomeDeliveries * complicationRisk) * homeComplicationCaseFatality;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const totalStepDeaths = (monthlyInstitutionalDeaths + monthlyEmergencyDeaths + monthlyHomeDeaths) * dt;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const totalStepBirths = (totalInstitutionalDeliveries + totalHomeDeliveries) * dt;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      currentMonthAccumulatedDeaths += totalStepDeaths;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      currentMonthAccumulatedBirths += totalStepBirths;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      cumulativeDeaths += totalStepDeaths;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      cumulativeBirths += totalStepBirths;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      // Calculate baseline comparison deaths (without intervention)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const baselineStepDeaths = totalStepBirths * (district.baselineMMR / 100000);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      baselineCumulativeDeaths += baselineStepDeaths;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      // Flow 7: Postpartum Recovery & Exit"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const deliveryToPostpartum = (inFacilityDelivery / 0.08) * (1 - institutionalCaseFatality);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const complicationToPostpartum = (withComplications / 0.12) * (1 - (institutionalCaseFatality + emergencyReferralCaseFatality));"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const homeToPostpartum = (totalHomeDeliveries / 0.05);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const postpartumExit = inPostpartum / 1.4; // 42 days"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      // --- DERIVATIVE UPDATES (Euler / RK integration) ---"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const dPregnant = (monthlyPregnancies - rateToANC - (pregnantWomen / 7.5)) * dt;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const dANC = (rateToANC - (inANC / 4.5)) * dt;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const dFacilityDelivery = (totalInstitutionalDeliveries + emergencyReferralRate - (inFacilityDelivery / 0.08)) * dt;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const dComplications = (totalComplicationInflow - emergencyReferralRate - (withComplications / 0.12)) * dt;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const dPostpartum = (deliveryToPostpartum + complicationToPostpartum + homeToPostpartum - postpartumExit) * dt;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      pregnantWomen = Math.max(50, pregnantWomen + dPregnant);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      inANC = Math.max(20, inANC + dANC);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      inFacilityDelivery = Math.max(5, inFacilityDelivery + dFacilityDelivery);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      withComplications = Math.max(2, withComplications + dComplications);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      inPostpartum = Math.max(50, inPostpartum + dPostpartum);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      // Record monthly snapshots"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      if (step > 0 && step % Math.round(1 / dt) === 0) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        const calculatedMMR = currentMonthAccumulatedBirths > 0"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          ? Math.round((currentMonthAccumulatedDeaths / currentMonthAccumulatedBirths) * 100000)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          : district.baselineMMR;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        rollingObservedMMR = rollingObservedMMR * 0.7 + calculatedMMR * 0.3;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        const calculatedANC = Math.min(99, Math.round((inANC / Math.max(1, pregnantWomen)) * 100 * 1.15));"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        const calculatedFacilityDelivery = Math.min(99, Math.round((totalInstitutionalDeliveries / Math.max(0.1, totalInstitutionalDeliveries + totalHomeDeliveries)) * 100));"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        monthlySnapshots.push({"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          timeMonth: currentMonth,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          pregnantWomen: Math.round(pregnantWomen),"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          inANC: Math.round(inANC),"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          inFacilityDelivery: Math.round(inFacilityDelivery),"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          inPostpartum: Math.round(inPostpartum),"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          withComplications: Math.round(withComplications),"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          monthlyBirths: Math.round(currentMonthAccumulatedBirths),"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          monthlyMaternalDeaths: Math.round(currentMonthAccumulatedDeaths * 10) / 10,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          monthlyLivesSaved: Math.max(0, Math.round((baselineStepDeaths * 10 - currentMonthAccumulatedDeaths) * 10) / 10),"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          calculatedMMR: Math.max(80, calculatedMMR),"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          ancCoveragePercent: calculatedANC,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          facilityDeliveryPercent: calculatedFacilityDelivery,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          systemTrustLevel: Math.round(systemTrust * 100) / 100,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          facilityCongestionIndex: Math.round(congestionIndex * 100) / 100,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          phase2DelayHours: Math.round(phase2Delay * 10) / 10,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        });"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        currentMonthAccumulatedBirths = 0;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        currentMonthAccumulatedDeaths = 0;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const finalSnapshot = monthlySnapshots[monthlySnapshots.length - 1] || monthlySnapshots[0];"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const finalMMR = finalSnapshot.calculatedMMR;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const totalLivesSaved = Math.max(0, Math.round(baselineCumulativeDeaths - cumulativeDeaths));"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const mmrReductionPercent = Math.max(0, Math.round(((district.baselineMMR - finalMMR) / district.baselineMMR) * 1000) / 10);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // Cost calculations"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const totalCost = Math.round(district.population * scenarioDef.costPerCapitaUSD * (simulationMonths / 12));"
