        }
        lines {
          text: "      for (let c = 0; c < gridSize; c++) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        const lng = minLng + (c / (gridSize - 1)) * (maxLng - minLng);"
