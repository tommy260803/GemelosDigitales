    instruction: "Update ReportsView.tsx to High Density theme with sharp borders, sky accents, mono numbers and compact layout"
    replacement_infos {
      original_chunk {
        target_content: "  return (\n    <div className=\"space-y-6\">\n      \n      {/* Header with Export Action Buttons */}\n      <div className=\"bg-slate-900/90 border border-slate-800 rounded-xl p-5 shadow-sm\">\n        <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n          <div>\n            <div className=\"flex items-center space-x-2\">\n              <span className=\"px-2 py-0.5 text-xs font-bold rounded bg-teal-500/20 text-teal-300 border border-teal-500/30\">\n                POLICY BRIEF & TECHNICAL REPORT GENERATOR\n              </span>\n              <h2 className=\"text-base font-bold text-white\">\n                Automated Evidence Synthesis & Publication-Ready Export\n              </h2>\n            </div>\n            <p className=\"text-xs text-slate-400 mt-1\">\n              Export comprehensive policy briefs formatted for Ministries of Health, WHO, and district planners.\n            </p>\n          </div>\n\n          <div className=\"flex items-center space-x-2\">\n            <button\n              id=\"btn-download-pdf-view\"\n              onClick={handleDownloadPDF}\n              className=\"flex items-center space-x-2 px-4 py-2 rounded-lg bg-rose-600 hover:bg-rose-500 text-white text-xs font-bold shadow transition cursor-pointer\"\n            >\n              <FileText className=\"w-4 h-4\" />\n              <span>Download Executive PDF</span>\n            </button>\n\n            <button\n              id=\"btn-download-excel-view\"\n              onClick={handleDownloadExcel}\n              className=\"flex items-center space-x-2 px-4 py-2 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold shadow transition cursor-pointer\"\n            >\n              <Download className=\"w-4 h-4\" />\n              <span>Download Excel Workbook</span>\n            </button>\n          </div>\n        </div>\n      </div>\n\n      {/* Document Reader Paper Mockup */}\n      <div className=\"max-w-4xl mx-auto bg-slate-950 border border-slate-800 rounded-2xl p-8 shadow-2xl text-slate-200 space-y-6\">\n        \n        {/* Document Header */}\n        <div className=\"border-b border-slate-800 pb-5\">\n          <div className=\"flex items-center justify-between text-xs text-slate-400 mb-2\">\n            <span className=\"font-mono uppercase tracking-widest text-teal-400\">Policy Brief / Technical Document</span>\n            <span>Date: {new Date().toLocaleDateString(\'en-US\', { year: \'numeric\', month: \'long\', day: \'numeric\' })}</span>\n          </div>\n          <h1 className=\"text-xl font-bold text-white tracking-tight\">\n            Targeted System Dynamics Interventions to Reduce Maternal Mortality in {district.name}, {district.country}\n          </h1>\n          <p className=\"text-xs text-slate-400 mt-1\">\n            Author: Population Digital Twin System Dynamics Modeling Group | Reference ID: MHT-SD-{district.id.toUpperCase()}-2026\n          </p>\n        </div>\n\n        {/* 1. Executive Summary */}\n        <div className=\"space-y-2\">\n          <h2 className=\"text-sm font-bold text-teal-300 uppercase tracking-wider\">1. Executive Summary & Key Findings</h2>\n          <p className=\"text-xs leading-relaxed text-slate-300\">\n            A continuous-time 5-stock System Dynamics model was calibrated using Demographic and Health Surveys (DHS) and DHIS2 data for <strong>{district.name} ({district.country})</strong>. The baseline Maternal Mortality Ratio (MMR) is <strong>{district.baselineMMR} per 100,000 live births</strong>. Simulation over a 36-month horizon indicates that implementing a combined policy package\342\200\224comprising motorcycle ambulances, complete delivery fee abolition, and certified Traditional Birth Attendant (TBA) danger sign recognition\342\200\224aversion of <strong>{comboRes.summary.livesSaved} maternal deaths (95% CI: [{comboRes.summary.livesSavedCI95[0]} - {comboRes.summary.livesSavedCI95[1]}])</strong>, achieving a <strong>{comboRes.summary.mmrReductionPercent}% reduction in MMR</strong>.\n          </p>\n        </div>\n\n        {/* 2. Key Intervention Matrix */}\n        <div className=\"space-y-3\">\n          <h2 className=\"text-sm font-bold text-teal-300 uppercase tracking-wider\">2. Comparative Policy Interventions Matrix</h2>\n          <div className=\"overflow-x-auto border border-slate-800 rounded-lg\">\n            <table className=\"w-full text-left text-xs\">\n              <thead className=\"bg-slate-900 text-slate-400\">\n                <tr>\n                  <th className=\"p-2.5\">Scenario</th>\n                  <th className=\"p-2.5\">Lives Saved (95% CI)</th>\n                  <th className=\"p-2.5\">Final MMR</th>\n                  <th className=\"p-2.5\">MMR Red. %</th>\n                  <th className=\"p-2.5\">Cost / Life</th>\n                  <th className=\"p-2.5\">ICER ($/DALY)</th>\n                </tr>\n              </thead>\n              <tbody className=\"divide-y divide-slate-800\">\n                {SCENARIO_DEFINITIONS.map((s) => {\n                  const r = allResults[s.id];\n                  return (\n                    <tr key={s.id} className={s.id === \'scenario_d\' ? \'bg-teal-950/20 font-bold text-teal-300\' : \'\'}>\n                      <td className=\"p-2.5\">({s.letter}) {s.name.split(\'(\')[0]}</td>\n                      <td className=\"p-2.5 font-mono\">{r.summary.livesSaved} [{r.summary.livesSavedCI95[0]}-{r.summary.livesSavedCI95[1]}]</td>\n                      <td className=\"p-2.5 font-mono\">{r.summary.mmrFinal}</td>\n                      <td className=\"p-2.5 text-emerald-400\">-{r.summary.mmrReductionPercent}%</td>\n                      <td className=\"p-2.5 font-mono\">${r.summary.costPerLifeSavedUSD.toLocaleString()}</td>\n                      <td className=\"p-2.5 font-mono text-cyan-300\">${r.summary.icerPerDALY}</td>\n                    </tr>\n                  );\n                })}\n              </tbody>\n            </table>\n          </div>\n        </div>\n\n        {/* 3. Equity & Policy Recommendations */}\n        <div className=\"space-y-2\">\n          <h2 className=\"text-sm font-bold text-teal-300 uppercase tracking-wider\">3. Strategic Policy Recommendations</h2>\n          <div className=\"space-y-1.5 text-xs text-slate-300\">\n            <div className=\"flex items-start space-x-2\">\n              <span className=\"text-teal-400 font-bold\">\342\200\242</span>\n              <span><strong>Prioritize Phase 2 Transport:</strong> Deploy 4x4 motorcycle ambulance units to the most remote sub-counties, reducing referral delays from {district.avgTravelTimeHours}h to under 1.0h.</span>\n            </div>\n            <div className=\"flex items-start space-x-2\">\n              <span className=\"text-teal-400 font-bold\">\342\200\242</span>\n              <span><strong>Abolish Out-of-Pocket Delivery Fees:</strong> Eliminating the average ${district.facilityDeliveryFeeUSD} delivery fee disproportionately rescues mothers in DHS Wealth Quintiles 1 & 2.</span>\n            </div>\n            <div className=\"flex items-start space-x-2\">\n              <span className=\"text-teal-400 font-bold\">\342\200\242</span>\n              <span><strong>Certify TBAs as Community Referral Champions:</strong> Shift TBA incentives toward early danger sign detection and rapid facility referral.</span>\n            </div>\n          </div>\n        </div>\n\n        {/* 4. Statistical Validation Box */}\n        <div className=\"bg-slate-900 p-4 rounded-xl border border-slate-800 text-xs space-y-2\">\n          <h3 className=\"font-bold text-white flex items-center space-x-2\">\n            <ShieldCheck className=\"w-4 h-4 text-emerald-400\" />\n            <span>Technical Validation & Sensitivity Summary</span>\n          </h3>\n          <p className=\"text-slate-400\">\n            \342\200\242 <strong>Kolmogorov-Smirnov Test:</strong> D = {validationMetrics.kolmogorovSmirnov.statisticD}, p = {validationMetrics.kolmogorovSmirnov.pValue} (Simulated distributions match empirical DHS GPS survey).<br />\n            \342\200\242 <strong>Wilcoxon Signed-Rank Test:</strong> W = {validationMetrics.wilcoxonSignedRank.statisticW}, p = {validationMetrics.wilcoxonSignedRank.pValue} (Zero systematic cross-district bias across 25 Sub-Saharan districts).<br />\n            \342\200\242 <strong>Goodness-of-Fit vs Countdown 2030:</strong> R\302\262 = {validationMetrics.externalValidation.rSquared}, RMSE = {validationMetrics.externalValidation.rmse} per 100k live births.\n          </p>\n        </div>\n\n      </div>\n\n    </div>\n  );"
        replacement_content: "  return (\n    <div className=\"space-y-4\">\n      \n      {/* Header with Export Action Buttons */}\n      <div className=\"bg-slate-900/50 border border-slate-800 rounded-lg p-3.5 shadow-sm\">\n        <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n          <div>\n            <div className=\"flex items-center space-x-2\">\n              <span className=\"px-2 py-0.5 text-[10px] font-mono font-bold rounded bg-sky-500/20 text-sky-300 border border-sky-500/30 uppercase tracking-wider\">\n                POLICY BRIEF &amp; TECHNICAL REPORT GENERATOR\n              </span>\n              <h2 className=\"text-xs font-bold text-white uppercase tracking-tight\">\n                Automated Evidence Synthesis &amp; Publication-Ready Export\n              </h2>\n            </div>\n            <p className=\"text-[11px] text-slate-400 font-mono mt-0.5\">\n              Export comprehensive policy briefs formatted for Ministries of Health, WHO, and district planners.\n            </p>\n          </div>\n\n          <div className=\"flex items-center space-x-2 font-mono text-xs\">\n            <button\n              id=\"btn-download-pdf-view\"\n              onClick={handleDownloadPDF}\n              className=\"flex items-center space-x-1.5 px-3 py-1.5 rounded bg-rose-600 hover:bg-rose-500 text-white text-xs font-bold shadow transition cursor-pointer\"\n            >\n              <FileText className=\"w-3.5 h-3.5\" />\n              <span>Download Executive PDF</span>\n            </button>\n\n            <button\n              id=\"btn-download-excel-view\"\n              onClick={handleDownloadExcel}\n              className=\"flex items-center space-x-1.5 px-3 py-1.5 rounded bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold shadow transition cursor-pointer\"\n            >\n              <Download className=\"w-3.5 h-3.5\" />\n              <span>Download Excel Workbook</span>\n            </button>\n          </div>\n        </div>\n      </div>\n\n      {/* Document Reader Paper Mockup */}\n      <div className=\"max-w-4xl mx-auto bg-[#0c0e12] border border-slate-800 rounded-xl p-6 shadow-2xl text-slate-200 space-y-4\">\n        \n        {/* Document Header */}\n        <div className=\"border-b border-slate-800 pb-3.5\">\n          <div className=\"flex items-center justify-between text-[10px] text-slate-500 font-mono mb-1\">\n            <span className=\"uppercase tracking-widest text-sky-400 font-bold\">Policy Brief / Technical Document</span>\n            <span>Date: {new Date().toLocaleDateString(\'en-US\', { year: \'numeric\', month: \'long\', day: \'numeric\' })}</span>\n          </div>\n          <h1 className=\"text-base font-bold text-white uppercase tracking-tight\">\n            Targeted System Dynamics Interventions to Reduce Maternal Mortality in {district.name}, {district.country}\n          </h1>\n          <p className=\"text-[10px] text-slate-500 font-mono mt-0.5\">\n            Author: Population Digital Twin System Dynamics Modeling Group | Reference ID: MHT-SD-{district.id.toUpperCase()}-2026\n          </p>\n        </div>\n\n        {/* 1. Executive Summary */}\n        <div className=\"space-y-1.5\">\n          <h2 className=\"text-xs font-bold text-sky-400 uppercase tracking-wider font-mono\">1. Executive Summary &amp; Key Findings</h2>\n          <p className=\"text-xs leading-relaxed text-slate-300\">\n            A continuous-time 5-stock System Dynamics model was calibrated using Demographic and Health Surveys (DHS) and DHIS2 data for <strong>{district.name} ({district.country})</strong>. The baseline Maternal Mortality Ratio (MMR) is <strong>{district.baselineMMR} per 100,000 live births</strong>. Simulation over a 36-month horizon indicates that implementing a combined policy package\342\200\224comprising motorcycle ambulances, complete delivery fee abolition, and certified Traditional Birth Attendant (TBA) danger sign recognition\342\200\224aversion of <strong className=\"text-sky-300 font-mono\">{comboRes.summary.livesSaved} maternal deaths (95% CI: [{comboRes.summary.livesSavedCI95[0]} - {comboRes.summary.livesSavedCI95[1]}])</strong>, achieving a <strong className=\"text-emerald-400 font-mono\">{comboRes.summary.mmrReductionPercent}% reduction in MMR</strong>.\n          </p>\n        </div>\n\n        {/* 2. Key Intervention Matrix */}\n        <div className=\"space-y-2\">\n          <h2 className=\"text-xs font-bold text-sky-400 uppercase tracking-wider font-mono\">2. Comparative Policy Interventions Matrix</h2>\n          <div className=\"overflow-x-auto border border-slate-800 rounded\">\n            <table className=\"w-full text-left text-xs font-mono\">\n              <thead className=\"bg-[#131a26] text-slate-400 text-[10px] uppercase font-bold\">\n                <tr>\n                  <th className=\"p-2\">Scenario</th>\n                  <th className=\"p-2\">Lives Saved (95% CI)</th>\n                  <th className=\"p-2\">Final MMR</th>\n                  <th className=\"p-2\">MMR Red. %</th>\n                  <th className=\"p-2\">Cost / Life</th>\n                  <th className=\"p-2\">ICER ($/DALY)</th>\n                </tr>\n              </thead>\n              <tbody className=\"divide-y divide-slate-800 text-[11px]\">\n                {SCENARIO_DEFINITIONS.map((s) => {\n                  const r = allResults[s.id];\n                  return (\n                    <tr key={s.id} className={s.id === \'scenario_d\' ? \'bg-sky-950/20 font-bold text-sky-300\' : \'text-slate-300\'}>\n                      <td className=\"p-2\">({s.letter}) {s.name.split(\'(\')[0]}</td>\n                      <td className=\"p-2 font-bold\">{r.summary.livesSaved} [{r.summary.livesSavedCI95[0]}-{r.summary.livesSavedCI95[1]}]</td>\n                      <td className=\"p-2 text-slate-200\">{r.summary.mmrFinal}</td>\n                      <td className=\"p-2 text-emerald-400\">-{r.summary.mmrReductionPercent}%</td>\n                      <td className=\"p-2\">${r.summary.costPerLifeSavedUSD.toLocaleString()}</td>\n                      <td className=\"p-2 text-cyan-400\">${r.summary.icerPerDALY}</td>\n                    </tr>\n                  );\n                })}\n              </tbody>\n            </table>\n          </div>\n        </div>\n\n        {/* 3. Equity & Policy Recommendations */}\n        <div className=\"space-y-1.5\">\n          <h2 className=\"text-xs font-bold text-sky-400 uppercase tracking-wider font-mono\">3. Strategic Policy Recommendations</h2>\n          <div className=\"space-y-1 text-xs text-slate-300\">\n            <div className=\"flex items-start space-x-2\">\n              <span className=\"text-sky-400 font-bold\">\342\200\242</span>\n              <span><strong>Prioritize Phase 2 Transport:</strong> Deploy 4x4 motorcycle ambulance units to the most remote sub-counties, reducing referral delays from {district.avgTravelTimeHours}h to under 1.0h.</span>\n            </div>\n            <div className=\"flex items-start space-x-2\">\n              <span className=\"text-sky-400 font-bold\">\342\200\242</span>\n              <span><strong>Abolish Out-of-Pocket Delivery Fees:</strong> Eliminating the average ${district.facilityDeliveryFeeUSD} delivery fee disproportionately rescues mothers in DHS Wealth Quintiles 1 &amp; 2.</span>\n            </div>\n            <div className=\"flex items-start space-x-2\">\n              <span className=\"text-sky-400 font-bold\">\342\200\242</span>\n              <span><strong>Certify TBAs as Community Referral Champions:</strong> Shift TBA incentives toward early danger sign detection and rapid facility referral.</span>\n            </div>\n          </div>\n        </div>\n\n        {/* 4. Statistical Validation Box */}\n        <div className=\"bg-slate-900/50 p-3 rounded-lg border border-slate-800 text-[11px] font-mono space-y-1.5\">\n          <h3 className=\"font-bold text-white flex items-center space-x-2 text-xs uppercase\">\n            <ShieldCheck className=\"w-3.5 h-3.5 text-emerald-400\" />\n            <span>Technical Validation &amp; Sensitivity Summary</span>\n          </h3>\n          <p className=\"text-slate-400 leading-relaxed font-sans text-xs\">\n            \342\200\242 <strong>Kolmogorov-Smirnov Test:</strong> D = {validationMetrics.kolmogorovSmirnov.statisticD}, p = {validationMetrics.kolmogorovSmirnov.pValue} (Simulated distributions match empirical DHS GPS survey).<br />\n            \342\200\242 <strong>Wilcoxon Signed-Rank Test:</strong> W = {validationMetrics.wilcoxonSignedRank.statisticW}, p = {validationMetrics.wilcoxonSignedRank.pValue} (Zero systematic cross-district bias across 25 Sub-Saharan districts).<br />\n            \342\200\242 <strong>Goodness-of-Fit vs Countdown 2030:</strong> R\302\262 = {validationMetrics.externalValidation.rSquared}, RMSE = {validationMetrics.externalValidation.rmse} per 100k live births.\n          </p>\n        </div>\n\n      </div>\n\n    </div>\n  );"
      }
      num_matches: 1
    }
  }
}
