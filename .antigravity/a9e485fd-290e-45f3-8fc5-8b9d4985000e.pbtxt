        lines {
          text: "   */"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  public static runExternalValidation(testDistrictId: string = \'ug-moroto\'): ValidationMetrics[\'externalValidation\'] {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const holdout = SUB_SAHARAN_DISTRICTS.find((d) => d.id === testDistrictId) || SUB_SAHARAN_DISTRICTS[0];"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
