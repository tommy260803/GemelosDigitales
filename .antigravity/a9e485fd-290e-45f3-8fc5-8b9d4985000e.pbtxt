      replacement_content: "import React, { useState, useMemo } from \'react\';\nimport { DistrictData, Country } from \'../types\';\nimport { SUB_SAHARAN_DISTRICTS } from \'../data/districts\';\nimport { SystemDynamicsEngine } from \'../services/systemDynamics\';\nimport { MapPin, Navigation, Layers, Info, Filter, CheckCircle2 } from \'lucide-react\';\nimport { useLanguage } from \'../i18n/translations\';\n\ninterface GeospatialMapViewProps {\n  selectedDistrict: DistrictData;\n  onSelectDistrict: (district: DistrictData) => void;\n  districtsList?: DistrictData[];\n}\n\ntype ChoroplethMetric = \'baselineMMR\' | \'livesSaved\' | \'travelTime\' | \'facilityDelivery\' | \'facilitiesCount\';\n\nexport const GeospatialMapView: React.FC<GeospatialMapViewProps> = ({\n  selectedDistrict,\n  onSelectDistrict,\n  districtsList = SUB_SAHARAN_DISTRICTS,\n}) => {\n  const { language } = useLanguage();\n  const [selectedCountry, setSelectedCountry] = useState<Country | \'ALL\'>(\'ALL\');\n  const [activeMetric, setActiveMetric] = useState<ChoroplethMetric>(\'baselineMMR\');\n  const [hoveredDistrict, setHoveredDistrict] = useState<DistrictData | null>(null);\n\n  // Filter districts\n  const filteredDistricts = useMemo(() => {\n    if (selectedCountry === \'ALL\') return districtsList;\n    return districtsList.filter((d) => d.country === selectedCountry);\n  }, [districtsList, selectedCountry]);\n\n  // Compute metric calculations (e.g. lives saved with scenario_d)\n  const districtMetrics = useMemo(() => {\n    const map = new Map<string, { livesSaved: number; mmrReduction: number }>();\n    districtsList.forEach((d) => {\n      const res = SystemDynamicsEngine.simulate(d, \'scenario_d\');\n      map.set(d.id, {\n        livesSaved: res.summary.livesSaved,\n        mmrReduction: res.summary.mmrReductionPercent,\n      });\n    });\n    return map;\n  }, [districtsList]);\n\n  // Metric color and size calculator\n  const getMetricValue = (d: DistrictData, metric: ChoroplethMetric): number => {\n    switch (metric) {\n      case \'baselineMMR\':\n        return d.baselineMMR;\n      case \'livesSaved\':\n        return districtMetrics.get(d.id)?.livesSaved || 0;\n      case \'travelTime\':\n        return d.avgTravelTimeHours;\n      case \'facilityDelivery\':\n        return d.institutionalDeliveryRate;\n      case \'facilitiesCount\':\n        return d.osmHealthFacilitiesCount || 20;\n    }\n  };\n\n  const getMetricColor = (val: number, metric: ChoroplethMetric): string => {\n    if (metric === \'baselineMMR\') {\n      if (val >= 700) return \'#ef4444\'; // Red-500\n      if (val >= 550) return \'#f97316\'; // Orange-500\n      if (val >= 400) return \'#eab308\'; // Yellow-500\n      return \'#10b981\'; // Green-500\n    }\n    if (metric === \'livesSaved\') {\n      if (val >= 150) return \'#10b981\'; // Green-500\n      if (val >= 100) return \'#06b6d4\'; // Cyan-500\n      if (val >= 50) return \'#3b82f6\'; // Blue-500\n      return \'#a855f7\'; // Purple-500\n    }\n    if (metric === \'travelTime\') {\n      if (val >= 4.0) return \'#ef4444\';\n      if (val >= 2.5) return \'#f59e0b\';\n      return \'#10b981\';\n    }\n    if (metric === \'facilityDelivery\') {\n      if (val >= 70) return \'#10b981\';\n      if (val >= 50) return \'#06b6d4\';\n      return \'#f97316\';\n    }\n    // facilitiesCount\n    if (val >= 50) return \'#3b82f6\';\n    if (val >= 30) return \'#06b6d4\';\n    return \'#64748b\';\n  };\n\n  // Convert lat/lng coordinates to SVG map projection (Equirectangular scaled for Africa region)\n  // Lat: ~ -15 (south) to 15 (north) -> range 30\n  // Lng: ~ -18 (west) to 48 (east) -> range 66\n  const projectCoords = (lat: number, lng: number): { x: number; y: number } => {\n    const minLng = -18;\n    const maxLng = 48;\n    const minLat = -16;\n    const maxLat = 16;\n\n    const x = ((lng - minLng) / (maxLng - minLng)) * 800;\n    const y = ((maxLat - lat) / (maxLat - minLat)) * 500;\n    return { x: Math.max(30, Math.min(770, x)), y: Math.max(30, Math.min(470, y)) };\n  };\n\n  return (\n    <div className=\"space-y-4\">\n      {/* Top Controls Header */}\n      <div className=\"bg-slate-900/50 border border-slate-800 rounded-lg p-4 shadow-sm flex flex-col lg:flex-row lg:items-center justify-between gap-4\">\n        <div>\n          <div className=\"flex items-center space-x-2\">\n            <span className=\"px-2 py-0.5 text-[10px] font-mono font-bold rounded bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 uppercase tracking-wider\">\n              GIS SPATIAL EPIDEMIOLOGY\n            </span>\n            <h2 className=\"text-sm font-bold text-white uppercase tracking-wider\">\n              {language === \'es\' ? \'Mapa Coropl\303\251tico & Geoespacial de 25 Distritos\' : \'Choropleth GIS Geospatial Health Map\'}\n            </h2>\n          </div>\n          <p className=\"text-xs text-slate-400 font-mono mt-0.5\">\n            {language === \'es\'\n              ? \'Georreferenciaci\303\263n de distritos DHS, hospitales EmONC y gradientes epidemiol\303\263gicos de mortalidad materna.\'\n              : \'Georeferenced DHS clusters, EmONC referral hospitals, and maternal mortality spatial gradients.\'}\n          </p>\n        </div>\n\n        {/* Metric & Country Selectors */}\n        <div className=\"flex flex-wrap items-center gap-2 font-mono text-xs\">\n          <div className=\"flex items-center bg-[#0c0e12] rounded p-1 border border-slate-800\">\n            <Filter className=\"w-3.5 h-3.5 text-slate-400 ml-1.5 mr-1\" />\n            <select\n              value={selectedCountry}\n              onChange={(e) => setSelectedCountry(e.target.value as Country | \'ALL\')}\n              className=\"bg-transparent text-slate-200 text-xs px-2 py-1 focus:outline-none cursor-pointer\"\n            >\n              <option value=\"ALL\" className=\"bg-slate-900\">{language === \'es\' ? \'Todos los Pa\303\255ses (25 Distritos)\' : \'All Countries (25 Districts)\'}</option>\n              <option value=\"Kenya\" className=\"bg-slate-900\">Kenya (5)</option>\n              <option value=\"Tanzania\" className=\"bg-slate-900\">Tanzania (5)</option>\n              <option value=\"Uganda\" className=\"bg-slate-900\">Uganda (5)</option>\n              <option value=\"Ghana\" className=\"bg-slate-900\">Ghana (5)</option>\n              <option value=\"Ethiopia\" className=\"bg-slate-900\">Ethiopia (5)</option>\n            </select>\n          </div>\n\n          <div className=\"flex items-center bg-[#0c0e12] rounded p-1 border border-slate-800\">\n            <Layers className=\"w-3.5 h-3.5 text-sky-400 ml-1.5 mr-1\" />\n            <select\n              value={activeMetric}\n              onChange={(e) => setActiveMetric(e.target.value as ChoroplethMetric)}\n              className=\"bg-transparent text-sky-300 font-bold text-xs px-2 py-1 focus:outline-none cursor-pointer\"\n            >\n              <option value=\"baselineMMR\" className=\"bg-slate-900\">{language === \'es\' ? \'Raz\303\263n de Mortalidad Materna (RMM Base)\' : \'Baseline Maternal Mortality Ratio\'}</option>\n              <option value=\"livesSaved\" className=\"bg-slate-900\">{language === \'es\' ? \'Vidas Salvadas Proyectadas (Paquete D)\' : \'Projected Lives Saved (Package D)\'}</option>\n              <option value=\"travelTime\" className=\"bg-slate-900\">{language === \'es\' ? \'Tiempo de Traslado a EmONC (Horas)\' : \'Transit Time to EmONC (Hours)\'}</option>\n              <option value=\"facilityDelivery\" className=\"bg-slate-900\">{language === \'es\' ? \'Tasa de Parto Institucional (%)\' : \'Institutional Delivery Rate (%)\'}</option>\n              <option value=\"facilitiesCount\" className=\"bg-slate-900\">{language === \'es\' ? \'Centros de Salud OpenStreetMap\' : \'OpenStreetMap Health Facilities\'}</option>\n            </select>\n          </div>\n        </div>\n      </div>\n\n      {/* Main Map & Detail Panel Grid */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-4\">\n        \n        {/* Interactive Vector GIS Canvas (2 Cols) */}\n        <div className=\"lg:col-span-2 bg-[#080a0f] border border-slate-800 rounded-lg p-3 relative overflow-hidden flex flex-col justify-between min-h-[480px]\">\n          \n          {/* Map Title & Legend Overlay */}\n          <div className=\"absolute top-4 left-4 z-10 bg-slate-900/90 backdrop-blur border border-slate-800 rounded-lg p-2.5 font-mono text-[11px] space-y-1 shadow-lg max-w-[260px]\">\n            <div className=\"font-bold text-white flex items-center justify-between\">\n              <span>{language === \'es\' ? \'Capa Activa:\' : \'Active Layer:\'}</span>\n              <span className=\"text-sky-400\">\n                {activeMetric === \'baselineMMR\' && \'MMR / 100k\'}\n                {activeMetric === \'livesSaved\' && \'Lives Saved\'}\n                {activeMetric === \'travelTime\' && \'Transit Hours\'}\n                {activeMetric === \'facilityDelivery\' && \'Inst. Delivery %\'}\n                {activeMetric === \'facilitiesCount\' && \'OSM Health Facilities\'}\n              </span>\n            </div>\n            <div className=\"flex items-center gap-1 pt-1\">\n              <span className=\"text-[10px] text-slate-400\">Bajo</span>\n              <div className=\"flex-1 h-2 rounded bg-gradient-to-r from-emerald-500 via-amber-500 to-rose-500\" />\n              <span className=\"text-[10px] text-slate-400\">Alto</span>\n            </div>\n            <div className=\"text-[9px] text-slate-500 pt-0.5\">\n              {language === \'es\' ? \'Haz clic en un distrito para simularlo.\' : \'Click on any district pin to simulate.\'}\n            </div>\n          </div>\n\n          {/* SVG Vector Map Container */}\n          <div className=\"w-full h-full flex items-center justify-center pt-8 pb-2\">\n            <svg\n              viewBox=\"0 0 800 500\"\n              className=\"w-full h-full max-h-[440px] drop-shadow-xl select-none\"\n            >\n              {/* Subtle GIS Grid Lines */}\n              <g stroke=\"#1e293b\" strokeWidth=\"0.5\" strokeDasharray=\"3 3\" opacity=\"0.6\">\n                {[100, 200, 300, 400].map((y) => (\n                  <line key={`h-${y}`} x1=\"0\" y1={y} x2=\"800\" y2={y} />\n                ))}\n                {[150, 300, 450, 600, 750].map((x) => (\n                  <line key={`v-${x}`} x1={x} y1=\"0\" x2={x} y2=\"500\" />\n                ))}\n              </g>\n\n              {/* Equator & Prime Reference Markers */}\n              <line x1=\"0\" y1=\"250\" x2=\"800\" y2=\"250\" stroke=\"#0ea5e9\" strokeWidth=\"0.8\" opacity=\"0.3\" strokeDasharray=\"5 5\" />\n              <text x=\"730\" y=\"245\" fill=\"#0ea5e9\" fontSize=\"9\" fontFamily=\"monospace\" opacity=\"0.6\">Ecuador 0\302\260</text>\n\n              {/* Approximate Sub-Saharan Africa Coastline Silhouette for High-Craft Context */}\n              <path\n                d=\"M 280,110 Q 320,80 390,85 T 460,95 Q 540,110 590,130 Q 640,170 660,220 Q 640,260 610,290 T 570,360 Q 520,440 480,470 Q 430,450 390,390 T 360,310 Q 320,290 280,260 Q 230,220 220,180 Z\"\n                fill=\"#0f172a\"\n                stroke=\"#334155\"\n                strokeWidth=\"1.2\"\n                opacity=\"0.85\"\n              />\n\n              {/* Country Regional Cluster Boundaries (Interactive visual nodes) */}\n              <circle cx=\"590\" cy=\"255\" r=\"95\" fill=\"#0369a1\" fillOpacity=\"0.08\" stroke=\"#0284c7\" strokeWidth=\"0.8\" strokeDasharray=\"4 4\" />\n              <text x=\"610\" y=\"195\" fill=\"#38bdf8\" fontSize=\"10\" fontFamily=\"monospace\" fontWeight=\"bold\">East Africa Hub</text>\n\n              <circle cx=\"270\" cy=\"210\" r=\"60\" fill=\"#15803d\" fillOpacity=\"0.08\" stroke=\"#16a34a\" strokeWidth=\"0.8\" strokeDasharray=\"4 4\" />\n              <text x=\"235\" y=\"170\" fill=\"#4ade80\" fontSize=\"10\" fontFamily=\"monospace\" fontWeight=\"bold\">West Africa (Ghana)</text>\n\n              <circle cx=\"580\" cy=\"155\" r=\"65\" fill=\"#b45309\" fillOpacity=\"0.08\" stroke=\"#d97706\" strokeWidth=\"0.8\" strokeDasharray=\"4 4\" />\n              <text x=\"560\" y=\"115\" fill=\"#fbbf24\" fontSize=\"10\" fontFamily=\"monospace\" fontWeight=\"bold\">Horn of Africa (Ethiopia)</text>\n\n              {/* Connection links to selected district */}\n              {districtsList.map((d) => {\n                const pos = projectCoords(d.lat, d.lng);\n                const isSelected = d.id === selectedDistrict.id;\n                if (!isSelected) return null;\n                return (\n                  <circle\n                    key={`pulse-${d.id}`}\n                    cx={pos.x}\n                    cy={pos.y}\n                    r=\"24\"\n                    fill=\"none\"\n                    stroke=\"#38bdf8\"\n                    strokeWidth=\"1.5\"\n                    className=\"animate-ping opacity-75\"\n                  />\n                );\n              })}\n\n              {/* 25 Districts Geo Scatter Pins */}\n              {filteredDistricts.map((d) => {\n                const pos = projectCoords(d.lat, d.lng);\n                const isSelected = d.id === selectedDistrict.id;\n                const isHovered = hoveredDistrict?.id === d.id;\n                const val = getMetricValue(d, activeMetric);\n                const color = getMetricColor(val, activeMetric);\n                const radius = isSelected ? 9 : isHovered ? 8 : 6;\n\n                return (\n                  <g\n                    key={d.id}\n                    className=\"cursor-pointer transition-transform duration-200\"\n                    onClick={() => onSelectDistrict(d)}\n                    onMouseEnter={() => setHoveredDistrict(d)}\n                    onMouseLeave={() => setHoveredDistrict(null)}\n                  >\n                    {/* Outer Glow */}\n                    <circle\n                      cx={pos.x}\n                      cy={pos.y}\n                      r={radius + 4}\n                      fill={color}\n                      fillOpacity={isSelected ? 0.4 : isHovered ? 0.3 : 0.15}\n                    />\n\n                    {/* District Core Pin */}\n                    <circle\n                      cx={pos.x}\n                      cy={pos.y}\n                      r={radius}\n                      fill={color}\n                      stroke={isSelected ? \'#ffffff\' : \'#0c0e12\'}\n                      strokeWidth={isSelected ? 2 : 1.2}\n                    />\n\n                    {/* District Label Tag */}\n                    {(isSelected || isHovered) && (\n                      <g>\n                        <rect\n                          x={pos.x + 10}\n                          y={pos.y - 14}\n                          width={d.name.length * 7 + 20}\n                          height=\"20\"\n                          rx=\"4\"\n                          fill=\"#0f172a\"\n                          stroke={color}\n                          strokeWidth=\"1\"\n                          opacity=\"0.95\"\n                        />\n                        <text\n                          x={pos.x + 16}\n                          y={pos.y}\n                          fill=\"#ffffff\"\n                          fontSize=\"10\"\n                          fontFamily=\"monospace\"\n                          fontWeight=\"bold\"\n                        >\n                          {d.name}\n                        </text>\n                      </g>\n                    )}\n                  </g>\n                );\n              })}\n            </svg>\n          </div>\n\n          {/* Bottom Coordinates & Geo Status Bar */}\n          <div className=\"flex items-center justify-between text-[10px] font-mono text-slate-500 border-t border-slate-800/80 pt-2 px-1\">\n            <span className=\"flex items-center gap-1\">\n              <Navigation className=\"w-3 h-3 text-sky-400\" />\n              Proyecci\303\263n: Equirectangular WGS84 | Cobertura: 25 Distritos DHS (SSA)\n            </span>\n            <span>\n              Distritos Visibles: <strong className=\"text-slate-300\">{filteredDistricts.length}</strong> / 25\n            </span>\n          </div>\n        </div>\n\n        {/* Selected / Hovered District Telemetry Card (1 Col) */}\n        <div className=\"bg-slate-900/50 border border-slate-800 rounded-lg p-4 shadow-sm flex flex-col justify-between space-y-4\">\n          {(() => {\n            const target = hoveredDistrict || selectedDistrict;\n            const sim = SystemDynamicsEngine.simulate(target, \'scenario_d\');\n\n            return (\n              <div className=\"space-y-4 font-mono text-xs\">\n                {/* Header Badge */}\n                <div className=\"flex items-center justify-between border-b border-slate-800 pb-3\">\n                  <div>\n                    <span className=\"text-[10px] text-sky-400 font-bold uppercase block\">\n                      {target.country} \342\200\242 {target.region}\n                    </span>\n                    <h3 className=\"text-sm font-bold text-white mt-0.5\">{target.name}</h3>\n                  </div>\n                  {target.id === selectedDistrict.id && (\n                    <span className=\"px-2 py-0.5 rounded text-[10px] bg-sky-500/20 text-sky-300 border border-sky-500/30 flex items-center gap-1 font-bold\">\n                      <CheckCircle2 className=\"w-3 h-3 text-sky-400\" />\n                      ACTIVO\n                    </span>\n                  )}\n                </div>\n\n                {/* Spatial Demographics */}\n                <div className=\"grid grid-cols-2 gap-2\">\n                  <div className=\"bg-[#0c0e12] p-2.5 rounded border border-slate-800\">\n                    <span className=\"text-[10px] text-slate-500 uppercase block\">Poblaci\303\263n:</span>\n                    <span className=\"text-slate-200 font-bold\">{target.population.toLocaleString()}</span>\n                  </div>\n                  <div className=\"bg-[#0c0e12] p-2.5 rounded border border-slate-800\">\n                    <span className=\"text-[10px] text-slate-500 uppercase block\">Nacimientos/A\303\261o:</span>\n                    <span className=\"text-slate-200 font-bold\">{target.annualBirths.toLocaleString()}</span>\n                  </div>\n                  <div className=\"bg-[#0c0e12] p-2.5 rounded border border-slate-800\">\n                    <span className=\"text-[10px] text-slate-500 uppercase block\">RMM Base:</span>\n                    <span className=\"text-rose-400 font-bold text-sm\">{target.baselineMMR} /100k</span>\n                  </div>\n                  <div className=\"bg-[#0c0e12] p-2.5 rounded border border-slate-800\">\n                    <span className=\"text-[10px] text-slate-500 uppercase block\">EmONC Dist./Tiempo:</span>\n                    <span className=\"text-amber-400 font-bold\">{target.avgDistanceToEmONC}km ({target.avgTravelTimeHours}h)</span>\n                  </div>\n                </div>\n\n                {/* Clinical Readiness Grid */}\n                <div className=\"space-y-2 bg-[#0c0e12] p-3 rounded border border-slate-800\">\n                  <span className=\"text-[10px] text-slate-400 uppercase font-bold block\">\n                    Capacidad Cl\303\255nica &amp; Infraestructura:\n                  </span>\n                  <div className=\"flex justify-between text-[11px]\">\n                    <span className=\"text-slate-400\">Banco de Sangre / Fr\303\255o:</span>\n                    <span className=\"text-slate-200 font-bold\">{target.bloodBankAvailability}%</span>\n                  </div>\n                  <div className=\"flex justify-between text-[11px]\">\n                    <span className=\"text-slate-400\">Stock Uterot\303\263nicos:</span>\n                    <span className=\"text-slate-200 font-bold\">{target.essentialDrugsAvailability}%</span>\n                  </div>\n                  <div className=\"flex justify-between text-[11px]\">\n                    <span className=\"text-slate-400\">Centros Salud OpenStreetMap:</span>\n                    <span className=\"text-sky-300 font-bold\">{target.osmHealthFacilitiesCount} unidades</span>\n                  </div>\n                  <div className=\"flex justify-between text-[11px]\">\n                    <span className=\"text-slate-400\">Pobreza Extrema (&lt;$1.90):</span>\n                    <span className=\"text-slate-200 font-bold\">{target.povertyRate}%</span>\n                  </div>\n                </div>\n\n                {/* Scenario D Projection Preview */}\n                <div className=\"p-3 bg-sky-950/20 border border-sky-800/40 rounded-lg space-y-1.5\">\n                  <span className=\"text-[10px] text-sky-400 font-bold uppercase block\">\n                    \342\232\241 Proyecci\303\263n Gemelo Digital (Escenario D Combinado):\n                  </span>\n                  <div className=\"flex justify-between text-xs\">\n                    <span className=\"text-slate-300\">Vidas Salvadas (36 meses):</span>\n                    <strong className=\"text-emerald-400 text-sm\">+{sim.summary.livesSaved} madres</strong>\n                  </div>\n                  <div className=\"flex justify-between text-xs\">\n                    <span className=\"text-slate-300\">RMM Proyectada:</span>\n                    <strong className=\"text-sky-300\">{sim.summary.mmrFinal} (-{sim.summary.mmrReductionPercent}%)</strong>\n                  </div>\n                  <div className=\"flex justify-between text-xs\">\n                    <span className=\"text-slate-300\">Costo por Vida Salvada:</span>\n                    <strong className=\"text-amber-300\">${sim.summary.costPerLifeSavedUSD.toLocaleString()}</strong>\n                  </div>\n                </div>\n\n                {/* Action button if not active */}\n                {target.id !== selectedDistrict.id && (\n                  <button\n                    onClick={() => onSelectDistrict(target)}\n                    className=\"w-full py-2 px-3 rounded font-bold bg-sky-500 hover:bg-sky-400 text-slate-950 text-xs transition cursor-pointer flex items-center justify-center space-x-1.5\"\n                  >\n                    <MapPin className=\"w-3.5 h-3.5\" />\n                    <span>Cargar &amp; Simular {target.name}</span>\n                  </button>\n                )}\n              </div>\n            );\n          })()}\n        </div>\n\n      </div>\n    </div>\n  );\n};\n"
    }
    diff {
