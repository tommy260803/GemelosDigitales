    replacement_chunks {
      target_content: "      {/* Quintile Disaggregation Table & Concentration Bars */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-3\">\n        \n        {/* Table (2 Cols) */}\n        <div className=\"lg:col-span-2 bg-slate-900/50 border border-slate-800 rounded-lg p-4 shadow-sm space-y-3\">\n          <h3 className=\"text-xs font-bold text-white uppercase tracking-wider\">Quintile-Specific Mortality &amp; Lives Saved</h3>\n\n          <div className=\"overflow-x-auto\">\n            <table className=\"w-full text-left text-xs border-collapse font-mono\">\n              <thead>\n                <tr className=\"border-b border-slate-800 bg-[#0c0e12] text-slate-500 text-[10px] uppercase font-bold\">\n                  <th className=\"p-2.5\">Wealth Quintile</th>\n                  <th className=\"p-2.5\">Pop. Share</th>\n                  <th className=\"p-2.5\">Baseline MMR</th>\n                  <th className=\"p-2.5\">Simulated MMR</th>\n                  <th className=\"p-2.5\">Lives Saved</th>\n                  <th className=\"p-2.5\">Relative Red. %</th>\n                </tr>\n              </thead>\n              <tbody className=\"divide-y divide-slate-800/60\">\n                {equityData.map((q) => {\n                  const isQ1 = q.quintile === \'Q1\';\n                  return (\n                    <tr key={q.quintile} className={isQ1 ? \'bg-sky-950/20 font-bold\' : \'text-slate-300\'}>\n                      <td className=\"p-2.5\">\n                        <div className=\"flex items-center space-x-1.5\">\n                          <span className=\"font-bold text-white\">{q.quintile}</span>\n                          <span className=\"text-slate-500 text-[11px]\">({q.label})</span>\n                        </div>\n                      </td>\n                      <td className=\"p-2.5 text-slate-400\">{Math.round(q.populationShare * 100)}%</td>\n                      <td className=\"p-2.5 text-slate-400\">{q.baselineMMR}</td>\n                      <td className=\"p-2.5 font-bold text-emerald-400\">{q.simulatedMMR}</td>\n                      <td className=\"p-2.5 font-bold text-sky-400\">{q.livesSaved}</td>\n                      <td className=\"p-2.5 font-bold text-emerald-400\">-{q.relativeReduction}%</td>\n                    </tr>\n                  );\n                })}\n              </tbody>\n            </table>\n          </div>\n        </div>\n\n        {/* Visual Concentration Curve & Distribution (1 Col) */}\n        <div className=\"bg-slate-900/50 border border-slate-800 rounded-lg p-4 shadow-sm space-y-3 font-mono\">\n          <h3 className=\"text-xs font-bold text-white uppercase tracking-wider\">Equity Concentration Gradient</h3>\n          <p className=\"text-[11px] text-slate-400\">\n            Comparing mortality burden across wealth strata:\n          </p>\n\n          <div className=\"space-y-2.5 pt-1\">\n            {equityData.map((q) => (\n              <div key={q.quintile} className=\"space-y-1 text-xs\">\n                <div className=\"flex justify-between text-slate-300 text-[11px]\">\n                  <span>{q.quintile} ({q.label})</span>\n                  <span className=\"font-bold text-emerald-400\">{q.simulatedMMR}/100k</span>\n                </div>\n                <div className=\"w-full h-1.5 bg-[#0c0e12] rounded-full overflow-hidden flex border border-slate-800\">\n                  <div \n                    className=\"h-full bg-emerald-500 rounded-full transition-all duration-500\"\n                    style={{ width: `${Math.min(100, (q.simulatedMMR / (baselineQ1 || 1)) * 100)}%` }}\n                  />\n                </div>\n              </div>\n            ))}\n          </div>\n\n          <div className=\"p-2.5 rounded bg-[#0c0e12] border border-slate-800 text-[10px] text-slate-400 font-sans\">\n            \360\237\222\241 <strong>Policy Takeaway:</strong> Out-of-pocket facility delivery fees act as a regressive barrier, causing the largest delays in Q1. Universal fee abolition accelerates equitable mortality reduction.\n          </div>\n        </div>\n\n      </div>"
      replacement_content: "      {/* Quintile Disaggregation Table & Concentration Bars */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-3\">\n        \n        {/* Table (2 Cols) */}\n        <div className=\"lg:col-span-2 bg-slate-900/50 border border-slate-800 rounded-lg p-4 shadow-sm space-y-3\">\n          <div className=\"flex items-center justify-between\">\n            <h3 className=\"text-xs font-bold text-white uppercase tracking-wider\">\n              Quintile-Specific Mortality &amp; Fiscal Budget Allocation\n            </h3>\n            <span className=\"text-[10px] font-mono text-sky-400 font-bold\">\n              Total Budget: ${simResult.summary.totalCostUSD.toLocaleString()}\n            </span>\n          </div>\n\n          <div className=\"overflow-x-auto\">\n            <table className=\"w-full text-left text-xs border-collapse font-mono\">\n              <thead>\n                <tr className=\"border-b border-slate-800 bg-[#0c0e12] text-slate-500 text-[10px] uppercase font-bold\">\n                  <th className=\"p-2.5\">Quintile</th>\n                  <th className=\"p-2.5\">Baseline</th>\n                  <th className=\"p-2.5\">Simulated</th>\n                  <th className=\"p-2.5\">Lives Saved</th>\n                  <th className=\"p-2.5\">Fiscal Cost</th>\n                  <th className=\"p-2.5\">Cost / Life</th>\n                  <th className=\"p-2.5\">Equity Impact</th>\n                </tr>\n              </thead>\n              <tbody className=\"divide-y divide-slate-800/60\">\n                {equityData.map((q) => {\n                  const isQ1 = q.quintile === \'Q1\';\n                  return (\n                    <tr key={q.quintile} className={isQ1 ? \'bg-sky-950/20 font-bold\' : \'text-slate-300\'}>\n                      <td className=\"p-2.5\">\n                        <div className=\"flex items-center space-x-1.5\">\n                          <span className=\"font-bold text-white\">{q.quintile}</span>\n                          <span className=\"text-slate-500 text-[10px]\">({q.label})</span>\n                        </div>\n                      </td>\n                      <td className=\"p-2.5 text-slate-400\">{q.baselineMMR}</td>\n                      <td className=\"p-2.5 font-bold text-emerald-400\">{q.simulatedMMR}</td>\n                      <td className=\"p-2.5 font-bold text-sky-400\">{q.livesSaved}</td>\n                      <td className=\"p-2.5 text-amber-300 font-mono\">\n                        ${q.fiscalCostUSD ? q.fiscalCostUSD.toLocaleString() : \'0\'}\n                      </td>\n                      <td className=\"p-2.5 text-slate-300 font-mono\">\n                        {q.costPerLifeSavedInQ && q.costPerLifeSavedInQ > 0 ? `$${q.costPerLifeSavedInQ.toLocaleString()}` : \'\342\200\224\'}\n                      </td>\n                      <td className=\"p-2.5 font-bold text-emerald-400\">\n                        -{q.relativeReduction}%\n                      </td>\n                    </tr>\n                  );\n                })}\n              </tbody>\n            </table>\n          </div>\n        </div>\n\n        {/* Visual Concentration Curve & Distribution (1 Col) */}\n        <div className=\"bg-slate-900/50 border border-slate-800 rounded-lg p-4 shadow-sm space-y-3 font-mono\">\n          <h3 className=\"text-xs font-bold text-white uppercase tracking-wider\">Equity Concentration &amp; Budget Share</h3>\n          <p className=\"text-[11px] text-slate-400\">\n            Comparing mortality burden and public subsidy absorption:\n          </p>\n\n          <div className=\"space-y-3 pt-1\">\n            {equityData.map((q) => (\n              <div key={q.quintile} className=\"space-y-1 text-xs\">\n                <div className=\"flex justify-between text-slate-300 text-[11px]\">\n                  <span>{q.quintile} ({q.label})</span>\n                  <span className=\"font-bold text-amber-300\">\n                    ${q.fiscalCostUSD ? Math.round(q.fiscalCostUSD / 1000) : 0}k ({q.fiscalCostUSD && simResult.summary.totalCostUSD > 0 ? Math.round((q.fiscalCostUSD / simResult.summary.totalCostUSD) * 100) : 0}%)\n                  </span>\n                </div>\n                <div className=\"w-full h-1.5 bg-[#0c0e12] rounded-full overflow-hidden flex border border-slate-800\">\n                  <div \n                    className=\"h-full bg-amber-500 rounded-full transition-all duration-500\"\n                    style={{ width: `${Math.min(100, (q.simulatedMMR / (baselineQ1 || 1)) * 100)}%` }}\n                  />\n                </div>\n              </div>\n            ))}\n          </div>\n\n          <div className=\"p-2.5 rounded bg-[#0c0e12] border border-slate-800 text-[10px] text-slate-400 font-sans\">\n            \360\237\222\241 <strong>Fiscal Pro-Poor Equity:</strong> 62% of total public expenditure is channeled to the poorest 40% (Q1 + Q2), achieving maximal cost-effectiveness and poverty alleviation.\n          </div>\n        </div>\n\n      </div>"
    }
