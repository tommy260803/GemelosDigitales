    command_line: "npx tsx -e \"\nimport { SUB_SAHARAN_DISTRICTS } from \'./src/data/districts\';\n\nfunction calibrateEngine(district, scenarioId = \'baseline\', simulationMonths = 36) {\n  const annualBirths = district.annualBirths;\n  const N_B = annualBirths / 12; // Monthly target live births\n  const baselineMMR = district.baselineMMR;\n\n  // Base parameters\n  let travelTimeHours = district.avgTravelTimeHours;\n  let facilityFeeUSD = district.insuranceCoverage > 50 ? 2.5 : 18.0;\n  let tbaPrevalence = district.traditionalBirthAttendantPrevalence / 100;\n  let roadQuality = Math.max(0.2, 1 - (district.avgDistanceToEmONC / 80));\n  let bloodAvail = district.bloodBankAvailability / 100;\n  let drugAvail = district.essentialDrugsAvailability / 100;\n  let skilledStaff = district.skilledStaffRatio;\n  let insuranceCov = district.insuranceCoverage / 100;\n  let trustBaseline = 0.72;\n\n  // Overrides per scenario\n  if (scenarioId === \'scenario_a\') {\n    travelTimeHours = 0.9;\n    roadQuality = 0.85;\n  } else if (scenarioId === \'scenario_b\') {\n    facilityFeeUSD = 0.0;\n    insuranceCov = 0.92;\n  } else if (scenarioId === \'scenario_c\') {\n    tbaPrevalence = 0.15; // Certified referral TBAs\n    trustBaseline = 0.88;\n  } else if (scenarioId === \'scenario_d\') {\n    travelTimeHours = 0.9;\n    roadQuality = 0.85;\n    facilityFeeUSD = 0.0;\n    insuranceCov = 0.95;\n    tbaPrevalence = 0.12;\n    trustBaseline = 0.92;\n    drugAvail = Math.max(0.92, drugAvail);\n    bloodAvail = Math.max(0.85, bloodAvail);\n    skilledStaff = Math.max(1.8, skilledStaff);\n  }\n\n  // Baseline calibration: evaluate risk under baseline parameters\n  const baseFacilityRate = district.institutionalDeliveryRate / 100;\n  const baseInstBirths = N_B * baseFacilityRate;\n  const baseHomeBirths = N_B * (1 - baseFacilityRate);\n  const baseCompRisk = 0.15 * (1.05 - 0.1 * (district.femaleSecondaryEducation / 100));\n  const baseHomeComp = baseHomeBirths * baseCompRisk;\n  const baseInstComp = baseInstBirths * baseCompRisk;\n\n  const baseReferralRate = Math.min(0.92, Math.max(0.25,\n    (0.65 - (district.avgTravelTimeHours / 10.0)) * (1.0 + (1.0 - (district.traditionalBirthAttendantPrevalence / 100)) * 0.6) * (Math.max(0.2, 1 - (district.avgDistanceToEmONC / 80)) * 0.5 + 0.5)\n  ));\n  const baseRefHomeComp = baseHomeComp * baseReferralRate;\n  const baseUnrefHomeComp = baseHomeComp * (1 - baseReferralRate);\n  const baseQuality = Math.min(1.0, (district.skilledStaffRatio / 3.0) * 0.4 + (district.bloodBankAvailability / 100) * 0.3 + (district.essentialDrugsAvailability / 100) * 0.3);\n\n  // Unscaled raw baseline deaths:\n  const rawBaseHomeDeaths = baseUnrefHomeComp * 2.2 * (1.0 + 0.2 * (district.avgTravelTimeHours / 4.0));\n  const rawBaseReferredDeaths = baseRefHomeComp * (0.35 + 0.65 * (district.avgTravelTimeHours / 4.0)) * (1.0 - 0.6 * baseQuality);\n  const rawBasePlannedDeaths = baseInstComp * 0.22 * (1.0 - 0.75 * baseQuality);\n  const rawBaseTotalDeaths = rawBaseHomeDeaths + rawBaseReferredDeaths + rawBasePlannedDeaths;\n\n  const targetBaselineMonthlyDeaths = N_B * (baselineMMR / 100000);\n  const calibScale = targetBaselineMonthlyDeaths / Math.max(0.001, rawBaseTotalDeaths);\n\n  // Time-stepping RK4 parameters\n  const dt = 0.1; // months\n  const totalSteps = Math.round(simulationMonths / dt);\n\n  // Stocks initialization\n  const monthlyPregnancies = N_B * 1.05;\n  let S1 = monthlyPregnancies * 7.5; // Pregnant\n  let S2 = S1 * (district.anc1Coverage / 100) * 0.75; // in ANC\n  let S3 = N_B * baseFacilityRate * (3 / 30); // Facility delivery / EmONC\n  let S4 = N_B * 1.4; // Postpartum\n  let S5 = N_B * 0.15 * (3 / 30); // Active complications\n\n  let cumulativeDeaths = 0;\n  let cumulativeBirths = 0;\n  let systemTrust = trustBaseline;\n  let rollingMMR = baselineMMR;\n\n  for (let step = 0; step < totalSteps; step++) {\n    // 1. Dynamic trust loop\n    const trustTarget = Math.max(0.4, Math.min(0.98, trustBaseline * (1.1 - 0.25 * (rollingMMR / Math.max(150, baselineMMR)))));\n    systemTrust += (trustTarget - systemTrust) * 0.08 * dt;\n\n    // 2. Access variables\n    const financialAffordability = Math.max(0.2, insuranceCov * 0.5 + (1 - Math.min(1, facilityFeeUSD / 25)) * 0.35 + (district.femaleSecondaryEducation / 100) * 0.15);\n    const geographicAccess = Math.max(0.2, 1.0 - (travelTimeHours / 8.0) * (1.5 - 0.5 * roadQuality));\n    const qualityIndex = Math.min(1.0, (skilledStaff / 3.0) * 0.4 + bloodAvail * 0.3 + drugAvail * 0.3);\n\n    // 3. Flow rates\n    const ancPropensity = Math.min(0.98, 0.40 + 0.35 * systemTrust + 0.25 * (district.femaleSecondaryEducation / 100));\n    const flow_1_to_2 = (S1 / 3.5) * ancPropensity;\n    const flow_1_to_term = (S1 / 7.5) * (1 - ancPropensity);\n\n    const facilityDeliveryPropensity = Math.min(0.98, Math.max(0.15,\n      (district.institutionalDeliveryRate / 100) * (0.5 + 0.3 * financialAffordability + 0.2 * geographicAccess + 0.2 * systemTrust)\n    ));\n\n    const flow_2_to_term = S2 / 4.5;\n    const flow_2_to_3 = flow_2_to_term * facilityDeliveryPropensity;\n    const flow_2_to_home = flow_2_to_term * (1 - facilityDeliveryPropensity);\n\n    const flow_1_to_3 = flow_1_to_term * (facilityDeliveryPropensity * 0.7);\n    const flow_1_to_home = flow_1_to_term * (1 - facilityDeliveryPropensity * 0.7);\n\n    const stepInstDeliveries = flow_2_to_3 + flow_1_to_3;\n    const stepHomeDeliveries = flow_2_to_home + flow_1_to_home;\n    const stepTotalDeliveries = stepInstDeliveries + stepHomeDeliveries;\n\n    // 4. Complications (15% incidence)\n    const complicationRate = 0.15 * (1.05 - 0.1 * (district.femaleSecondaryEducation / 100));\n    const compFromHome = stepHomeDeliveries * complicationRate;\n    const compFromInst = stepInstDeliveries * complicationRate;\n\n    // Emergency referral of home complications\n    const referralRate = Math.min(0.92, Math.max(0.25,\n      (0.65 - (travelTimeHours / 10.0)) * (1.0 + (1.0 - tbaPrevalence) * 0.6) * (roadQuality * 0.5 + 0.5)\n    ));\n\n    const flow_5_to_3 = compFromHome * referralRate;\n    const unreferredHomeComp = compFromHome * (1 - referralRate);\n\n    // Deaths computation using calibrated epidemiological risk\n    const stepHomeDeaths = unreferredHomeComp * 2.2 * (1.0 + 0.2 * (travelTimeHours / 4.0)) * calibScale;\n    const stepReferredDeaths = flow_5_to_3 * (0.35 + 0.65 * (travelTimeHours / 4.0)) * (1.0 - 0.6 * qualityIndex) * calibScale;\n    const stepPlannedFacilityDeaths = compFromInst * 0.22 * (1.0 - 0.75 * qualityIndex) * calibScale;\n\n    const stepTotalDeaths = (stepHomeDeaths + stepReferredDeaths + stepPlannedFacilityDeaths) * dt;\n    const stepBirths = stepTotalDeliveries * dt;\n\n    cumulativeDeaths += stepTotalDeaths;\n    cumulativeBirths += stepBirths;\n\n    // Stock derivatives (ODEs)\n    const dS1 = (monthlyPregnancies - flow_1_to_2 - flow_1_to_term) * dt;\n    const dS2 = (flow_1_to_2 - flow_2_to_term) * dt;\n    const stayTime = 0.1;\n    const exit3 = S3 / stayTime;\n    const dS3 = (stepInstDeliveries + flow_5_to_3 - exit3) * dt;\n    const dS5 = (compFromHome - flow_5_to_3 - (unreferredHomeComp / 0.15)) * dt;\n    const exit4 = S4 / 1.4;\n    const dS4 = ((stepHomeDeliveries - compFromHome) + (exit3 - stepPlannedFacilityDeaths - stepReferredDeaths) - exit4) * dt;\n\n    S1 = Math.max(10, S1 + dS1);\n    S2 = Math.max(10, S2 + dS2);\n    S3 = Math.max(5, S3 + dS3);\n    S4 = Math.max(10, S4 + dS4);\n    S5 = Math.max(1, S5 + dS5);\n\n    if (step % Math.round(1 / dt) === 0 && step > 0) {\n      const monthMMR = (stepTotalDeaths / Math.max(0.01, stepBirths)) * 100000;\n      rollingMMR = rollingMMR * 0.7 + monthMMR * 0.3;\n    }\n  }\n\n  const finalMMR = Math.round((cumulativeDeaths / Math.max(1, cumulativeBirths)) * 100000);\n  const baselineExpectedDeaths = Math.round(cumulativeBirths * (baselineMMR / 100000));\n  const livesSaved = Math.max(0, Math.round(baselineExpectedDeaths - cumulativeDeaths));\n  const redPercent = Math.round(((baselineMMR - finalMMR) / baselineMMR) * 1000) / 10;\n\n  return {\n    scenarioId,\n    finalMMR,\n    baselineMMR,\n    redPercent,\n    livesSaved,\n    cumulativeDeaths: Math.round(cumulativeDeaths),\n    baselineExpectedDeaths\n  };\n}\n\nconsole.log(\'--- Testing Garissa with Fully Calibrated SD Engine ---\');\n[\'baseline\', \'scenario_a\', \'scenario_b\', \'scenario_c\', \'scenario_d\'].forEach(s => {\n  const r = calibrateEngine(SUB_SAHARAN_DISTRICTS.find(d => d.id === \'ke-garissa\'), s);\n  console.log(s.padEnd(12) + \' -> MMR: \' + r.finalMMR + \' (Base: \' + r.baselineMMR + \') | Red%: \' + r.redPercent + \'% | Lives Saved: \' + r.livesSaved + \' | Deaths: \' + r.cumulativeDeaths + \' / \' + r.baselineExpectedDeaths);\n});\n\""
    proposed_command_line: "npx tsx -e \"\nimport { SUB_SAHARAN_DISTRICTS } from \'./src/data/districts\';\n\nfunction calibrateEngine(district, scenarioId = \'baseline\', simulationMonths = 36) {\n  const annualBirths = district.annualBirths;\n  const N_B = annualBirths / 12; // Monthly target live births\n  const baselineMMR = district.baselineMMR;\n\n  // Base parameters\n  let travelTimeHours = district.avgTravelTimeHours;\n  let facilityFeeUSD = district.insuranceCoverage > 50 ? 2.5 : 18.0;\n  let tbaPrevalence = district.traditionalBirthAttendantPrevalence / 100;\n  let roadQuality = Math.max(0.2, 1 - (district.avgDistanceToEmONC / 80));\n  let bloodAvail = district.bloodBankAvailability / 100;\n  let drugAvail = district.essentialDrugsAvailability / 100;\n  let skilledStaff = district.skilledStaffRatio;\n  let insuranceCov = district.insuranceCoverage / 100;\n  let trustBaseline = 0.72;\n\n  // Overrides per scenario\n  if (scenarioId === \'scenario_a\') {\n    travelTimeHours = 0.9;\n    roadQuality = 0.85;\n  } else if (scenarioId === \'scenario_b\') {\n    facilityFeeUSD = 0.0;\n    insuranceCov = 0.92;\n  } else if (scenarioId === \'scenario_c\') {\n    tbaPrevalence = 0.15; // Certified referral TBAs\n    trustBaseline = 0.88;\n  } else if (scenarioId === \'scenario_d\') {\n    travelTimeHours = 0.9;\n    roadQuality = 0.85;\n    facilityFeeUSD = 0.0;\n    insuranceCov = 0.95;\n    tbaPrevalence = 0.12;\n    trustBaseline = 0.92;\n    drugAvail = Math.max(0.92, drugAvail);\n    bloodAvail = Math.max(0.85, bloodAvail);\n    skilledStaff = Math.max(1.8, skilledStaff);\n  }\n\n  // Baseline calibration: evaluate risk under baseline parameters\n  const baseFacilityRate = district.institutionalDeliveryRate / 100;\n  const baseInstBirths = N_B * baseFacilityRate;\n  const baseHomeBirths = N_B * (1 - baseFacilityRate);\n  const baseCompRisk = 0.15 * (1.05 - 0.1 * (district.femaleSecondaryEducation / 100));\n  const baseHomeComp = baseHomeBirths * baseCompRisk;\n  const baseInstComp = baseInstBirths * baseCompRisk;\n\n  const baseReferralRate = Math.min(0.92, Math.max(0.25,\n    (0.65 - (district.avgTravelTimeHours / 10.0)) * (1.0 + (1.0 - (district.traditionalBirthAttendantPrevalence / 100)) * 0.6) * (Math.max(0.2, 1 - (district.avgDistanceToEmONC / 80)) * 0.5 + 0.5)\n  ));\n  const baseRefHomeComp = baseHomeComp * baseReferralRate;\n  const baseUnrefHomeComp = baseHomeComp * (1 - baseReferralRate);\n  const baseQuality = Math.min(1.0, (district.skilledStaffRatio / 3.0) * 0.4 + (district.bloodBankAvailability / 100) * 0.3 + (district.essentialDrugsAvailability / 100) * 0.3);\n\n  // Unscaled raw baseline deaths:\n  const rawBaseHomeDeaths = baseUnrefHomeComp * 2.2 * (1.0 + 0.2 * (district.avgTravelTimeHours / 4.0));\n  const rawBaseReferredDeaths = baseRefHomeComp * (0.35 + 0.65 * (district.avgTravelTimeHours / 4.0)) * (1.0 - 0.6 * baseQuality);\n  const rawBasePlannedDeaths = baseInstComp * 0.22 * (1.0 - 0.75 * baseQuality);\n  const rawBaseTotalDeaths = rawBaseHomeDeaths + rawBaseReferredDeaths + rawBasePlannedDeaths;\n\n  const targetBaselineMonthlyDeaths = N_B * (baselineMMR / 100000);\n  const calibScale = targetBaselineMonthlyDeaths / Math.max(0.001, rawBaseTotalDeaths);\n\n  // Time-stepping RK4 parameters\n  const dt = 0.1; // months\n  const totalSteps = Math.round(simulationMonths / dt);\n\n  // Stocks initialization\n  const monthlyPregnancies = N_B * 1.05;\n  let S1 = monthlyPregnancies * 7.5; // Pregnant\n  let S2 = S1 * (district.anc1Coverage / 100) * 0.75; // in ANC\n  let S3 = N_B * baseFacilityRate * (3 / 30); // Facility delivery / EmONC\n  let S4 = N_B * 1.4; // Postpartum\n  let S5 = N_B * 0.15 * (3 / 30); // Active complications\n\n  let cumulativeDeaths = 0;\n  let cumulativeBirths = 0;\n  let systemTrust = trustBaseline;\n  let rollingMMR = baselineMMR;\n\n  for (let step = 0; step < totalSteps; step++) {\n    // 1. Dynamic trust loop\n    const trustTarget = Math.max(0.4, Math.min(0.98, trustBaseline * (1.1 - 0.25 * (rollingMMR / Math.max(150, baselineMMR)))));\n    systemTrust += (trustTarget - systemTrust) * 0.08 * dt;\n\n    // 2. Access variables\n    const financialAffordability = Math.max(0.2, insuranceCov * 0.5 + (1 - Math.min(1, facilityFeeUSD / 25)) * 0.35 + (district.femaleSecondaryEducation / 100) * 0.15);\n    const geographicAccess = Math.max(0.2, 1.0 - (travelTimeHours / 8.0) * (1.5 - 0.5 * roadQuality));\n    const qualityIndex = Math.min(1.0, (skilledStaff / 3.0) * 0.4 + bloodAvail * 0.3 + drugAvail * 0.3);\n\n    // 3. Flow rates\n    const ancPropensity = Math.min(0.98, 0.40 + 0.35 * systemTrust + 0.25 * (district.femaleSecondaryEducation / 100));\n    const flow_1_to_2 = (S1 / 3.5) * ancPropensity;\n    const flow_1_to_term = (S1 / 7.5) * (1 - ancPropensity);\n\n    const facilityDeliveryPropensity = Math.min(0.98, Math.max(0.15,\n      (district.institutionalDeliveryRate / 100) * (0.5 + 0.3 * financialAffordability + 0.2 * geographicAccess + 0.2 * systemTrust)\n    ));\n\n    const flow_2_to_term = S2 / 4.5;\n    const flow_2_to_3 = flow_2_to_term * facilityDeliveryPropensity;\n    const flow_2_to_home = flow_2_to_term * (1 - facilityDeliveryPropensity);\n\n    const flow_1_to_3 = flow_1_to_term * (facilityDeliveryPropensity * 0.7);\n    const flow_1_to_home = flow_1_to_term * (1 - facilityDeliveryPropensity * 0.7);\n\n    const stepInstDeliveries = flow_2_to_3 + flow_1_to_3;\n    const stepHomeDeliveries = flow_2_to_home + flow_1_to_home;\n    const stepTotalDeliveries = stepInstDeliveries + stepHomeDeliveries;\n\n    // 4. Complications (15% incidence)\n    const complicationRate = 0.15 * (1.05 - 0.1 * (district.femaleSecondaryEducation / 100));\n    const compFromHome = stepHomeDeliveries * complicationRate;\n    const compFromInst = stepInstDeliveries * complicationRate;\n\n    // Emergency referral of home complications\n    const referralRate = Math.min(0.92, Math.max(0.25,\n      (0.65 - (travelTimeHours / 10.0)) * (1.0 + (1.0 - tbaPrevalence) * 0.6) * (roadQuality * 0.5 + 0.5)\n    ));\n\n    const flow_5_to_3 = compFromHome * referralRate;\n    const unreferredHomeComp = compFromHome * (1 - referralRate);\n\n    // Deaths computation using calibrated epidemiological risk\n    const stepHomeDeaths = unreferredHomeComp * 2.2 * (1.0 + 0.2 * (travelTimeHours / 4.0)) * calibScale;\n    const stepReferredDeaths = flow_5_to_3 * (0.35 + 0.65 * (travelTimeHours / 4.0)) * (1.0 - 0.6 * qualityIndex) * calibScale;\n    const stepPlannedFacilityDeaths = compFromInst * 0.22 * (1.0 - 0.75 * qualityIndex) * calibScale;\n\n    const stepTotalDeaths = (stepHomeDeaths + stepReferredDeaths + stepPlannedFacilityDeaths) * dt;\n    const stepBirths = stepTotalDeliveries * dt;\n\n    cumulativeDeaths += stepTotalDeaths;\n    cumulativeBirths += stepBirths;\n\n    // Stock derivatives (ODEs)\n    const dS1 = (monthlyPregnancies - flow_1_to_2 - flow_1_to_term) * dt;\n    const dS2 = (flow_1_to_2 - flow_2_to_term) * dt;\n    const stayTime = 0.1;\n    const exit3 = S3 / stayTime;\n    const dS3 = (stepInstDeliveries + flow_5_to_3 - exit3) * dt;\n    const dS5 = (compFromHome - flow_5_to_3 - (unreferredHomeComp / 0.15)) * dt;\n    const exit4 = S4 / 1.4;\n    const dS4 = ((stepHomeDeliveries - compFromHome) + (exit3 - stepPlannedFacilityDeaths - stepReferredDeaths) - exit4) * dt;\n\n    S1 = Math.max(10, S1 + dS1);\n    S2 = Math.max(10, S2 + dS2);\n    S3 = Math.max(5, S3 + dS3);\n    S4 = Math.max(10, S4 + dS4);\n    S5 = Math.max(1, S5 + dS5);\n\n    if (step % Math.round(1 / dt) === 0 && step > 0) {\n      const monthMMR = (stepTotalDeaths / Math.max(0.01, stepBirths)) * 100000;\n      rollingMMR = rollingMMR * 0.7 + monthMMR * 0.3;\n    }\n  }\n\n  const finalMMR = Math.round((cumulativeDeaths / Math.max(1, cumulativeBirths)) * 100000);\n  const baselineExpectedDeaths = Math.round(cumulativeBirths * (baselineMMR / 100000));\n  const livesSaved = Math.max(0, Math.round(baselineExpectedDeaths - cumulativeDeaths));\n  const redPercent = Math.round(((baselineMMR - finalMMR) / baselineMMR) * 1000) / 10;\n\n  return {\n    scenarioId,\n    finalMMR,\n    baselineMMR,\n    redPercent,\n    livesSaved,\n    cumulativeDeaths: Math.round(cumulativeDeaths),\n    baselineExpectedDeaths\n  };\n}\n\nconsole.log(\'--- Testing Garissa with Fully Calibrated SD Engine ---\');\n[\'baseline\', \'scenario_a\', \'scenario_b\', \'scenario_c\', \'scenario_d\'].forEach(s => {\n  const r = calibrateEngine(SUB_SAHARAN_DISTRICTS.find(d => d.id === \'ke-garissa\'), s);\n  console.log(s.padEnd(12) + \' -> MMR: \' + r.finalMMR + \' (Base: \' + r.baselineMMR + \') | Red%: \' + r.redPercent + \'% | Lives Saved: \' + r.livesSaved + \' | Deaths: \' + r.cumulativeDeaths + \' / \' + r.baselineExpectedDeaths);\n});\n\""
