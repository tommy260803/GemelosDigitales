        }
        lines {
          text: "    const predictedMMR = sim.summary.mmrFinal;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const observedMMR = holdout.baselineMMR;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // Cross-district validation statistics"
