wnloadPDF: string;\n  btnDownloadExcel: string;\n  docType: string;\n  docTitle: string;\n  authorLabel: string;\n  sec1Exec: string;\n  sec1ExecText: string;\n  sec2Matrix: string;\n  sec3Policy: string;\n  sec3Policy1: string;\n  sec3Policy2: string;\n  sec3Policy3: string;\n  sec4Validation: string;\n\n  // Code Arch View\n  codeArchTitle: string;\n  codeArchSubtitle: string;\n  repoManifest: string;\n  copyCode: string;\n  copied: string;\n\n  // Copilot Modal\n  copilotTitle: string;\n  copilotSubtitle: string;\n  copilotWelcome: string;\n  copilotSuggestedTitle: string;\n  copilotPrompt1: string;\n  copilotPrompt2: string;\n  copilotPrompt3: string;\n  copilotPrompt4: string;\n  copilotInputPlaceholder: string;\n  copilotSend: string;\n  copilotAnalyzing: string;\n\n  // Footer\n  footerEngine: string;\n  footerProtocol: string;\n  footerCalibration: string;\n  footerDistricts: string;\n  footerTelemetry: string;\n}\n\nexport const translations: Record<Language, Translations> = {\n  es: {\n    // Navigation & General\n    appTitle: \'MaternalTwin\',\n    appSubtitle: \'Gemelo Digital de Din\303\241mica de Sistemas \342\200\242 25 Distritos \303\201frica Subsahariana\',\n    protocolVersion: \'PROTOCOLO V4.2\',\n    highRiskMMR: \'ALTO RIESGO RMM\',\n    districtTwinSummary: \'Simulaci\303\263n de Mortalidad Materna y An\303\241lisis Epidemiol\303\263gico\',\n    selectDistrict: \'Seleccionar Distrito\',\n    aiCopilotBtn: \'COPILOTO IA\',\n    exportPDF: \'Descargar PDF Ejecutivo\',\n    exportXLSX: \'Descargar Libro Excel\',\n    langToggle: \'Idioma\',\n\n    // Tabs\n    tabDashboard: \'Resumen del Distrito\',\n    tabCausal: \'Din\303\241mica de Sistemas\',\n    tabScenarios: \'Matriz de Pol\303\255ticas (A-D)\',\n    tabEquity: \'Quintiles de Riqueza\',\n    tabValidation: \'Validaci\303\263n (Sobol/KS)\',\n    tabReports: \'Informes y Exportaci\303\263n\',\n    tabCodeArch: \'Arquitectura y ODE\',\n\n    // Scenarios\n    baseline: \'L\303\255nea de Base