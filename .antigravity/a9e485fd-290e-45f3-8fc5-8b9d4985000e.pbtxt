    instruction: "Internationalize DashboardView with useLanguage"
    replacement_infos {
      original_chunk {
        target_content: "import React, { useState, useMemo } from \'react\';\nimport { \n  HeartHandshake, \n  TrendingDown, \n  Clock, \n  DollarSign, \n  AlertCircle, \n  Sliders, \n  Compass, \n  ShieldCheck,\n  CheckCircle,\n  HelpCircle,\n  BarChart2,\n  RefreshCw,\n  Building2\n} from \'lucide-react\';\nimport { DistrictData, SimulationResult, SDParameters } from \'../types\';\nimport { SystemDynamicsEngine, SCENARIO_DEFINITIONS, buildDefaultParameters } from \'../services/systemDynamics\';\n\ninterface DashboardViewProps {\n  district: DistrictData;\n  activeScenarioId: \'baseline\' | \'scenario_a\' | \'scenario_b\' | \'scenario_c\' | \'scenario_d\';\n  onScenarioChange: (id: \'baseline\' | \'scenario_a\' | \'scenario_b\' | \'scenario_c\' | \'scenario_d\') => void;\n  onOpenCopilot: () => void;\n}\n\nexport const DashboardView: React.FC<DashboardViewProps> = ({\n  district,\n  activeScenarioId,\n  onScenarioChange,\n  onOpenCopilot,\n}) => {\n  const [horizonMonths, setHorizonMonths] = useState<number>(36);\n  const [customParams, setCustomParams] = useState<Partial<SDParameters>>({});\n  const [hoveredMonth, setHoveredMonth] = useState<number | null>(null);\n  const [isParamsOpen, setIsParamsOpen] = useState<boolean>(false);\n\n  // Run simulation\n  const simResult: SimulationResult = useMemo(() => {\n    return SystemDynamicsEngine.simulate(district, activeScenarioId, customParams, horizonMonths);\n  }, [district, activeScenarioId, customParams, horizonMonths]);\n\n  const defaultParams = useMemo(() => buildDefaultParameters(district), [district]);\n  const activeParams: SDParameters = {\n    ...defaultParams,\n    ...(SCENARIO_DEFINITIONS.find((s) => s.id === activeScenarioId)?.parameterOverrides || {}),\n    ...customParams,\n  };\n\n  const trajectories = simResult.trajectories;\n  const currentSnapshot = hoveredMonth !== null \n    ? trajectories.find((t) => t.timeMonth === hoveredMonth) || trajectories[trajectories.length - 1]\n    : trajectories[trajectories.length - 1];\n\n  // Stock Colors for Visual Chart\n  const stockColors = {\n    pregnant: \'#38bdf8\', // S1: Light Blue\n    anc: \'#34d399\',      // S2: Emerald\n    delivery: \'#818cf8\', // S3: Indigo\n    postpartum: \'#fbbf24\', // S4: Amber\n    complications: \'#f43f5e\', // S5: Rose\n  };\n\n  // Find max stock for SVG scaling\n  const maxStock = Math.max(...trajectories.map((t) => Math.max(t.pregnantWomen, t.inANC * 1.5, t.inPostpartum)));\n\n  return (\n    <div className=\"space-y-4\">\n      \n      {/* Top Protocol & Hypothesis Banner */}\n      <div className=\"bg-slate-900/50 border border-slate-800 rounded-lg p-3.5 shadow-sm\">\n        <div className=\"flex flex-col lg:flex-row lg:items-center justify-between gap-3\">\n          <div>\n            <div className=\"flex items-center space-x-2\">\n              <span className=\"px-2 py-0.5 text-[10px] font-mono font-bold rounded bg-sky-500/20 text-sky-300 border border-sky-500/30 uppercase tracking-wider\">\n                SIMULATION CORE V4.2\n              </span>\n              <h2 className=\"text-sm font-bold text-white uppercase tracking-tight\">\n                {district.name} ({district.country}) \342\200\224 Maternal Health System Dynamics Twin\n              </h2>\n            </div>\n            <p className=\"text-[11px] text-slate-400 font-mono mt-0.5\">\n              Testing Hypothesis H1: ODE system identifies phase 1-3 delays &amp; achieves &ge;15% MMR reduction.\n            </p>\n          </div>\n\n          {/* Scenario Selector Pills - High Density */}\n          <div className=\"flex items-center flex-wrap gap-1 bg-[#0c0e12] p-1 rounded-md border border-slate-800\">\n            {SCENARIO_DEFINITIONS.map((s) => {\n              const isActive = activeScenarioId === s.id;\n              return (\n                <button\n                  key={s.id}\n                  id={`btn-scenario-${s.id}`}\n                  onClick={() => onScenarioChange(s.id)}\n                  className={`px-2.5 py-1 rounded text-xs font-mono font-bold transition cursor-pointer ${\n                    isActive\n                      ? \'bg-sky-600 text-white shadow-md shadow-sky-900/30\'\n                      : \'text-slate-400 hover:text-slate-200 hover:bg-slate-800/80\'\n                  }`}\n                >\n                  <span className=\"opacity-70\">({s.letter})</span> {s.name.split(\'(\')[0].trim()}\n                </button>\n              );\n            })}\n          </div>\n        </div>\n      </div>\n\n      {/* High Density KPI Cards Row */}\n      <div className=\"grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3\">\n        \n        {/* Baseline MMR */}\n        <div className=\"bg-slate-900/50 border border-slate-800 rounded-lg p-3 flex flex-col justify-between\">\n          <div className=\"text-[10px] text-slate-500 font-bold uppercase tracking-wider\">Baseline MMR</div>\n          <div className=\"flex items-end gap-1.5 my-1\">\n            <span className=\"text-2xl font-mono font-bold text-white\">{district.baselineMMR}</span>\n          </div>\n          <div className=\"text-[9px] text-slate-600 font-mono italic\">per 100k Live Births</div>\n        </div>\n\n        {/* Simulated MMR */}\n        <div className=\"bg-slate-900/50 border border-slate-800 rounded-lg p-3 flex flex-col justify-between\">\n          <div className=\"text-[10px] text-slate-500 font-bold uppercase tracking-wider\">Simulated MMR</div>\n          <div className=\"flex items-end gap-1.5 my-1\">\n            <span className=\"text-2xl font-mono font-bold text-emerald-400\">{simResult.summary.mmrFinal}</span>\n            <span className=\"text-[10px] text-emerald-400 mb-0.5 font-mono\">-{simResult.summary.mmrReductionPercent}%</span>\n          </div>\n          <div className=\"text-[9px] text-slate-600 font-mono italic\">Averted Mortality Ratio</div>\n        </div>\n\n        {/* ANC 4+ Coverage */}\n        <div className=\"bg-slate-900/50 border border-slate-800 rounded-lg p-3 flex flex-col justify-between\">\n          <div className=\"text-[10px] text-slate-500 font-bold uppercase tracking-wider\">ANC 4+ Coverage</div>\n          <div className=\"flex items-end gap-1.5 my-1\">\n            <span className=\"text-2xl font-mono font-bold text-white\">{simResult.summary.anc4CoverageFinal}%</span>\n            <span className=\"text-[10px] text-sky-400 mb-0.5 font-mono\">+{simResult.summary.anc4CoverageFinal - district.anc4Coverage}%</span>\n          </div>\n          <div className=\"text-[9px] text-slate-600 font-mono italic\">Base: {district.anc4Coverage}%</div>\n        </div>\n\n        {/* Institutional Deliveries */}\n        <div className=\"bg-slate-900/50 border border-slate-800 rounded-lg p-3 flex flex-col justify-between\">\n          <div className=\"text-[10px] text-slate-500 font-bold uppercase tracking-wider\">Institutional Births</div>\n          <div className=\"flex items-end gap-1.5 my-1\">\n            <span className=\"text-2xl font-mono font-bold text-white\">{simResult.summary.facilityDeliveryRateFinal}%</span>\n            <span className=\"text-[10px] text-indigo-400 mb-0.5 font-mono\">+{simResult.summary.facilityDeliveryRateFinal - district.institutionalDeliveryRate}%</span>\n          </div>\n          <div className=\"text-[9px] text-slate-600 font-mono italic\">Base: {district.institutionalDeliveryRate}%</div>\n        </div>\n\n        {/* Projected Lives Saved Highlight Card */}\n        <div className=\"bg-slate-900/50 border border-slate-800 rounded-lg p-3 flex flex-col justify-between bg-sky-900/10 border-sky-900/30 ring-1 ring-sky-500/20\">\n          <div className=\"text-[10px] text-sky-400 font-bold uppercase tracking-wider\">Projected Lives Saved</div>\n          <div className=\"flex items-end gap-1.5 my-1\">\n            <span className=\"text-3xl font-mono font-bold text-sky-400\">{simResult.summary.livesSaved}</span>\n          </div>\n          <div className=\"text-[9px] text-sky-500 font-mono italic\">\n            95% CI: [{simResult.summary.livesSavedCI95[0]} - {simResult.summary.livesSavedCI95[1]}]\n          </div>\n        </div>\n\n        {/* Cost per Life Saved */}\n        <div className=\"bg-slate-900/50 border border-slate-800 rounded-lg p-3 flex flex-col justify-between\">\n          <div className=\"text-[10px] text-slate-500 font-bold uppercase tracking-wider\">Cost / Life Saved</div>\n          <div className=\"flex items-end gap-1.5 my-1\">\n            <span className=\"text-xl font-mono font-bold text-white\">${simResult.summary.costPerLifeSavedUSD.toLocaleString()}</span>\n          </div>\n          <div className=\"text-[9px] text-slate-600 font-mono italic\">ICER: ${simResult.summary.icerPerDALY}/DALY</div>\n        </div>\n\n      </div>\n\n      {/* Main Grid: 5-Stock Time Series Chart & System Bottlenecks Panel */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-4\">\n        \n        {/* Left 2 Cols: 5-Stock Trajectory Chart */}\n        <div className=\"lg:col-span-2 bg-slate-900/50 border border-slate-800 rounded-lg p-4 shadow-sm space-y-3\">\n          \n          <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-800/80 pb-2.5\">\n            <div>\n              <div className=\"flex items-center space-x-2\">\n                <span className=\"w-2 h-2 rounded-full bg-sky-500\"></span>\n                <h3 className=\"text-xs font-bold text-slate-300 uppercase tracking-wider\">\n                  5-Stock Differential Equation Trajectories (Horizon: {horizonMonths}M)\n                </h3>\n              </div>\n              <p className=\"text-[10px] text-slate-500 font-mono mt-0.5\">\n                Runge-Kutta 4th Order ODE numerical solution for S1 (Pregnant), S2 (ANC), S3 (Del), S4 (Postpartum), S5 (Compl)\n              </p>\n            </div>\n\n            {/* Parameter & Horizon controls */}\n            <div className=\"flex items-center space-x-1.5\">\n              <select\n                value={horizonMonths}\n                onChange={(e) => setHorizonMonths(Number(e.target.value))}\n                className=\"bg-slate-800 border border-slate-700 text-xs font-mono text-slate-200 rounded px-2 py-1 focus:outline-none\"\n              >\n                <option value={24}>24 Months</option>\n                <option value={36}>36 Months</option>\n                <option value={60}>60 Months (5Y)</option>\n              </select>\n\n              <button\n                onClick={() => setIsParamsOpen(!isParamsOpen)}\n                className={`flex items-center space-x-1 px-2 py-1 rounded text-xs font-mono font-semibold border transition ${\n                  isParamsOpen ? \'bg-sky-500/20 text-sky-300 border-sky-500/40\' : \'bg-slate-800 text-slate-300 border-slate-700 hover:bg-slate-700\'\n                }`}\n              >\n                <Sliders className=\"w-3 h-3\" />\n                <span>PARAMETERS</span>\n              </button>\n            </div>\n          </div>\n\n          {/* Interactive Stock Legend */}\n          <div className=\"flex flex-wrap items-center gap-3 text-[11px] font-mono\">\n            <div className=\"flex items-center space-x-1.5\">\n              <span className=\"w-2.5 h-2.5 rounded-sm\" style={{ backgroundColor: stockColors.pregnant }} />\n              <span className=\"text-slate-300\">S1: Preg ({currentSnapshot?.pregnantWomen?.toLocaleString()})</span>\n            </div>\n            <div className=\"flex items-center space-x-1.5\">\n              <span className=\"w-2.5 h-2.5 rounded-sm\" style={{ backgroundColor: stockColors.anc }} />\n              <span className=\"text-slate-300\">S2: ANC ({currentSnapshot?.inANC?.toLocaleString()})</span>\n            </div>\n            <div className=\"flex items-center space-x-1.5\">\n              <span className=\"w-2.5 h-2.5 rounded-sm\" style={{ backgroundColor: stockColors.delivery }} />\n              <span className=\"text-slate-300\">S3: Del ({currentSnapshot?.inFacilityDelivery?.toLocaleString()})</span>\n            </div>\n            <div className=\"flex items-center space-x-1.5\">\n              <span className=\"w-2.5 h-2.5 rounded-sm\" style={{ backgroundColor: stockColors.postpartum }} />\n              <span className=\"text-slate-300\">S4: Postp ({currentSnapshot?.inPostpartum?.toLocaleString()})</span>\n            </div>\n            <div className=\"flex items-center space-x-1.5\">\n              <span className=\"w-2.5 h-2.5 rounded-sm\" style={{ backgroundColor: stockColors.complications }} />\n              <span className=\"text-rose-400 font-bold\">S5: Compl ({currentSnapshot?.withComplications?.toLocaleString()})</span>\n            </div>\n          </div>\n\n          {/* SVG Multi-Curve Trajectory Chart with #131a26 High Density Canvas */}\n          <div className=\"relative w-full h-64 bg-[#131a26] rounded-lg p-2.5 border border-slate-800\">\n            <svg \n              className=\"w-full h-full overflow-visible\"\n              viewBox=\"0 0 700 240\"\n              preserveAspectRatio=\"none\"\n            >\n              {/* Grid Lines */}\n              {[0, 60, 120, 180, 240].map((y) => (\n                <line key={y} x1=\"0\" y1={y} x2=\"700\" y2={y} stroke=\"#1e293b\" strokeDasharray=\"3 3\" strokeWidth=\"0.8\" />\n              ))}\n\n              {/* Curves for the 5 Stocks */}\n              {/* S1: Pregnant Women */}\n              <polyline\n                fill=\"none\"\n                stroke={stockColors.pregnant}\n                strokeWidth=\"2.5\"\n                points={trajectories.map((t, idx) => {\n                  const x = (idx / (trajectories.length - 1)) * 700;\n                  const y = 240 - (t.pregnantWomen / maxStock) * 220;\n                  return `${x},${y}`;\n                }).join(\' \')}\n              />\n\n              {/* S2: In ANC */}\n              <polyline\n                fill=\"none\"\n                stroke={stockColors.anc}\n                strokeWidth=\"2.5\"\n                points={trajectories.map((t, idx) => {\n                  const x = (idx / (trajectories.length - 1)) * 700;\n                  const y = 240 - ((t.inANC * 1.5) / maxStock) * 220;\n                  return `${x},${y}`;\n                }).join(\' \')}\n              />\n\n              {/* S4: Postpartum */}\n              <polyline\n                fill=\"none\"\n                stroke={stockColors.postpartum}\n                strokeWidth=\"2.5\"\n                points={trajectories.map((t, idx) => {\n                  const x = (idx / (trajectories.length - 1)) * 700;\n                  const y = 240 - (t.inPostpartum / maxStock) * 220;\n                  return `${x},${y}`;\n                }).join(\' \')}\n              />\n\n              {/* S3: Facility Delivery (Scaled x4 for visibility) */}\n              <polyline\n                fill=\"none\"\n                stroke={stockColors.delivery}\n                strokeWidth=\"2.5\"\n                strokeDasharray=\"4 2\"\n                points={trajectories.map((t, idx) => {\n                  const x = (idx / (trajectories.length - 1)) * 700;\n                  const y = 240 - ((t.inFacilityDelivery * 6) / maxStock) * 220;\n                  return `${x},${y}`;\n                }).join(\' \')}\n              />\n\n              {/* S5: Complications (Scaled x8 for visibility) */}\n              <polyline\n                fill=\"none\"\n                stroke={stockColors.complications}\n                strokeWidth=\"3\"\n                points={trajectories.map((t, idx) => {\n                  const x = (idx / (trajectories.length - 1)) * 700;\n                  const y = 240 - ((t.withComplications * 12) / maxStock) * 220;\n                  return `${x},${y}`;\n                }).join(\' \')}\n              />\n            </svg>\n\n            {/* Month Hover & Timeline Scrubber */}\n            <div className=\"absolute inset-x-3 bottom-1 flex justify-between text-[9px] font-mono text-slate-500\">\n              <span>Month 0</span>\n              <span>Month {Math.round(horizonMonths / 2)}</span>\n              <span>Month {horizonMonths}</span>\n            </div>\n          </div>\n\n          {/* Feedback Loops Active Telemetry */}\n          <div className=\"grid grid-cols-3 gap-2 text-xs font-mono\">\n            <div className=\"bg-[#0c0e12] p-2.5 rounded-lg border border-slate-800\">\n              <span className=\"text-[10px] text-slate-500 uppercase font-bold block\">Trust Level (R1 Loop):</span>\n              <span className=\"font-bold text-sky-400\">{Math.round(currentSnapshot.systemTrustLevel * 100)}% Confidence</span>\n            </div>\n            <div className=\"bg-[#0c0e12] p-2.5 rounded-lg border border-slate-800\">\n              <span className=\"text-[10px] text-slate-500 uppercase font-bold block\">Facility Congestion (B1):</span>\n              <span className={`font-bold ${currentSnapshot.facilityCongestionIndex > 1.2 ? \'text-amber-400\' : \'text-emerald-400\'}`}>\n                {currentSnapshot.facilityCongestionIndex}x Capacity Load\n              </span>\n            </div>\n            <div className=\"bg-[#0c0e12] p-2.5 rounded-lg border border-slate-800\">\n              <span className=\"text-[10px] text-slate-500 uppercase font-bold block\">Phase 2 Transit Delay (B2):</span>\n              <span className=\"font-bold text-cyan-400\">{currentSnapshot.phase2DelayHours} Hours</span>\n            </div>\n          </div>\n\n          {/* Collapsible Parameter Customization Drawer */}\n          {isParamsOpen && (\n            <div className=\"bg-[#0c0e12] border border-sky-500/30 rounded-lg p-3 space-y-2 mt-3\">\n              <div className=\"flex items-center justify-between text-xs font-mono border-b border-slate-800 pb-1.5\">\n                <span className=\"font-bold text-sky-300 uppercase\">CALIBRATION PARAMETERS (REAL-TIME ODE TUNING)</span>\n                <button\n                  onClick={() => setCustomParams({})}\n                  className=\"text-slate-400 hover:text-white flex items-center space-x-1\"\n                >\n                  <RefreshCw className=\"w-3 h-3\" />\n                  <span>Reset Overrides</span>\n                </button>\n              </div>\n\n              <div className=\"grid grid-cols-1 md:grid-cols-3 gap-3 text-xs\">\n                <div>\n                  <label className=\"text-slate-400 flex justify-between mb-1 font-mono\">\n                    <span>Travel Time (Hours):</span>\n                    <span className=\"text-sky-300 font-bold\">{activeParams.travelTimeHours}h</span>\n                  </label>\n                  <input\n                    type=\"range\"\n                    min=\"0.5\"\n                    max=\"6.0\"\n                    step=\"0.1\"\n                    value={activeParams.travelTimeHours}\n                    onChange={(e) => setCustomParams((prev) => ({ ...prev, travelTimeHours: Number(e.target.value) }))}\n                    className=\"w-full accent-sky-500 cursor-pointer\"\n                  />\n                </div>\n\n                <div>\n                  <label className=\"text-slate-400 flex justify-between mb-1 font-mono\">\n                    <span>Facility Delivery Fee ($):</span>\n                    <span className=\"text-sky-300 font-bold\">${activeParams.facilityDeliveryFeeUSD}</span>\n                  </label>\n                  <input\n                    type=\"range\"\n                    min=\"0\"\n                    max=\"30\"\n                    step=\"1\"\n                    value={activeParams.facilityDeliveryFeeUSD}\n                    onChange={(e) => setCustomParams((prev) => ({ ...prev, facilityDeliveryFeeUSD: Number(e.target.value) }))}\n                    className=\"w-full accent-sky-500 cursor-pointer\"\n                  />\n                </div>\n\n                <div>\n                  <label className=\"text-slate-400 flex justify-between mb-1 font-mono\">\n                    <span>Skilled Staff Ratio (per 1k):</span>\n                    <span className=\"text-sky-300 font-bold\">{activeParams.skilledStaffRatio}</span>\n                  </label>\n                  <input\n                    type=\"range\"\n                    min=\"0.5\"\n                    max=\"5.0\"\n                    step=\"0.1\"\n                    value={activeParams.skilledStaffRatio}\n                    onChange={(e) => setCustomParams((prev) => ({ ...prev, skilledStaffRatio: Number(e.target.value) }))}\n                    className=\"w-full accent-sky-500 cursor-pointer\"\n                  />\n                </div>\n              </div>\n            </div>\n          )}\n\n        </div>\n\n        {/* Right 1 Col: System Dynamics Stocks & Bottlenecks */}\n        <div className=\"space-y-4\">\n          \n          {/* System Dynamics Stocks HUD */}\n          <div className=\"bg-slate-900/50 border border-slate-800 rounded-lg p-3.5 flex flex-col\">\n            <div className=\"text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-3\">\n              System Dynamics Instantaneous Stocks\n            </div>\n            \n            <div className=\"flex-1 flex flex-col gap-2.5 relative justify-between font-mono\">\n              <div className=\"flex items-center justify-between border-l-2 border-sky-500 pl-3 py-1 bg-slate-950/40 rounded-r\">\n                <div>\n                  <div className=\"text-xs font-bold text-slate-200\">Pregnant Women (S1)</div>\n                  <div className=\"text-[9px] text-slate-500\">District Stock Level</div>\n                </div>\n                <div className=\"text-base font-bold text-white\">{currentSnapshot?.pregnantWomen?.toLocaleString()}</div>\n              </div>\n\n              <div className=\"flex items-center justify-between border-l-2 border-emerald-500 pl-3 py-1 bg-slate-950/40 rounded-r\">\n                <div>\n                  <div className=\"text-xs font-bold text-slate-200\">In ANC Routine (S2)</div>\n                  <div className=\"text-[9px] text-slate-500\">Clinic Retention Level</div>\n                </div>\n                <div className=\"text-base font-bold text-white\">{currentSnapshot?.inANC?.toLocaleString()}</div>\n              </div>\n\n              <div className=\"flex items-center justify-between border-l-2 border-indigo-500 pl-3 py-1 bg-slate-950/40 rounded-r\">\n                <div>\n                  <div className=\"text-xs font-bold text-slate-200\">Facility Delivery (S3)</div>\n                  <div className=\"text-[9px] text-slate-500\">Skilled Attendant Flow</div>\n                </div>\n                <div className=\"text-base font-bold text-white\">{currentSnapshot?.inFacilityDelivery?.toLocaleString()}</div>\n              </div>\n\n              <div className=\"flex items-center justify-between border-l-2 border-rose-500 pl-3 py-1 bg-rose-500/10 rounded-r\">\n                <div>\n                  <div className=\"text-xs font-bold text-rose-400\">Obstetric Compl. (S5)</div>\n                  <div className=\"text-[9px] text-rose-300/70\">Critical Emergency Flow</div>\n                </div>\n                <div className=\"text-base font-bold text-rose-300\">{currentSnapshot?.withComplications?.toLocaleString()}</div>\n              </div>\n            </div>\n          </div>\n\n          {/* Identified Systemic Bottlenecks Card */}\n          <div className=\"bg-slate-900/50 border border-slate-800 rounded-lg p-3.5 shadow-sm space-y-2.5\">\n            <h3 className=\"text-xs font-bold text-slate-300 uppercase tracking-wider flex items-center space-x-1.5\">\n              <AlertCircle className=\"w-3.5 h-3.5 text-rose-400\" />\n              <span>Identified Systemic Bottlenecks</span>\n            </h3>\n\n            <div className=\"space-y-2\">\n              {/* Bottleneck 1 */}\n              <div className=\"bg-[#0c0e12] border border-rose-500/30 rounded p-2.5\">\n                <div className=\"flex items-center justify-between text-xs mb-1\">\n                  <span className=\"font-bold text-rose-300 text-[11px]\">Phase 2 Geographic Referral Delay</span>\n                  <span className=\"px-1.5 py-0.5 rounded text-[9px] font-mono font-bold bg-rose-500/20 text-rose-300\">\n                    38% Var\n                  </span>\n                </div>\n                <p className=\"text-[10px] text-slate-400\">\n                  {district.avgDistanceToEmONC}km avg distance &amp; {district.avgTravelTimeHours}h transit time creates high risk in unmanaged PPH.\n                </p>\n              </div>\n\n              {/* Bottleneck 2 */}\n              <div className=\"bg-[#0c0e12] border border-amber-500/30 rounded p-2.5\">\n                <div className=\"flex items-center justify-between text-xs mb-1\">\n                  <span className=\"font-bold text-amber-300 text-[11px]\">Out-of-Pocket User Fee Barrier</span>\n                  <span className=\"px-1.5 py-0.5 rounded text-[9px] font-mono font-bold bg-amber-500/20 text-amber-300\">\n                    24% Var\n                  </span>\n                </div>\n                <p className=\"text-[10px] text-slate-400\">\n                  Poverty rate of {district.povertyRate}% creates delays in seeking institutional delivery among Q1 and Q2.\n                </p>\n              </div>\n            </div>\n\n            <button\n              id=\"btn-ask-ai-dashboard\"\n              onClick={onOpenCopilot}\n              className=\"w-full mt-1 py-1.5 rounded bg-slate-800 hover:bg-slate-700 text-sky-400 text-xs font-mono font-bold uppercase flex items-center justify-center space-x-1.5 border border-slate-700 transition cursor-pointer\"\n            >\n              <span>CONSULT EPIDEMIOLOGIST AI COPILOT</span>\n            </button>\n          </div>\n\n        </div>\n\n      </div>\n\n      {/* High Density Scenario Comparison Matrix Row */}\n      <div className=\"bg-slate-900/50 border border-slate-800 rounded-lg flex flex-col\">\n        <div className=\"px-4 py-2 border-b border-slate-800 flex justify-between items-center\">\n          <span className=\"text-[10px] font-bold text-slate-400 uppercase tracking-wider\">\n            Comparative Scenario Impact Matrix\n          </span>\n          <div className=\"text-[10px] font-mono text-slate-500 italic\">Simulated Horizon: {horizonMonths} Months</div>\n        </div>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-4 divide-y md:divide-y-0 md:divide-x divide-slate-800\">\n          {SCENARIO_DEFINITIONS.filter((s) => s.id !== \'baseline\').map((s) => {\n            const isOpt = s.id === \'scenario_d\';\n            const res = SystemDynamicsEngine.simulate(district, s.id, {}, horizonMonths);\n            const isSelected = activeScenarioId === s.id;\n\n            return (\n              <div \n                key={s.id} \n                onClick={() => onScenarioChange(s.id)}\n                className={`p-3.5 transition-colors cursor-pointer group ${\n                  isOpt \n                    ? \'bg-sky-900/10 border-l-2 border-sky-500/50 hover:bg-sky-900/20\' \n                    : \'hover:bg-slate-800/30\'\n                } ${isSelected ? \'ring-1 ring-sky-500/50\' : \'\'}`}\n              >\n                <div className={`text-[10px] font-bold uppercase mb-1.5 ${isOpt ? \'text-sky-400\' : \'text-slate-400 group-hover:text-sky-300\'}`}>\n                  ({s.letter}) {s.name.split(\'(\')[0].trim()}\n                </div>\n                <div className={`text-xl font-mono font-bold mb-1 ${isOpt ? \'text-white\' : \'text-slate-200\'}`}>\n                  -{res.summary.mmrReductionPercent}% MMR\n                </div>\n                <div className=\"text-[10px] text-slate-400 mb-2.5 line-clamp-1\">{s.description}</div>\n                <div className=\"flex items-center justify-between text-[10px] font-mono\">\n                  <span className=\"text-slate-500\">Lives:</span>\n                  <span className=\"text-sky-400 font-bold\">{res.summary.livesSaved} [CI: {res.summary.livesSavedCI95[0]}-{res.summary.livesSavedCI95[1]}]</span>\n                </div>\n                <div className=\"flex items-center justify-between text-[10px] font-mono mt-1\">\n                  <span className=\"text-slate-500\">Cost:</span>\n                  <span className=\"text-slate-300 font-bold\">${res.summary.costPerLifeSavedUSD.toLocaleString()} / Life</span>\n                </div>\n              </div>\n            );\n          })}\n        </div>\n      </div>\n\n    </div>\n  );\n};"
        replacement_content: "import React, { useState, useMemo } from \'react\';\nimport { \n  Sliders, \n  AlertCircle, \n  RefreshCw,\n  Sparkles\n} from \'lucide-react\';\nimport { DistrictData, SimulationResult, SDParameters } from \'../types\';\nimport { SystemDynamicsEngine, SCENARIO_DEFINITIONS, buildDefaultParameters } from \'../services/systemDynamics\';\nimport { useLanguage } from \'../i18n/translations\';\n\ninterface DashboardViewProps {\n  district: DistrictData;\n  activeScenarioId: \'baseline\' | \'scenario_a\' | \'scenario_b\' | \'scenario_c\' | \'scenario_d\';\n  onScenarioChange: (id: \'baseline\' | \'scenario_a\' | \'scenario_b\' | \'scenario_c\' | \'scenario_d\') => void;\n  onOpenCopilot: () => void;\n}\n\nexport const DashboardView: React.FC<DashboardViewProps> = ({\n  district,\n  activeScenarioId,\n  onScenarioChange,\n  onOpenCopilot,\n}) => {\n  const { t, language } = useLanguage();\n  const [horizonMonths, setHorizonMonths] = useState<number>(36);\n  const [customParams, setCustomParams] = useState<Partial<SDParameters>>({});\n  const [hoveredMonth, setHoveredMonth] = useState<number | null>(null);\n  const [isParamsOpen, setIsParamsOpen] = useState<boolean>(false);\n\n  // Run simulation\n  const simResult: SimulationResult = useMemo(() => {\n    return SystemDynamicsEngine.simulate(district, activeScenarioId, customParams, horizonMonths);\n  }, [district, activeScenarioId, customParams, horizonMonths]);\n\n  const defaultParams = useMemo(() => buildDefaultParameters(district), [district]);\n  const activeParams: SDParameters = {\n    ...defaultParams,\n    ...(SCENARIO_DEFINITIONS.find((s) => s.id === activeScenarioId)?.parameterOverrides || {}),\n    ...customParams,\n  };\n\n  const trajectories = simResult.trajectories;\n  const currentSnapshot = hoveredMonth !== null \n    ? trajectories.find((t) => t.timeMonth === hoveredMonth) || trajectories[trajectories.length - 1]\n    : trajectories[trajectories.length - 1];\n\n  // Stock Colors for Visual Chart\n  const stockColors = {\n    pregnant: \'#38bdf8\', // S1: Light Blue\n    anc: \'#34d399\',      // S2: Emerald\n    delivery: \'#818cf8\', // S3: Indigo\n    postpartum: \'#fbbf24\', // S4: Amber\n    complications: \'#f43f5e\', // S5: Rose\n  };\n\n  // Scenario localized name helper\n  const getScenarioName = (sId: string, letter: string, origName: string) => {\n    if (sId === \'baseline\') return t.baseline;\n    if (sId === \'scenario_a\') return t.scenarioAName;\n    if (sId === \'scenario_b\') return t.scenarioBName;\n    if (sId === \'scenario_c\') return t.scenarioCName;\n    if (sId === \'scenario_d\') return t.scenarioDName;\n    return origName;\n  };\n\n  const getScenarioDesc = (sId: string, origDesc: string) => {\n    if (sId === \'baseline\') return t.baselineDesc;\n    if (sId === \'scenario_a\') return t.scenarioADesc;\n    if (sId === \'scenario_b\') return t.scenarioBDesc;\n    if (sId === \'scenario_c\') return t.scenarioCDesc;\n    if (sId === \'scenario_d\') return t.scenarioDDesc;\n    return origDesc;\n  };\n\n  // Find max stock for SVG scaling\n  const maxStock = Math.max(...trajectories.map((t) => Math.max(t.pregnantWomen, t.inANC * 1.5, t.inPostpartum)));\n\n  return (\n    <div className=\"space-y-4\">\n      \n      {/* Top Protocol & Hypothesis Banner */}\n      <div className=\"bg-slate-900/50 border border-slate-800 rounded-lg p-3.5 shadow-sm\">\n        <div className=\"flex flex-col lg:flex-row lg:items-center justify-between gap-3\">\n          <div>\n            <div className=\"flex items-center space-x-2\">\n              <span className=\"px-2 py-0.5 text-[10px] font-mono font-bold rounded bg-sky-500/20 text-sky-300 border border-sky-500/30 uppercase tracking-wider\">\n                {t.coreVersion}\n              </span>\n              <h2 className=\"text-sm font-bold text-white uppercase tracking-tight\">\n                {district.name} ({district.country}) \342\200\224 {language === \'es\' ? \'Gemelo Digital de Din\303\241mica de Sistemas Maternos\' : \'Maternal Health System Dynamics Twin\'}\n              </h2>\n            </div>\n            <p className=\"text-[11px] text-slate-400 font-mono mt-0.5\">\n              {t.hypothesisH1}\n            </p>\n          </div>\n\n          {/* Scenario Selector Pills - High Density */}\n          <div className=\"flex items-center flex-wrap gap-1 bg-[#0c0e12] p-1 rounded-md border border-slate-800\">\n            {SCENARIO_DEFINITIONS.map((s) => {\n              const isActive = activeScenarioId === s.id;\n              const localizedName = getScenarioName(s.id, s.letter, s.name);\n              return (\n                <button\n                  key={s.id}\n                  id={`btn-scenario-${s.id}`}\n                  onClick={() => onScenarioChange(s.id)}\n                  className={`px-2.5 py-1 rounded text-xs font-mono font-bold transition cursor-pointer ${\n                    isActive\n                      ? \'bg-sky-600 text-white shadow-md shadow-sky-900/30\'\n                      : \'text-slate-400 hover:text-slate-200 hover:bg-slate-800/80\'\n                  }`}\n                >\n                  <span className=\"opacity-70\">({s.letter})</span> {localizedName}\n                </button>\n              );\n            })}\n          </div>\n        </div>\n      </div>\n\n      {/* High Density KPI Cards Row */}\n      <div className=\"grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3\">\n        \n        {/* Baseline MMR */}\n        <div className=\"bg-slate-900/50 border border-slate-800 rounded-lg p-3 flex flex-col justify-between\">\n          <div className=\"text-[10px] text-slate-500 font-bold uppercase tracking-wider\">{t.baselineMMR}</div>\n          <div className=\"flex items-end gap-1.5 my-1\">\n            <span className=\"text-2xl font-mono font-bold text-white\">{district.baselineMMR}</span>\n          </div>\n          <div className=\"text-[9px] text-slate-600 font-mono italic\">{t.per100kLiveBirths}</div>\n        </div>\n\n        {/* Simulated MMR */}\n        <div className=\"bg-slate-900/50 border border-slate-800 rounded-lg p-3 flex flex-col justify-between\">\n          <div className=\"text-[10px] text-slate-500 font-bold uppercase tracking-wider\">{t.simulatedMMR}</div>\n          <div className=\"flex items-end gap-1.5 my-1\">\n            <span className=\"text-2xl font-mono font-bold text-emerald-400\">{simResult.summary.mmrFinal}</span>\n            <span className=\"text-[10px] text-emerald-400 mb-0.5 font-mono\">-{simResult.summary.mmrReductionPercent}%</span>\n          </div>\n          <div className=\"text-[9px] text-slate-600 font-mono italic\">{t.avertedMMR}</div>\n        </div>\n\n        {/* ANC 4+ Coverage */}\n        <div className=\"bg-slate-900/50 border border-slate-800 rounded-lg p-3 flex flex-col justify-between\">\n          <div className=\"text-[10px] text-slate-500 font-bold uppercase tracking-wider\">{t.anc4Coverage}</div>\n          <div className=\"flex items-end gap-1.5 my-1\">\n            <span className=\"text-2xl font-mono font-bold text-white\">{simResult.summary.anc4CoverageFinal}%</span>\n            <span className=\"text-[10px] text-sky-400 mb-0.5 font-mono\">+{simResult.summary.anc4CoverageFinal - district.anc4Coverage}%</span>\n          </div>\n          <div className=\"text-[9px] text-slate-600 font-mono italic\">{t.baseLabel}: {district.anc4Coverage}%</div>\n        </div>\n\n        {/* Institutional Deliveries */}\n        <div className=\"bg-slate-900/50 border border-slate-800 rounded-lg p-3 flex flex-col justify-between\">\n          <div className=\"text-[10px] text-slate-500 font-bold uppercase tracking-wider\">{t.facilityDelivery}</div>\n          <div className=\"flex items-end gap-1.5 my-1\">\n            <span className=\"text-2xl font-mono font-bold text-white\">{simResult.summary.facilityDeliveryRateFinal}%</span>\n            <span className=\"text-[10px] text-indigo-400 mb-0.5 font-mono\">+{simResult.summary.facilityDeliveryRateFinal - district.institutionalDeliveryRate}%</span>\n          </div>\n          <div className=\"text-[9px] text-slate-600 font-mono italic\">{t.baseLabel}: {district.institutionalDeliveryRate}%</div>\n        </div>\n\n        {/* Projected Lives Saved Highlight Card */}\n        <div className=\"bg-slate-900/50 border border-slate-800 rounded-lg p-3 flex flex-col justify-between bg-sky-900/10 border-sky-900/30 ring-1 ring-sky-500/20\">\n          <div className=\"text-[10px] text-sky-400 font-bold uppercase tracking-wider\">{t.livesSaved}</div>\n          <div className=\"flex items-end gap-1.5 my-1\">\n            <span className=\"text-3xl font-mono font-bold text-sky-400\">{simResult.summary.livesSaved}</span>\n          </div>\n          <div className=\"text-[9px] text-sky-500 font-mono italic\">\n            IC 95%: [{simResult.summary.livesSavedCI95[0]} - {simResult.summary.livesSavedCI95[1]}]\n          </div>\n        </div>\n\n        {/* Cost per Life Saved */}\n        <div className=\"bg-slate-900/50 border border-slate-800 rounded-lg p-3 flex flex-col justify-between\">\n          <div className=\"text-[10px] text-slate-500 font-bold uppercase tracking-wider\">{t.costPerLife}</div>\n          <div className=\"flex items-end gap-1.5 my-1\">\n            <span className=\"text-xl font-mono font-bold text-white\">${simResult.summary.costPerLifeSavedUSD.toLocaleString()}</span>\n          </div>\n          <div className=\"text-[9px] text-slate-600 font-mono italic\">{t.icerPerDaly}: ${simResult.summary.icerPerDALY}</div>\n        </div>\n\n      </div>\n\n      {/* Main Grid: 5-Stock Time Series Chart & System Bottlenecks Panel */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-4\">\n        \n        {/* Left 2 Cols: 5-Stock Trajectory Chart */}\n        <div className=\"lg:col-span-2 bg-slate-900/50 border border-slate-800 rounded-lg p-4 shadow-sm space-y-3\">\n          \n          <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-800/80 pb-2.5\">\n            <div>\n              <div className=\"flex items-center space-x-2\">\n                <span className=\"w-2 h-2 rounded-full bg-sky-500\"></span>\n                <h3 className=\"text-xs font-bold text-slate-300 uppercase tracking-wider\">\n                  {t.monthlyTrajectoryTitle} ({horizonMonths} {t.monthsCount})\n                </h3>\n              </div>\n              <p className=\"text-[10px] text-slate-500 font-mono mt-0.5\">\n                {t.stockVisualSubtitle}\n              </p>\n            </div>\n\n            {/* Parameter & Horizon controls */}\n            <div className=\"flex items-center space-x-1.5\">\n              <select\n                value={horizonMonths}\n                onChange={(e) => setHorizonMonths(Number(e.target.value))}\n                className=\"bg-slate-800 border border-slate-700 text-xs font-mono text-slate-200 rounded px-2 py-1 focus:outline-none\"\n              >\n                <option value={24}>24 {t.monthsCount}</option>\n                <option value={36}>36 {t.monthsCount}</option>\n                <option value={60}>60 {t.monthsCount} (5A)</option>\n              </select>\n\n              <button\n                onClick={() => setIsParamsOpen(!isParamsOpen)}\n                className={`flex items-center space-x-1 px-2 py-1 rounded text-xs font-mono font-semibold border transition cursor-pointer ${\n                  isParamsOpen ? \'bg-sky-500/20 text-sky-300 border-sky-500/40\' : \'bg-slate-800 text-slate-300 border-slate-700 hover:bg-slate-700\'\n                }`}\n              >\n                <Sliders className=\"w-3 h-3\" />\n                <span>{language === \'es\' ? \'PAR\303\201METROS\' : \'PARAMETERS\'}</span>\n              </button>\n            </div>\n          </div>\n\n          {/* Interactive Stock Legend */}\n          <div className=\"flex flex-wrap items-center gap-3 text-[11px] font-mono\">\n            <div className=\"flex items-center space-x-1.5\">\n              <span className=\"w-2.5 h-2.5 rounded-sm\" style={{ backgroundColor: stockColors.pregnant }} />\n              <span className=\"text-slate-300\">{language === \'es\' ? \'S1: Gestantes\' : \'S1: Preg\'} ({currentSnapshot?.pregnantWomen?.toLocaleString()})</span>\n            </div>\n            <div className=\"flex items-center space-x-1.5\">\n              <span className=\"w-2.5 h-2.5 rounded-sm\" style={{ backgroundColor: stockColors.anc }} />\n              <span className=\"text-slate-300\">{language === \'es\' ? \'S2: CPN 4+\' : \'S2: ANC\'} ({currentSnapshot?.inANC?.toLocaleString()})</span>\n            </div>\n            <div className=\"flex items-center space-x-1.5\">\n              <span className=\"w-2.5 h-2.5 rounded-sm\" style={{ backgroundColor: stockColors.delivery }} />\n              <span className=\"text-slate-300\">{language === \'es\' ? \'S3: Parto Inst.\' : \'S3: Del\'} ({currentSnapshot?.inFacilityDelivery?.toLocaleString()})</span>\n            </div>\n            <div className=\"flex items-center space-x-1.5\">\n              <span className=\"w-2.5 h-2.5 rounded-sm\" style={{ backgroundColor: stockColors.postpartum }} />\n              <span className=\"text-slate-300\">{language === \'es\' ? \'S4: Puerperio\' : \'S4: Postp\'} ({currentSnapshot?.inPostpartum?.toLocaleString()})</span>\n            </div>\n            <div className=\"flex items-center space-x-1.5\">\n              <span className=\"w-2.5 h-2.5 rounded-sm\" style={{ backgroundColor: stockColors.complications }} />\n              <span className=\"text-rose-400 font-bold\">{language === \'es\' ? \'S5: Compl. Graves\' : \'S5: Compl\'} ({currentSnapshot?.withComplications?.toLocaleString()})</span>\n            </div>\n          </div>\n\n          {/* SVG Multi-Curve Trajectory Chart */}\n          <div className=\"relative w-full h-64 bg-[#131a26] rounded-lg p-2.5 border border-slate-800\">\n            <svg \n              className=\"w-full h-full overflow-visible\"\n              viewBox=\"0 0 700 240\"\n              preserveAspectRatio=\"none\"\n            >\n              {/* Grid Lines */}\n              {[0, 60, 120, 180, 240].map((y) => (\n                <line key={y} x1=\"0\" y1={y} x2=\"700\" y2={y} stroke=\"#1e293b\" strokeDasharray=\"3 3\" strokeWidth=\"0.8\" />\n              ))}\n\n              {/* Curves for the 5 Stocks */}\n              <polyline\n                fill=\"none\"\n                stroke={stockColors.pregnant}\n                strokeWidth=\"2.5\"\n                points={trajectories.map((t, idx) => {\n                  const x = (idx / (trajectories.length - 1)) * 700;\n                  const y = 240 - (t.pregnantWomen / maxStock) * 220;\n                  return `${x},${y}`;\n                }).join(\' \')}\n              />\n\n              <polyline\n                fill=\"none\"\n                stroke={stockColors.anc}\n                strokeWidth=\"2.5\"\n                points={trajectories.map((t, idx) => {\n                  const x = (idx / (trajectories.length - 1)) * 700;\n                  const y = 240 - ((t.inANC * 1.5) / maxStock) * 220;\n                  return `${x},${y}`;\n                }).join(\' \')}\n              />\n\n              <polyline\n                fill=\"none\"\n                stroke={stockColors.postpartum}\n                strokeWidth=\"2.5\"\n                points={trajectories.map((t, idx) => {\n                  const x = (idx / (trajectories.length - 1)) * 700;\n                  const y = 240 - (t.inPostpartum / maxStock) * 220;\n                  return `${x},${y}`;\n                }).join(\' \')}\n              />\n\n              <polyline\n                fill=\"none\"\n                stroke={stockColors.delivery}\n                strokeWidth=\"2.5\"\n                strokeDasharray=\"4 2\"\n                points={trajectories.map((t, idx) => {\n                  const x = (idx / (trajectories.length - 1)) * 700;\n                  const y = 240 - ((t.inFacilityDelivery * 6) / maxStock) * 220;\n                  return `${x},${y}`;\n                }).join(\' \')}\n              />\n\n              <polyline\n                fill=\"none\"\n                stroke={stockColors.complications}\n                strokeWidth=\"3\"\n                points={trajectories.map((t, idx) => {\n                  const x = (idx / (trajectories.length - 1)) * 700;\n                  const y = 240 - ((t.withComplications * 12) / maxStock) * 220;\n                  return `${x},${y}`;\n                }).join(\' \')}\n              />\n            </svg>\n\n            {/* Month Hover & Timeline Scrubber */}\n            <div className=\"absolute inset-x-3 bottom-1 flex justify-between text-[9px] font-mono text-slate-500\">\n              <span>{t.monthHover} 0</span>\n              <span>{t.monthHover} {Math.round(horizonMonths / 2)}</span>\n              <span>{t.monthHover} {horizonMonths}</span>\n            </div>\n          </div>\n\n          {/* Feedback Loops Active Telemetry */}\n          <div className=\"grid grid-cols-3 gap-2 text-xs font-mono\">\n            <div className=\"bg-[#0c0e12] p-2.5 rounded-lg border border-slate-800\">\n              <span className=\"text-[10px] text-slate-500 uppercase font-bold block\">\n                {language === \'es\' ? \'Nivel de Confianza (Bucle R1):\' : \'Trust Level (R1 Loop):\'}\n              </span>\n              <span className=\"font-bold text-sky-400\">{Math.round(currentSnapshot.systemTrustLevel * 100)}% {language === \'es\' ? \'Adherencia\' : \'Confidence\'}</span>\n            </div>\n            <div className=\"bg-[#0c0e12] p-2.5 rounded-lg border border-slate-800\">\n              <span className=\"text-[10px] text-slate-500 uppercase font-bold block\">\n                {language === \'es\' ? \'Saturaci\303\263n Centro Salud (B1):\' : \'Facility Congestion (B1):\'}\n              </span>\n              <span className={`font-bold ${currentSnapshot.facilityCongestionIndex > 1.2 ? \'text-amber-400\' : \'text-emerald-400\'}`}>\n                {currentSnapshot.facilityCongestionIndex}x {language === \'es\' ? \'Carga\' : \'Load\'}\n              </span>\n            </div>\n            <div className=\"bg-[#0c0e12] p-2.5 rounded-lg border border-slate-800\">\n              <span className=\"text-[10px] text-slate-500 uppercase font-bold block\">\n                {language === \'es\' ? \'Retraso de Traslado Fase 2 (B2):\' : \'Phase 2 Transit Delay (B2):\'}\n              </span>\n              <span className=\"font-bold text-cyan-400\">{currentSnapshot.phase2DelayHours} {language === \'es\' ? \'Horas\' : \'Hours\'}</span>\n            </div>\n          </div>\n\n          {/* Collapsible Parameter Customization Drawer */}\n          {isParamsOpen && (\n            <div className=\"bg-[#0c0e12] border border-sky-500/30 rounded-lg p-3 space-y-2 mt-3\">\n              <div className=\"flex items-center justify-between text-xs font-mono border-b border-slate-800 pb-1.5\">\n                <span className=\"font-bold text-sky-300 uppercase\">{t.parameterControls}</span>\n                <button\n                  onClick={() => setCustomParams({})}\n                  className=\"text-slate-400 hover:text-white flex items-center space-x-1 cursor-pointer\"\n                >\n                  <RefreshCw className=\"w-3 h-3\" />\n                  <span>{t.resetDefaults}</span>\n                </button>\n              </div>\n\n              <div className=\"grid grid-cols-1 md:grid-cols-3 gap-3 text-xs\">\n                <div>\n                  <label className=\"text-slate-400 flex justify-between mb-1 font-mono\">\n                    <span>{language === \'es\' ? \'Tiempo de Traslado (Horas):\' : \'Travel Time (Hours):\'}</span>\n                    <span className=\"text-sky-300 font-bold\">{activeParams.travelTimeHours}h</span>\n                  </label>\n                  <input\n                    type=\"range\"\n                    min=\"0.5\"\n                    max=\"6.0\"\n                    step=\"0.1\"\n                    value={activeParams.travelTimeHours}\n                    onChange={(e) => setCustomParams((prev) => ({ ...prev, travelTimeHours: Number(e.target.value) }))}\n                    className=\"w-full accent-sky-500 cursor-pointer\"\n                  />\n                </div>\n\n                <div>\n                  <label className=\"text-slate-400 flex justify-between mb-1 font-mono\">\n                    <span>{language === \'es\' ? \'Tarifa de Parto ($):\' : \'Facility Delivery Fee ($):\'}</span>\n                    <span className=\"text-sky-300 font-bold\">${activeParams.facilityDeliveryFeeUSD}</span>\n                  </label>\n                  <input\n                    type=\"range\"\n                    min=\"0\"\n                    max=\"30\"\n                    step=\"1\"\n                    value={activeParams.facilityDeliveryFeeUSD}\n                    onChange={(e) => setCustomParams((prev) => ({ ...prev, facilityDeliveryFeeUSD: Number(e.target.value) }))}\n                    className=\"w-full accent-sky-500 cursor-pointer\"\n                  />\n                </div>\n\n                <div>\n                  <label className=\"text-slate-400 flex justify-between mb-1 font-mono\">\n                    <span>{language === \'es\' ? \'Personal Calificado (/1k):\' : \'Skilled Staff Ratio (/1k):\'}</span>\n                    <span className=\"text-sky-300 font-bold\">{activeParams.skilledStaffRatio}</span>\n                  </label>\n                  <input\n                    type=\"range\"\n                    min=\"0.5\"\n                    max=\"5.0\"\n                    step=\"0.1\"\n                    value={activeParams.skilledStaffRatio}\n                    onChange={(e) => setCustomParams((prev) => ({ ...prev, skilledStaffRatio: Number(e.target.value) }))}\n                    className=\"w-full accent-sky-500 cursor-pointer\"\n                  />\n                </div>\n              </div>\n            </div>\n          )}\n\n        </div>\n\n        {/* Right 1 Col: System Dynamics Stocks & Bottlenecks */}\n        <div className=\"space-y-4\">\n          \n          {/* System Dynamics Stocks HUD */}\n          <div className=\"bg-slate-900/50 border border-slate-800 rounded-lg p-3.5 flex flex-col\">\n            <div className=\"text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-3\">\n              {language === \'es\' ? \'Stocks Instant\303\241neos de Din\303\241mica de Sistemas\' : \'System Dynamics Instantaneous Stocks\'}\n            </div>\n            \n            <div className=\"flex-1 flex flex-col gap-2.5 relative justify-between font-mono\">\n              <div className=\"flex items-center justify-between border-l-2 border-sky-500 pl-3 py-1 bg-slate-950/40 rounded-r\">\n                <div>\n                  <div className=\"text-xs font-bold text-slate-200\">{language === \'es\' ? \'Gestantes en Comunidad (S1)\' : \'Pregnant Women (S1)\'}</div>\n                  <div className=\"text-[9px] text-slate-500\">{t.stockS1Desc}</div>\n                </div>\n                <div className=\"text-base font-bold text-white\">{currentSnapshot?.pregnantWomen?.toLocaleString()}</div>\n              </div>\n\n              <div className=\"flex items-center justify-between border-l-2 border-emerald-500 pl-3 py-1 bg-slate-950/40 rounded-r\">\n                <div>\n                  <div className=\"text-xs font-bold text-slate-200\">{language === \'es\' ? \'En Control CPN 4+ (S2)\' : \'In ANC Routine (S2)\'}</div>\n                  <div className=\"text-[9px] text-slate-500\">{t.stockS2Desc}</div>\n                </div>\n                <div className=\"text-base font-bold text-white\">{currentSnapshot?.inANC?.toLocaleString()}</div>\n              </div>\n\n              <div className=\"flex items-center justify-between border-l-2 border-indigo-500 pl-3 py-1 bg-slate-950/40 rounded-r\">\n                <div>\n                  <div className=\"text-xs font-bold text-slate-200\">{language === \'es\' ? \'Parto Institucional (S3)\' : \'Facility Delivery (S3)\'}</div>\n                  <div className=\"text-[9px] text-slate-500\">{t.stockS3Desc}</div>\n                </div>\n                <div className=\"text-base font-bold text-white\">{currentSnapshot?.inFacilityDelivery?.toLocaleString()}</div>\n              </div>\n\n              <div className=\"flex items-center justify-between border-l-2 border-rose-500 pl-3 py-1 bg-rose-500/10 rounded-r\">\n                <div>\n                  <div className=\"text-xs font-bold text-rose-400\">{language === \'es\' ? \'Complicaciones Graves (S5)\' : \'Obstetric Compl. (S5)\'}</div>\n                  <div className=\"text-[9px] text-rose-300/70\">{t.stockS5Desc}</div>\n                </div>\n                <div className=\"text-base font-bold text-rose-300\">{currentSnapshot?.withComplications?.toLocaleString()}</div>\n              </div>\n            </div>\n          </div>\n\n          {/* Identified Systemic Bottlenecks Card */}\n          <div className=\"bg-slate-900/50 border border-slate-800 rounded-lg p-3.5 shadow-sm space-y-2.5\">\n            <h3 className=\"text-xs font-bold text-slate-300 uppercase tracking-wider flex items-center space-x-1.5\">\n              <AlertCircle className=\"w-3.5 h-3.5 text-rose-400\" />\n              <span>{language === \'es\' ? \'Cuellos de Botella Sist\303\251micos\' : \'Identified Systemic Bottlenecks\'}</span>\n            </h3>\n\n            <div className=\"space-y-2\">\n              {/* Bottleneck 1 */}\n              <div className=\"bg-[#0c0e12] border border-rose-500/30 rounded p-2.5\">\n                <div className=\"flex items-center justify-between text-xs mb-1\">\n                  <span className=\"font-bold text-rose-300 text-[11px]\">\n                    {language === \'es\' ? \'Retraso Geogr\303\241fico de Traslado (Fase 2)\' : \'Phase 2 Geographic Referral Delay\'}\n                  </span>\n                  <span className=\"px-1.5 py-0.5 rounded text-[9px] font-mono font-bold bg-rose-500/20 text-rose-300\">\n                    38% Var\n                  </span>\n                </div>\n                <p className=\"text-[10px] text-slate-400\">\n                  {language === \'es\' \n                    ? `${district.avgDistanceToEmONC}km de distancia media y ${district.avgTravelTimeHours}h de traslado elevan el riesgo en hemorragias postparto.`\n                    : `${district.avgDistanceToEmONC}km avg distance & ${district.avgTravelTimeHours}h transit time creates high risk in unmanaged PPH.`}\n                </p>\n              </div>\n\n              {/* Bottleneck 2 */}\n              <div className=\"bg-[#0c0e12] border border-amber-500/30 rounded p-2.5\">\n                <div className=\"flex items-center justify-between text-xs mb-1\">\n                  <span className=\"font-bold text-amber-300 text-[11px]\">\n                    {language === \'es\' ? \'Barrera de Tarifas de Bolsillo\' : \'Out-of-Pocket User Fee Barrier\'}\n                  </span>\n                  <span className=\"px-1.5 py-0.5 rounded text-[9px] font-mono font-bold bg-amber-500/20 text-amber-300\">\n                    24% Var\n                  </span>\n                </div>\n                <p className=\"text-[10px] text-slate-400\">\n                  {language === \'es\'\n                    ? `Tasa de pobreza del ${district.povertyRate}% retrasa la decisi\303\263n de acudir al parto institucional en Q1 y Q2.`\n                    : `Poverty rate of ${district.povertyRate}% creates delays in seeking institutional delivery among Q1 and Q2.`}\n                </p>\n              </div>\n            </div>\n\n            <button\n              id=\"btn-ask-ai-dashboard\"\n              onClick={onOpenCopilot}\n              className=\"w-full mt-1 py-1.5 rounded bg-slate-800 hover:bg-slate-700 text-sky-400 text-xs font-mono font-bold uppercase flex items-center justify-center space-x-1.5 border border-slate-700 transition cursor-pointer\"\n            >\n              <Sparkles className=\"w-3.5 h-3.5 mr-1\" />\n              <span>{t.aiCopilotBtn}</span>\n            </button>\n          </div>\n\n        </div>\n\n      </div>\n\n      {/* High Density Scenario Comparison Matrix Row */}\n      <div className=\"bg-slate-900/50 border border-slate-800 rounded-lg flex flex-col\">\n        <div className=\"px-4 py-2 border-b border-slate-800 flex justify-between items-center\">\n          <span className=\"text-[10px] font-bold text-slate-400 uppercase tracking-wider\">\n            {t.policyMatrixTitle}\n          </span>\n          <div className=\"text-[10px] font-mono text-slate-500 italic\">\n            {t.timeHorizon} {horizonMonths} {t.monthsCount}\n          </div>\n        </div>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-4 divide-y md:divide-y-0 md:divide-x divide-slate-800\">\n          {SCENARIO_DEFINITIONS.filter((s) => s.id !== \'baseline\').map((s) => {\n            const isOpt = s.id === \'scenario_d\';\n            const res = SystemDynamicsEngine.simulate(district, s.id, {}, horizonMonths);\n            const isSelected = activeScenarioId === s.id;\n            const localizedName = getScenarioName(s.id, s.letter, s.name);\n            const localizedDesc = getScenarioDesc(s.id, s.description);\n\n            return (\n              <div \n                key={s.id} \n                onClick={() => onScenarioChange(s.id)}\n                className={`p-3.5 transition-colors cursor-pointer group ${\n                  isOpt \n                    ? \'bg-sky-900/10 border-l-2 border-sky-500/50 hover:bg-sky-900/20\' \n                    : \'hover:bg-slate-800/30\'\n                } ${isSelected ? \'ring-1 ring-sky-500/50\' : \'\'}`}\n              >\n                <div className={`text-[10px] font-bold uppercase mb-1.5 ${isOpt ? \'text-sky-400\' : \'text-slate-400 group-hover:text-sky-300\'}`}>\n                  ({s.letter}) {localizedName}\n                </div>\n                <div className={`text-xl font-mono font-bold mb-1 ${isOpt ? \'text-white\' : \'text-slate-200\'}`}>\n                  -{res.summary.mmrReductionPercent}% {language === \'es\' ? \'RMM\' : \'MMR\'}\n                </div>\n                <div className=\"text-[10px] text-slate-400 mb-2.5 line-clamp-1\">{localizedDesc}</div>\n                <div className=\"flex items-center justify-between text-[10px] font-mono\">\n                  <span className=\"text-slate-500\">{language === \'es\' ? \'Vidas:\' : \'Lives:\'}</span>\n                  <span className=\"text-sky-400 font-bold\">{res.summary.livesSaved} [IC: {res.summary.livesSavedCI95[0]}-{res.summary.livesSavedCI95[1]}]</span>\n                </div>\n                <div className=\"flex items-center justify-between text-[10px] font-mono mt-1\">\n                  <span className=\"text-slate-500\">{language === \'es\' ? \'Costo:\' : \'Cost:\'}</span>\n                  <span className=\"text-slate-300 font-bold\">${res.summary.costPerLifeSavedUSD.toLocaleString()} / {language === \'es\' ? \'Vida\' : \'Life\'}</span>\n                </div>\n              </div>\n            );\n          })}\n        </div>\n      </div>\n\n    </div>\n  );\n};"
      }
      num_matches: 1
    }
  }
}
