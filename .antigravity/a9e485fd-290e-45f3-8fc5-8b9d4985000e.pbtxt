  file_change {
    absolute_path_uri: "file:///src/components/EquityView.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useMemo } from \'react\';\nimport { \n  Scale, \n  TrendingDown, \n  Users, \n  Award, \n  HelpCircle, \n  ArrowRight,\n  ShieldCheck\n} from \'lucide-react\';\nimport { DistrictData, SimulationResult } from \'../types\';\nimport { SystemDynamicsEngine } from \'../services/systemDynamics\';\n\ninterface EquityViewProps {\n  district: DistrictData;\n  activeScenarioId: \'baseline\' | \'scenario_a\' | \'scenario_b\' | \'scenario_c\' | \'scenario_d\';\n}\n\nexport const EquityView: React.FC<EquityViewProps> = ({ district, activeScenarioId }) => {\n  const simResult: SimulationResult = useMemo(() => {\n    return SystemDynamicsEngine.simulate(district, activeScenarioId, {}, 36);\n  }, [district, activeScenarioId]);\n\n  const equityData = simResult.equityDisaggregation;\n\n  const baselineQ1 = district.wealthQuintilesMMR.q1_poorest;\n  const baselineQ5 = district.wealthQuintilesMMR.q5_richest;\n  const baselineGap = baselineQ1 - baselineQ5;\n\n  const simulatedQ1 = equityData.find((q) => q.quintile === \'Q1\')?.simulatedMMR || baselineQ1;\n  const simulatedQ5 = equityData.find((q) => q.quintile === \'Q5\')?.simulatedMMR || baselineQ5;\n  const simulatedGap = simulatedQ1 - simulatedQ5;\n  const gapReductionPercent = Math.round(((baselineGap - simulatedGap) / baselineGap) * 100);\n\n  const totalLivesSavedInQ1Q2 = equityData\n    .filter((q) => q.quintile === \'Q1\' || q.quintile === \'Q2\')\n    .reduce((acc, q) => acc + q.livesSaved, 0);\n\n  const totalLivesSaved = simResult.summary.livesSaved || 1;\n  const proPoorShare = Math.round((totalLivesSavedInQ1Q2 / totalLivesSaved) * 100);\n\n  return (\n    <div className=\"space-y-6\">\n      \n      {/* Header Banner */}\n      <div className=\"bg-slate-900/90 border border-slate-800 rounded-xl p-5 shadow-sm\">\n        <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n          <div>\n            <div className=\"flex items-center space-x-2\">\n              <span className=\"px-2 py-0.5 text-xs font-bold rounded bg-teal-500/20 text-teal-300 border border-teal-500/30\">\n                SOCIOECONOMIC EQUITY & WEALTH QUINTILES\n              </span>\n              <h2 className=\"text-base font-bold text-white\">\n                Disaggregated Maternal Health Outcomes by DHS Wealth Quintile (Q1\342\200\223Q5)\n              </h2>\n            </div>\n            <p className=\"text-xs text-slate-400 mt-1\">\n              Evaluating the equity impact of {simResult.scenarioName} in {district.name} ({district.country})\n            </p>\n          </div>\n        </div>\n      </div>\n\n      {/* Top Equity KPIs */}\n      <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n        \n        <div className=\"bg-slate-900/90 border border-slate-800 rounded-xl p-4 flex items-center space-x-4\">\n          <div className=\"w-12 h-12 rounded-xl bg-teal-500/15 border border-teal-500/30 flex items-center justify-center shrink-0\">\n            <Scale className=\"w-6 h-6 text-teal-400\" />\n          </div>\n          <div>\n            <div className=\"text-xs text-slate-400\">Absolute Inequality Gap (Q1 vs Q5)</div>\n            <div className=\"text-xl font-bold text-white mt-0.5\">\n              {simulatedGap} <span className=\"text-xs font-normal text-slate-400\">vs {baselineGap} baseline</span>\n            </div>\n            <div className=\"text-xs text-emerald-400 font-semibold mt-0.5\">\n              -{gapReductionPercent}% narrowing of inequality gap\n            </div>\n          </div>\n        </div>\n\n        <div className=\"bg-slate-900/90 border border-slate-800 rounded-xl p-4 flex items-center space-x-4\">\n          <div className=\"w-12 h-12 rounded-xl bg-cyan-500/15 border border-cyan-500/30 flex items-center justify-center shrink-0\">\n            <Users className=\"w-6 h-6 text-cyan-400\" />\n          </div>\n          <div>\n            <div className=\"text-xs text-slate-400\">Pro-Poor Benefit Concentration</div>\n            <div className=\"text-xl font-bold text-cyan-300 mt-0.5\">\n              {proPoorShare}% of Lives Saved\n            </div>\n            <div className=\"text-xs text-slate-400 mt-0.5\">\n              Accrue directly to Quintiles 1 & 2 (poorest 40%)\n            </div>\n          </div>\n        </div>\n\n        <div className=\"bg-slate-900/90 border border-slate-800 rounded-xl p-4 flex items-center space-x-4\">\n          <div className=\"w-12 h-12 rounded-xl bg-emerald-500/15 border border-emerald-500/30 flex items-center justify-center shrink-0\">\n            <ShieldCheck className=\"w-6 h-6 text-emerald-400\" />\n          </div>\n          <div>\n            <div className=\"text-xs text-slate-400\">Equity Index Ranking</div>\n            <div className=\"text-xl font-bold text-emerald-300 mt-0.5\">\n              Progressive / Highly Equitable\n            </div>\n            <div className=\"text-xs text-slate-400 mt-0.5\">\n              DHS Concentration Index shifts towards parity\n            </div>\n          </div>\n        </div>\n\n      </div>\n\n      {/* Quintile Disaggregation Table & Concentration Bars */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n        \n        {/* Table (2 Cols) */}\n        <div className=\"lg:col-span-2 bg-slate-900/90 border border-slate-800 rounded-xl p-5 shadow-sm space-y-4\">\n          <h3 className=\"text-sm font-bold text-white\">Quintile-Specific Mortality & Lives Saved</h3>\n\n          <div className=\"overflow-x-auto\">\n            <table className=\"w-full text-left text-xs border-collapse\">\n              <thead>\n                <tr className=\"border-b border-slate-800 bg-slate-950 text-slate-400\">\n                  <th className=\"p-3 font-semibold\">Wealth Quintile</th>\n                  <th className=\"p-3 font-semibold\">Share of Population</th>\n                  <th className=\"p-3 font-semibold\">Baseline MMR</th>\n                  <th className=\"p-3 font-semibold\">Simulated MMR</th>\n                  <th className=\"p-3 font-semibold\">Lives Saved</th>\n                  <th className=\"p-3 font-semibold\">Relative Red. %</th>\n                </tr>\n              </thead>\n              <tbody className=\"divide-y divide-slate-800/60\">\n                {equityData.map((q) => {\n                  const isQ1 = q.quintile === \'Q1\';\n                  return (\n                    <tr key={q.quintile} className={isQ1 ? \'bg-teal-950/20 font-semibold\' : \'\'}>\n                      <td className=\"p-3\">\n                        <div className=\"flex items-center space-x-2\">\n                          <span className=\"font-bold text-white\">{q.quintile}</span>\n                          <span className=\"text-slate-400\">({q.label})</span>\n                        </div>\n                      </td>\n                      <td className=\"p-3 text-slate-400\">{Math.round(q.populationShare * 100)}%</td>\n                      <td className=\"p-3 font-mono text-slate-300\">{q.baselineMMR}</td>\n                      <td className=\"p-3 font-mono font-bold text-emerald-400\">{q.simulatedMMR}</td>\n                      <td className=\"p-3 font-mono font-bold text-teal-300\">{q.livesSaved}</td>\n                      <td className=\"p-3 font-semibold text-emerald-400\">-{q.relativeReduction}%</td>\n                    </tr>\n                  );\n                })}\n              </tbody>\n            </table>\n          </div>\n        </div>\n\n        {/* Visual Concentration Curve & Distribution (1 Col) */}\n        <div className=\"bg-slate-900/90 border border-slate-800 rounded-xl p-5 shadow-sm space-y-4\">\n          <h3 className=\"text-sm font-bold text-white\">Equity Concentration Gradient</h3>\n          <p className=\"text-xs text-slate-400\">\n            Comparing mortality burden across wealth strata:\n          </p>\n\n          <div className=\"space-y-3 pt-2\">\n            {equityData.map((q) => (\n              <div key={q.quintile} className=\"space-y-1 text-xs\">\n                <div className=\"flex justify-between text-slate-300\">\n                  <span>{q.quintile} ({q.label})</span>\n                  <span className=\"font-mono text-emerald-400\">{q.simulatedMMR} per 100k</span>\n                </div>\n                <div className=\"w-full h-2 bg-slate-800 rounded-full overflow-hidden flex\">\n                  <div \n                    className=\"h-full bg-emerald-500 rounded-full transition-all duration-500\"\n                    style={{ width: `${Math.min(100, (q.simulatedMMR / district.wealthQuintilesMMR.q1_poorest) * 100)}%` }}\n                  />\n                </div>\n              </div>\n            ))}\n          </div>\n\n          <div className=\"p-3 rounded-lg bg-slate-950 border border-slate-800 text-xs text-slate-400\">\n            \360\237\222\241 <strong>Policy Takeaway:</strong> Out-of-pocket facility delivery fees act as a regressive tax, causing the largest delays in Q1. Universal fee abolition accelerates equitable mortality reduction.\n          </div>\n        </div>\n\n      </div>\n\n    </div>\n  );\n};\n"
    }
    diff {
      unified_diff {
        lines {
          text: "import React, { useMemo } from \'react\';"
