          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    const val = getMetricValue(d, activeMetric);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    const color = getMetricColor(val, activeMetric);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    const radius = isSelected ? 9 : isHovered ? 8 : 6;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
