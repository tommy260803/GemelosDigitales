  file_change {
    absolute_path_uri: "file:///test-runner.ts"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { SystemDynamicsEngine } from \'./src/services/systemDynamics\';\nimport { SUB_SAHARAN_DISTRICTS } from \'./src/data/districts\';\nimport { DistrictData } from \'./src/types\';\n\nconst GARISSA_TEST_DATA: DistrictData = {\n  id: \'garissa-ke\',\n  name: \'Garissa District\',\n  country: \'Kenya\',\n  region: \'North Eastern Province\',\n  population: 841353,\n  annualBirths: 29447,\n  baselineMMR: 646,\n  anc1Coverage: 62.4,\n  anc4Coverage: 34.2,\n  institutionalDeliveryRate: 46.5,\n  cSectionRate: 2.1,\n  avgDistanceToEmONC: 38.5,\n  avgTravelTimeHours: 3.9,\n  skilledStaffRatio: 1.1,\n  bloodBankAvailability: 42.0,\n  essentialDrugsAvailability: 68.0,\n  insuranceCoverage: 11.2,\n  povertyRate: 65.5,\n  femaleSecondaryEducation: 22.4,\n  traditionalBirthAttendantPrevalence: 48.0,\n  lat: -0.4532,\n  lng: 39.6461,\n  osmHealthFacilitiesCount: 14,\n  wealthQuintileMMR: {\n    q1_poorest: 891,\n    q2_poor: 762,\n    q3_middle: 614,\n    q4_richer: 491,\n    q5_richest: 342,\n  },\n};\n\nconsole.log(\'================================================================\');\nconsole.log(\'\360\237\224\254 SYSTEM DYNAMICS SIMULATION ENGINE - VERIFICATION SUITE\');\nconsole.log(\'================================================================\\n\');\n\nlet passedTests = 0;\nlet totalTests = 0;\n\nfunction assert(condition: boolean, testName: string, details?: string) {\n  totalTests++;\n  if (condition) {\n    console.log(`\342\234\205 [PASS] ${testName}`);\n    if (details) console.log(`   \342\224\224\342\224\200 ${details}`);\n    passedTests++;\n  } else {\n    console.error(`\342\235\214 [FAIL] ${testName}`);\n    if (details) console.error(`   \342\224\224\342\224\200 ${details}`);\n    process.exitCode = 1;\n  }\n}\n\n// TEST 1: Baseline Calibration\nconst simBaseline = SystemDynamicsEngine.simulate(GARISSA_TEST_DATA, \'baseline\', {}, 36);\nconst predictedBaseline = simBaseline.summary.mmrFinal;\nconst observedBaseline = GARISSA_TEST_DATA.baselineMMR;\nconst baseDiff = Math.abs(predictedBaseline - observedBaseline) / observedBaseline;\n\nassert(\n  baseDiff < 0.05,\n  \'Test 1: Baseline MMR matches historical district baseline within 5%\',\n  `Observed: ${observedBaseline} / 100k, Simulated Baseline: ${predictedBaseline} / 100k (Error: ${(baseDiff * 100).toFixed(2)}%)`\n);\n\n// TEST 2: Scenario D reduces MMR by >= 15% and saves lives\nconst simD = SystemDynamicsEngine.simulate(GARISSA_TEST_DATA, \'scenario_d\', {}, 36);\nconst finalMMRD = simD.summary.mmrFinal;\nconst mmrReductionD = simD.summary.mmrReductionPercent;\nconst livesSavedD = simD.summary.livesSaved;\n\nassert(\n  finalMMRD < predictedBaseline && mmrReductionD >= 15.0,\n  \'Test 2A: Scenario D (Combined) strictly reduces MMR by >= 15%\',\n  `Baseline MMR: ${predictedBaseline} -> Scenario D MMR: ${finalMMRD} (Reduction: ${mmrReductionD.toFixed(1)}%)`\n);\n\nassert(\n  livesSavedD > 0,\n  \'Test 2B: Scenario D results in positive lives saved (> 0)\',\n  `Mothers saved over 36 months: +${livesSavedD} [95% CI: ${simD.summary.livesSavedCI95.join(\' - \')}]`\n);\n\n// TEST 3: Interventions monotonicity (A, B, C, D each reduce MMR)\nconst simA = SystemDynamicsEngine.simulate(GARISSA_TEST_DATA, \'scenario_a\', {}, 36);\nconst simB = SystemDynamicsEngine.simulate(GARISSA_TEST_DATA, \'scenario_b\', {}, 36);\nconst simC = SystemDynamicsEngine.simulate(GARISSA_TEST_DATA, \'scenario_c\', {}, 36);\n\nassert(\n  simA.summary.mmrFinal < predictedBaseline &&\n  simB.summary.mmrFinal < predictedBaseline &&\n  simC.summary.mmrFinal < predictedBaseline &&\n  simD.summary.mmrFinal <= Math.min(simA.summary.mmrFinal, simB.summary.mmrFinal, simC.summary.mmrFinal),\n  \'Test 3: Synergistic intervention compounding across all scenarios\',\n  `Base: ${predictedBaseline} | Scen A: ${simA.summary.mmrFinal} (-${simA.summary.mmrReductionPercent}%) | Scen B: ${simB.summary.mmrFinal} (-${simB.summary.mmrReductionPercent}%) | Scen C: ${simC.summary.mmrFinal} (-${simC.summary.mmrReductionPercent}%) | Scen D: ${simD.summary.mmrFinal} (-${simD.summary.mmrReductionPercent}%)`\n);\n\n// TEST 4: Stock non-negativity across all 5 stocks\nlet allStocksPositive = true;\n[\'baseline\', \'scenario_a\', \'scenario_b\', \'scenario_c\', \'scenario_d\'].forEach((scen) => {\n  const res = SystemDynamicsEngine.simulate(GARISSA_TEST_DATA, scen as any, {}, 36);\n  res.trajectories.forEach((step) => {\n    if (\n      step.pregnantWomen <= 0 ||\n      step.inANC <= 0 ||\n      step.inFacilityDelivery <= 0 ||\n      step.inPostpartum <= 0 ||\n      step.withComplications <= 0\n    ) {\n      allStocksPositive = false;\n    }\n  });\n});\n\nassert(\n  allStocksPositive,\n  \'Test 4: Conservation of state stocks (S1..S5 > 0 at all 36 months)\'\n);\n\n// TEST 5: Verification across all 20 Sub-Saharan districts\nlet allDistrictsPassed = true;\nlet districtFails: string[] = [];\n\nSUB_SAHARAN_DISTRICTS.forEach((d) => {\n  const base = SystemDynamicsEngine.simulate(d, \'baseline\', {}, 36);\n  const scD = SystemDynamicsEngine.simulate(d, \'scenario_d\', {}, 36);\n\n  const calibErr = Math.abs(base.summary.mmrFinal - d.baselineMMR) / d.baselineMMR;\n  if (calibErr >= 0.05 || scD.summary.mmrReductionPercent < 15 || scD.summary.livesSaved <= 0) {\n    allDistrictsPassed = false;\n    districtFails.push(d.name);\n  }\n});\n\nassert(\n  allDistrictsPassed,\n  \'Test 5: All 20 Sub-Saharan districts pass calibration & Scenario D criteria\',\n  allDistrictsPassed ? `Tested ${SUB_SAHARAN_DISTRICTS.length} districts with 100% compliance` : `Failed in: ${districtFails.join(\', \')}`\n);\n\nconsole.log(`\\n================================================================`);\nconsole.log(`\360\237\217\201 RESULT: ${passedTests}/${totalTests} Tests Passed`);\nconsole.log(\'================================================================\\n\');\n"
    }
