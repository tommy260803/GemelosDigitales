          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      const bloodDeficit = Math.max(0, (1 - params.bloodAvailabilityRate) * 2.0);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      const drugDeficit = Math.max(0, (1 - params.oxytocinMisoprostolStockRate) * 1.8);"
