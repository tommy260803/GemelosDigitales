        }
        lines {
          text: "  ): SimulationResult {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const baseParams = buildDefaultParameters(district);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const scenarioDef = SCENARIO_DEFINITIONS.find((s) => s.id === scenarioId) || SCENARIO_DEFINITIONS[0];"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    "
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    // Merge parameters with scenario overrides and any user customizations"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const params: SDParameters = {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      ...baseParams,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      ...scenarioDef.parameterOverrides,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      ...(customParams || {}),"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    };"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    // Apply proper directional constraints for interventions (e.g. moto-ambulance reduces travel time, never increases it)"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "    // Ensure interventions only IMPROVE or retain capacity (never degrade already high-performing districts)"
