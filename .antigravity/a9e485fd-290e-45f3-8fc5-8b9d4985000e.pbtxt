        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    // District-specific sensitivity modulation based on remote vs urban profile"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    if (district.avgDistanceToEmONC > 30) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      // Remote rural district: Geographic distance and SBA ratio dominate"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      s1 = [0.38, 0.16, 0.22, 0.12, 0.06, 0.04];"
