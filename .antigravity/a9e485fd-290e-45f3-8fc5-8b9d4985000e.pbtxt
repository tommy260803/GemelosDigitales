        }
        lines {
          text: "        facility_propensity = np.clip(0.3 + 0.35 * affordability + 0.2 * system_trust + 0.15 * quality_factor - 0.18 * max(0.0, (phase2_delay - 1.5) / 3.0), 0.1, 0.98)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        flow_anc_to_facility = (A / 4.5) * facility_propensity"
