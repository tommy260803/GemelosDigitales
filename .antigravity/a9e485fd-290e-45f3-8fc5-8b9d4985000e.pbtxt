    command_line: "npx tsx -e \"\nimport { SUB_SAHARAN_DISTRICTS } from \'./src/data/districts\';\n\nfunction testCalibratedODE(district, scenarioId = \'baseline\', simulationMonths = 36) {\n  const annualBirths = district.annualBirths;\n  const N_B = annualBirths / 12;\n  const baselineMMR = district.baselineMMR;\n\n  // Base parameters\n  const baseTravelTime = district.avgTravelTimeHours;\n  const baseFee = district.insuranceCoverage > 50 ? 2.5 : 18.0;\n  const baseTBA = district.traditionalBirthAttendantPrevalence / 100;\n  const baseRoadQuality = Math.max(0.2, 1 - (district.avgDistanceToEmONC / 80));\n  const baseBlood = district.bloodBankAvailability / 100;\n  const baseDrug = district.essentialDrugsAvailability / 100;\n  const baseStaff = district.skilledStaffRatio;\n  const baseInsurance = district.insuranceCoverage / 100;\n  const baseInstDelivRate = district.institutionalDeliveryRate / 100;\n  const baseANC1Rate = district.anc1Coverage / 100;\n  const baseANC4Rate = district.anc4Coverage / 100;\n\n  // Active parameter values with overrides\n  let travelTime = baseTravelTime;\n  let facilityFee = baseFee;\n  let tbaPrev = baseTBA;\n  let roadQuality = baseRoadQuality;\n  let bloodAvail = baseBlood;\n  let drugAvail = baseDrug;\n  let skilledStaff = baseStaff;\n  let insurance = baseInsurance;\n  let communityTrust = 0.75;\n\n  if (scenarioId === \'scenario_a\') {\n    travelTime = 0.9;\n    roadQuality = 0.85;\n  } else if (scenarioId === \'scenario_b\') {\n    facilityFee = 0.0;\n    insurance = 0.92;\n  } else if (scenarioId === \'scenario_c\') {\n    tbaPrev = 0.15;\n    communityTrust = 0.88;\n  } else if (scenarioId === \'scenario_d\') {\n    travelTime = 0.9;\n    roadQuality = 0.85;\n    facilityFee = 0.0;\n    insurance = 0.95;\n    tbaPrev = 0.12;\n    communityTrust = 0.92;\n    drugAvail = Math.max(0.92, baseDrug);\n    bloodAvail = Math.max(0.85, baseBlood);\n    skilledStaff = Math.max(1.8, baseStaff);\n  }\n\n  // Baseline reference values\n  const baseQuality = (baseStaff / 3.0) * 0.4 + baseBlood * 0.3 + baseDrug * 0.3;\n  const baseCompRisk = 0.15;\n  const baseReferralPropensity = Math.min(0.85, Math.max(0.20,\n    0.70 - (baseTravelTime / 12.0) - (baseTBA * 0.25) + (baseRoadQuality * 0.15)\n  ));\n\n  // Risk weighting in baseline\n  const baseHomeWeight = (1 - baseInstDelivRate) * (\n    (1 - baseReferralPropensity) * 1.0 + // unreferred home complication relative fatality weight\n    baseReferralPropensity * (0.20 + 0.40 * (baseTravelTime / 5.0)) * (1.0 - 0.5 * baseQuality) // referred emergency\n  );\n  const baseInstWeight = baseInstDelivRate * 0.12 * (1.0 - 0.7 * baseQuality);\n  const baseTotalRiskScore = (baseHomeWeight + baseInstWeight) * baseCompRisk;\n\n  // Exact scale calibration so baseline equals historical MMR\n  const targetMonthlyDeaths = N_B * (baselineMMR / 100000);\n  const calibConst = targetMonthlyDeaths / (N_B * baseTotalRiskScore);\n\n  // Time integration\n  const dt = 0.1;\n  const steps = Math.round(simulationMonths / dt);\n\n  // Initial stock values\n  const monthlyPregnancies = N_B * 1.05;\n  let S1 = monthlyPregnancies * 7.5;\n  let S2 = S1 * (baseANC1Rate * 0.75);\n  let S3 = N_B * baseInstDelivRate * (3 / 30);\n  let S4 = N_B * 1.4;\n  let S5 = N_B * baseCompRisk * (2 / 30);\n\n  let cumulativeDeaths = 0;\n  let cumulativeBirths = 0;\n  let rollingMMR = baselineMMR;\n  let currentTrust = communityTrust;\n\n  const monthlySnapshots = [];\n  let monthDeaths = 0;\n  let monthBirths = 0;\n\n  for (let s = 0; s < steps; s++) {\n    const month = Math.floor(s * dt);\n\n    // Feedback loops\n    const mmrRatio = rollingMMR / Math.max(100, baselineMMR);\n    const trustTarget = Math.max(0.4, Math.min(0.98, communityTrust * (1.15 - 0.20 * mmrRatio)));\n    currentTrust += (trustTarget - currentTrust) * 0.08 * dt;\n\n    // Relative effect modifiers vs baseline\n    const feeBenefit = (baseFee - facilityFee) / 25.0; // 0 at base, >0 if fees eliminated\n    const travelBenefit = (baseTravelTime - travelTime) / Math.max(1.0, baseTravelTime); // 0 at base, >0 if travel time reduced\n    const tbaBenefit = (baseTBA - tbaPrev); // 0 at base, >0 if TBA trained\n    const quality = Math.min(1.0, (skilledStaff / 3.0) * 0.4 + bloodAvail * 0.3 + drugAvail * 0.3);\n    const qualityBenefit = (quality - baseQuality);\n\n    // Dynamic ANC Coverage\n    const ancCoverage = Math.min(0.96, Math.max(0.15,\n      baseANC1Rate * (1.0 + 0.15 * feeBenefit + 0.10 * tbaBenefit + 0.10 * (currentTrust - 0.75))\n    ));\n\n    // Dynamic Institutional Delivery Coverage\n    const instDelivRate = Math.min(0.96, Math.max(0.15,\n      baseInstDelivRate * (1.0 + 0.40 * feeBenefit + 0.25 * travelBenefit + 0.15 * tbaBenefit + 0.15 * qualityBenefit + 0.10 * (currentTrust - 0.75))\n    ));\n\n    // Flows\n    const flow1to2 = (S1 / 3.5) * (ancCoverage / Math.max(0.1, baseANC1Rate));\n    const flow1toTerm = S1 / 7.5;\n    const flow2toTerm = S2 / 4.5;\n\n    const currentInstDeliveries = flow2toTerm * instDelivRate + flow1toTerm * (instDelivRate * 0.7);\n    const currentHomeDeliveries = flow2toTerm * (1 - instDelivRate) + flow1toTerm * (1 - instDelivRate * 0.7);\n    const currentTotalDeliveries = currentInstDeliveries + currentHomeDeliveries;\n\n    // Complications\n    const compRisk = baseCompRisk * (1.05 - 0.1 * (district.femaleSecondaryEducation / 100));\n    const homeComp = currentHomeDeliveries * compRisk;\n    const instComp = currentInstDeliveries * compRisk;\n\n    // Referral rate from home complications\n    const referralPropensity = Math.min(0.92, Math.max(0.20,\n      baseReferralPropensity + 0.35 * travelBenefit + 0.30 * tbaBenefit + 0.15 * (roadQuality - baseRoadQuality)\n    ));\n\n    const flow5to3 = homeComp * referralPropensity; // Emergency referrals to facility\n    const unreferredHomeComp = homeComp * (1 - referralPropensity);\n\n    // Deaths Calculation\n    // 1. Home unreferred deaths\n    const stepHomeDeaths = unreferredHomeComp * 1.0 * calibConst;\n    // 2. Emergency referred deaths\n    const stepReferredDeaths = flow5to3 * (0.20 + 0.40 * (travelTime / 5.0)) * (1.0 - 0.5 * quality) * calibConst;\n    // 3. Planned facility delivery deaths\n    const stepPlannedFacilityDeaths = instComp * 0.12 * (1.0 - 0.7 * quality) * calibConst;\n\n    const stepDeaths = (stepHomeDeaths + stepReferredDeaths + stepPlannedFacilityDeaths) * dt;\n    const stepBirths = currentTotalDeliveries * dt;\n\n    cumulativeDeaths += stepDeaths;\n    cumulativeBirths += stepBirths;\n    monthDeaths += stepDeaths;\n    monthBirths += stepBirths;\n\n    // ODE stock integration\n    const dS1 = (monthlyPregnancies - flow1to2 - flow1toTerm) * dt;\n    const dS2 = (flow1to2 - flow2toTerm) * dt;\n    const stayTime = 0.1; // ~3 days\n    const exit3 = S3 / stayTime;\n    const dS3 = (currentInstDeliveries + flow5to3 - exit3) * dt;\n    const dS5 = (homeComp - flow5to3 - (unreferredHomeComp / 0.15)) * dt;\n    const exit4 = S4 / 1.4;\n    const dS4 = ((currentHomeDeliveries - homeComp) + (exit3 - stepPlannedFacilityDeaths - stepReferredDeaths) - exit4) * dt;\n\n    S1 = Math.max(10, S1 + dS1);\n    S2 = Math.max(10, S2 + dS2);\n    S3 = Math.max(5, S3 + dS3);\n    S4 = Math.max(10, S4 + dS4);\n    S5 = Math.max(1, S5 + dS5);\n\n    if (s > 0 && s % Math.round(1 / dt) === 0) {\n      const monthMMR = Math.round((monthDeaths / Math.max(0.01, monthBirths)) * 100000);\n      rollingMMR = rollingMMR * 0.7 + monthMMR * 0.3;\n      monthDeaths = 0;\n      monthBirths = 0;\n    }\n  }\n\n  const finalMMR = Math.round((cumulativeDeaths / Math.max(1, cumulativeBirths)) * 100000);\n  const baselineExpectedDeaths = Math.round(cumulativeBirths * (baselineMMR / 100000));\n  const livesSaved = Math.max(0, Math.round(baselineExpectedDeaths - cumulativeDeaths));\n  const redPercent = Math.round(((baselineMMR - finalMMR) / baselineMMR) * 1000) / 10;\n\n  return {\n    scenarioId,\n    baselineMMR,\n    finalMMR,\n    redPercent,\n    livesSaved,\n    cumulativeDeaths: Math.round(cumulativeDeaths),\n    baselineExpectedDeaths\n  };\n}\n\nconsole.log(\'=== TEST ALL SCENARIOS ON GARISSA DISTRICT ===\');\n[\'baseline\', \'scenario_a\', \'scenario_b\', \'scenario_c\', \'scenario_d\'].forEach(s => {\n  const r = testCalibratedODE(SUB_SAHARAN_DISTRICTS.find(d => d.id === \'ke-garissa\'), s);\n  console.log(s.padEnd(12) + \' -> MMR: \' + String(r.finalMMR).padStart(4) + \' (Base: \' + r.baselineMMR + \') | Red%: \' + (r.redPercent + \'%\').padStart(6) + \' | Lives Saved: \' + String(r.livesSaved).padStart(4) + \' | Deaths: \' + r.cumulativeDeaths + \' / \' + r.baselineExpectedDeaths);\n});\n\nconsole.log(\'\\n=== TEST SCENARIO D ACROSS ALL 20 SUB-SAHARAN DISTRICTS ===\');\nSUB_SAHARAN_DISTRICTS.forEach(d => {\n  const rBase = testCalibratedODE(d, \'baseline\');\n  const rD = testCalibratedODE(d, \'scenario_d\');\n  console.log(d.name.padEnd(22) + \' | Base MMR: \' + String(rBase.finalMMR).padStart(4) + \' (Obs: \' + d.baselineMMR + \') | Scen D MMR: \' + String(rD.finalMMR).padStart(4) + \' | Red: \' + (rD.redPercent + \'%\').padStart(6) + \' | Lives Saved: \' + String(rD.livesSaved).padStart(5));\n});\n\""
    proposed_command_line: "npx tsx -e \"\nimport { SUB_SAHARAN_DISTRICTS } from \'./src/data/districts\';\n\nfunction testCalibratedODE(district, scenarioId = \'baseline\', simulationMonths = 36) {\n  const annualBirths = district.annualBirths;\n  const N_B = annualBirths / 12;\n  const baselineMMR = district.baselineMMR;\n\n  // Base parameters\n  const baseTravelTime = district.avgTravelTimeHours;\n  const baseFee = district.insuranceCoverage > 50 ? 2.5 : 18.0;\n  const baseTBA = district.traditionalBirthAttendantPrevalence / 100;\n  const baseRoadQuality = Math.max(0.2, 1 - (district.avgDistanceToEmONC / 80));\n  const baseBlood = district.bloodBankAvailability / 100;\n  const baseDrug = district.essentialDrugsAvailability / 100;\n  const baseStaff = district.skilledStaffRatio;\n  const baseInsurance = district.insuranceCoverage / 100;\n  const baseInstDelivRate = district.institutionalDeliveryRate / 100;\n  const baseANC1Rate = district.anc1Coverage / 100;\n  const baseANC4Rate = district.anc4Coverage / 100;\n\n  // Active parameter values with overrides\n  let travelTime = baseTravelTime;\n  let facilityFee = baseFee;\n  let tbaPrev = baseTBA;\n  let roadQuality = baseRoadQuality;\n  let bloodAvail = baseBlood;\n  let drugAvail = baseDrug;\n  let skilledStaff = baseStaff;\n  let insurance = baseInsurance;\n  let communityTrust = 0.75;\n\n  if (scenarioId === \'scenario_a\') {\n    travelTime = 0.9;\n    roadQuality = 0.85;\n  } else if (scenarioId === \'scenario_b\') {\n    facilityFee = 0.0;\n    insurance = 0.92;\n  } else if (scenarioId === \'scenario_c\') {\n    tbaPrev = 0.15;\n    communityTrust = 0.88;\n  } else if (scenarioId === \'scenario_d\') {\n    travelTime = 0.9;\n    roadQuality = 0.85;\n    facilityFee = 0.0;\n    insurance = 0.95;\n    tbaPrev = 0.12;\n    communityTrust = 0.92;\n    drugAvail = Math.max(0.92, baseDrug);\n    bloodAvail = Math.max(0.85, baseBlood);\n    skilledStaff = Math.max(1.8, baseStaff);\n  }\n\n  // Baseline reference values\n  const baseQuality = (baseStaff / 3.0) * 0.4 + baseBlood * 0.3 + baseDrug * 0.3;\n  const baseCompRisk = 0.15;\n  const baseReferralPropensity = Math.min(0.85, Math.max(0.20,\n    0.70 - (baseTravelTime / 12.0) - (baseTBA * 0.25) + (baseRoadQuality * 0.15)\n  ));\n\n  // Risk weighting in baseline\n  const baseHomeWeight = (1 - baseInstDelivRate) * (\n    (1 - baseReferralPropensity) * 1.0 + // unreferred home complication relative fatality weight\n    baseReferralPropensity * (0.20 + 0.40 * (baseTravelTime / 5.0)) * (1.0 - 0.5 * baseQuality) // referred emergency\n  );\n  const baseInstWeight = baseInstDelivRate * 0.12 * (1.0 - 0.7 * baseQuality);\n  const baseTotalRiskScore = (baseHomeWeight + baseInstWeight) * baseCompRisk;\n\n  // Exact scale calibration so baseline equals historical MMR\n  const targetMonthlyDeaths = N_B * (baselineMMR / 100000);\n  const calibConst = targetMonthlyDeaths / (N_B * baseTotalRiskScore);\n\n  // Time integration\n  const dt = 0.1;\n  const steps = Math.round(simulationMonths / dt);\n\n  // Initial stock values\n  const monthlyPregnancies = N_B * 1.05;\n  let S1 = monthlyPregnancies * 7.5;\n  let S2 = S1 * (baseANC1Rate * 0.75);\n  let S3 = N_B * baseInstDelivRate * (3 / 30);\n  let S4 = N_B * 1.4;\n  let S5 = N_B * baseCompRisk * (2 / 30);\n\n  let cumulativeDeaths = 0;\n  let cumulativeBirths = 0;\n  let rollingMMR = baselineMMR;\n  let currentTrust = communityTrust;\n\n  const monthlySnapshots = [];\n  let monthDeaths = 0;\n  let monthBirths = 0;\n\n  for (let s = 0; s < steps; s++) {\n    const month = Math.floor(s * dt);\n\n    // Feedback loops\n    const mmrRatio = rollingMMR / Math.max(100, baselineMMR);\n    const trustTarget = Math.max(0.4, Math.min(0.98, communityTrust * (1.15 - 0.20 * mmrRatio)));\n    currentTrust += (trustTarget - currentTrust) * 0.08 * dt;\n\n    // Relative effect modifiers vs baseline\n    const feeBenefit = (baseFee - facilityFee) / 25.0; // 0 at base, >0 if fees eliminated\n    const travelBenefit = (baseTravelTime - travelTime) / Math.max(1.0, baseTravelTime); // 0 at base, >0 if travel time reduced\n    const tbaBenefit = (baseTBA - tbaPrev); // 0 at base, >0 if TBA trained\n    const quality = Math.min(1.0, (skilledStaff / 3.0) * 0.4 + bloodAvail * 0.3 + drugAvail * 0.3);\n    const qualityBenefit = (quality - baseQuality);\n\n    // Dynamic ANC Coverage\n    const ancCoverage = Math.min(0.96, Math.max(0.15,\n      baseANC1Rate * (1.0 + 0.15 * feeBenefit + 0.10 * tbaBenefit + 0.10 * (currentTrust - 0.75))\n    ));\n\n    // Dynamic Institutional Delivery Coverage\n    const instDelivRate = Math.min(0.96, Math.max(0.15,\n      baseInstDelivRate * (1.0 + 0.40 * feeBenefit + 0.25 * travelBenefit + 0.15 * tbaBenefit + 0.15 * qualityBenefit + 0.10 * (currentTrust - 0.75))\n    ));\n\n    // Flows\n    const flow1to2 = (S1 / 3.5) * (ancCoverage / Math.max(0.1, baseANC1Rate));\n    const flow1toTerm = S1 / 7.5;\n    const flow2toTerm = S2 / 4.5;\n\n    const currentInstDeliveries = flow2toTerm * instDelivRate + flow1toTerm * (instDelivRate * 0.7);\n    const currentHomeDeliveries = flow2toTerm * (1 - instDelivRate) + flow1toTerm * (1 - instDelivRate * 0.7);\n    const currentTotalDeliveries = currentInstDeliveries + currentHomeDeliveries;\n\n    // Complications\n    const compRisk = baseCompRisk * (1.05 - 0.1 * (district.femaleSecondaryEducation / 100));\n    const homeComp = currentHomeDeliveries * compRisk;\n    const instComp = currentInstDeliveries * compRisk;\n\n    // Referral rate from home complications\n    const referralPropensity = Math.min(0.92, Math.max(0.20,\n      baseReferralPropensity + 0.35 * travelBenefit + 0.30 * tbaBenefit + 0.15 * (roadQuality - baseRoadQuality)\n    ));\n\n    const flow5to3 = homeComp * referralPropensity; // Emergency referrals to facility\n    const unreferredHomeComp = homeComp * (1 - referralPropensity);\n\n    // Deaths Calculation\n    // 1. Home unreferred deaths\n    const stepHomeDeaths = unreferredHomeComp * 1.0 * calibConst;\n    // 2. Emergency referred deaths\n    const stepReferredDeaths = flow5to3 * (0.20 + 0.40 * (travelTime / 5.0)) * (1.0 - 0.5 * quality) * calibConst;\n    // 3. Planned facility delivery deaths\n    const stepPlannedFacilityDeaths = instComp * 0.12 * (1.0 - 0.7 * quality) * calibConst;\n\n    const stepDeaths = (stepHomeDeaths + stepReferredDeaths + stepPlannedFacilityDeaths) * dt;\n    const stepBirths = currentTotalDeliveries * dt;\n\n    cumulativeDeaths += stepDeaths;\n    cumulativeBirths += stepBirths;\n    monthDeaths += stepDeaths;\n    monthBirths += stepBirths;\n\n    // ODE stock integration\n    const dS1 = (monthlyPregnancies - flow1to2 - flow1toTerm) * dt;\n    const dS2 = (flow1to2 - flow2toTerm) * dt;\n    const stayTime = 0.1; // ~3 days\n    const exit3 = S3 / stayTime;\n    const dS3 = (currentInstDeliveries + flow5to3 - exit3) * dt;\n    const dS5 = (homeComp - flow5to3 - (unreferredHomeComp / 0.15)) * dt;\n    const exit4 = S4 / 1.4;\n    const dS4 = ((currentHomeDeliveries - homeComp) + (exit3 - stepPlannedFacilityDeaths - stepReferredDeaths) - exit4) * dt;\n\n    S1 = Math.max(10, S1 + dS1);\n    S2 = Math.max(10, S2 + dS2);\n    S3 = Math.max(5, S3 + dS3);\n    S4 = Math.max(10, S4 + dS4);\n    S5 = Math.max(1, S5 + dS5);\n\n    if (s > 0 && s % Math.round(1 / dt) === 0) {\n      const monthMMR = Math.round((monthDeaths / Math.max(0.01, monthBirths)) * 100000);\n      rollingMMR = rollingMMR * 0.7 + monthMMR * 0.3;\n      monthDeaths = 0;\n      monthBirths = 0;\n    }\n  }\n\n  const finalMMR = Math.round((cumulativeDeaths / Math.max(1, cumulativeBirths)) * 100000);\n  const baselineExpectedDeaths = Math.round(cumulativeBirths * (baselineMMR / 100000));\n  const livesSaved = Math.max(0, Math.round(baselineExpectedDeaths - cumulativeDeaths));\n  const redPercent = Math.round(((baselineMMR - finalMMR) / baselineMMR) * 1000) / 10;\n\n  return {\n    scenarioId,\n    baselineMMR,\n    finalMMR,\n    redPercent,\n    livesSaved,\n    cumulativeDeaths: Math.round(cumulativeDeaths),\n    baselineExpectedDeaths\n  };\n}\n\nconsole.log(\'=== TEST ALL SCENARIOS ON GARISSA DISTRICT ===\');\n[\'baseline\', \'scenario_a\', \'scenario_b\', \'scenario_c\', \'scenario_d\'].forEach(s => {\n  const r = testCalibratedODE(SUB_SAHARAN_DISTRICTS.find(d => d.id === \'ke-garissa\'), s);\n  console.log(s.padEnd(12) + \' -> MMR: \' + String(r.finalMMR).padStart(4) + \' (Base: \' + r.baselineMMR + \') | Red%: \' + (r.redPercent + \'%\').padStart(6) + \' | Lives Saved: \' + String(r.livesSaved).padStart(4) + \' | Deaths: \' + r.cumulativeDeaths + \' / \' + r.baselineExpectedDeaths);\n});\n\nconsole.log(\'\\n=== TEST SCENARIO D ACROSS ALL 20 SUB-SAHARAN DISTRICTS ===\');\nSUB_SAHARAN_DISTRICTS.forEach(d => {\n  const rBase = testCalibratedODE(d, \'baseline\');\n  const rD = testCalibratedODE(d, \'scenario_d\');\n  console.log(d.name.padEnd(22) + \' | Base MMR: \' + String(rBase.finalMMR).padStart(4) + \' (Obs: \' + d.baselineMMR + \') | Scen D MMR: \' + String(rD.finalMMR).padStart(4) + \' | Red: \' + (rD.redPercent + \'%\').padStart(6) + \' | Lives Saved: \' + String(rD.livesSaved).padStart(5));\n});\n\""
