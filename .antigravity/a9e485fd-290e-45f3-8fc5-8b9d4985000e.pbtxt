      end_line: 547
      unified_diff {
        lines {
          text: "import React, { useState, useMemo } from \'react\';"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "import { "
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
