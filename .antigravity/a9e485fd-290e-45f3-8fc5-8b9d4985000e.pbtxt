        }
        lines {
          text: "      st = [0.21, 0.12, 0.44, 0.34, 0.14, 0.09];"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    } else {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      // Mixed rural-periurban: Balanced drivers"
