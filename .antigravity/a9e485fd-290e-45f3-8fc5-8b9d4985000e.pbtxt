          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    district: DistrictData,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    scenarioId: \'baseline\' | \'scenario_a\' | \'scenario_b\' | \'scenario_c\' | \'scenario_d\' = \'baseline\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    customParams?: Partial<SDParameters>,"
