    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "    // Wealth Quintile Disaggregation\n    const quintiles = [\n      { key: \'q1_poorest\', label: \'Q1 (Poorest)\', share: 0.20, base: district.wealthQuintileMMR.q1_poorest, weight: 1.45 },\n      { key: \'q2_poor\', label: \'Q2 (Poor)\', share: 0.20, base: district.wealthQuintileMMR.q2_poor, weight: 1.22 },\n      { key: \'q3_middle\', label: \'Q3 (Middle)\', share: 0.20, base: district.wealthQuintileMMR.q3_middle, weight: 0.98 },\n      { key: \'q4_richer\', label: \'Q4 (Richer)\', share: 0.20, base: district.wealthQuintileMMR.q4_richer, weight: 0.78 },\n      { key: \'q5_richest\', label: \'Q5 (Richest)\', share: 0.20, base: district.wealthQuintileMMR.q5_richest, weight: 0.57 },\n    ];\n\n    const equityDisaggregation = quintiles.map((q) => {\n      // Free fees and TBA training benefit poorest quintiles disproportionately\n      let equityMultiplier = 1.0;\n      if (scenarioId === \'scenario_b\' || scenarioId === \'scenario_d\') {\n        equityMultiplier = q.key === \'q1_poorest\' ? 1.48 : q.key === \'q2_poor\' ? 1.32 : 0.85;\n      } else if (scenarioId === \'scenario_a\') {\n        equityMultiplier = (q.key === \'q1_poorest\' || q.key === \'q2_poor\') ? 1.35 : 0.95;\n      }\n\n      const qReduction = Math.min(0.85, (mmrReductionPercent / 100) * equityMultiplier);\n      const simulatedMMR = Math.max(60, Math.round(q.base * (1 - qReduction)));\n      const birthsInQ = cumulativeBirths * q.share;\n      const livesSavedInQ = Math.max(0, Math.round((birthInQDeaths(q.base, birthsInQ) - birthInQDeaths(simulatedMMR, birthsInQ))));\n\n      return {\n        quintile: q.key,\n        label: q.label,\n        populationShare: q.share,\n        baselineMMR: q.base,\n        simulatedMMR,\n        livesSaved: livesSavedInQ,\n        relativeReduction: Math.round(qReduction * 1000) / 10,\n        absoluteReduction: q.base - simulatedMMR,\n      };\n    });"
      replacement_content: "    // Wealth Quintile Disaggregation\n    const wq = district.wealthQuintileMMR || district.wealthQuintilesMMR || {\n      q1_poorest: Math.round(district.baselineMMR * 1.38),\n      q2_poor: Math.round(district.baselineMMR * 1.18),\n      q3_middle: Math.round(district.baselineMMR * 0.95),\n      q4_richer: Math.round(district.baselineMMR * 0.76),\n      q5_richest: Math.round(district.baselineMMR * 0.53),\n    };\n\n    const quintiles = [\n      { key: \'Q1\', id: \'q1_poorest\', label: \'Poorest 20%\', share: 0.20, base: wq.q1_poorest ?? Math.round(district.baselineMMR * 1.38), weight: 1.45 },\n      { key: \'Q2\', id: \'q2_poor\', label: \'Poor\', share: 0.20, base: wq.q2_poor ?? Math.round(district.baselineMMR * 1.18), weight: 1.22 },\n      { key: \'Q3\', id: \'q3_middle\', label: \'Middle\', share: 0.20, base: wq.q3_middle ?? Math.round(district.baselineMMR * 0.95), weight: 0.98 },\n      { key: \'Q4\', id: \'q4_richer\', label: \'Richer\', share: 0.20, base: wq.q4_richer ?? Math.round(district.baselineMMR * 0.76), weight: 0.78 },\n      { key: \'Q5\', id: \'q5_richest\', label: \'Richest 20%\', share: 0.20, base: wq.q5_richest ?? Math.round(district.baselineMMR * 0.53), weight: 0.57 },\n    ];\n\n    const equityDisaggregation = quintiles.map((q) => {\n      // Free fees and TBA training benefit poorest quintiles disproportionately\n      let equityMultiplier = 1.0;\n      if (scenarioId === \'scenario_b\' || scenarioId === \'scenario_d\') {\n        equityMultiplier = q.key === \'Q1\' ? 1.48 : q.key === \'Q2\' ? 1.32 : 0.85;\n      } else if (scenarioId === \'scenario_a\') {\n        equityMultiplier = (q.key === \'Q1\' || q.key === \'Q2\') ? 1.35 : 0.95;\n      }\n\n      const qReduction = Math.min(0.85, (mmrReductionPercent / 100) * equityMultiplier);\n      const simulatedMMR = Math.max(60, Math.round(q.base * (1 - qReduction)));\n      const birthsInQ = cumulativeBirths * q.share;\n      const livesSavedInQ = Math.max(0, Math.round((birthInQDeaths(q.base, birthsInQ) - birthInQDeaths(simulatedMMR, birthsInQ))));\n\n      return {\n        quintile: q.key,\n        label: q.label,\n        populationShare: q.share,\n        baselineMMR: q.base,\n        simulatedMMR,\n        livesSaved: livesSavedInQ,\n        relativeReduction: Math.round(qReduction * 1000) / 10,\n        absoluteReduction: q.base - simulatedMMR,\n      };\n    });"
    }
