        }
        lines {
          text: "      params.travelTimeHours = Math.min(baseParams.travelTimeHours * 0.28, customParams?.travelTimeHours ?? 0.9);"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "      params.travelTimeHours = Math.min(baseParams.travelTimeHours * 0.28, customParams?.travelTimeHours ?? Math.min(0.9, baseParams.travelTimeHours * 0.5));"
