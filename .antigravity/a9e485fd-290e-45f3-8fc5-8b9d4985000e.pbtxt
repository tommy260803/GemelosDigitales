        }
        lines {
          text: "      q2_poor: Math.round(district.baselineMMR * 1.18),"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      q3_middle: Math.round(district.baselineMMR * 0.95),"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      q4_richer: Math.round(district.baselineMMR * 0.76),"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      q5_richest: Math.round(district.baselineMMR * 0.53),"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    };"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const quintiles = ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      { key: \'Q1\', id: \'q1_poorest\', label: \'Poorest 20%\', share: 0.20, base: wq.q1_poorest ?? Math.round(district.baselineMMR * 1.38), weight: 1.45 },"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
