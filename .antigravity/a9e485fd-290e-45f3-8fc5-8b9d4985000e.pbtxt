        target_content: "    <div className=\"min-h-screen bg-slate-950 text-slate-100 font-sans selection:bg-teal-500 selection:text-slate-950 flex flex-col justify-between\">\n      \n      {/* Navigation Header */}\n      <div>\n        <Navbar\n          currentTab={currentTab}\n          onTabChange={setCurrentTab}\n          selectedDistrict={selectedDistrict}\n          onDistrictChange={setSelectedDistrict}\n          onOpenCopilot={() => setIsCopilotOpen(true)}\n          onExportPDF={handleExportPDF}\n          onExportExcel={handleExportExcel}\n        />\n\n        {/* Main View Container */}\n        <main className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6\">\n          {currentTab === \'dashboard\' && (\n            <DashboardView\n              district={selectedDistrict}\n              activeScenarioId={activeScenarioId}\n              onScenarioChange={setActiveScenarioId}\n              onOpenCopilot={() => setIsCopilotOpen(true)}\n            />\n          )}\n\n          {currentTab === \'causal-model\' && (\n            <CausalLoopView district={selectedDistrict} />\n          )}\n\n          {currentTab === \'scenarios\' && (\n            <ScenariosView\n              district={selectedDistrict}\n              activeScenarioId={activeScenarioId}\n              onSelectScenario={setActiveScenarioId}\n            />\n          )}\n\n          {currentTab === \'equity\' && (\n            <EquityView\n              district={selectedDistrict}\n              activeScenarioId={activeScenarioId}\n            />\n          )}\n\n          {currentTab === \'validation\' && (\n            <ValidationView district={selectedDistrict} />\n          )}\n\n          {currentTab === \'reports\' && (\n            <ReportsView\n              district={selectedDistrict}\n              activeScenarioId={activeScenarioId}\n            />\n          )}\n\n          {currentTab === \'code-arch\' && (\n            <CodeArchitectureView />\n          )}\n        </main>\n      </div>\n\n      {/* Persistent Footer with Scientific Disclosures */}\n      <footer className=\"bg-slate-900/60 border-t border-slate-800/80 py-4 mt-8\">\n        <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-400 gap-2\">\n          <div className=\"flex items-center space-x-2\">\n            <span className=\"font-semibold text-slate-300\">Maternal Health SD Digital Twin</span>\n            <span>\342\200\242</span>\n            <span>Study Protocol & Retrospective Validation (5 SSA Countries, 25 Districts)</span>\n          </div>\n          <div>\n            <span>No Individual PII Stored | Aggregated District Level Data (DHS / DHIS2)</span>\n          </div>\n        </div>\n      </footer>\n\n      {/* AI Epidemiologist Copilot Modal */}\n      <AICopilotModal\n        isOpen={isCopilotOpen}\n        onClose={() => setIsCopilotOpen(false)}\n        selectedDistrict={selectedDistrict}\n        activeScenarioId={activeScenarioId}\n      />\n\n    </div>"
        replacement_content: "    <div className=\"min-h-screen bg-[#0c0e12] text-slate-200 font-sans selection:bg-sky-500 selection:text-slate-950 flex flex-col justify-between\">\n      \n      {/* Navigation Header */}\n      <div>\n        <Navbar\n          currentTab={currentTab}\n          onTabChange={setCurrentTab}\n          selectedDistrict={selectedDistrict}\n          onDistrictChange={setSelectedDistrict}\n          onOpenCopilot={() => setIsCopilotOpen(true)}\n          onExportPDF={handleExportPDF}\n          onExportExcel={handleExportExcel}\n        />\n\n        {/* Main View Container */}\n        <main className=\"max-w-7xl mx-auto px-3 sm:px-4 lg:px-6 py-4\">\n          {currentTab === \'dashboard\' && (\n            <DashboardView\n              district={selectedDistrict}\n              activeScenarioId={activeScenarioId}\n              onScenarioChange={setActiveScenarioId}\n              onOpenCopilot={() => setIsCopilotOpen(true)}\n            />\n          )}\n\n          {currentTab === \'causal-model\' && (\n            <CausalLoopView district={selectedDistrict} />\n          )}\n\n          {currentTab === \'scenarios\' && (\n            <ScenariosView\n              district={selectedDistrict}\n              activeScenarioId={activeScenarioId}\n              onSelectScenario={setActiveScenarioId}\n            />\n          )}\n\n          {currentTab === \'equity\' && (\n            <EquityView\n              district={selectedDistrict}\n              activeScenarioId={activeScenarioId}\n            />\n          )}\n\n          {currentTab === \'validation\' && (\n            <ValidationView district={selectedDistrict} />\n          )}\n\n          {currentTab === \'reports\' && (\n            <ReportsView\n              district={selectedDistrict}\n              activeScenarioId={activeScenarioId}\n            />\n          )}\n\n          {currentTab === \'code-arch\' && (\n            <CodeArchitectureView />\n          )}\n        </main>\n      </div>\n\n      {/* Persistent High Density Footer with Telemetry Disclosures */}\n      <footer className=\"bg-[#0c0e12] border-t border-slate-800 py-3 mt-6\">\n        <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between text-[11px] text-slate-500 font-mono gap-2\">\n          <div className=\"flex items-center space-x-3\">\n            <span className=\"flex items-center gap-1.5 text-slate-400 font-bold\">\n              <span className=\"w-2 h-2 rounded-full bg-emerald-500 animate-pulse\"></span>\n              MATERNALTWIN AI ENGINE\n            </span>\n            <span className=\"text-slate-700\">|</span>\n            <span>SYSTEM DYNAMICS PROTOCOL V4.2</span>\n            <span className=\"text-slate-700\">|</span>\n            <span className=\"text-sky-400\">CALIBRATION R\302\262 = 0.938</span>\n          </div>\n          <div className=\"flex items-center space-x-3 text-[10px] text-slate-500\">\n            <span>25 SSA DISTRICTS VALIDATED</span>\n            <span className=\"text-slate-700\">\342\200\242</span>\n            <span>DHS &amp; DHIS2 AGGREGATE TELEMETRY (NO PII)</span>\n          </div>\n        </div>\n      </footer>\n\n      {/* AI Epidemiologist Copilot Modal */}\n      <AICopilotModal\n        isOpen={isCopilotOpen}\n        onClose={() => setIsCopilotOpen(false)}\n        selectedDistrict={selectedDistrict}\n        activeScenarioId={activeScenarioId}\n      />\n\n    </div>"
