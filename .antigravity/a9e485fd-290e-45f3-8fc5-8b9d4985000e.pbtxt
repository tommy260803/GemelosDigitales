          text: "    };"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    handleResize();"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    window.addEventListener(\'resize\', handleResize);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    return () => window.removeEventListener(\'resize\', handleResize);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
