        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        // Base altitude"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        let h = topo.baseAltitude;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        // Primary topographic trend (mountain massifs, rift escarpments, river valleys)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        // 1. Regional gradient slope"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        h += (u - 0.5) * topo.eastWestGradient + (v - 0.5) * topo.northSouthGradient;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        // 2. High-amplitude terrain features (mountains, ridge lines, escarpments)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        if (topo.ridgeFeature) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          const distToRidge = Math.abs((u - topo.ridgeFeature.uCenter) * Math.cos(topo.ridgeFeature.angle) + (v - topo.ridgeFeature.vCenter) * Math.sin(topo.ridgeFeature.angle));"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          const ridgeFactor = Math.exp(-Math.pow(distToRidge / topo.ridgeFeature.width, 2));"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          h += ridgeFactor * topo.ridgeFeature.height;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        // 3. Valley / River gorges (e.g. Omo Valley, Rift floor, Tana River basin)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        if (topo.valleyFeature) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          const distToValley = Math.abs((u - topo.valleyFeature.uCenter) * Math.cos(topo.valleyFeature.angle) + (v - topo.valleyFeature.vCenter) * Math.sin(topo.valleyFeature.angle));"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          const valleyFactor = Math.exp(-Math.pow(distToValley / topo.valleyFeature.width, 2));"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          h -= valleyFactor * topo.valleyFeature.depth;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        // 4. Multi-octave natural terrain noise (SRTM roughness)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        const n1 = Math.sin(u * 6.28 * 2.1 + topo.noiseSeed) * Math.cos(v * 6.28 * 2.1 + topo.noiseSeed * 0.7);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        const n2 = Math.sin(u * 6.28 * 5.4 + topo.noiseSeed * 1.3) * Math.cos(v * 6.28 * 4.8 + topo.noiseSeed * 1.9) * 0.45;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        const n3 = Math.sin(u * 6.28 * 11.2) * Math.cos(v * 6.28 * 9.7) * 0.2;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        h += (n1 + n2 + n3) * topo.roughnessScale;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        // Clamp minimum realistic sea level or continental plateau height"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        h = Math.max(topo.minFloorAltitude, Math.round(h));"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        if (h < minAlt) minAlt = h;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        if (h > maxAlt) maxAlt = h;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        rowElev.push(h);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      elevations.push(rowElev);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // Calculate slope percentages and barrier cells"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const cellDistMeters = (50000 / gridSize); // ~1380m per cell"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    for (let r = 0; r < gridSize; r++) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const rowSlope: number[] = [];"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const rowBarrier: boolean[] = [];"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      for (let c = 0; c < gridSize; c++) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        const h = elevations[r][c];"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        const hRight = c < gridSize - 1 ? elevations[r][c + 1] : h;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        const hLeft = c > 0 ? elevations[r][c - 1] : h;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        const hDown = r < gridSize - 1 ? elevations[r + 1][c] : h;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        const hUp = r > 0 ? elevations[r - 1][c] : h;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        const dz_dx = (hRight - hLeft) / (2 * cellDistMeters);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        const dz_dy = (hDown - hUp) / (2 * cellDistMeters);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        const gradient = Math.sqrt(dz_dx * dz_dx + dz_dy * dz_dy);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        const slopePercent = Math.round(gradient * 100 * 10) / 10;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        rowSlope.push(slopePercent);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        // A barrier cell is defined as slope > 15% (steep impassable escarpment for standard vehicles)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        rowBarrier.push(slopePercent > 15.0);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      slopes.push(rowSlope);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      isBarrier.push(rowBarrier);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    return {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      districtId: district.id,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      gridSize,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      bounds: { minLat, maxLat, minLng, maxLng },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      minAltitude: minAlt,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      maxAltitude: maxAlt,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      elevations,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      slopes,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      isBarrier,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    };"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
