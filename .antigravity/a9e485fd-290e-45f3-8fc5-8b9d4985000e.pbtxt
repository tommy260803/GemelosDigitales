        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      // Phase 2 (Geographic transit hours) & Phase 3 (Intra-hospital definitive care delay hours)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      const phase2Delay = Math.max("
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        0.4,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        params.travelTimeHours * (1.5 - 0.5 * params.roadQualityIndex) +"
