        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    // Initial Stock Conditions"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    let pregnantWomen = monthlyPregnancies * 7.5; // ~7.5 months average pregnant stock (S1)"
