    instruction: "Internationalize ScenariosView using useLanguage"
    replacement_infos {
      original_chunk {
        target_content: "import React, { useMemo } from \'react\';\nimport { \n  Layers, \n  TrendingDown, \n  DollarSign, \n  HeartHandshake, \n  CheckCircle2, \n  Zap, \n  ShieldCheck, \n  Award,\n  ArrowUpRight\n} from \'lucide-react\';\nimport { DistrictData, SimulationResult } from \'../types\';\nimport { SystemDynamicsEngine, SCENARIO_DEFINITIONS } from \'../services/systemDynamics\';\n\ninterface ScenariosViewProps {\n  district: DistrictData;\n  activeScenarioId: \'baseline\' | \'scenario_a\' | \'scenario_b\' | \'scenario_c\' | \'scenario_d\';\n  onSelectScenario: (id: \'baseline\' | \'scenario_a\' | \'scenario_b\' | \'scenario_c\' | \'scenario_d\') => void;\n}\n\nexport const ScenariosView: React.FC<ScenariosViewProps> = ({\n  district,\n  activeScenarioId,\n  onSelectScenario,\n}) => {\n  // Compute simulation for all scenarios simultaneously\n  const allResults: Record<string, SimulationResult> = useMemo(() => {\n    const results: Record<string, SimulationResult> = {};\n    SCENARIO_DEFINITIONS.forEach((s) => {\n      results[s.id] = SystemDynamicsEngine.simulate(district, s.id, {}, 36);\n    });\n    return results;\n  }, [district]);\n\n  const maxLivesSaved = Math.max(...Object.values(allResults).map((r) => r.summary.livesSaved), 1);\n\n  return (\n    <div className=\"space-y-4\">\n      \n      {/* Header */}\n      <div className=\"bg-slate-900/50 border border-slate-800 rounded-lg p-3.5 shadow-sm\">\n        <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n          <div>\n            <div className=\"flex items-center space-x-2\">\n              <span className=\"px-2 py-0.5 text-[10px] font-mono font-bold rounded bg-sky-500/20 text-sky-300 border border-sky-500/30 uppercase tracking-wider\">\n                SCENARIO COMPARISON MATRIX\n              </span>\n              <h2 className=\"text-xs font-bold text-white uppercase tracking-tight\">\n                Policy Interventions &amp; Cost-Effectiveness Evaluation (36-Month Horizon)\n              </h2>\n            </div>\n            <p className=\"text-[11px] text-slate-400 font-mono mt-0.5\">\n              Comparative analysis for {district.name} ({district.country}) across single and combined intervention packages.\n            </p>\n          </div>\n        </div>\n      </div>\n\n      {/* Scenario Cards Grid */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-3\">\n        {SCENARIO_DEFINITIONS.filter((s) => s.id !== \'baseline\').map((s) => {\n          const res = allResults[s.id];\n          const isSelected = activeScenarioId === s.id;\n          const isCombined = s.id === \'scenario_d\';\n\n          return (\n            <div\n              key={s.id}\n              onClick={() => onSelectScenario(s.id)}\n              className={`p-3.5 rounded-lg border transition cursor-pointer flex flex-col justify-between ${\n                isCombined\n                  ? \'bg-sky-950/20 border-sky-500/40 shadow-sm ring-1 ring-sky-500/20\'\n                  : \'bg-slate-900/50 border-slate-800 hover:border-slate-700\'\n              } ${isSelected ? \'ring-2 ring-sky-400 bg-sky-900/10\' : \'\'}`}\n            >\n              <div>\n                <div className=\"flex items-center justify-between mb-2\">\n                  <span className={`text-[10px] font-mono font-bold px-2 py-0.5 rounded ${\n                    isCombined ? \'bg-sky-600 text-white shadow-sm\' : \'bg-[#0c0e12] text-sky-400 border border-slate-800\'\n                  }`}>\n                    Scenario ({s.letter})\n                  </span>\n                  {isCombined && (\n                    <span className=\"text-[9px] px-1.5 py-0.5 rounded bg-amber-500/20 text-amber-300 font-mono font-bold border border-amber-500/30 flex items-center\">\n                      <Award className=\"w-3 h-3 mr-0.5\" /> High Impact\n                    </span>\n                  )}\n                </div>\n\n                <h3 className=\"text-xs font-bold text-white mb-1 uppercase tracking-tight\">{s.name.split(\'(\')[0].trim()}</h3>\n                <p className=\"text-[11px] text-slate-400 line-clamp-2 mb-2.5\">{s.description}</p>\n\n                {/* Core Result Stats */}\n                <div className=\"space-y-1.5 text-xs pt-2 border-t border-slate-800 font-mono\">\n                  <div className=\"flex justify-between\">\n                    <span className=\"text-slate-500 text-[11px]\">Lives Saved:</span>\n                    <span className=\"font-bold text-sky-400 text-xs\">\n                      {res.summary.livesSaved} <span className=\"text-[9px] text-slate-500\">[{res.summary.livesSavedCI95[0]}-{res.summary.livesSavedCI95[1]}]</span>\n                    </span>\n                  </div>\n                  <div className=\"flex justify-between\">\n                    <span className=\"text-slate-500 text-[11px]\">MMR Reduction:</span>\n                    <span className=\"font-bold text-emerald-400 text-xs\">-{res.summary.mmrReductionPercent}%</span>\n                  </div>\n                  <div className=\"flex justify-between\">\n                    <span className=\"text-slate-500 text-[11px]\">Cost / Life:</span>\n                    <span className=\"font-bold text-slate-200 text-xs\">${res.summary.costPerLifeSavedUSD.toLocaleString()}</span>\n                  </div>\n                  <div className=\"flex justify-between\">\n                    <span className=\"text-slate-500 text-[11px]\">ICER ($/DALY):</span>\n                    <span className=\"font-bold text-cyan-400 text-xs\">${res.summary.icerPerDALY} / DALY</span>\n                  </div>\n                </div>\n              </div>\n\n              <button\n                className={`w-full mt-3 py-1.5 rounded text-xs font-mono font-bold uppercase flex items-center justify-center space-x-1 transition cursor-pointer ${\n                  isSelected ? \'bg-sky-600 text-white shadow-md shadow-sky-900/30\' : \'bg-slate-800 text-slate-300 hover:bg-slate-700\'\n                }`}\n              >\n                <span>{isSelected ? \'Active Scenario\' : \'Select Scenario\'}</span>\n                <ArrowUpRight className=\"w-3.5 h-3.5\" />\n              </button>\n            </div>\n          );\n        })}\n      </div>\n\n      {/* Comparative Full Table */}\n      <div className=\"bg-slate-900/50 border border-slate-800 rounded-lg p-4 shadow-sm space-y-3\">\n        <h3 className=\"text-xs font-bold text-white uppercase tracking-wider\">Full Cross-Scenario Cost-Effectiveness Matrix</h3>\n\n        <div className=\"overflow-x-auto\">\n          <table className=\"w-full text-left text-xs border-collapse font-mono\">\n            <thead>\n              <tr className=\"border-b border-slate-800 bg-[#0c0e12] text-slate-500 text-[10px] uppercase font-bold\">\n                <th className=\"p-2.5\">Scenario</th>\n                <th className=\"p-2.5\">Intervention Mechanism</th>\n                <th className=\"p-2.5\">Lives Saved (95% CI)</th>\n                <th className=\"p-2.5\">Final MMR</th>\n                <th className=\"p-2.5\">MMR Red. %</th>\n                <th className=\"p-2.5\">Total Cost (USD)</th>\n                <th className=\"p-2.5\">Cost / Life</th>\n                <th className=\"p-2.5\">ICER ($/DALY)</th>\n                <th className=\"p-2.5\">WHO Threshold</th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-slate-800/60\">\n              {SCENARIO_DEFINITIONS.map((s) => {\n                const res = allResults[s.id];\n                const isSelected = activeScenarioId === s.id;\n\n                return (\n                  <tr\n                    key={s.id}\n                    onClick={() => onSelectScenario(s.id)}\n                    className={`cursor-pointer transition ${\n                      isSelected ? \'bg-sky-950/30 text-white\' : \'hover:bg-slate-800/40 text-slate-300\'\n                    }`}\n                  >\n                    <td className=\"p-2.5 font-bold\">\n                      <div className=\"flex items-center space-x-1.5\">\n                        <span className={`w-1.5 h-1.5 rounded-full ${isSelected ? \'bg-sky-400\' : \'bg-slate-600\'}`} />\n                        <span>({s.letter}) {s.name.split(\'(\')[0]}</span>\n                      </div>\n                    </td>\n                    <td className=\"p-2.5 text-slate-400 font-sans text-xs\">{s.description.slice(0, 48)}...</td>\n                    <td className=\"p-2.5 font-bold text-sky-400\">\n                      {res.summary.livesSaved} <span className=\"text-[9px] text-slate-500\">[{res.summary.livesSavedCI95[0]}-{res.summary.livesSavedCI95[1]}]</span>\n                    </td>\n                    <td className=\"p-2.5 font-semibold text-slate-200\">{res.summary.mmrFinal}</td>\n                    <td className=\"p-2.5 font-bold text-emerald-400\">-{res.summary.mmrReductionPercent}%</td>\n                    <td className=\"p-2.5\">${res.summary.totalCostUSD.toLocaleString()}</td>\n                    <td className=\"p-2.5\">${res.summary.costPerLifeSavedUSD.toLocaleString()}</td>\n                    <td className=\"p-2.5 text-cyan-400 font-bold\">${res.summary.icerPerDALY}</td>\n                    <td className=\"p-2.5\">\n                      <span className=\"px-1.5 py-0.5 rounded text-[9px] font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30\">\n                        Highly Cost-Effective\n                      </span>\n                    </td>\n                  </tr>\n                );\n              })}\n            </tbody>\n          </table>\n        </div>\n\n        {/* Synergistic Impact Box */}\n        <div className=\"bg-sky-950/20 border border-sky-500/30 rounded-lg p-3 text-xs text-sky-200 space-y-1\">\n          <div className=\"flex items-center space-x-2 font-bold text-sky-300 text-[11px] uppercase\">\n            <Zap className=\"w-3.5 h-3.5 text-sky-400\" />\n            <span>Multi-Faceted Synergy in Scenario (d): Non-Linear Mortality Aversion</span>\n          </div>\n          <p className=\"text-slate-300 font-sans text-xs leading-relaxed\">\n            Implementing moto-ambulances (a), fee elimination (b), and TBA certifications (c) simultaneously produces <strong>1.48x greater lives saved</strong> than the simple sum of individual interventions due to eliminating multiple sequential bottlenecks across the Three Delays model.\n          </p>\n        </div>\n\n      </div>\n\n    </div>\n  );\n};"
        replacement_content: "import React, { useMemo } from \'react\';\nimport { \n  Award,\n  ArrowUpRight,\n  Zap\n} from \'lucide-react\';\nimport { DistrictData, SimulationResult } from \'../types\';\nimport { SystemDynamicsEngine, SCENARIO_DEFINITIONS } from \'../services/systemDynamics\';\nimport { useLanguage } from \'../i18n/translations\';\n\ninterface ScenariosViewProps {\n  district: DistrictData;\n  activeScenarioId: \'baseline\' | \'scenario_a\' | \'scenario_b\' | \'scenario_c\' | \'scenario_d\';\n  onSelectScenario: (id: \'baseline\' | \'scenario_a\' | \'scenario_b\' | \'scenario_c\' | \'scenario_d\') => void;\n}\n\nexport const ScenariosView: React.FC<ScenariosViewProps> = ({\n  district,\n  activeScenarioId,\n  onSelectScenario,\n}) => {\n  const { t, language } = useLanguage();\n\n  // Compute simulation for all scenarios simultaneously\n  const allResults: Record<string, SimulationResult> = useMemo(() => {\n    const results: Record<string, SimulationResult> = {};\n    SCENARIO_DEFINITIONS.forEach((s) => {\n      results[s.id] = SystemDynamicsEngine.simulate(district, s.id, {}, 36);\n    });\n    return results;\n  }, [district]);\n\n  // Scenario localized name helper\n  const getScenarioName = (sId: string, origName: string) => {\n    if (sId === \'baseline\') return t.baseline;\n    if (sId === \'scenario_a\') return t.scenarioAName;\n    if (sId === \'scenario_b\') return t.scenarioBName;\n    if (sId === \'scenario_c\') return t.scenarioCName;\n    if (sId === \'scenario_d\') return t.scenarioDName;\n    return origName;\n  };\n\n  const getScenarioDesc = (sId: string, origDesc: string) => {\n    if (sId === \'baseline\') return t.baselineDesc;\n    if (sId === \'scenario_a\') return t.scenarioADesc;\n    if (sId === \'scenario_b\') return t.scenarioBDesc;\n    if (sId === \'scenario_c\') return t.scenarioCDesc;\n    if (sId === \'scenario_d\') return t.scenarioDDesc;\n    return origDesc;\n  };\n\n  return (\n    <div className=\"space-y-4\">\n      \n      {/* Header */}\n      <div className=\"bg-slate-900/50 border border-slate-800 rounded-lg p-3.5 shadow-sm\">\n        <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n          <div>\n            <div className=\"flex items-center space-x-2\">\n              <span className=\"px-2 py-0.5 text-[10px] font-mono font-bold rounded bg-sky-500/20 text-sky-300 border border-sky-500/30 uppercase tracking-wider\">\n                {t.scenarioMatrixTitle}\n              </span>\n              <h2 className=\"text-xs font-bold text-white uppercase tracking-tight\">\n                {t.scenarioSubtitle} (36 {t.monthsCount})\n              </h2>\n            </div>\n            <p className=\"text-[11px] text-slate-400 font-mono mt-0.5\">\n              {language === \'es\' \n                ? `An\303\241lisis comparativo para ${district.name} (${district.country}) en paquetes de intervenci\303\263n \303\272nicos y combinados.`\n                : `Comparative analysis for ${district.name} (${district.country}) across single and combined intervention packages.`}\n            </p>\n          </div>\n        </div>\n      </div>\n\n      {/* Scenario Cards Grid */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-3\">\n        {SCENARIO_DEFINITIONS.filter((s) => s.id !== \'baseline\').map((s) => {\n          const res = allResults[s.id];\n          const isSelected = activeScenarioId === s.id;\n          const isCombined = s.id === \'scenario_d\';\n          const localizedName = getScenarioName(s.id, s.name);\n          const localizedDesc = getScenarioDesc(s.id, s.description);\n\n          return (\n            <div\n              key={s.id}\n              onClick={() => onSelectScenario(s.id)}\n              className={`p-3.5 rounded-lg border transition cursor-pointer flex flex-col justify-between ${\n                isCombined\n                  ? \'bg-sky-950/20 border-sky-500/40 shadow-sm ring-1 ring-sky-500/20\'\n                  : \'bg-slate-900/50 border-slate-800 hover:border-slate-700\'\n              } ${isSelected ? \'ring-2 ring-sky-400 bg-sky-900/10\' : \'\'}`}\n            >\n              <div>\n                <div className=\"flex items-center justify-between mb-2\">\n                  <span className={`text-[10px] font-mono font-bold px-2 py-0.5 rounded ${\n                    isCombined ? \'bg-sky-600 text-white shadow-sm\' : \'bg-[#0c0e12] text-sky-400 border border-slate-800\'\n                  }`}>\n                    {language === \'es\' ? \'Escenario\' : \'Scenario\'} ({s.letter})\n                  </span>\n                  {isCombined && (\n                    <span className=\"text-[9px] px-1.5 py-0.5 rounded bg-amber-500/20 text-amber-300 font-mono font-bold border border-amber-500/30 flex items-center\">\n                      <Award className=\"w-3 h-3 mr-0.5\" /> {language === \'es\' ? \'Alto Impacto\' : \'High Impact\'}\n                    </span>\n                  )}\n                </div>\n\n                <h3 className=\"text-xs font-bold text-white mb-1 uppercase tracking-tight\">{localizedName}</h3>\n                <p className=\"text-[11px] text-slate-400 line-clamp-2 mb-2.5\">{localizedDesc}</p>\n\n                {/* Core Result Stats */}\n                <div className=\"space-y-1.5 text-xs pt-2 border-t border-slate-800 font-mono\">\n                  <div className=\"flex justify-between\">\n                    <span className=\"text-slate-500 text-[11px]\">{language === \'es\' ? \'Vidas Salvadas:\' : \'Lives Saved:\'}</span>\n                    <span className=\"font-bold text-sky-400 text-xs\">\n                      {res.summary.livesSaved} <span className=\"text-[9px] text-slate-500\">[{res.summary.livesSavedCI95[0]}-{res.summary.livesSavedCI95[1]}]</span>\n                    </span>\n                  </div>\n                  <div className=\"flex justify-between\">\n                    <span className=\"text-slate-500 text-[11px]\">{language === \'es\' ? \'Reducci\303\263n RMM:\' : \'MMR Reduction:\'}</span>\n                    <span className=\"font-bold text-emerald-400 text-xs\">-{res.summary.mmrReductionPercent}%</span>\n                  </div>\n                  <div className=\"flex justify-between\">\n                    <span className=\"text-slate-500 text-[11px]\">{language === \'es\' ? \'Costo / Vida:\' : \'Cost / Life:\'}</span>\n                    <span className=\"font-bold text-slate-200 text-xs\">${res.summary.costPerLifeSavedUSD.toLocaleString()}</span>\n                  </div>\n                  <div className=\"flex justify-between\">\n                    <span className=\"text-slate-500 text-[11px]\">{t.icerPerDaly}:</span>\n                    <span className=\"font-bold text-cyan-400 text-xs\">${res.summary.icerPerDALY} / {language === \'es\' ? \'AVAD\' : \'DALY\'}</span>\n                  </div>\n                </div>\n              </div>\n\n              <button\n                className={`w-full mt-3 py-1.5 rounded text-xs font-mono font-bold uppercase flex items-center justify-center space-x-1 transition cursor-pointer ${\n                  isSelected ? \'bg-sky-600 text-white shadow-md shadow-sky-900/30\' : \'bg-slate-800 text-slate-300 hover:bg-slate-700\'\n                }`}\n              >\n                <span>{isSelected ? (language === \'es\' ? \'Escenario Activo\' : \'Active Scenario\') : (language === \'es\' ? \'Seleccionar Escenario\' : \'Select Scenario\')}</span>\n                <ArrowUpRight className=\"w-3.5 h-3.5\" />\n              </button>\n            </div>\n          );\n        })}\n      </div>\n\n      {/* Comparative Full Table */}\n      <div className=\"bg-slate-900/50 border border-slate-800 rounded-lg p-4 shadow-sm space-y-3\">\n        <h3 className=\"text-xs font-bold text-white uppercase tracking-wider\">\n          {language === \'es\' ? \'Matriz Completa de Costo-Efectividad Comparada\' : \'Full Cross-Scenario Cost-Effectiveness Matrix\'}\n        </h3>\n\n        <div className=\"overflow-x-auto\">\n          <table className=\"w-full text-left text-xs border-collapse font-mono\">\n            <thead>\n              <tr className=\"border-b border-slate-800 bg-[#0c0e12] text-slate-500 text-[10px] uppercase font-bold\">\n                <th className=\"p-2.5\">{language === \'es\' ? \'Escenario\' : \'Scenario\'}</th>\n                <th className=\"p-2.5\">{language === \'es\' ? \'Mecanismo de Intervenci\303\263n\' : \'Intervention Mechanism\'}</th>\n                <th className=\"p-2.5\">{language === \'es\' ? \'Vidas Salvadas (IC 95%)\' : \'Lives Saved (95% CI)\'}</th>\n                <th className=\"p-2.5\">{language === \'es\' ? \'RMM Final\' : \'Final MMR\'}</th>\n                <th className=\"p-2.5\">{language === \'es\' ? \'% Red. RMM\' : \'MMR Red. %\'}</th>\n                <th className=\"p-2.5\">{language === \'es\' ? \'Costo Total (USD)\' : \'Total Cost (USD)\'}</th>\n                <th className=\"p-2.5\">{language === \'es\' ? \'Costo / Vida\' : \'Cost / Life\'}</th>\n                <th className=\"p-2.5\">{t.icerPerDaly}</th>\n                <th className=\"p-2.5\">{language === \'es\' ? \'Umbral OMS\' : \'WHO Threshold\'}</th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-slate-800/60\">\n              {SCENARIO_DEFINITIONS.map((s) => {\n                const res = allResults[s.id];\n                const isSelected = activeScenarioId === s.id;\n                const localizedName = getScenarioName(s.id, s.name);\n                const localizedDesc = getScenarioDesc(s.id, s.description);\n\n                return (\n                  <tr\n                    key={s.id}\n                    onClick={() => onSelectScenario(s.id)}\n                    className={`cursor-pointer transition ${\n                      isSelected ? \'bg-sky-950/30 text-white\' : \'hover:bg-slate-800/40 text-slate-300\'\n                    }`}\n                  >\n                    <td className=\"p-2.5 font-bold\">\n                      <div className=\"flex items-center space-x-1.5\">\n                        <span className={`w-1.5 h-1.5 rounded-full ${isSelected ? \'bg-sky-400\' : \'bg-slate-600\'}`} />\n                        <span>({s.letter}) {localizedName}</span>\n                      </div>\n                    </td>\n                    <td className=\"p-2.5 text-slate-400 font-sans text-xs\">{localizedDesc.slice(0, 48)}...</td>\n                    <td className=\"p-2.5 font-bold text-sky-400\">\n                      {res.summary.livesSaved} <span className=\"text-[9px] text-slate-500\">[{res.summary.livesSavedCI95[0]}-{res.summary.livesSavedCI95[1]}]</span>\n                    </td>\n                    <td className=\"p-2.5 font-semibold text-slate-200\">{res.summary.mmrFinal}</td>\n                    <td className=\"p-2.5 font-bold text-emerald-400\">-{res.summary.mmrReductionPercent}%</td>\n                    <td className=\"p-2.5\">${res.summary.totalCostUSD.toLocaleString()}</td>\n                    <td className=\"p-2.5\">${res.summary.costPerLifeSavedUSD.toLocaleString()}</td>\n                    <td className=\"p-2.5 text-cyan-400 font-bold\">${res.summary.icerPerDALY}</td>\n                    <td className=\"p-2.5\">\n                      <span className=\"px-1.5 py-0.5 rounded text-[9px] font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30\">\n                        {language === \'es\' ? \'Altamente Costo-Efectivo\' : \'Highly Cost-Effective\'}\n                      </span>\n                    </td>\n                  </tr>\n                );\n              })}\n            </tbody>\n          </table>\n        </div>\n\n        {/* Synergistic Impact Box */}\n        <div className=\"bg-sky-950/20 border border-sky-500/30 rounded-lg p-3 text-xs text-sky-200 space-y-1\">\n          <div className=\"flex items-center space-x-2 font-bold text-sky-300 text-[11px] uppercase\">\n            <Zap className=\"w-3.5 h-3.5 text-sky-400\" />\n            <span>{language === \'es\' ? \'Sinergia Multifac\303\251tica en Escenario (d): Aversi\303\263n No Lineal de Mortalidad\' : \'Multi-Faceted Synergy in Scenario (d): Non-Linear Mortality Aversion\'}</span>\n          </div>\n          <p className=\"text-slate-300 font-sans text-xs leading-relaxed\">\n            {language === \'es\'\n              ? \'Implementar moto-ambulancias (a), eliminaci\303\263n de tarifas (b) y capacitaci\303\263n de parteras tradicionales (c) simult\303\241neamente genera 1.48x m\303\241s vidas salvadas que la suma simple de intervenciones individuales, al resolver cuellos de botella secuenciales del Modelo de las Tres Demoras.\'\n              : \'Implementing moto-ambulances (a), fee elimination (b), and TBA certifications (c) simultaneously produces 1.48x greater lives saved than the simple sum of individual interventions due to eliminating multiple sequential bottlenecks across the Three Delays model.\'}\n          </p>\n        </div>\n\n      </div>\n\n    </div>\n  );\n};"
      }
      num_matches: 1
    }
  }
}
