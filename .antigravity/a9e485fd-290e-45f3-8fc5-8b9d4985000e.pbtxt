        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    // First-Order indices (S1) and Total-Order indices (ST) calculated via variance of conditional expectations"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    // Calibrated against Sub-Saharan African demographic parameters"
