    replacement_chunks {
      target_content: "      {/* Top 6 High-Density KPI Cards */}\n      <div className=\"grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3\">\n        \n        {/* Baseline MMR */}\n        <div className=\"bg-slate-900/50 border border-slate-800 rounded-lg p-3 flex flex-col justify-between\">\n          <div className=\"text-[10px] text-slate-500 font-bold uppercase tracking-wider\">{t.baselineMMR}</div>\n          <div className=\"flex items-end gap-1.5 my-1\">\n            <span className=\"text-2xl font-mono font-bold text-white\">{district.baselineMMR}</span>\n          </div>\n          <div className=\"text-[9px] text-slate-600 font-mono italic\">{t.per100kLiveBirths}</div>\n        </div>\n\n        {/* Simulated MMR */}\n        <div className=\"bg-slate-900/50 border border-slate-800 rounded-lg p-3 flex flex-col justify-between\">\n          <div className=\"text-[10px] text-slate-500 font-bold uppercase tracking-wider\">{t.simulatedMMR}</div>\n          <div className=\"flex items-end gap-1.5 my-1\">\n            <span className=\"text-2xl font-mono font-bold text-emerald-400\">{simResult.summary.mmrFinal}</span>\n            <span className=\"text-[10px] text-emerald-400 mb-0.5 font-mono\">-{simResult.summary.mmrReductionPercent}%</span>\n          </div>\n          <div className=\"text-[9px] text-slate-600 font-mono italic\">{t.avertedMMR}</div>\n        </div>\n\n        {/* ANC 4+ Coverage */}\n        <div className=\"bg-slate-900/50 border border-slate-800 rounded-lg p-3 flex flex-col justify-between\">\n          <div className=\"text-[10px] text-slate-500 font-bold uppercase tracking-wider\">{t.anc4Coverage}</div>\n          <div className=\"flex items-end gap-1.5 my-1\">\n            <span className=\"text-2xl font-mono font-bold text-white\">{simResult.summary.anc4CoverageFinal}%</span>\n            <span className=\"text-[10px] text-sky-400 mb-0.5 font-mono\">+{simResult.summary.anc4CoverageFinal - district.anc4Coverage}%</span>\n          </div>\n          <div className=\"text-[9px] text-slate-600 font-mono italic\">{t.baseLabel}: {district.anc4Coverage}%</div>\n        </div>\n\n        {/* Institutional Deliveries */}\n        <div className=\"bg-slate-900/50 border border-slate-800 rounded-lg p-3 flex flex-col justify-between\">\n          <div className=\"text-[10px] text-slate-500 font-bold uppercase tracking-wider\">{t.facilityDelivery}</div>\n          <div className=\"flex items-end gap-1.5 my-1\">\n            <span className=\"text-2xl font-mono font-bold text-white\">{simResult.summary.facilityDeliveryRateFinal}%</span>\n            <span className=\"text-[10px] text-indigo-400 mb-0.5 font-mono\">+{simResult.summary.facilityDeliveryRateFinal - district.institutionalDeliveryRate}%</span>\n          </div>\n          <div className=\"text-[9px] text-slate-600 font-mono italic\">{t.baseLabel}: {district.institutionalDeliveryRate}%</div>\n        </div>\n\n        {/* Projected Lives Saved Highlight Card */}\n        <div className={`bg-slate-900/50 border rounded-lg p-3 flex flex-col justify-between ${\n          activeScenarioId === \'baseline\' ? \'border-slate-800\' : \'bg-sky-900/10 border-sky-900/30 ring-1 ring-sky-500/20\'\n        }`}>\n          <div className={`text-[10px] font-bold uppercase tracking-wider ${activeScenarioId === \'baseline\' ? \'text-slate-400\' : \'text-sky-400\'}`}>\n            {t.livesSaved}\n          </div>\n          <div className=\"flex items-end gap-1.5 my-1\">\n            <span className={`text-3xl font-mono font-bold ${activeScenarioId === \'baseline\' ? \'text-slate-400\' : \'text-sky-400\'}`}>\n              {simResult.summary.livesSaved}\n            </span>\n            {activeScenarioId === \'baseline\' && (\n              <span className=\"text-[10px] text-slate-500 font-mono mb-1\">({language === \'es\' ? \'Control\' : \'Ref\'})</span>\n            )}\n          </div>\n          <div className=\"text-[9px] text-slate-500 font-mono italic\">\n            {activeScenarioId === \'baseline\' \n              ? (language === \'es\' ? \'Escenario de control (sin cambios)\' : \'Baseline control (no intervention)\')\n              : `IC 95%: [${simResult.summary.livesSavedCI95[0]} - ${simResult.summary.livesSavedCI95[1]}]`}\n          </div>\n        </div>\n\n        {/* Cost per Life Saved */}\n        <div className=\"bg-slate-900/50 border border-slate-800 rounded-lg p-3 flex flex-col justify-between\">\n          <div className=\"text-[10px] text-slate-500 font-bold uppercase tracking-wider\">{t.costPerLife}</div>\n          <div className=\"flex items-end gap-1.5 my-1\">\n            <span className=\"text-xl font-mono font-bold text-white\">\n              {activeScenarioId === \'baseline\' ? \'\342\200\224\' : `$${simResult.summary.costPerLifeSavedUSD.toLocaleString()}`}\n            </span>\n            {activeScenarioId === \'baseline\' && (\n              <span className=\"text-[10px] text-slate-500 font-mono mb-0.5\">({language === \'es\' ? \'L\303\255nea Base\' : \'Baseline\'})</span>\n            )}\n          </div>\n          <div className=\"text-[9px] text-slate-600 font-mono italic\">\n            {activeScenarioId === \'baseline\' \n              ? `${t.icerPerDaly}: \342\200\224`\n              : `${t.icerPerDaly}: $${simResult.summary.icerPerDALY}`}\n          </div>\n        </div>\n\n      </div>"
      replacement_content: "      {/* Top 6 High-Density KPI Cards */}\n      <div className=\"grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-2.5 sm:gap-3\">\n        \n        {/* Baseline MMR */}\n        <div className=\"bg-slate-900/50 border border-slate-800 rounded-lg p-2.5 sm:p-3 flex flex-col justify-between\">\n          <div className=\"text-[10px] text-slate-500 font-bold uppercase tracking-wider\">{t.baselineMMR}</div>\n          <div className=\"flex items-end gap-1.5 my-1\">\n            <span className=\"text-xl sm:text-2xl font-mono font-bold text-white\">{district.baselineMMR}</span>\n          </div>\n          <div className=\"text-[9px] text-slate-600 font-mono italic\">{t.per100kLiveBirths}</div>\n        </div>\n\n        {/* Simulated MMR */}\n        <div className=\"bg-slate-900/50 border border-slate-800 rounded-lg p-2.5 sm:p-3 flex flex-col justify-between\">\n          <div className=\"text-[10px] text-slate-500 font-bold uppercase tracking-wider\">{t.simulatedMMR}</div>\n          <div className=\"flex items-end gap-1.5 my-1\">\n            <span className=\"text-xl sm:text-2xl font-mono font-bold text-emerald-400\">{simResult.summary.mmrFinal}</span>\n            <span className=\"text-[10px] text-emerald-400 mb-0.5 font-mono\">-{simResult.summary.mmrReductionPercent}%</span>\n          </div>\n          <div className=\"text-[9px] text-slate-600 font-mono italic\">{t.avertedMMR}</div>\n        </div>\n\n        {/* ANC 4+ Coverage */}\n        <div className=\"bg-slate-900/50 border border-slate-800 rounded-lg p-2.5 sm:p-3 flex flex-col justify-between\">\n          <div className=\"text-[10px] text-slate-500 font-bold uppercase tracking-wider\">{t.anc4Coverage}</div>\n          <div className=\"flex items-end gap-1.5 my-1\">\n            <span className=\"text-xl sm:text-2xl font-mono font-bold text-white\">{simResult.summary.anc4CoverageFinal}%</span>\n            <span className=\"text-[10px] text-sky-400 mb-0.5 font-mono\">+{simResult.summary.anc4CoverageFinal - district.anc4Coverage}%</span>\n          </div>\n          <div className=\"text-[9px] text-slate-600 font-mono italic\">{t.baseLabel}: {district.anc4Coverage}%</div>\n        </div>\n\n        {/* Institutional Deliveries */}\n        <div className=\"bg-slate-900/50 border border-slate-800 rounded-lg p-2.5 sm:p-3 flex flex-col justify-between\">\n          <div className=\"text-[10px] text-slate-500 font-bold uppercase tracking-wider\">{t.facilityDelivery}</div>\n          <div className=\"flex items-end gap-1.5 my-1\">\n            <span className=\"text-xl sm:text-2xl font-mono font-bold text-white\">{simResult.summary.facilityDeliveryRateFinal}%</span>\n            <span className=\"text-[10px] text-indigo-400 mb-0.5 font-mono\">+{simResult.summary.facilityDeliveryRateFinal - district.institutionalDeliveryRate}%</span>\n          </div>\n          <div className=\"text-[9px] text-slate-600 font-mono italic\">{t.baseLabel}: {district.institutionalDeliveryRate}%</div>\n        </div>\n\n        {/* Projected Lives Saved Highlight Card */}\n        <div className={`bg-slate-900/50 border rounded-lg p-2.5 sm:p-3 flex flex-col justify-between ${\n          activeScenarioId === \'baseline\' ? \'border-slate-800\' : \'bg-sky-900/10 border-sky-900/30 ring-1 ring-sky-500/20\'\n        }`}>\n          <div className={`text-[10px] font-bold uppercase tracking-wider ${activeScenarioId === \'baseline\' ? \'text-slate-400\' : \'text-sky-400\'}`}>\n            {t.livesSaved}\n          </div>\n          <div className=\"flex items-end gap-1.5 my-1\">\n            <span className={`text-2xl sm:text-3xl font-mono font-bold ${activeScenarioId === \'baseline\' ? \'text-slate-400\' : \'text-sky-400\'}`}>\n              {simResult.summary.livesSaved}\n            </span>\n            {activeScenarioId === \'baseline\' && (\n              <span className=\"text-[10px] text-slate-500 font-mono mb-1\">({language === \'es\' ? \'Control\' : \'Ref\'})