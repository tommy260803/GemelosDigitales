g-slate-900/50 border border-slate-800 rounded-lg flex flex-col p-4\'> <div class=\'text-[10px] font-bold text-slate-400 uppercase mb-4\'>System Dynamics Stocks</div> <div class=\'flex-1 flex flex-col gap-4 relative justify-between\'> <div class=\'flex items-center justify-between border-l-2 border-sky-500 pl-3 py-1\'> <div> <div class=\'text-xs font-bold\'>Pregnant Women</div> <div class=\'text-[10px] text-slate-500\'>Stock Level</div> </div> <div class=\'text-lg font-mono text-white\'>14,204</div> </div> <div class=\'w-full flex justify-center py-1\'><span class=\'text-slate-700 text-xs\'>\342\206\223 ANC rate</span></div> <div class=\'flex items-center justify-between border-l-2 border-emerald-500 pl-3 py-1\'> <div> <div class=\'text-xs font-bold\'>In ANC Routine</div> <div class=\'text-[10px] text-slate-500\'>Stock Level</div> </div> <div class=\'text-lg font-mono text-white\'>8,912</div> </div> <div class=\'w-full flex justify-center py-1\'><span class=\'text-slate-700 text-xs\'>\342\206\223 Delivery rate</span></div> <div class=\'flex items-center justify-between border-l-2 border-indigo-500 pl-3 py-1\'> <div> <div class=\'text-xs font-bold\'>Inst. Delivery</div> <div class=\'text-[10px] text-slate-500\'>Stock Level</div> </div> <div class=\'text-lg font-mono text-white\'>5,102</div> </div> <div class=\'w-full flex justify-center py-1\'><span class=\'text-slate-700 text-xs text-rose-500\'>\342\206\227 Risk flow</span></div> <div class=\'flex items-center justify-between border-l-2 border-rose-500 pl-3 py-1 bg-rose-500/10\'> <div> <div class=\'text-xs font-bold text-rose-400\'>Obstetric Compl.</div> <div class=\'text-[10px] text-rose-300\'>Stock Level</div> </div> <div class=\'text-lg font-mono text-white\'>412</div> </div> </div> </div> <div class=\'col-span-12 row-span-2 bg-slate-900/50 border border-slate-800 rounded-lg flex flex-col\'> <div class=\'px-4 py-2 border-b border-slate-800 flex justify-between items-center\'> <span class=\'text-[10px] font-bold t