        }
        lines {
          text: "      const baseColor = TerrainService.getHypsometricColor(q.alt);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      // Calculate normal vector & hillshade intensity"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const slopeFactor = Math.min(1.0, q.slope / 30.0);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const shade = 0.8 + (1.0 - slopeFactor) * 0.25;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      let rCol = Math.round(baseColor.r * shade);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      let gCol = Math.round(baseColor.g * shade);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      let bCol = Math.round(baseColor.b * shade);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      // Highlight barrier zones (slope > 15%) in distinct warning amber/red hazard tint"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
