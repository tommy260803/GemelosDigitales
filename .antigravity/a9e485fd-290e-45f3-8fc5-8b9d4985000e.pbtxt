          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      params.facilityDeliveryFeeUSD = 0.0;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      params.insuranceCoverageRate = Math.max(0.92, baseParams.insuranceCoverageRate);"
