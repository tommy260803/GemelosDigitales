  const transitFatalityMultiplier = 0.5 + Math.min(1.5, p.travelTime / 3.0);\n    const cfrReferred = Math.max(0.012, 0.055 * transitFatalityMultiplier * (1 - qualityIndex * 0.55));\n    const emergencyDeaths = referredHomeComplications * cfrReferred;\n\n    // In-facility planned delivery complication CFR (detected early with partograph, immediate IV oxytocin / C-section)\n    const cfrInstPlanned = Math.max(0.004, 0.022 * (1 - qualityIndex * 0.60));\n    const instDeaths = instComplications * cfrInstPlanned;\n\n    // Total monthly maternal deaths\n    const totalMonthlyDeaths = homeDeaths + emergencyDeaths + instDeaths;\n    const simulatedMMR = Math.round((totalMonthlyDeaths / N_B) * 100000);\n\n    const redPercent = Math.round(((baselineMMR - simulatedMMR) / baselineMMR) * 1000) / 10;\n    const monthlyLivesSaved = Math.round(((baselineMMR / 100000) * N_B - totalMonthlyDeaths) * 10) / 10;\n    const totalLivesSaved36m = Math.round(monthlyLivesSaved * 36);\n\n    console.log(sId.padEnd(12) + \' -> MMR: \' + simulatedMMR + \' | Red%: \' + redPercent + \'% | 36m Lives Saved: \' + totalLivesSaved36m + \' | Deaths/mo: \' + totalMonthlyDeaths.toFixed(1));\n  }\n}\n\ntestModel(SUB_SAHARAN_DISTRICTS.find(d => d.id === \'ke-garissa\'));\n\""
