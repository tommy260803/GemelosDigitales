        lines {
          text: "  useEffect(() => {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const handleResize = () => {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      if (!canvasRef.current || !containerRef.current) return;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const rect = containerRef.current.getBoundingClientRect();"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      canvasRef.current.width = rect.width || 700;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      canvasRef.current.height = 460;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
