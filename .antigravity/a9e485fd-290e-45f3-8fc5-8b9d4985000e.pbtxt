    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "  return (\n    <div className=\"space-y-6\">\n      \n      {/* Header Banner */}\n      <div className=\"bg-slate-900/90 border border-slate-800 rounded-xl p-5 shadow-sm\">\n        <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n          <div>\n            <div className=\"flex items-center space-x-2\">\n              <span className=\"px-2 py-0.5 text-xs font-bold rounded bg-teal-500/20 text-teal-300 border border-teal-500/30\">\n                EPIDEMIOLOGICAL VALIDATION SUITE\n              </span>\n              <h2 className=\"text-base font-bold text-white\">\n                Statistical Testing, Sobol Global Sensitivity & Countdown 2030 Goodness-of-Fit\n              </h2>\n            </div>\n            <p className=\"text-xs text-slate-400 mt-1\">\n              Rigorous empirical validation against DHS cluster GPS surveys, DHIS2 monthly registries, and WHO benchmarks.\n            </p>\n          </div>\n\n          <div className=\"flex items-center space-x-2 bg-emerald-500/10 border border-emerald-500/30 px-3 py-1.5 rounded-lg text-emerald-300 text-xs font-semibold\">\n            <CheckCircle2 className=\"w-4 h-4 text-emerald-400\" />\n            <span>Hypothesis H1 Confirmed</span>\n          </div>\n        </div>\n      </div>\n\n      {/* Top 3 Statistical Test Cards */}\n      <div className=\"grid grid-cols-1 md:grid-cols-3 gap-6\">\n        \n        {/* 1. Kolmogorov-Smirnov Test Card */}\n        <div className=\"bg-slate-900/90 border border-slate-800 rounded-xl p-5 shadow-sm space-y-3 flex flex-col justify-between\">\n          <div>\n            <div className=\"flex items-center justify-between text-xs mb-1\">\n              <span className=\"font-bold text-teal-300\">1. Kolmogorov-Smirnov Test</span>\n              <span className=\"px-2 py-0.5 rounded text-[10px] font-bold bg-teal-500/20 text-teal-300\">\n                Transit Times\n              </span>\n            </div>\n            <p className=\"text-xs text-slate-400\">\n              Two-sample KS test comparing model-simulated emergency transit vs empirical DHS cluster GPS data.\n            </p>\n\n            <div className=\"mt-4 space-y-2 text-xs bg-slate-950 p-3 rounded-lg border border-slate-800 font-mono\">\n              <div className=\"flex justify-between\">\n                <span className=\"text-slate-400\">KS Statistic (D):</span>\n                <span className=\"text-slate-200 font-bold\">{ksResult.statisticD}</span>\n              </div>\n              <div className=\"flex justify-between\">\n                <span className=\"text-slate-400\">Critical Value (\316\261=0.05):</span>\n                <span className=\"text-slate-200\">{ksResult.criticalValue}</span>\n              </div>\n              <div className=\"flex justify-between\">\n                <span className=\"text-slate-400\">Asymptotic p-value:</span>\n                <span className=\"text-emerald-400 font-bold\">{ksResult.pValue}</span>\n              </div>\n            </div>\n          </div>\n\n          <div className=\"pt-2 border-t border-slate-800 text-xs text-emerald-400 flex items-center space-x-1.5\">\n            <CheckCircle2 className=\"w-4 h-4 shrink-0\" />\n            <span>Distributions are statistically equivalent (p &gt; 0.05)</span>\n          </div>\n        </div>\n\n        {/* 2. Wilcoxon Signed-Rank Test Card */}\n        <div className=\"bg-slate-900/90 border border-slate-800 rounded-xl p-5 shadow-sm space-y-3 flex flex-col justify-between\">\n          <div>\n            <div className=\"flex items-center justify-between text-xs mb-1\">\n              <span className=\"font-bold text-cyan-300\">2. Wilcoxon Signed-Rank Test</span>\n              <span className=\"px-2 py-0.5 rounded text-[10px] font-bold bg-cyan-500/20 text-cyan-300\">\n                25 Districts\n              </span>\n            </div>\n            <p className=\"text-xs text-slate-400\">\n              Paired non-parametric test validating predicted vs observed MMR across all 25 Sub-Saharan health districts.\n            </p>\n\n            <div className=\"mt-4 space-y-2 text-xs bg-slate-950 p-3 rounded-lg border border-slate-800 font-mono\">\n              <div className=\"flex justify-between\">\n                <span className=\"text-slate-400\">Test Statistic (W):</span>\n                <span className=\"text-slate-200 font-bold\">{wilcoxonResult.statisticW}</span>\n              </div>\n              <div className=\"flex justify-between\">\n                <span className=\"text-slate-400\">Normalized Z-Score:</span>\n                <span className=\"text-slate-200\">{wilcoxonResult.zScore}</span>\n              </div>\n              <div className=\"flex justify-between\">\n                <span className=\"text-slate-400\">Two-tailed p-value:</span>\n                <span className=\"text-emerald-400 font-bold\">{wilcoxonResult.pValue}</span>\n              </div>\n            </div>\n          </div>\n\n          <div className=\"pt-2 border-t border-slate-800 text-xs text-emerald-400 flex items-center space-x-1.5\">\n            <CheckCircle2 className=\"w-4 h-4 shrink-0\" />\n            <span>Zero systematic calibration bias across districts</span>\n          </div>\n        </div>\n\n        {/* 3. Goodness of Fit & Countdown 2030 */}\n        <div className=\"bg-slate-900/90 border border-slate-800 rounded-xl p-5 shadow-sm space-y-3 flex flex-col justify-between\">\n          <div>\n            <div className=\"flex items-center justify-between text-xs mb-1\">\n              <span className=\"font-bold text-indigo-300\">3. Countdown 2030 Fit</span>\n              <span className=\"px-2 py-0.5 rounded text-[10px] font-bold bg-indigo-500/20 text-indigo-300\">\n                Holdout Test\n              </span>\n            </div>\n            <p className=\"text-xs text-slate-400\">\n              External validation on uncalibrated holdout district ({externalResult.testDistrict}, {externalResult.country}).\n            </p>\n\n            <div className=\"mt-4 space-y-2 text-xs bg-slate-950 p-3 rounded-lg border border-slate-800 font-mono\">\n              <div className=\"flex justify-between\">\n                <span className=\"text-slate-400\">Coefficient of Determ. (R\302\262):</span>\n                <span className=\"text-emerald-400 font-bold\">{externalResult.rSquared}</span>\n              </div>\n              <div className=\"flex justify-between\">\n                <span className=\"text-slate-400\">RMSE (per 100k births):</span>\n                <span className=\"text-slate-200\">{externalResult.rmse}</span>\n              </div>\n              <div className=\"flex justify-between\">\n                <span className=\"text-slate-400\">Countdown Correlation (r):</span>\n                <span className=\"text-indigo-300 font-bold\">{externalResult.countdown2030Correlation}</span>\n              </div>\n            </div>\n          </div>\n\n          <div className=\"pt-2 border-t border-slate-800 text-xs text-indigo-300 flex items-center space-x-1.5\">\n            <ShieldCheck className=\"w-4 h-4 shrink-0\" />\n            <span>High external generalizability (R\302\262 &gt; 0.90)</span>\n          </div>\n        </div>\n\n      </div>\n\n      {/* Sobol Global Sensitivity Analysis (Variance Decomposition) */}\n      <div className=\"bg-slate-900/90 border border-slate-800 rounded-xl p-5 shadow-sm space-y-4\">\n        <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-800 pb-3\">\n          <div>\n            <h3 className=\"text-sm font-bold text-white flex items-center space-x-2\">\n              <BarChart2 className=\"w-4 h-4 text-teal-400\" />\n              <span>Sobol Global Sensitivity Analysis (Saltelli Variance Decomposition)</span>\n            </h3>\n            <p className=\"text-xs text-slate-400\">\n              Quantifies First-Order (S1) and Total-Order (ST) parameter contributions to Maternal Mortality variance.\n            </p>\n          </div>\n        </div>\n\n        {/* Sensitivity Bars */}\n        <div className=\"space-y-4 pt-2\">\n          {sobolResult.parameters.map((param, idx) => {\n            const s1 = sobolResult.firstOrderIndices[idx];\n            const st = sobolResult.totalOrderIndices[idx];\n            const ci = sobolResult.confidenceIntervals[idx];\n\n            return (\n              <div key={param} className=\"space-y-1.5 text-xs\">\n                <div className=\"flex justify-between text-slate-300\">\n                  <span className=\"font-semibold\">{param}</span>\n                  <div className=\"space-x-3 font-mono text-[11px]\">\n                    <span className=\"text-teal-400\">S1: {s1} [95% CI: {ci[0]}-{ci[1]}]</span>\n                    <span className=\"text-cyan-400 font-bold\">ST: {st}</span>\n                  </div>\n                </div>\n\n                {/* Stacked bar showing S1 and interaction effect */}\n                <div className=\"w-full h-3 bg-slate-800 rounded-full overflow-hidden flex\">\n                  {/* S1 Main effect */}\n                  <div\n                    className=\"h-full bg-teal-500 rounded-l-full\"\n                    style={{ width: `${Math.round(s1 * 100)}%` }}\n                    title={`First Order S1: ${s1}`}\n                  />\n                  {/* ST Interaction effect */}\n                  <div\n                    className=\"h-full bg-cyan-600 rounded-r-full\"\n                    style={{ width: `${Math.round((st - s1) * 100)}%` }}\n                    title={`Higher Order Interactions: ${Math.round((st - s1) * 100)}%`}\n                  />\n                </div>\n              </div>\n            );\n          })}\n        </div>\n\n        {/* Sobol Conclusion */}\n        <div className=\"bg-slate-950 p-3 rounded-lg border border-slate-800 text-xs text-slate-300 flex items-start space-x-2\">\n          <Award className=\"w-4 h-4 text-teal-400 shrink-0 mt-0.5\" />\n          <div>\n            <span className=\"font-bold text-white block\">Dominant Variance Drivers Identified:</span>\n            <span className=\"text-slate-400\">\n              {sobolResult.topVarianceContributors.join(\' \342\200\242 \')}. Targeted interventions on these 3 variables achieve the greatest systemic mortality reduction.\n            </span>\n          </div>\n        </div>\n      </div>\n\n      {/* Bootstrap Monte Carlo Resampling */}\n      <div className=\"bg-slate-900/90 border border-slate-800 rounded-xl p-5 shadow-sm space-y-3\">\n        <h3 className=\"text-sm font-bold text-white flex items-center space-x-2\">\n          <Activity className=\"w-4 h-4 text-emerald-400\" />\n          <span>Bootstrap Monte Carlo Resampling (N = 1,000 Iterations)</span>\n        </h3>\n        <p className=\"text-xs text-slate-400\">\n          Non-parametric 95% confidence interval estimation across simulated demographic and clinical variations:\n        </p>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4 pt-2\">\n          <div className=\"p-3.5 rounded-lg bg-slate-950 border border-slate-800 text-xs\">\n            <span className=\"text-slate-400 block mb-1\">Estimated Lives Saved (Scenario D):</span>\n            <div className=\"text-lg font-bold text-teal-300 font-mono\">\n              {bootstrapResult.meanLivesSaved} lives averted\n            </div>\n            <div className=\"text-slate-400 mt-1\">\n              95% Confidence Interval: <strong className=\"text-white font-mono\">[{bootstrapResult.ci95LivesSaved[0]} - {bootstrapResult.ci95LivesSaved[1]}]</strong>\n            </div>\n          </div>\n\n          <div className=\"p-3.5 rounded-lg bg-slate-950 border border-slate-800 text-xs\">\n            <span className=\"text-slate-400 block mb-1\">Cost-Effectiveness Distribution:</span>\n            <div className=\"text-lg font-bold text-cyan-300 font-mono\">\n              ${bootstrapResult.meanCostPerLifeSaved.toLocaleString()} / life saved\n            </div>\n            <div className=\"text-slate-400 mt-1\">\n              95% Confidence Interval: <strong className=\"text-white font-mono\">[${bootstrapResult.ci95CostPerLifeSaved[0].toLocaleString()} - ${bootstrapResult.ci95CostPerLifeSaved[1].toLocaleString()}]</strong>\n            </div>\n          </div>\n        </div>\n      </div>\n\n    </div>\n  );"
      replacement_content: "  return (\n    <div className=\"space-y-4\">\n      \n      {/* Header Banner */}\n      <div className=\"bg-slate-900/50 border border-slate-800 rounded-lg p-3.5 shadow-sm\">\n        <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n          <div>\n            <div className=\"flex items-center space-x-2\">\n              <span className=\"px-2 py-0.5 text-[10px] font-mono font-bold rounded bg-sky-500/20 text-sky-300 border border-sky-500/30 uppercase tracking-wider\">\n                EPIDEMIOLOGICAL VALIDATION SUITE\n              </span>\n              <h2 className=\"text-xs font-bold text-white uppercase tracking-tight\">\n                Statistical Testing, Sobol Global Sensitivity &amp; Countdown 2030 Goodness-of-Fit\n              </h2>\n            </div>\n            <p className=\"text-[11px] text-slate-400 font-mono mt-0.5\">\n              Empirical validation against DHS cluster GPS surveys, DHIS2 monthly registries, and WHO benchmarks.\n            </p>\n          </div>\n\n          <div className=\"flex items-center space-x-1.5 bg-emerald-500/10 border border-emerald-500/30 px-2.5 py-1 rounded text-emerald-300 text-[10px] font-mono font-bold uppercase\">\n            <CheckCircle2 className=\"w-3.5 h-3.5 text-emerald-400\" />\n            <span>Hypothesis H1 Confirmed</span>\n          </div>\n        </div>\n      </div>\n\n      {/* Top 3 Statistical Test Cards */}\n      <div className=\"grid grid-cols-1 md:grid-cols-3 gap-3\">\n        \n        {/* 1. Kolmogorov-Smirnov Test Card */}\n        <div className=\"bg-slate-900/50 border border-slate-800 rounded-lg p-3.5 shadow-sm space-y-2.5 flex flex-col justify-between\">\n          <div>\n            <div className=\"flex items-center justify-between text-xs mb-1 font-mono\">\n              <span className=\"font-bold text-sky-400 text-xs uppercase\">1. Kolmogorov-Smirnov</span>\n              <span className=\"px-1.5 py-0.5 rounded text-[9px] font-bold bg-sky-500/20 text-sky-300 uppercase\">\n                Transit Times\n              </span>\n            </div>\n            <p className=\"text-[11px] text-slate-400\">\n              Two-sample KS test comparing model-simulated emergency transit vs empirical DHS cluster GPS data.\n            </p>\n\n            <div className=\"mt-3 space-y-1.5 text-xs bg-[#0c0e12] p-2.5 rounded border border-slate-800 font-mono\">\n              <div className=\"flex justify-between\">\n                <span className=\"text-slate-500 text-[11px]\">KS Statistic (D):</span>\n                <span className=\"text-slate-200 font-bold\">{ksResult.statisticD}</span>\n              </div>\n              <div className=\"flex justify-between\">\n                <span className=\"text-slate-500 text-[11px]\">Critical (\316\261=0.05):</span>\n                <span className=\"text-slate-200\">{ksResult.criticalValue}</span>\n              </div>\n              <div className=\"flex justify-between\">\n                <span className=\"text-slate-500 text-[11px]\">Asymptotic p-val:</span>\n                <span className=\"text-emerald-400 font-bold\">{ksResult.pValue}</span>\n              </div>\n            </div>\n          </div>\n\n          <div className=\"pt-2 border-t border-slate-800 text-[11px] text-emerald-400 font-mono flex items-center space-x-1.5\">\n            <CheckCircle2 className=\"w-3.5 h-3.5 shrink-0\" />\n            <span>Distributions equivalent (p &gt; 0.05)</span>\n          </div>\n        </div>\n\n        {/* 2. Wilcoxon Signed-Rank Test Card */}\n        <div className=\"bg-slate-900/50 border border-slate-800 rounded-lg p-3.5 shadow-sm space-y-2.5 flex flex-col justify-between\">\n          <div>\n            <div className=\"flex items-center justify-between text-xs mb-1 font-mono\">\n              <span className=\"font-bold text-cyan-400 text-xs uppercase\">2. Wilcoxon Signed-Rank</span>\n              <span className=\"px-1.5 py-0.5 rounded text-[9px] font-bold bg-cyan-500/20 text-cyan-300 uppercase\">\n                25 Districts\n              </span>\n            </div>\n            <p className=\"text-[11px] text-slate-400\">\n              Paired non-parametric test validating predicted vs observed MMR across all 25 Sub-Saharan health districts.\n            </p>\n\n            <div className=\"mt-3 space-y-1.5 text-xs bg-[#0c0e12] p-2.5 rounded border border-slate-800 font-mono\">\n              <div className=\"flex justify-between\">\n                <span className=\"text-slate-500 text-[11px]\">Test Stat (W):</span>\n                <span className=\"text-slate-200 font-bold\">{wilcoxonResult.statisticW}</span>\n              </div>\n              <div className=\"flex justify-between\">\n                <span className=\"text-slate-500 text-[11px]\">Z-Score:</span>\n                <span className=\"text-slate-200\">{wilcoxonResult.zScore}</span>\n              </div>\n              <div className=\"flex justify-between\">\n                <span className=\"text-slate-500 text-[11px]\">Two-tailed p-val:</span>\n                <span className=\"text-emerald-400 font-bold\">{wilcoxonResult.pValue}</span>\n              </div>\n            </div>\n          </div>\n\n          <div className=\"pt-2 border-t border-slate-800 text-[11px] text-emerald-400 font-mono flex items-center space-x-1.5\">\n            <CheckCircle2 className=\"w-3.5 h-3.5 shrink-0\" />\n            <span>Zero systematic calibration bias</span>\n          </div>\n        </div>\n\n        {/* 3. Goodness of Fit & Countdown 2030 */}\n        <div className=\"bg-slate-900/50 border border-slate-800 rounded-lg p-3.5 shadow-sm space-y-2.5 flex flex-col justify-between\">\n          <div>\n            <div className=\"flex items-center justify-between text-xs mb-1 font-mono\">\n              <span className=\"font-bold text-indigo-400 text-xs uppercase\">3. Countdown 2030 Fit</span>\n              <span className=\"px-1.5 py-0.5 rounded text-[9px] font-bold bg-indigo-500/20 text-indigo-300 uppercase\">\n                Holdout Test\n              </span>\n            </div>\n            <p className=\"text-[11px] text-slate-400\">\n              External validation on uncalibrated holdout district ({externalResult.testDistrict}, {externalResult.country}).\n            </p>\n\n            <div className=\"mt-3 space-y-1.5 text-xs bg-[#0c0e12] p-2.5 rounded border border-slate-800 font-mono\">\n              <div className=\"flex justify-between\">\n                <span className=\"text-slate-500 text-[11px]\">Determ. (R\302\262):</span>\n                <span className=\"text-emerald-400 font-bold\">{externalResult.rSquared}</span>\n              </div>\n              <div className=\"flex justify-between\">\n                <span className=\"text-slate-500 text-[11px]\">RMSE (/100k):</span>\n                <span className=\"text-slate-200\">{externalResult.rmse}</span>\n              </div>\n              <div className=\"flex justify-between\">\n                <span className=\"text-slate-500 text-[11px]\">Correlation (r):</span>\n                <span className=\"text-indigo-300 font-bold\">{externalResult.countdown2030Correlation}</span>\n              </div>\n            </div>\n          </div>\n\n          <div className=\"pt-2 border-t border-slate-800 text-[11px] text-indigo-300 font-mono flex items-center space-x-1.5\">\n            <ShieldCheck className=\"w-3.5 h-3.5 shrink-0\" />\n            <span>High external generalizability (R\302\262 &gt; 0.90)</span>\n          </div>\n        </div>\n\n      </div>\n\n      {/* Sobol Global Sensitivity Analysis (Variance Decomposition) */}\n      <div className=\"bg-slate-900/50 border border-slate-800 rounded-lg p-4 shadow-sm space-y-3\">\n        <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-800 pb-2.5\">\n          <div>\n            <h3 className=\"text-xs font-bold text-white uppercase tracking-wider flex items-center space-x-2\">\n              <BarChart2 className=\"w-4 h-4 text-sky-400\" />\n              <span>Sobol Global Sensitivity Analysis (Saltelli Variance Decomposition)</span>\n            </h3>\n            <p className=\"text-[11px] text-slate-400 font-mono\">\n              Quantifies First-Order (S1) and Total-Order (ST) parameter contributions to Maternal Mortality variance.\n            </p>\n          </div>\n        </div>\n\n        {/* Sensitivity Bars */}\n        <div className=\"space-y-3 pt-1\">\n          {sobolResult.parameters.map((param, idx) => {\n            const s1 = sobolResult.firstOrderIndices[idx];\n            const st = sobolResult.totalOrderIndices[idx];\n            const ci = sobolResult.confidenceIntervals[idx];\n\n            return (\n              <div key={param} className=\"space-y-1 text-xs\">\n                <div className=\"flex justify-between text-slate-300\">\n                  <span className=\"font-bold text-xs\">{param}</span>\n                  <div className=\"space-x-3 font-mono text-[10px]\">\n                    <span className=\"text-sky-400\">S1: {s1} [95% CI: {ci[0]}-{ci[1]}]</span>\n                    <span className=\"text-cyan-400 font-bold\">ST: {st}</span>\n                  </div>\n                </div>\n\n                {/* Stacked bar showing S1 and interaction effect */}\n                <div className=\"w-full h-2.5 bg-[#0c0e12] rounded-full overflow-hidden flex border border-slate-800\">\n                  {/* S1 Main effect */}\n                  <div\n                    className=\"h-full bg-sky-500 rounded-l-full\"\n                    style={{ width: `${Math.round(s1 * 100)}%` }}\n                    title={`First Order S1: ${s1}`}\n                  />\n                  {/* ST Interaction effect */}\n                  <div\n                    className=\"h-full bg-cyan-600 rounded-r-full\"\n                    style={{ width: `${Math.round((st - s1) * 100)}%` }}\n                    title={`Higher Order Interactions: ${Math.round((st - s1) * 100)}%`}\n                  />\n                </div>\n              </div>\n            );\n          })}\n        </div>\n\n        {/* Sobol Conclusion */}\n        <div className=\"bg-[#0c0e12] p-2.5 rounded border border-slate-800 text-xs text-slate-300 flex items-start space-x-2 font-mono\">\n          <Award className=\"w-4 h-4 text-sky-400 shrink-0 mt-0.5\" />\n          <div>\n            <span className=\"font-bold text-white block text-xs\">Dominant Variance Drivers Identified:</span>\n            <span className=\"text-slate-400 text-[11px] font-sans\">\n              {sobolResult.topVarianceContributors.join(\' \342\200\242 \')}. Targeted interventions on these 3 variables achieve the greatest systemic mortality reduction.\n            </span>\n          </div>\n        </div>\n      </div>\n\n      {/* Bootstrap Monte Carlo Resampling */}\n      <div className=\"bg-slate-900/50 border border-slate-800 rounded-lg p-4 shadow-sm space-y-2.5\">\n        <h3 className=\"text-xs font-bold text-white uppercase tracking-wider flex items-center space-x-2\">\n          <Activity className=\"w-4 h-4 text-emerald-400\" />\n          <span>Bootstrap Monte Carlo Resampling (N = 1,000 Iterations)</span>\n        </h3>\n        <p className=\"text-[11px] text-slate-400 font-mono\">\n          Non-parametric 95% confidence interval estimation across simulated demographic and clinical variations:\n        </p>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-2 gap-3 pt-1\">\n          <div className=\"p-3 rounded bg-[#0c0e12] border border-slate-800 text-xs font-mono\">\n            <span className=\"text-slate-500 uppercase font-bold text-[10px] block mb-0.5\">Estimated Lives Saved (Scenario D):</span>\n            <div className=\"text-base font-bold text-sky-400\">\n              {bootstrapResult.meanLivesSaved} lives averted\n            </div>\n            <div className=\"text-slate-400 text-[11px] mt-0.5\">\n              95% Confidence Interval: <strong className=\"text-white\">[{bootstrapResult.ci95LivesSaved[0]} - {bootstrapResult.ci95LivesSaved[1]}]</strong>\n            </div>\n          </div>\n\n          <div className=\"p-3 rounded bg-[#0c0e12] border border-slate-800 text-xs font-mono\">\n            <span className=\"text-slate-500 uppercase font-bold text-[10px] block mb-0.5\">Cost-Effectiveness Distribution:</span>\n            <div className=\"text-base font-bold text-cyan-300\">\n              ${bootstrapResult.meanCostPerLifeSaved.toLocaleString()} / life saved\n            </div>\n            <div className=\"text-slate-400 text-[11px] mt-0.5\">\n              95% Confidence Interval: <strong className=\"text-white\">[${bootstrapResult.ci95CostPerLifeSaved[0].toLocaleString()} - ${bootstrapResult.ci95CostPerLifeSaved[1].toLocaleString()}]</strong>\n            </div>\n          </div>\n        </div>\n      </div>\n\n    </div>\n  );"
    }
