        }
        lines {
          text: "      predictedArr.push(pred);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      sumSquaredError += (pred - obs) ** 2;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      sumObserved += obs;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      sumPredicted += pred;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
