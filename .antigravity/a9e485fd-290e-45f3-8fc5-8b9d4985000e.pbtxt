        target_content: "  return (\n    <div className=\"space-y-6\">\n      \n      {/* Header */}\n      <div className=\"bg-slate-900/90 border border-slate-800 rounded-xl p-5 shadow-sm\">\n        <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n          <div>\n            <div className=\"flex items-center space-x-2\">\n              <span className=\"px-2 py-0.5 text-xs font-bold rounded bg-teal-500/20 text-teal-300 border border-teal-500/30\">\n                SCENARIO COMPARISON MATRIX\n              </span>\n              <h2 className=\"text-base font-bold text-white\">\n                Policy Interventions & Cost-Effectiveness Evaluation (36-Month Horizon)\n              </h2>\n            </div>\n            <p className=\"text-xs text-slate-400 mt-1\">\n              Comparative analysis for {district.name} ({district.country}) across single and combined intervention packages.\n            </p>\n          </div>\n        </div>\n      </div>\n\n      {/* Scenario Cards Grid */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4\">\n        {SCENARIO_DEFINITIONS.filter((s) => s.id !== \'baseline\').map((s) => {\n          const res = allResults[s.id];\n          const isSelected = activeScenarioId === s.id;\n          const isCombined = s.id === \'scenario_d\';\n\n          return (\n            <div\n              key={s.id}\n              onClick={() => onSelectScenario(s.id)}\n              className={`p-4 rounded-xl border transition cursor-pointer flex flex-col justify-between ${\n                isCombined\n                  ? \'bg-gradient-to-b from-teal-950/40 via-slate-900 to-slate-900 border-teal-500/40 shadow-md shadow-teal-500/10\'\n                  : \'bg-slate-900/90 border-slate-800 hover:border-slate-700\'\n              } ${isSelected ? \'ring-2 ring-teal-400\' : \'\'}`}\n            >\n              <div>\n                <div className=\"flex items-center justify-between mb-2\">\n                  <span className={`text-xs font-bold px-2 py-0.5 rounded ${\n                    isCombined ? \'bg-teal-500 text-slate-950\' : \'bg-slate-800 text-teal-400\'\n                  }`}>\n                    Scenario ({s.letter})\n                  </span>\n                  {isCombined && (\n                    <span className=\"text-[10px] px-1.5 py-0.5 rounded bg-amber-500/20 text-amber-300 font-bold border border-amber-500/30 flex items-center\">\n                      <Award className=\"w-3 h-3 mr-0.5\" /> High Impact\n                    </span>\n                  )}\n                </div>\n\n                <h3 className=\"text-sm font-bold text-white mb-1.5\">{s.name.split(\'(\')[0].trim()}</h3>\n                <p className=\"text-xs text-slate-400 line-clamp-2 mb-3\">{s.description}</p>\n\n                {/* Core Result Stats */}\n                <div className=\"space-y-2 text-xs pt-2 border-t border-slate-800\">\n                  <div className=\"flex justify-between\">\n                    <span className=\"text-slate-400\">Lives Saved:</span>\n                    <span className=\"font-bold text-teal-300 font-mono\">\n                      {res.summary.livesSaved} <span className=\"text-[10px] text-slate-500\">[{res.summary.livesSavedCI95[0]}-{res.summary.livesSavedCI95[1]}]</span>\n                    </span>\n                  </div>\n                  <div className=\"flex justify-between\">\n                    <span className=\"text-slate-400\">MMR Reduction:</span>\n                    <span className=\"font-bold text-emerald-400\">-{res.summary.mmrReductionPercent}%</span>\n                  </div>\n                  <div className=\"flex justify-between\">\n                    <span className=\"text-slate-400\">Cost / Life Saved:</span>\n                    <span className=\"font-mono text-slate-200\">${res.summary.costPerLifeSavedUSD.toLocaleString()}</span>\n                  </div>\n                  <div className=\"flex justify-between\">\n                    <span className=\"text-slate-400\">ICER ($/DALY):</span>\n                    <span className=\"font-mono text-cyan-300\">${res.summary.icerPerDALY} / DALY</span>\n                  </div>\n                </div>\n              </div>\n\n              <button\n                className={`w-full mt-4 py-1.5 rounded-lg text-xs font-semibold flex items-center justify-center space-x-1 transition ${\n                  isSelected ? \'bg-teal-500 text-slate-950\' : \'bg-slate-800 text-slate-300 hover:bg-slate-700\'\n                }`}\n              >\n                <span>{isSelected ? \'Active Scenario\' : \'Select Scenario\'}</span>\n                <ArrowUpRight className=\"w-3.5 h-3.5\" />\n              </button>\n            </div>\n          );\n        })}\n      </div>\n\n      {/* Comparative Full Table */}\n      <div className=\"bg-slate-900/90 border border-slate-800 rounded-xl p-5 shadow-sm space-y-4\">\n        <h3 className=\"text-sm font-bold text-white\">Full Cross-Scenario Cost-Effectiveness Matrix</h3>\n\n        <div className=\"overflow-x-auto\">\n          <table className=\"w-full text-left text-xs border-collapse\">\n            <thead>\n              <tr className=\"border-b border-slate-800 bg-slate-950 text-slate-400\">\n                <th className=\"p-3 font-semibold\">Scenario</th>\n                <th className=\"p-3 font-semibold\">Intervention Mechanism</th>\n                <th className=\"p-3 font-semibold\">Lives Saved (95% CI)</th>\n                <th className=\"p-3 font-semibold\">Final MMR</th>\n                <th className=\"p-3 font-semibold\">MMR Red. %</th>\n                <th className=\"p-3 font-semibold\">Total Cost (USD)</th>\n                <th className=\"p-3 font-semibold\">Cost / Life Saved</th>\n                <th className=\"p-3 font-semibold\">ICER ($/DALY)</th>\n                <th className=\"p-3 font-semibold\">WHO Threshold</th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-slate-800/60\">\n              {SCENARIO_DEFINITIONS.map((s) => {\n                const res = allResults[s.id];\n                const isSelected = activeScenarioId === s.id;\n                const isCombined = s.id === \'scenario_d\';\n\n                return (\n                  <tr\n                    key={s.id}\n                    onClick={() => onSelectScenario(s.id)}\n                    className={`cursor-pointer transition ${\n                      isSelected ? \'bg-teal-950/30 text-white\' : \'hover:bg-slate-800/40 text-slate-300\'\n                    }`}\n                  >\n                    <td className=\"p-3 font-bold\">\n                      <div className=\"flex items-center space-x-1.5\">\n                        <span className={`w-2 h-2 rounded-full ${isSelected ? \'bg-teal-400\' : \'bg-slate-600\'}`} />\n                        <span>({s.letter}) {s.name.split(\'(\')[0]}</span>\n                      </div>\n                    </td>\n                    <td className=\"p-3 text-slate-400\">{s.description.slice(0, 48)}...</td>\n                    <td className=\"p-3 font-mono font-bold text-teal-300\">\n                      {res.summary.livesSaved} <span className=\"text-[10px] text-slate-500\">[{res.summary.livesSavedCI95[0]}-{res.summary.livesSavedCI95[1]}]</span>\n                    </td>\n                    <td className=\"p-3 font-mono font-semibold\">{res.summary.mmrFinal}</td>\n                    <td className=\"p-3 font-semibold text-emerald-400\">-{res.summary.mmrReductionPercent}%</td>\n                    <td className=\"p-3 font-mono\">${res.summary.totalCostUSD.toLocaleString()}</td>\n                    <td className=\"p-3 font-mono\">${res.summary.costPerLifeSavedUSD.toLocaleString()}</td>\n                    <td className=\"p-3 font-mono text-cyan-300\">${res.summary.icerPerDALY}</td>\n                    <td className=\"p-3\">\n                      <span c