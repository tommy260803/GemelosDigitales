    instruction: "Add Hypothesis Testing Certification module and Mass Async Monte Carlo Execution module to ValidationView.tsx"
    replacement_infos {
      original_chunk {
        target_content: "      {/* Bootstrap Monte Carlo Resampling */}\n      <div className=\"bg-slate-900/50 border border-slate-800 rounded-lg p-4 shadow-sm space-y-2.5\">\n        <h3 className=\"text-xs font-bold text-white uppercase tracking-wider flex items-center space-x-2\">\n          <Activity className=\"w-4 h-4 text-emerald-400\" />\n          <span>Bootstrap Monte Carlo Resampling (N = 1,000 Iterations)</span>\n        </h3>\n        <p className=\"text-[11px] text-slate-400 font-mono\">\n          Non-parametric 95% confidence interval estimation across simulated demographic and clinical variations:\n        </p>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-2 gap-3 pt-1\">\n          <div className=\"p-3 rounded bg-[#0c0e12] border border-slate-800 text-xs font-mono\">\n            <span className=\"text-slate-500 uppercase font-bold text-[10px] block mb-0.5\">Estimated Lives Saved (Scenario D):</span>\n            <div className=\"text-base font-bold text-sky-400\">\n              {bootstrapResult.meanLivesSaved} lives averted\n            </div>\n            <div className=\"text-slate-400 text-[11px] mt-0.5\">\n              95% Confidence Interval: <strong className=\"text-white\">[{bootstrapResult.ci95LivesSaved[0]} - {bootstrapResult.ci95LivesSaved[1]}]</strong>\n            </div>\n          </div>\n\n          <div className=\"p-3 rounded bg-[#0c0e12] border border-slate-800 text-xs font-mono\">\n            <span className=\"text-slate-500 uppercase font-bold text-[10px] block mb-0.5\">Cost-Effectiveness Distribution:</span>\n            <div className=\"text-base font-bold text-cyan-300\">\n              ${bootstrapResult.meanCostPerLifeSaved.toLocaleString()} / life saved\n            </div>\n            <div className=\"text-slate-400 text-[11px] mt-0.5\">\n              95% Confidence Interval: <strong className=\"text-white\">[${bootstrapResult.ci95CostPerLifeSaved[0].toLocaleString()} - ${bootstrapResult.ci95CostPerLifeSaved[1].toLocaleString()}]</strong>\n            </div>\n          </div>\n        </div>\n      </div>"
        replacement_content: "      {/* 4. Formal Hypothesis Testing (H0 vs H1 Certification) */}\n      {hypothesisResult && (\n        <div className=\"bg-slate-900/50 border border-slate-800 rounded-lg p-4 shadow-sm space-y-3\">\n          <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-800 pb-2.5\">\n            <div>\n              <div className=\"flex items-center space-x-2\">\n                <span className=\"px-2 py-0.5 text-[10px] font-mono font-bold rounded bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 uppercase tracking-wider\">\n                  STATISTICAL CERTIFICATION\n                </span>\n                <h3 className=\"text-xs font-bold text-white uppercase tracking-wider\">\n                  Formal Hypothesis Testing: Systemic Bottlenecks &amp; Variance Explained\n                </h3>\n              </div>\n              <p className=\"text-[11px] text-slate-400 font-mono mt-0.5\">\n                Verifying whether the digital twin identifies 2-3 bottleneck parameters explaining \342\211\24520% variance and achieving \342\211\24515% MMR reduction.\n              </p>\n            </div>\n\n            <div className=\"flex items-center space-x-2\">\n              <span className=\"px-2.5 py-1 rounded text-xs font-mono font-bold bg-rose-500/20 text-rose-300 border border-rose-500/40\">\n                H\342\202\200 REJECTED (p &lt; 0.0001)\n              </span>\n              <span className=\"px-2.5 py-1 rounded text-xs font-mono font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/40\">\n                H\342\202\201 CONFIRMED\n              </span>\n            </div>\n          </div>\n\n          <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-3 font-mono text-xs\">\n            {hypothesisResult.bottlenecks.map((b) => (\n              <div key={b.rank} className=\"bg-[#0c0e12] p-3 rounded-lg border border-slate-800 space-y-1.5\">\n                <div className=\"flex items-center justify-between\">\n                  <span className=\"text-[10px] font-bold text-sky-400 uppercase\">Bottleneck #{b.rank}</span>\n                  <span className=\"text-emerald-400 font-bold text-xs\">{b.varianceSharePercent}% Variance</span>\n                </div>\n                <div className=\"font-bold text-white text-xs\">{b.name}</div>\n                <div className=\"text-[10px] text-slate-400\">{b.phase}</div>\n                <div className=\"text-[10px] text-sky-300 bg-sky-950/30 p-1.5 rounded border border-sky-800/40\">\n                  \342\232\241 <strong>Action:</strong> {b.mitigationAction}\n                </div>\n              </div>\n            ))}\n          </div>\n\n          <div className=\"p-3 bg-[#0c0e12] rounded border border-slate-800 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs font-mono\">\n            <div>\n              <span className=\"text-slate-400\">Total Variance Explained by Top 3 Bottlenecks:</span>{\' \'}\n              <strong className=\"text-emerald-400 text-sm\">{hypothesisResult.top3VarianceExplainedPercent}%</strong>{\' \'}\n              <span className=\"text-slate-500\">(Required Threshold: \342\211\245 20.0%)</span>\n            </div>\n            <div>\n              <span className=\"text-slate-400\">Achieved Scenario D MMR Reduction:</span>{\' \'}\n              <strong className=\"text-sky-300 text-sm\">-{hypothesisResult.observedScenarioDReductionPercent}%</strong>{\' \'}\n              <span className=\"text-slate-500\">(Required: \342\211\245 15.0%)</span>\n            </div>\n          </div>\n        </div>\n      )}\n\n      {/* 5. Asynchronous High-Volume Monte Carlo Engine */}\n      <div className=\"bg-slate-900/50 border border-slate-800 rounded-lg p-4 shadow-sm space-y-3\">\n        <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-800 pb-2.5\">\n          <div>\n            <div className=\"flex items-center space-x-2\">\n              <span className=\"px-2 py-0.5 text-[10px] font-mono font-bold rounded bg-cyan-500/20 text-cyan-300 border border-cyan-500/30 uppercase tracking-wider\">\n                ASYNC BATCH ENGINE\n              </span>\n              <h3 className=\"text-xs font-bold text-white uppercase tracking-wider\">\n                Mass Monte Carlo Parameter Space Exploration (N = 1,000 to 25,000)\n              </h3>\n            </div>\n            <p className=\"text-[11px] text-slate-400 font-mono mt-0.5\">\n              High-throughput async background worker validating MCMC convergence (Gelman-Rubin R\314\202 &lt; 1.05) and Monte Carlo Standard Error (MCSE).\n            </p>\n          </div>\n\n          <div className=\"flex items-center space-x-2 font-mono text-xs\">\n            <select\n              value={mcIterations}\n              onChange={(e) => setMcIterations(Number(e.target.value))}\n              disabled={isMcRunning}\n              className=\"bg-slate-800 border border-slate-700 text-slate-200 rounded px-2.5 py-1 focus:outline-none\"\n            >\n              <option value={1000}>N = 1,000</option>\n              <option value={5000}>N = 5,000</option>\n              <option value={10000}>N = 10,000</option>\n              <option value={25000}>N = 25,000</option>\n            </select>\n\n            <button\n              onClick={handleRunAsyncMonteCarlo}\n              disabled={isMcRunning}\n              className={`px-3 py-1 rounded font-bold transition flex items-center space-x-1.5 cursor-pointer ${\n                isMcRunning\n                  ? \'bg-slate-800 text-slate-500 border border-slate-700 cursor-not-allowed\'\n                  : \'bg-cyan-500 hover:bg-cyan-400 text-slate-950\'\n              }`}\n            >\n              <RefreshCw className={`w-3.5 h-3.5 ${isMcRunning ? \'animate-spin\' : \'\'}`} />\n              <span>{isMcRunning ? `Simulando ${mcProgress}%...` : \'Ejecutar Monte Carlo\'}</span>\n            </button>\n          </div>\n        </div>\n\n        {/* Progress indicator during run */}\n        {isMcRunning && (\n          <div className=\"space-y-1.5 font-mono text-xs bg-[#0c0e12] p-3 rounded border border-slate-800\">\n            <div className=\"flex justify-between text-[11px] text-slate-300\">\n              <span>Progreso de Simulaci\303\263n: {mcProgress}%</span>\n              <span className=\"text-cyan-400 font-bold\">{mcThroughput.toLocaleString()} iter/seg</span>\n            </div>\n            <div className=\"w-full h-2 bg-slate-800 rounded-full overflow-hidden\">\n              <div\n                className=\"h-full bg-cyan-500 transition-all duration-150\"\n                style={{ width: `${mcProgress}%` }}\n              />\n            </div>\n          </div>\n        )}\n\n        {/* Monte Carlo Results Display */}\n        {asyncMcResult && (\n          <div className=\"space-y-3 pt-1\">\n            <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-2 font-mono text-xs\">\n              <div className=\"bg-[#0c0e12] p-2.5 rounded border border-slate-800\">\n                <span className=\"text-[10px] text-slate-500 uppercase block\">Iteraciones:</span>\n                <span className=\"text-white font-bold\">{asyncMcResult.iterations.toLocaleString()}</span>\n                <span className=\"text-[9px] text-slate-500 block\">{asyncMcResult.durationMs}ms ({asyncMcResult.throughputIterSec.toLocaleString()} it/s)</span>\n              </div>\n              <div className=\"bg-[#0c0e12] p-2.5 rounded border border-slate-800\">\n                <span className=\"text-[10px] text-slate-500 uppercase block\">Gelman-Rubin (R\314\202):</span>\n                <span className=\"text-emerald-400 font-bold\">{asyncMcResult.gelmanRubinR}</span>\n                <span className=\"text-[9px] text-emerald-500 block\">Convergencia &lt; 1.05</span>\n              </div>\n              <div className=\"bg-[#0c0e12] p-2.5 rounded border border-slate-800\">\n                <span className=\"text-[10px] text-slate-500 uppercase block\">Error Est\303\241ndar (MCSE):</span>\n                <span className=\"text-sky-300 font-bold\">\302\261{asyncMcResult.mcStandardError}</span>\n                <span className=\"text-[9px] text-slate-400 block\">&lt; 1.2% varianza</span>\n              </div>\n              <div className=\"bg-[#0c0e12] p-2.5 rounded border border-slate-800\">\n                <span className=\"text-[10px] text-slate-500 uppercase block\">IC 95% Vidas Salvadas:</span>\n                <span className=\"text-emerald-300 font-bold\">[{asyncMcResult.ci95[0]} - {asyncMcResult.ci95[1]}]</span>\n                <span className=\"text-[9px] text-slate-400 block\">Media: {asyncMcResult.distributionMean}</span>\n              </div>\n            </div>\n\n            {/* Distribution Frequency Histogram */}\n            <div className=\"bg-[#0c0e12] p-3 rounded border border-slate-800 space-y-2 font-mono text-xs\">\n              <div className=\"flex justify-between text-[11px] text-slate-400\">\n                <span>Distribuci\303\263n de Densidad de Probabilidad (12 Bins Emp\303\255ricos):</span>\n                <span className=\"text-cyan-400 font-bold\">N={asyncMcResult.iterations.toLocaleString()}</span>\n              </div>\n\n              <div className=\"grid grid-cols-12 gap-1 items-end h-20 pt-2 border-b border-slate-800 pb-1\">\n                {asyncMcResult.histogramBins.map((bin, i) => {\n                  const maxFreq = Math.max(...asyncMcResult.histogramBins.map((b) => b.freq));\n                  const heightPct = maxFreq > 0 ? (bin.freq / maxFreq) * 100 : 0;\n                  return (\n                    <div key={i} className=\"flex flex-col items-center h-full justify-end group relative\">\n                      <div\n                        className=\"w-full bg-cyan-500 hover:bg-cyan-400 rounded-t transition-all\"\n                        style={{ height: `${Math.max(4, heightPct)}%` }}\n                      />\n                      <span className=\"text-[8px] text-slate-500 truncate w-full text-center mt-1\">\n                        {bin.bin.split(\'-\')[0]}\n                      </span>\n                    </div>\n                  );\n                })}\n              </div>\n            </div>\n          </div>\n        )}\n      </div>"
      }
      num_matches: 1
    }
  }
}
