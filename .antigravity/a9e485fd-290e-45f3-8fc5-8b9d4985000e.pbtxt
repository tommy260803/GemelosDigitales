        }
        lines {
          text: "    }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const monthlyBirthsTarget = district.annualBirths / 12;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const monthlyPregnancies = monthlyBirthsTarget * 1.05; // accounting for early pregnancy loss / fetal wastage"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    // --- BASELINE EPIDEMIOLOGICAL RISK CALIBRATION ---"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const baseInstDelivRate = district.institutionalDeliveryRate / 100;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const baseANC1Rate = district.anc1Coverage / 100;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const baseTravelTime = baseParams.travelTimeHours;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const baseFee = baseParams.facilityDeliveryFeeUSD;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const baseTBA = baseParams.tbaInfluenceFactor;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const baseRoadQuality = baseParams.roadQualityIndex;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const baseQuality = Math.min(1.0, (baseParams.skilledStaffRatio / 3.0) * 0.4 + baseParams.bloodAvailabilityRate * 0.3 + baseParams.oxytocinMisoprostolStockRate * 0.3);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const baseCompRisk = baseParams.baselineComplicationRate * (1.05 - 0.1 * baseParams.maternalEducationRate);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const baseReferralPropensity = Math.min(0.85, Math.max(0.20,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      0.70 - (baseTravelTime / 12.0) - (baseTBA * 0.25) + (baseRoadQuality * 0.15)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    ));"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const baseHomeWeight = (1 - baseInstDelivRate) * ("
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      (1 - baseReferralPropensity) * 1.0 +"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      baseReferralPropensity * (0.22 + 0.38 * (baseTravelTime / 5.0)) * (1.0 - 0.5 * baseQuality)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    );"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const baseInstWeight = baseInstDelivRate * 0.12 * (1.0 - 0.7 * baseQuality);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const baseTotalRiskScore = (baseHomeWeight + baseInstWeight) * baseCompRisk;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    // Mathematical calibration factor: ensures baseline model matches historical observed MMR exactly"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const targetMonthlyDeaths = monthlyBirthsTarget * (district.baselineMMR / 100000);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const calibConst = targetMonthlyDeaths / Math.max(0.0001, monthlyBirthsTarget * baseTotalRiskScore);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    // Initial Stock Conditions"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    let pregnantWomen = monthlyPregnancies * 7.5; // ~7.5 months average gestation stock (S1)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    let inANC = pregnantWomen * (baseANC1Rate * 0.75); // (S2)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    let inFacilityDelivery = monthlyBirthsTarget * baseInstDelivRate * (3 / 30); // ~3 days in facility (S3)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    let inPostpartum = monthlyBirthsTarget * 1.4; // ~42 days (1.4 months) postpartum (S4)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    let withComplications = monthlyBirthsTarget * baseCompRisk * (2 / 30); // ~2 days acute complication state (S5)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const dt = 0.1; // RK4 sub-step in months"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const totalSteps = Math.round(simulationMonths / dt);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const monthlySnapshots: StockState[] = [];"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    // System Feedback Variables"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    let systemTrust = params.communityTrustBaseline;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    let rollingObservedMMR = district.baselineMMR;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    let cumulativeBirths = 0;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    let cumulativeDeaths = 0;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    let currentMonthAccumulatedBirths = 0;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    let currentMonthAccumulatedDeaths = 0;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    for (let step = 0; step <= totalSteps; step++) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      const currentMonth = Math.floor(step * dt);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      // --- 1. DYNAMIC FEEDBACK LOOPS ---"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      // R1: Trust Feedback Loop"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      const mmrDistressRatio = rollingObservedMMR / Math.max(100, district.baselineMMR);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      const targetTrust = Math.max(0.35, Math.min(0.98, params.communityTrustBaseline * (1.15 - 0.20 * mmrDistressRatio)));"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      systemTrust += (targetTrust - systemTrust) * 0.08 * dt;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      // B1: Resource & Capacity Congestion Loop"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      const currentPatientLoad = inFacilityDelivery + withComplications * 1.8;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      const nominalCapacity = Math.max(10, monthlyBirthsTarget * 0.12 * (params.skilledStaffRatio / 1.5));"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      const congestionIndex = Math.min(2.5, currentPatientLoad / nominalCapacity);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      // Clinical Quality of Care Index (0 to 1)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      const qualityFactor = Math.max("
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        0.25,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        Math.min("
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
