    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "      // Effective Geographic Access & Phase 2 Delay (Hours)\n      const phase2Delay = Math.max(\n        0.4,\n        params.travelTimeHours * (1.6 - 0.6 * params.roadQualityIndex) +\n        (params.transportCostUSD > 5 ? 0.8 : 0.1)\n      );\n\n      // Effective Willingness / Financial Access\n      const financialAffordability = Math.max(\n        0.2,\n        params.insuranceCoverageRate * 0.5 +\n        (1 - Math.min(1, params.facilityDeliveryFeeUSD / 25)) * 0.35 +\n        params.maternalEducationRate * 0.15\n      );\n\n      // --- COMPUTE FLOW RATES ---\n      // Flow 1: Pregnant women seeking ANC (Inflow to S2 from S1)\n      const ancPropensity = Math.min(0.98, 0.45 + 0.35 * systemTrust + 0.2 * params.maternalEducationRate - 0.15 * (params.avgDistanceKm / 60));\n      const rateToANC = (pregnantWomen / 3.0) * ancPropensity;\n\n      // Flow 2: Transition from ANC to Institutional Delivery vs Home Delivery\n      const facilityDeliveryPropensity = Math.min(\n        0.98,\n        0.3 + 0.35 * financialAffordability + 0.2 * systemTrust + 0.15 * qualityFactor - 0.18 * Math.max(0, (phase2Delay - 1.5) / 3)\n      );\n      const deliveryFromANC = (inANC / 4.5) * facilityDeliveryPropensity;\n      const homeDeliveryFromANC = (inANC / 4.5) * (1 - facilityDeliveryPropensity);\n\n      // Flow 3: Direct Pregnant Women Delivery without ANC\n      const directFacilityDelivery = (pregnantWomen / 7.5) * (1 - ancPropensity) * (facilityDeliveryPropensity * 0.6);\n      const directHomeDelivery = (pregnantWomen / 7.5) * (1 - ancPropensity) * (1 - facilityDeliveryPropensity * 0.6);\n\n      // Total Deliveries\n      const totalInstitutionalDeliveries = deliveryFromANC + directFacilityDelivery;\n      const totalHomeDeliveries = homeDeliveryFromANC + directHomeDelivery;\n\n      // Flow 4: Complication Inflows (15% base + risk moderators)\n      const complicationRisk = params.baselineComplicationRate * (1.1 - 0.2 * params.maternalEducationRate);\n      const complicationsFromANC = (inANC / 4.5) * complicationRisk * 0.4;\n      const complicationsFromHome = totalHomeDeliveries * complicationRisk;\n      const complicationsFromFacility = totalInstitutionalDeliveries * complicationRisk;\n      const totalComplicationInflow = complicationsFromANC + complicationsFromHome + complicationsFromFacility;\n\n      // Flow 5: Emergency Referrals from Complications into Facility Care\n      // TBA Training significantly boosts referral from community/home complications\n      const tbaReferralBoost = 1.0 + (1 - params.tbaInfluenceFactor) * 0.8;\n      const emergencyReferralRate = (withComplications / Math.max(0.1, phase2Delay * 0.15)) * Math.min(1.0, 0.45 * tbaReferralBoost * (params.roadQualityIndex + 0.3));\n\n      // Flow 6: Complication Case Fatality & Deaths\n      // Institutional delivery with high quality drastically lowers fatality (< 1%)\n      // Unattended home complications with high delay have ~18-35% fatality\n      const institutionalCaseFatality = Math.max(0.005, 0.045 * (1 - qualityFactor) * (1 + Math.max(0, congestionIndex - 1.0) * 0.5));\n      const emergencyReferralCaseFatality = Math.max(0.015, 0.12 * (phase2Delay / 3.5) * (1 - qualityFactor * 0.6));\n      const homeComplicationCaseFatality = Math.max(0.08, 0.28 * (1 - params.maternalEducationRate * 0.3));\n\n      const monthlyInstitutionalDeaths = (inFacilityDelivery / 0.1) * 0.0008 + (withComplications * 0.5) * institutionalCaseFatality;\n      const monthlyEmergencyDeaths = emergencyReferralRate * emergencyReferralCaseFatality;\n      const monthlyHomeDeaths = (totalHomeDeliveries * complicationRisk) * homeComplicationCaseFatality;\n\n      const totalStepDeaths = (monthlyInstitutionalDeaths + monthlyEmergencyDeaths + monthlyHomeDeaths) * dt;\n      const totalStepBirths = (totalInstitutionalDeliveries + totalHomeDeliveries) * dt;\n\n      currentMonthAccumulatedDeaths += totalStepDeaths;\n      currentMonthAccumulatedBirths += totalStepBirths;\n      cumulativeDeaths += totalStepDeaths;\n      cumulativeBirths += totalStepBirths;\n\n      // Calculate baseline comparison deaths (without intervention)\n      const baselineStepDeaths = totalStepBirths * (district.baselineMMR / 100000);\n      baselineCumulativeDeaths += baselineStepDeaths;\n\n      // Flow 7: Postpartum Recovery & Exit\n      const deliveryToPostpartum = (inFacilityDelivery / 0.08) * (1 - institutionalCaseFatality);\n      const complicationToPostpartum = (withComplications / 0.12) * (1 - (institutionalCaseFatality + emergencyReferralCaseFatality));\n      const homeToPostpartum = (totalHomeDeliveries / 0.05);\n      const postpartumExit = inPostpartum / 1.4; // 42 days\n\n      // --- DERIVATIVE UPDATES (Euler / RK integration) ---\n      const dPregnant = (monthlyPregnancies - rateToANC - (pregnantWomen / 7.5)) * dt;\n      const dANC = (rateToANC - (inANC / 4.5)) * dt;\n      const dFacilityDelivery = (totalInstitutionalDeliveries + emergencyReferralRate - (inFacilityDelivery / 0.08)) * dt;\n      const dComplications = (totalComplicationInflow - emergencyReferralRate - (withComplications / 0.12)) * dt;\n      const dPostpartum = (deliveryToPostpartum + complicationToPostpartum + homeToPostpartum - postpartumExit) * dt;\n\n      pregnantWomen = Math.max(50, pregnantWomen + dPregnant);\n      inANC = Math.max(20, inANC + dANC);\n      inFacilityDelivery = Math.max(5, inFacilityDelivery + dFacilityDelivery);\n      withComplications = Math.max(2, withComplications + dComplications);\n      inPostpartum = Math.max(50, inPostpartum + dPostpartum);\n\n      // Record monthly snapshots\n      if (step > 0 && step % Math.round(1 / dt) === 0) {\n        const calculatedMMR = currentMonthAccumulatedBirths > 0\n          ? Math.round((currentMonthAccumulatedDeaths / currentMonthAccumulatedBirths) * 100000)\n          : district.baselineMMR;\n\n        rollingObservedMMR = rollingObservedMMR * 0.7 + calculatedMMR * 0.3;\n\n        const calculatedANC = Math.min(99, Math.round((inANC / Math.max(1, pregnantWomen)) * 100 * 1.15));\n        const calculatedFacilityDelivery = Math.min(99, Math.round((totalInstitutionalDeliveries / Math.max(0.1, totalInstitutionalDeliveries + totalHomeDeliveries)) * 100));\n\n        monthlySnapshots.push({\n          timeMonth: currentMonth,\n          pregnantWomen: Math.round(pregnantWomen),\n          inANC: Math.round(inANC),\n          inFacilityDelivery: Math.round(inFacilityDelivery),\n          inPostpartum: Math.round(inPostpartum),\n          withComplications: Math.round(withComplications),\n          monthlyBirths: Math.round(currentMonthAccumulatedBirths),\n          monthlyMaternalDeaths: Math.round(currentMonthAccumulatedDeaths * 10) / 10,\n          monthlyLivesSaved: Math.max(0, Math.round((baselineStepDeaths * 10 - currentMonthAccumulatedDeaths) * 10) / 10),\n          calculatedMMR: Math.max(80, calculatedMMR),\n          ancCoveragePercent: calculatedANC,\n          facilityDeliveryPercent: calculatedFacilityDelivery,\n          systemTrustLevel: Math.round(systemTrust * 100) / 100,\n          facilityCongestionIndex: Math.round(congestionIndex * 100) / 100,\n          phase2DelayHours: Math.round(phase2Delay * 10) / 10,\n        });\n\n        currentMonthAccumulatedBirths = 0;\n        currentMonthAccumulatedDeaths = 0;\n      }"
      replacement_content: "      // Effective Geographic Access & Phase 2 Delay (Transit Hours)\n      const phase2Delay = Math.max(\n        0.4,\n        params.travelTimeHours * (1.6 - 0.6 * params.roadQualityIndex) +\n        (params.transportCostUSD > 5 ? 0.8 : 0.1)\n      );\n\n      // Effective Clinical Triage & Phase 3 Delay (Intra-Hospital Definitive Care Hours)\n      // Modulated stochastically by blood cold-chain stockouts, uterotonic shortages, and midwife/doctor availability\n      const bloodShortagePenalty = Math.max(0, (1 - params.bloodAvailabilityRate) * 2.6);\n      const uterotonicShortagePenalty = Math.max(0, (1 - params.oxytocinMisoprostolStockRate) * 2.1);\n      const staffShortagePenalty = Math.max(0, (1 - Math.min(1.2, params.skilledStaffRatio / 2.2)) * 1.8);\n      const phase3Delay = Math.max(\n        0.2,\n        0.35 + bloodShortagePenalty + uterotonicShortagePenalty + staffShortagePenalty + Math.max(0, congestionIndex - 1.0) * 1.4\n      );\n\n      // Effective Willingness / Financial Access\n      const financialAffordability = Math.max(\n        0.2,\n        params.insuranceCoverageRate * 0.5 +\n        (1 - Math.min(1, params.facilityDeliveryFeeUSD / 25)) * 0.35 +\n        params.maternalEducationRate * 0.15\n      );\n\n      // --- COMPUTE FLOW RATES ---\n      // Flow 1: Pregnant women seeking ANC (Inflow to S2 from S1)\n      const ancPropensity = Math.min(0.98, 0.45 + 0.35 * systemTrust + 0.2 * params.maternalEducationRate - 0.15 * (params.avgDistanceKm / 60));\n      const rateToANC = (pregnantWomen / 3.0) * ancPropensity;\n\n      // Flow 2: Transition from ANC to Institutional Delivery vs Home Delivery\n      const facilityDeliveryPropensity = Math.min(\n        0.98,\n        0.3 + 0.35 * financialAffordability + 0.2 * systemTrust + 0.15 * qualityFactor - 0.18 * Math.max(0, (phase2Delay - 1.5) / 3)\n      );\n      const deliveryFromANC = (inANC / 4.5) * facilityDeliveryPropensity;\n      const homeDeliveryFromANC = (inANC / 4.5) * (1 - facilityDeliveryPropensity);\n\n      // Flow 3: Direct Pregnant Women Delivery without ANC\n      const directFacilityDelivery = (pregnantWomen / 7.5) * (1 - ancPropensity) * (facilityDeliveryPropensity * 0.6);\n      const directHomeDelivery = (pregnantWomen / 7.5) * (1 - ancPropensity) * (1 - facilityDeliveryPropensity * 0.6);\n\n      // Total Deliveries\n      const totalInstitutionalDeliveries = deliveryFromANC + directFacilityDelivery;\n      const totalHomeDeliveries = homeDeliveryFromANC + directHomeDelivery;\n\n      // Flow 4: Complication Inflows (15% base + risk moderators)\n      const complicationRisk = params.baselineComplicationRate * (1.1 - 0.2 * params.maternalEducationRate);\n      const complicationsFromANC = (inANC / 4.5) * complicationRisk * 0.4;\n      const complicationsFromHome = totalHomeDeliveries * complicationRisk;\n      const complicationsFromFacility = totalInstitutionalDeliveries * complicationRisk;\n      const totalComplicationInflow = complicationsFromANC + complicationsFromHome + complicationsFromFacility;\n\n      // Flow 5: Emergency Referrals from Complications into Facility Care\n      // TBA Training significantly boosts referral from community/home complications\n      const tbaReferralBoost = 1.0 + (1 - params.tbaInfluenceFactor) * 0.8;\n      const emergencyReferralRate = (withComplications / Math.max(0.1, phase2Delay * 0.15)) * Math.min(1.0, 0.45 * tbaReferralBoost * (params.roadQualityIndex + 0.3));\n\n      // Flow 6: Complication Case Fatality & Deaths\n      // Institutional delivery with high quality drastically lowers fatality (< 1%)\n      // Phase 3 delay (blood/oxytocin deficit) and Phase 2 delay interact non-linearly\n      const phase3FatalityMultiplier = 1.0 + Math.max(0, (phase3Delay - 0.8) * 0.65);\n      const institutionalCaseFatality = Math.max(0.005, 0.040 * (1 - qualityFactor) * phase3FatalityMultiplier * (1 + Math.max(0, congestionIndex - 1.0) * 0.5));\n      const emergencyReferralCaseFatality = Math.max(0.015, 0.11 * (phase2Delay / 3.5) * phase3FatalityMultiplier * (1 - qualityFactor * 0.6));\n      const homeComplicationCaseFatality = Math.max(0.08, 0.28 * (1 - params.maternalEducationRate * 0.3));\n\n      const monthlyInstitutionalDeaths = (inFacilityDelivery / 0.1) * 0.0008 + (withComplications * 0.5) * institutionalCaseFatality;\n      const monthlyEmergencyDeaths = emergencyReferralRate * emergencyReferralCaseFatality;\n      const monthlyHomeDeaths = (totalHomeDeliveries * complicationRisk) * homeComplicationCaseFatality;\n\n      const totalStepDeaths = (monthlyInstitutionalDeaths + monthlyEmergencyDeaths + monthlyHomeDeaths) * dt;\n      const totalStepBirths = (totalInstitutionalDeliveries + totalHomeDeliveries) * dt;\n\n      currentMonthAccumulatedDeaths += totalStepDeaths;\n      currentMonthAccumulatedBirths += totalStepBirths;\n      cumulativeDeaths += totalStepDeaths;\n      cumulativeBirths += totalStepBirths;\n\n      // Calculate baseline comparison deaths (without intervention)\n      const baselineStepDeaths = totalStepBirths * (district.baselineMMR / 100000);\n      baselineCumulativeDeaths += baselineStepDeaths;\n\n      // Flow 7: Postpartum Recovery & Exit\n      const deliveryToPostpartum = (inFacilityDelivery / 0.08) * (1 - institutionalCaseFatality);\n      const complicationToPostpartum = (withComplications / 0.12) * (1 - (institutionalCaseFatality + emergencyReferralCaseFatality));\n      const homeToPostpartum = (totalHomeDeliveries / 0.05);\n      const postpartumExit = inPostpartum / 1.4; // 42 days\n\n      // --- DERIVATIVE UPDATES (Euler / RK integration) ---\n      const dPregnant = (monthlyPregnancies - rateToANC - (pregnantWomen / 7.5)) * dt;\n      const dANC = (rateToANC - (inANC / 4.5)) * dt;\n      const dFacilityDelivery = (totalInstitutionalDeliveries + emergencyReferralRate - (inFacilityDelivery / 0.08)) * dt;\n      const dComplications = (totalComplicationInflow - emergencyReferralRate - (withComplications / 0.12)) * dt;\n      const dPostpartum = (deliveryToPostpartum + complicationToPostpartum + homeToPostpartum - postpartumExit) * dt;\n\n      pregnantWomen = Math.max(50, pregnantWomen + dPregnant);\n      inANC = Math.max(20, inANC + dANC);\n      inFacilityDelivery = Math.max(5, inFacilityDelivery + dFacilityDelivery);\n      withComplications = Math.max(2, withComplications + dComplications);\n      inPostpartum = Math.max(50, inPostpartum + dPostpartum);\n\n      // Record monthly snapshots\n      if (step > 0 && step % Math.round(1 / dt) === 0) {\n        const calculatedMMR = currentMonthAccumulatedBirths > 0\n          ? Math.round((currentMonthAccumulatedDeaths / currentMonthAccumulatedBirths) * 100000)\n          : district.baselineMMR;\n\n        rollingObservedMMR = rollingObservedMMR * 0.7 + calculatedMMR * 0.3;\n\n        const calculatedANC = Math.min(99, Math.round((inANC / Math.max(1, pregnantWomen)) * 100 * 1.15));\n        const calculatedFacilityDelivery = Math.min(99, Math.round((totalInstitutionalDeliveries / Math.max(0.1, totalInstitutionalDeliveries + totalHomeDeliveries)) * 100));\n\n        monthlySnapshots.push({\n          timeMonth: currentMonth,\n          pregnantWomen: Math.round(pregnantWomen),\n          inANC: Math.round(inANC),\n          inFacilityDelivery: Math.round(inFacilityDelivery),\n          inPostpartum: Math.round(inPostpartum),\n          withComplications: Math.round(withComplications),\n          monthlyBirths: Math.round(currentMonthAccumulatedBirths),\n          monthlyMaternalDeaths: Math.round(currentMonthAccumulatedDeaths * 10) / 10,\n          monthlyLivesSaved: Math.max(0, Math.round((baselineStepDeaths * 10 - currentMonthAccumulatedDeaths) * 10) / 10),\n          calculatedMMR: Math.max(80, calculatedMMR),\n          ancCoveragePercent: calculatedANC,\n          facilityDeliveryPercent: calculatedFacilityDelivery,\n          systemTrustLevel: Math.round(systemTrust * 100) / 100,\n          facilityCongestionIndex: Math.round(congestionIndex * 100) / 100,\n          phase2DelayHours: Math.round(phase2Delay * 10) / 10,\n          phase3DelayHours: Math.round(phase3Delay * 10) / 10,\n        });\n\n        currentMonthAccumulatedBirths = 0;\n        currentMonthAccumulatedDeaths = 0;\n      }"
    }
