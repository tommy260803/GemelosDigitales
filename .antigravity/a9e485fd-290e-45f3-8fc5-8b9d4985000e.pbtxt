        }
        lines {
          text: "  ) => {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const { minLat, maxLat, minLng, maxLng } = demGrid.bounds;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // Normalize coordinates in -1 to 1 local space"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const u = ((lng - minLng) / (maxLng - minLng) - 0.5) * 2; // -1 (West) to 1 (East)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const v = ((lat - minLat) / (maxLat - minLat) - 0.5) * 2; // -1 (South) to 1 (North)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // Normalize altitude relative to district relief span"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const elevSpan = Math.max(200, demGrid.maxAltitude - demGrid.minAltitude);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const zNorm = ((altitudeMeters - demGrid.minAltitude) / elevSpan) * 1.8 * verticalExaggeration;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // Convert Euler angles (Pitch & Yaw) to Radians"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const radYaw = (yaw * Math.PI) / 180;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const radPitch = (pitch * Math.PI) / 180;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // Rotate around Z axis (Yaw)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const rotX = u * Math.cos(radYaw) - v * Math.sin(radYaw);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const rotY = u * Math.sin(radYaw) + v * Math.cos(radYaw);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // Project with Pitch & Perspective"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const scaleFactor = Math.min(canvasWidth, canvasHeight) * 0.38 * zoom;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const projX = canvasWidth / 2 + panOffset.x + rotX * scaleFactor;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const projY = canvasHeight / 2 + panOffset.y + (rotY * Math.sin(radPitch) - zNorm * Math.cos(radPitch) * 0.65) * scaleFactor;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    return { x: projX, y: projY, depth: rotY * Math.cos(radPitch) + zNorm * Math.sin(radPitch) };"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  }, [demGrid, yaw, pitch, zoom, panOffset, verticalExaggeration]);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  // Auto-rotation animation loop"
