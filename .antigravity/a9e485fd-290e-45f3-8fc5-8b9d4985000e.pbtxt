        }
        lines {
          text: "      params.insuranceCoverageRate = Math.max(0.95, baseParams.insuranceCoverageRate);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    if (scenarioId === \'scenario_c\' || scenarioId === \'scenario_d\') {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      params.tbaInfluenceFactor = Math.min(0.15, baseParams.tbaInfluenceFactor * 0.3);"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "      params.communityTrustBaseline = Math.max(0.88, baseParams.communityTrustBaseline);"
