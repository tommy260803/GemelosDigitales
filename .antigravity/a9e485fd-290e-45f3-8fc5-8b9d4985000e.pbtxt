          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        # 1. Flow to ANC (from S1)"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        anc_propensity = np.clip(0.45 + 0.35 * system_trust - 0.15 * (params.get(\"avg_distance_km\", 25.0) / 60.0), 0.1, 0.98)"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        flow_anc = (W / 3.0) * anc_propensity"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        "
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        # 2. Flow to Facility Delivery vs Home Delivery"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        facility_propensity = np.clip(0.3 + 0.35 * affordability + 0.2 * system_trust + 0.15 * quality_factor - 0.18 * max(0.0, (phase2_delay - 1.5) / 3.0), 0.1, 0.98)"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        flow_anc_to_facility = (A / 4.5) * facility_propensity"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        flow_anc_to_home = (A / 4.5) * (1.0 - facility_propensity)"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        "
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        total_facility_deliveries = flow_anc_to_facility + (W / 7.5) * (1.0 - anc_propensity) * (facility_propensity * 0.6)"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        "
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        # 3. Complications"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        flow_complications = (total_facility_deliveries + (A / 4.5) * 0.4) * complication_rate"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        "
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        # 4. Emergency Referral"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        emergency_referral = (C / max(0.1, phase2_delay * 0.15)) * np.clip(0.45 * tba_boost * (params.get(\"road_quality\", 0.5) + 0.3), 0.1, 1.0)"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        "
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        # 5. Recovery & Postpartum"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        recovery_facility = (D / 0.08) * 0.98"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        recovery_complications = (C / 0.12) * 0.92"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        flow_postpartum_exit = P / 1.4"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        "
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        # ODE Equations"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        dW_dt = monthly_pregnancies - flow_anc - (W / 7.5)"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        dA_dt = flow_anc - (A / 4.5)"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        dD_dt = total_facility_deliveries + emergency_referral - (D / 0.08)"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        dC_dt = flow_complications - emergency_referral - (C / 0.12)"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        dP_dt = recovery_facility + recovery_complications - flow_postpartum_exit"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        "
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        return [dW_dt, dA_dt, dD_dt, dP_dt, dC_dt]`,"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "    def simulate_district(district_data: Dict[str, Any], scenario_id: str = \"baseline\", months: int = 36):"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        annual_births = district_data.get(\"annual_births\", 29400)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        n_b = annual_births / 12.0  # Monthly births"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        baseline_mmr = district_data.get(\"baseline_mmr\", 646.0)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        # Base parameters"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        base_inst_deliv = district_data.get(\"institutional_delivery_rate\", 46.5) / 100.0"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        base_anc = district_data.get(\"anc1_coverage\", 62.4) / 100.0"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        base_travel_time = district_data.get(\"avg_travel_time_hours\", 3.9)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        base_fee = 18.0 if district_data.get(\"insurance_coverage\", 11.2) <= 50.0 else 2.5"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        base_tba = district_data.get(\"tba_prevalence\", 48.0) / 100.0"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        base_road_quality = max(0.2, 1.0 - (district_data.get(\"avg_distance_km\", 38.5) / 80.0))"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        base_quality = min(1.0, (district_data.get(\"skilled_staff\", 1.1) / 3.0) * 0.4 + "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                                (district_data.get(\"blood_bank\", 42.0) / 100.0) * 0.3 + "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                                (district_data.get(\"drugs_avail\", 68.0) / 100.0) * 0.3)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        base_comp_risk = 0.15 * (1.05 - 0.1 * (district_data.get(\"female_edu\", 22.4) / 100.0))"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        # Scenario overrides (a: moto-ambulance, b: free fees, c: TBA training, d: combined)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        travel_time = base_travel_time"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        facility_fee = base_fee"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        tba_prev = base_tba"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        road_quality = base_road_quality"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        quality = base_quality"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        trust = 0.75"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        if scenario_id in (\"scenario_a\", \"scenario_d\"):"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            travel_time = min(base_travel_time * 0.28, 0.9)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            road_quality = max(0.85, base_road_quality)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        if scenario_id in (\"scenario_b\", \"scenario_d\"):"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            facility_fee = 0.0"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        if scenario_id in (\"scenario_c\", \"scenario_d\"):"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            tba_prev = min(0.15, base_tba * 0.3)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            trust = 0.88"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        if scenario_id == \"scenario_d\":"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            trust = 0.92"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            quality = max(0.88, quality)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        # Baseline calibration scale"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        base_referral_propensity = np.clip(0.70 - (base_travel_time / 12.0) - (base_tba * 0.25) + (base_road_quality * 0.15), 0.20, 0.85)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        base_home_weight = (1.0 - base_inst_deliv) * ("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            (1.0 - base_referral_propensity) * 1.0 +"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            base_referral_propensity * (0.22 + 0.38 * (base_travel_time / 5.0)) * (1.0 - 0.5 * base_quality)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        )"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        base_inst_weight = base_inst_deliv * 0.12 * (1.0 - 0.7 * base_quality)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        base_risk_score = (base_home_weight + base_inst_weight) * base_comp_risk"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        calib_scale = (n_b * (baseline_mmr / 100000.0)) / max(0.0001, n_b * base_risk_score)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        # Initial Stocks"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        monthly_pregnancies = n_b * 1.05"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        y0 = ["
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            monthly_pregnancies * 7.5,           # S1: Pregnant"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            monthly_pregnancies * 7.5 * base_anc * 0.75, # S2: ANC"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            n_b * base_inst_deliv * (3.0 / 30.0), # S3: Facility Delivery"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            n_b * 1.4,                           # S4: Postpartum"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            n_b * base_comp_risk * (2.0 / 30.0)  # S5: Complications"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        ]"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        def ode_rhs(t, y):"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            W, A, D, P, C = y"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            fee_benefit = max(0.0, (base_fee - facility_fee) / 25.0)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            travel_benefit = max(0.0, (base_travel_time - travel_time) / max(1.0, base_travel_time))"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            tba_benefit = max(0.0, base_tba - tba_prev)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            quality_benefit = max(0.0, quality - base_quality)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            anc_rate = np.clip(base_anc * (1.0 + 0.15 * fee_benefit + 0.12 * tba_benefit), 0.15, 0.98)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            inst_rate = np.clip(base_inst_deliv * (1.0 + 0.35 * fee_benefit + 0.22 * travel_benefit + 0.15 * tba_benefit + 0.15 * quality_benefit), 0.15, 0.98)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            flow_w_to_a = (W / 3.5) * (anc_rate / max(0.1, base_anc))"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            flow_w_term = W / 7.5"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            flow_a_term = A / 4.5"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            total_deliv = flow_a_term + flow_w_term"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            current_inst = total_deliv * inst_rate"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            current_home = total_deliv * (1.0 - inst_rate)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            home_comp = current_home * base_comp_risk"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            inst_comp = current_inst * base_comp_risk"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            referral_prop = np.clip(base_referral_propensity + 0.35 * travel_benefit + 0.30 * tba_benefit, 0.20, 0.94)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            emergency_ref = home_comp * referral_prop"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            unref_home_comp = home_comp * (1.0 - referral_prop)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            # Mortality flows"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            death_home = unref_home_comp * 1.0 * calib_scale"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            death_ref = emergency_ref * (0.22 + 0.38 * (travel_time / 5.0)) * (1.0 - 0.5 * quality) * calib_scale"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            death_inst = inst_comp * 0.12 * (1.0 - 0.7 * quality) * calib_scale"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            exit_d = D / 0.1"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            exit_p = P / 1.4"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            # Conservation ODEs"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            dW_dt = monthly_pregnancies - flow_w_to_a - flow_w_term"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            dA_dt = flow_w_to_a - flow_a_term"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            dD_dt = current_inst + emergency_ref - exit_d"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            dC_dt = home_comp - emergency_ref - (unref_home_comp / 0.15)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            dP_dt = (current_home - home_comp) + (exit_d - death_inst - death_ref) - exit_p"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            return [dW_dt, dA_dt, dD_dt, dP_dt, dC_dt]"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        sol = solve_ivp(ode_rhs, [0, months], y0, t_eval=np.linspace(0, months, months + 1), method=\"RK45\")"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        return sol`,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    \'backend/services/validation.py\': {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      language: \'python\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      description: \'Statistical validation suite: Kolmogorov-Smirnov, Wilcoxon Signed-Rank, and Sobol Sensitivity.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      content: `import numpy as np"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "from scipy import stats"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "from typing import Dict, Any, List"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "class StatisticalValidationPy:"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    @staticmethod"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    def kolmogorov_smirnov(district_data: Dict[str, Any], n_samples: int = 120):"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        mu = np.log(district_data.get(\"avg_travel_time_hours\", 3.2))"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        empirical = np.random.lognormal(mean=mu, sigma=0.52, size=n_samples)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        simulated = np.random.lognormal(mean=mu, sigma=0.49, size=n_samples)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        "
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        stat_d, p_val = stats.ks_2samp(empirical, simulated)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        return {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            \"statistic_d\": round(float(stat_d), 4),"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            \"p_value\": round(float(p_val), 4),"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            \"is_statistically_equivalent\": bool(p_val > 0.05)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    @staticmethod"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    def wilcoxon_signed_rank(observed: List[float], predicted: List[float]):"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        diff = np.array(predicted) - np.array(observed)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        w_stat, p_val = stats.wilcoxon(diff)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        return {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            \"statistic_w\": float(w_stat),"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            \"p_value\": float(p_val),"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            \"is_valid\": bool(p_val > 0.05)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        }`,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
