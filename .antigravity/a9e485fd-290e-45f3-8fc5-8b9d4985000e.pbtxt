    replacement_chunks {
      replacement_content: "import io\nfrom typing import Dict, Any\nfrom reportlab.lib.pagesizes import letter\nfrom reportlab.pdfgen import canvas\nimport openpyxl\n\nclass ReportGenerationPy:\n    @staticmethod\n    def generate_pdf_bytes(district_name: str, country: str, summary: Dict[str, Any]) -> bytes:\n        buffer = io.BytesIO()\n        p = canvas.Canvas(buffer, pagesize=letter)\n        p.setFont(\"Helvetica-Bold\", 16)\n        p.drawString(50, 750, f\"Maternal Health Digital Twin: {district_name} ({country})\")\n        \n        p.setFont(\"Helvetica\", 11)\n        p.drawString(50, 720, f\"Simulated Lives Saved: {summary.get(\'lives_saved\', 0)}\")\n        p.drawString(50, 700, f\"MMR Reduction: {summary.get(\'mmr_reduction_percent\', 0)}%\")\n        p.drawString(50, 680, f\"Cost per Life Saved: ${summary.get(\'cost_per_life_saved_usd\', 0)}\")\n        p.drawString(50, 660, f\"ICER: ${summary.get(\'icer_per_daly\', 0)} per DALY averted\")\n        \n        p.showPage()\n        p.save()\n        buffer.seek(0)\n        return buffer.getvalue()\n\n    @staticmethod\n    def generate_excel_bytes(district_name: str, trajectories: list) -> bytes:\n        wb = openpyxl.Workbook()\n        ws = wb.active\n        ws.title = \"Simulation_Trajectories\"\n        \n        ws.append([\"Month\", \"Pregnant\", \"ANC\", \"Facility Delivery\", \"Postpartum\", \"Complications\"])\n        for row in trajectories:\n            ws.append([\n                row.get(\"time_month\", 0),\n                row.get(\"pregnant_women\", 0),\n                row.get(\"in_anc\", 0),\n                row.get(\"in_facility_delivery\", 0),\n                row.get(\"in_postpartum\", 0),\n                row.get(\"with_complications\", 0)\n            ])\n            \n        buffer = io.BytesIO()\n        wb.save(buffer)\n        buffer.seek(0)\n        return buffer.getvalue()\n"
    }
