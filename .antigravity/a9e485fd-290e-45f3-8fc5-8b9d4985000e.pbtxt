        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const baseHomeWeight = (1 - baseInstDelivRate) * ("
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      (1 - baseReferralPropensity) * 1.0 +"
