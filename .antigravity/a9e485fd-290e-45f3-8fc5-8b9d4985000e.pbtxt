    command_line: "npx tsx -e \"\nimport { SUB_SAHARAN_DISTRICTS } from \'./src/data/districts\';\n\n// Prototype new calibrated engine\nfunction testModel(district) {\n  const annualBirths = district.annualBirths;\n  const N_B = annualBirths / 12; // monthly births\n  const baselineMMR = district.baselineMMR;\n\n  // Let\'s test baseline vs scenario_a, b, c, d\n  const scenarios = {\n    baseline: { travelTime: district.avgTravelTimeHours, fee: district.insuranceCoverage > 50 ? 2.5 : 18.0, tba: district.traditionalBirthAttendantPrevalence / 100, drug: district.essentialDrugsAvailability / 100, blood: district.bloodBankAvailability / 100, staff: district.skilledStaffRatio },\n    scenario_a: { travelTime: 0.9, fee: district.insuranceCoverage > 50 ? 2.5 : 18.0, tba: district.traditionalBirthAttendantPrevalence / 100, drug: district.essentialDrugsAvailability / 100, blood: district.bloodBankAvailability / 100, staff: district.skilledStaffRatio },\n    scenario_b: { travelTime: district.avgTravelTimeHours, fee: 0.0, tba: district.traditionalBirthAttendantPrevalence / 100, drug: district.essentialDrugsAvailability / 100, blood: district.bloodBankAvailability / 100, staff: district.skilledStaffRatio },\n    scenario_c: { travelTime: district.avgTravelTimeHours, fee: district.insuranceCoverage > 50 ? 2.5 : 18.0, tba: 0.15, drug: district.essentialDrugsAvailability / 100, blood: district.bloodBankAvailability / 100, staff: district.skilledStaffRatio },\n    scenario_d: { travelTime: 0.9, fee: 0.0, tba: 0.15, drug: Math.max(0.92, district.essentialDrugsAvailability / 100), blood: Math.max(0.85, district.bloodBankAvailability / 100), staff: Math.max(1.8, district.skilledStaffRatio) }\n  };\n\n  console.log(\'--- Testing \' + district.name + \' (Baseline MMR: \' + baselineMMR + \') ---\');\n\n  for (const [sId, p] of Object.entries(scenarios)) {\n    // Calculate dynamic rates\n    // 1. ANC Coverage\n    const ancRate = Math.min(0.95, (district.anc1Coverage / 100) * (p.fee === 0 ? 1.15 : 1.0) * (p.tba <= 0.2 ? 1.12 : 1.0));\n    \n    // 2. Institutional Delivery Rate\n    const financialFactor = p.fee === 0 ? 0.35 : Math.max(0.05, 0.35 - (p.fee / 50));\n    const distanceFactor = Math.max(0.05, 0.40 - (p.travelTime / 12));\n    const instDelivRate = Math.min(0.95, Math.max(0.20, (district.institutionalDeliveryRate / 100) * (p.fee === 0 ? 1.30 : 1.0) * (p.travelTime < 1.5 ? 1.18 : 1.0) * (p.tba <= 0.2 ? 1.10 : 1.0)));\n\n    const instBirths = N_B * instDelivRate;\n    const homeBirths = N_B * (1 - instDelivRate);\n\n    // 3. Complications (WHO 15% of all births)\n    const compRate = 0.15;\n    const homeComplications = homeBirths * compRate;\n    const instComplications = instBirths * compRate;\n\n    // 4. Emergency Referral from Home Complications\n    // With moto-ambulance (travelTime < 1.5) and TBA training (tba <= 0.2), referral rate is high (75-90%)\n    // In baseline with long delays and high TBA home delivery, referral rate is lower (30-45%)\n    const baseReferralRate = Math.max(0.25, 0.65 - (p.travelTime / 10) - (p.tba * 0.25));\n    const referralRate = p.tba <= 0.2 ? Math.min(0.90, baseReferralRate * 1.5 + (p.travelTime < 1.5 ? 0.20 : 0)) : Math.min(0.85, baseReferralRate + (p.travelTime < 1.5 ? 0.20 : 0));\n\n    const referredHomeComplications = homeComplications * referralRate;\n    const unreferredHomeComplications = homeComplications * (1 - referralRate);\n\n    // 5. Case Fatality Rates (CFR)\n    // Untreated home complication CFR is ~18-25%\n    const cfrHomeUntreated = 0.22;\n    const homeDeaths = unreferredHomeComplications * cfrHomeUntreated;\n\n    // Quality index in facility\n    const qualityIndex = (p.staff / 3.0) * 0.35 + p.blood * 0.35 + p.drug * 0.30;\n    \n    // Emergency referred CFR depends on transit delay (Phase 2 delay) and hospital readiness (Phase 3 delay)\n    // If transit time is low (moto-ambulance), woman arrives before irreversible hypovolemic shock/eclampsia convulsions\n    const transitFatalityMultiplier = 0.5 + Math.min(1.5, p.travelTime / 3.0);\n    const cfrReferred = Math.max(0.012, 0.055 * transitFatalityMultiplier * (1 - qualityIndex * 0.55));\n    const emergencyDeaths = referredHomeComplications * cfrReferred;\n\n    // In-facility planned delivery complication CFR (detected early with partograph, immediate IV oxytocin / C-section)\n    const cfrInstPlanned = Math.max(0.004, 0.022 * (1 - qualityIndex * 0.60));\n    const instDeaths = instComplications * cfrInstPlanned;\n\n    // Total monthly maternal deaths\n    const totalMonthlyDeaths = homeDeaths + emergencyDeaths + instDeaths;\n    const simulatedMMR = Math.round((totalMonthlyDeaths / N_B) * 100000);\n\n    const redPercent = Math.round(((baselineMMR - simulatedMMR) / baselineMMR) * 1000) / 10;\n    const monthlyLivesSaved = Math.round(((baselineMMR / 100000) * N_B - totalMonthlyDeaths) * 10) / 10;\n    const totalLivesSaved36m = Math.round(monthlyLivesSaved * 36);\n\n    console.log(sId.padEnd(12) + \' -> MMR: \' + simulatedMMR + \' | Red%: \' + redPercent + \'% | 36m Lives Saved: \' + totalLivesSaved36m + \' | Deaths/mo: \' + totalMonthlyDeaths.toFixed(1));\n  }\n}\n\ntestModel(SUB_SAHARAN_DISTRICTS.find(d => d.id === \'ke-garissa\'));\n\""
    proposed_command_line: "npx tsx -e \"\nimport { SUB_SAHARAN_DISTRICTS } from \'./src/data/districts\';\n\n// Prototype new calibrated engine\nfunction testModel(district) {\n  const annualBirths = district.annualBirths;\n  const N_B = annualBirths / 12; // monthly births\n  const baselineMMR = district.baselineMMR;\n\n  // Let\'s test baseline vs scenario_a, b, c, d\n  const scenarios = {\n    baseline: { travelTime: district.avgTravelTimeHours, fee: district.insuranceCoverage > 50 ? 2.5 : 18.0, tba: district.traditionalBirthAttendantPrevalence / 100, drug: district.essentialDrugsAvailability / 100, blood: district.bloodBankAvailability / 100, staff: district.skilledStaffRatio },\n    scenario_a: { travelTime: 0.9, fee: district.insuranceCoverage > 50 ? 2.5 : 18.0, tba: district.traditionalBirthAttendantPrevalence / 100, drug: district.essentialDrugsAvailability / 100, blood: district.bloodBankAvailability / 100, staff: district.skilledStaffRatio },\n    scenario_b: { travelTime: district.avgTravelTimeHours, fee: 0.0, tba: district.traditionalBirthAttendantPrevalence / 100, drug: district.essentialDrugsAvailability / 100, blood: district.bloodBankAvailability / 100, staff: district.skilledStaffRatio },\n    scenario_c: { travelTime: district.avgTravelTimeHours, fee: district.insuranceCoverage > 50 ? 2.5 : 18.0, tba: 0.15, drug: district.essentialDrugsAvailability / 100, blood: district.bloodBankAvailability / 100, staff: district.skilledStaffRatio },\n    scenario_d: { travelTime: 0.9, fee: 0.0, tba: 0.15, drug: Math.max(0.92, district.essentialDrugsAvailability / 100), blood: Math.max(0.85, district.bloodBankAvailability / 100), staff: Math.max(1.8, district.skilledStaffRatio) }\n  };\n\n  console.log(\'--- Testing \' + district.name + \' (Baseline MMR: \' + baselineMMR + \') ---\');\n\n  for (const [sId, p] of Object.entries(scenarios)) {\n    // Calculate dynamic rates\n    // 1. ANC Coverage\n    const ancRate = Math.min(0.95, (district.anc1Coverage / 100) *