        }
        lines {
          text: "      params.tbaInfluenceFactor = Math.min(0.12, baseParams.tbaInfluenceFactor * 0.25);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      params.communityTrustBaseline = Math.max(0.90, baseParams.communityTrustBaseline);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    if (scenarioId === \'scenario_d\') {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      params.bloodAvailabilityRate = Math.max(0.92, baseParams.bloodAvailabilityRate);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      params.oxytocinMisoprostolStockRate = Math.max(0.95, baseParams.oxytocinMisoprostolStockRate);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      params.skilledStaffRatio = Math.max(baseParams.skilledStaffRatio, 2.2);"
