    replacement_chunks {
      target_content: "export const Navbar: React.FC<NavbarProps> = ({\n  currentTab,\n  onTabChange,\n  selectedDistrict,\n  onDistrictChange,\n  onOpenCopilot,\n  onExportPDF,\n  onExportExcel,\n}) => {\n  const countries: Country[] = [\'Kenya\', \'Tanzania\', \'Uganda\', \'Ghana\', \'Ethiopia\'];\n  const isHighRiskDistrict = selectedDistrict.baselineMMR >= 500;\n\n  return (\n    <header className=\"sticky top-0 z-40 bg-slate-900/95 backdrop-blur border-b border-slate-800 shadow-md\">\n      {/* Top Banner */}\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"flex items-center justify-between h-16\">\n          \n          {/* Logo & Branding */}\n          <div className=\"flex items-center space-x-3\">\n            <div className=\"w-10 h-10 rounded-xl bg-gradient-to-tr from-teal-600 to-cyan-500 flex items-center justify-center shadow-lg shadow-teal-500/20\">\n              <Activity className=\"w-6 h-6 text-white\" />\n            </div>\n            <div>\n              <div className=\"flex items-center space-x-2\">\n                <span className=\"font-bold text-lg text-white tracking-tight\">MATERNAL-TWIN</span>\n                <span className=\"text-xs px-2 py-0.5 rounded-full bg-teal-500/20 text-teal-300 font-semibold border border-teal-500/30\">\n                  SD v2.4\n                </span>\n                {isHighRiskDistrict && (\n                  <span className=\"hidden sm:inline-flex items-center text-xs px-2 py-0.5 rounded-full bg-rose-500/20 text-rose-300 font-medium border border-rose-500/30\">\n                    <AlertTriangle className=\"w-3 h-3 mr-1\" /> High MMR Bottleneck\n                  </span>\n                )}\n              </div>\n              <p className=\"text-xs text-slate-400 hidden sm:block\">\n                System Dynamics Digital Twin for Maternal Mortality Prevention in Sub-Saharan Africa\n              </p>\n            </div>\n          </div>\n\n          {/* District & Country Selector */}\n          <div className=\"flex items-center space-x-3\">\n            <div className=\"flex items-center bg-slate-800/90 border border-slate-700 rounded-lg px-2.5 py-1.5 shadow-inner\">\n              <MapPin className=\"w-4 h-4 text-teal-400 mr-2 shrink-0\" />\n              <select\n                id=\"district-selector\"\n                value={selectedDistrict.id}\n                onChange={(e) => {\n                  const d = SUB_SAHARAN_DISTRICTS.find((item) => item.id === e.target.value);\n                  if (d) onDistrictChange(d);\n                }}\n                className=\"bg-transparent text-sm font-medium text-slate-100 focus:outline-none cursor-pointer pr-2\"\n              >\n                {countries.map((c) => (\n                  <optgroup key={c} label={`\342\200\224 ${c.toUpperCase()} \342\200\224`} className=\"bg-slate-900 text-slate-200\">\n                    {SUB_SAHARAN_DISTRICTS.filter((d) => d.country === c).map((dist) => (\n                      <option key={dist.id} value={dist.id} className=\"bg-slate-900 text-slate-100\">\n                        {dist.name} (MMR: {dist.baselineMMR})\n                      </option>\n                    ))}\n                  </optgroup>\n                ))}\n              </select>\n            </div>\n\n            {/* AI Advisor Button */}\n            <button\n              id=\"btn-open-copilot\"\n              onClick={onOpenCopilot}\n              className=\"flex items-center space-x-1.5 px-3 py-1.5 rounded-lg bg-gradient-to-r from-teal-600 to-emerald-600 text-white text-xs font-semibold hover:from-teal-500 hover:to-emerald-500 transition shadow-sm cursor-pointer\"\n            >\n              <Sparkles className=\"w-3.5 h-3.5\" />\n              <span>AI Copilot</span>\n            </button>\n\n            {/* Quick Export Menu */}\n            <div className=\"hidden md:flex items-center space-x-1 bg-slate-800/80 border border-slate-700/80 rounded-lg p-0.5\">\n              <button\n                id=\"btn-export-pdf-nav\"\n                onClick={onExportPDF}\n                title=\"Download Executive PDF\"\n                className=\"px-2.5 py-1 text-xs text-slate-300 hover:text-white hover:bg-slate-700 rounded transition flex items-center space-x-1\"\n              >\n                <FileText className=\"w-3.5 h-3.5 text-rose-400\" />\n                <span>PDF</span>\n              </button>\n              <button\n                id=\"btn-export-excel-nav\"\n                onClick={onExportExcel}\n                title=\"Download Excel Workbook\"\n                className=\"px-2.5 py-1 text-xs text-slate-300 hover:text-white hover:bg-slate-700 rounded transition flex items-center space-x-1\"\n              >\n                <Download className=\"w-3.5 h-3.5 text-emerald-400\" />\n                <span>XLSX</span>\n              </button>\n            </div>\n          </div>\n\n        </div>\n\n        {/* Navigation Tabs */}\n        <nav className=\"flex space-x-1 overflow-x-auto py-1 scrollbar-none border-t border-slate-800/60\">\n          {[\n            { id: \'dashboard\', label: \'Executive Dashboard\', icon: Activity },\n            { id: \'causal-model\', label: \'Causal Loop & Stock-Flow\', icon: GitMerge },\n            { id: \'scenarios\', label: \'Scenario Matrix (a, b, c, d)\', icon: Layers },\n            { id: \'equity\', label: \'Wealth Quintile Equity\', icon: Scale },\n            { id: \'validation\', label: \'Statistical Validation & Sobol\', icon: CheckCircle2 },\n            { id: \'reports\', label: \'Automated Reports\', icon: FileText },\n            { id: \'code-arch\', label: \'Monorepo & Python Backend\', icon: Code2 },\n          ].map((tab) => {\n            const Icon = tab.icon;\n            const isActive = currentTab === tab.id;\n            return (\n              <button\n                key={tab.id}\n                id={`tab-${tab.id}`}\n                onClick={() => onTabChange(tab.id)}\n                className={`flex items-center space-x-2 px-3.5 py-2 rounded-lg text-xs font-medium whitespace-nowrap transition-all ${\n                  isActive\n                    ? \'bg-teal-500/15 text-teal-300 border border-teal-500/40 shadow-sm\'\n                    : \'text-slate-400 hover:text-slate-200 hover:bg-slate-800/60\'\n                }`}\n              >\n                <Icon className={`w-4 h-4 ${isActive ? \'text-teal-400\' : \'text-slate-400\'}`} />\n                <span>{tab.label}</span>\n              </button>\n            );\n          })}\n        </nav>\n      </div>\n    </header>\n  );\n};"
      replacement_content: "export const Navbar: React.FC<NavbarProps> = ({\n  currentTab,\n  onTabChange,\n  selectedDistrict,\n  onDistrictChange,\n  onOpenCopilot,\n  onExportPDF,\n  onExportExcel,\n}) => {\n  const countries: Country[] = [\'Kenya\', \'Tanzania\', \'Uganda\', \'Ghana\', \'Ethiopia\'];\n  const isHighRiskDistrict = selectedDistrict.baselineMMR >= 500;\n\n  return (\n    <header className=\"sticky top-0 z-40 bg-[#0c0e12]/95 backdrop-blur-md border-b border-slate-800 shadow-sm\">\n      {/* Top Banner */}\n      <div className=\"max-w-7xl mx-auto px-3 sm:px-4 lg:px-6\">\n        <div className=\"flex items-center justify-between h-14\">\n          \n          {/* Logo & Branding */}\n          <div className=\"flex items-center space-x-3\">\n            <div className=\"w-8 h-8 rounded bg-slate-800 border border-slate-700 flex items-center justify-center text-sky-400 font-mono font-bold text-xs\">\n              <Activity className=\"w-4 h-4 text-sky-400\" />\n            </div>\n            <div>\n              <div className=\"flex items-center space-x-2\">\n                <h1 className=\"text-sky-400 font-bold tracking-tighter text-base sm:text-lg uppercase\">\n                  MaternalTwin<span className=\"text-white\">AI</span>\n                </h1>\n                <span className=\"text-[9px] px-1.5 py-0.5 rounded bg-slate-800 text-slate-400 font-mono uppercase tracking-widest border border-slate-700\">\n                  PROTOCOL V4.2\n                </span>\n                {isHighRiskDistrict && (\n                  <span className=\"hidden md:inline-flex items-center text-[10px] px-1.5 py-0.5 rounded bg-rose-500/10 text-rose-400 font-mono font-bold border border-rose-500/30\">\n                    <AlertTriangle className=\"w-3 h-3 mr-1\" /> HIGH RISK MMR\n                  </span>\n                )}\n              </div>\n              <p className=\"text-[10px] text-slate-500 font-mono hidden sm:block\">\n                System Dynamics Digital Twin \342\200\242 25 SSA Districts\n              </p>\n            </div>\n          </div>\n\n          {/* District & Country Selector + Action Buttons */}\n          <div className=\"flex items-center space-x-2\">\n            <div className=\"flex items-center bg-slate-800/90 border border-slate-700 rounded px-2 py-1 text-xs shadow-inner\">\n              <MapPin className=\"w-3.5 h-3.5 text-sky-400 mr-1.5 shrink-0\" />\n              <select\n                id=\"district-selector\"\n                value={selectedDistrict.id}\n                onChange={(e) => {\n                  const d = SUB_SAHARAN_DISTRICTS.find((item) => item.id === e.target.value);\n                  if (d) onDistrictChange(d);\n                }}\n                className=\"bg-transparent text-xs font-mono font-bold text-slate-200 focus:outline-none cursor-pointer pr-1\"\n              >\n                {countries.map((c) => (\n                  <optgroup key={c} label={`\342\200\224 ${c.toUpperCase()} \342\200\224`} className=\"bg-[#0c0e12] text-slate-200\">\n                    {SUB_SAHARAN_DISTRICTS.filter((d) => d.country === c).map((dist) => (\n                      <option key={dist.id} value={dist.id} className=\"bg-[#0c0e12] text-slate-200\">\n                        {dist.name} (MMR: {dist.baselineMMR})\n                      </option>\n                    ))}\n                  </optgroup>\n                ))}\n              </select>\n            </div>\n\n            {/* AI Advisor Button */}\n            <button\n              id=\"btn-open-copilot\"\n              onClick={onOpenCopilot}\n              className=\"flex items-center space-x-1.5 px-3 py-1.5 rounded bg-sky-600 hover:bg-sky-500 text-white text-xs font-mono font-bold uppercase tracking-wider shadow-lg shadow-sky-900/20 transition cursor-pointer\"\n            >\n              <Sparkles className=\"w-3.5 h-3.5\" />\n              <span>AI COPILOT</span>\n            </button>\n\n            {/* Quick Export Menu */}\n            <div className=\"hidden sm:flex items-center space-x-1 bg-slate-800/80 border border-slate-700 rounded p-0.5\">\n              <button\n                id=\"btn-export-pdf-nav\"\n                onClick={onExportPDF}\n                title=\"Download Executive PDF\"\n                className=\"px-2 py-1 text-[11px] font-mono text-slate-300 hover:text-white hover:bg-slate-700 rounded transition flex items-center space-x-1\"\n              >\n                <FileText className=\"w-3 h-3 text-rose-400\" />\n                <span>PDF</span>\n              </button>\n              <button\n                id=\"btn-export-excel-nav\"\n                onClick={onExportExcel}\n                title=\"Download Excel Workbook\"\n                className=\"px-2 py-1 text-[11px] font-mono text-slate-300 hover:text-white hover:bg-slate-700 rounded transition flex items-center space-x-1\"\n              >\n                <Download className=\"w-3 h-3 text-emerald-400\" />\n                <span>XLSX</span>\n              </button>\n            </div>\n          </div>\n\n        </div>\n\n        {/* Navigation Tabs - High Density Row */}\n        <nav className=\"flex space-x-1 overflow-x-auto py-1.5 scrollbar-none border-t border-slate-800/80\">\n          {[\n            { id: \'dashboard\', label: \'District Overview\', icon: Activity, dot: \'bg-sky-500\' },\n            { id: \'causal-model\', label: \'System Dynamics\', icon: GitMerge, dot: \'bg-slate-500\' },\n            { id: \'scenarios\', label: \'Policy Matrix (A-D)\', icon: Layers, dot: \'bg-indigo-500\' },\n            { id: \'equity\', label: \'Wealth Quintiles\', icon: Scale, dot: \'bg-cyan-500\' },\n            { id: \'validation\', label: \'Validation (Sobol/KS)\', icon: CheckCircle2, dot: \'bg-emerald-500\' },\n            { id: \'reports\', label: \'Briefs & Exports\', icon: FileText, dot: \'bg-amber-500\' },\n            { id: \'code-arch\', label: \'Architecture & ODE\', icon: Code2, dot: \'bg-slate-400\' },\n          ].map((tab) => {\n            const Icon = tab.icon;\n            const isActive = currentTab === tab.id;\n            return (\n              <button\n                key={tab.id}\n                id={`tab-${tab.id}`}\n                onClick={() => onTabChange(tab.id)}\n                className={`flex items-center space-x-2 px-2.5 py-1 rounded text-xs font-mono transition-colors whitespace-nowrap ${\n                  isActive\n                    ? \'bg-slate-800 text-sky-400 font-bold border border-slate-700\'\n                    : \'text-slate-400 hover:text-slate-200 hover:bg-slate-800/60\'\n                }`}\n              >\n                <span className={`w-1.5 h-1.5 rounded-full ${isActive ? \'bg-sky-400\' : tab.dot}`}></span>\n                <span>{tab.label}</span>\n              </button>\n            );\n          })}\n        </nav>\n      </div>\n    </header>\n  );\n};"
    }
