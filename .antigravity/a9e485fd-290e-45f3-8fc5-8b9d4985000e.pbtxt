  file_change {
    absolute_path_uri: "file:///backend/services/system_dynamics.py"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "\"\"\"\nMaternal Health System Dynamics Differential Equation Solver\n5 Core Stocks:\n  S1: Pregnant Women (W)\n  S2: In ANC (A)\n  S3: In Facility Delivery (D)\n  S4: In Postpartum (P)\n  S5: With Complications (C)\n\"\"\"\n\nimport numpy as np\nfrom scipy.integrate import solve_ivp\nfrom typing import Dict, Any, List\n\nclass SystemDynamicsEnginePy:\n    @staticmethod\n    def ode_system(t, y, params):\n        W, A, D, P, C = y\n        \n        # Unpack parameters\n        monthly_births = params[\"annual_births\"] / 12.0\n        monthly_pregnancies = monthly_births * 1.08\n        \n        system_trust = params.get(\"community_trust\", 0.75)\n        phase2_delay = params.get(\"phase2_delay_hours\", 3.5)\n        quality_factor = params.get(\"quality_factor\", 0.65)\n        affordability = params.get(\"affordability\", 0.70)\n        complication_rate = params.get(\"baseline_complication_rate\", 0.15)\n        tba_boost = params.get(\"tba_referral_boost\", 1.0)\n        \n        # 1. Flow to ANC (from S1)\n        anc_propensity = np.clip(0.45 + 0.35 * system_trust - 0.15 * (params.get(\"avg_distance_km\", 25.0) / 60.0), 0.1, 0.98)\n        flow_anc = (W / 3.0) * anc_propensity\n        \n        # 2. Flow to Facility Delivery vs Home Delivery\n        facility_propensity = np.clip(0.3 + 0.35 * affordability + 0.2 * system_trust + 0.15 * quality_factor - 0.18 * max(0.0, (phase2_delay - 1.5) / 3.0), 0.1, 0.98)\n        flow_anc_to_facility = (A / 4.5) * facility_propensity\n        flow_anc_to_home = (A / 4.5) * (1.0 - facility_propensity)\n        \n        flow_direct_facility = (W / 7.5) * (1.0 - anc_propensity) * (facility_propensity * 0.6)\n        flow_direct_home = (W / 7.5) * (1.0 - anc_propensity) * (1.0 - facility_propensity * 0.6)\n        \n        total_facility_deliveries = flow_anc_to_facility + flow_direct_facility\n        total_home_deliveries = flow_anc_to_home + flow_direct_home\n        \n        # 3. Complications\n        flow_complications = (total_home_deliveries + total_facility_deliveries + (A / 4.5) * 0.4) * complication_rate\n        \n        # 4. Emergency Referral\n        emergency_referral = (C / max(0.1, phase2_delay * 0.15)) * np.clip(0.45 * tba_boost * (params.get(\"road_quality\", 0.5) + 0.3), 0.1, 1.0)\n        \n        # 5. Recovery & Postpartum\n        recovery_facility = (D / 0.08) * 0.98\n        recovery_complications = (C / 0.12) * 0.92\n        recovery_home = total_home_deliveries\n        flow_postpartum_exit = P / 1.4\n        \n        # ODE Equations\n        dW_dt = monthly_pregnancies - flow_anc - (W / 7.5)\n        dA_dt = flow_anc - (A / 4.5)\n        dD_dt = total_facility_deliveries + emergency_referral - (D / 0.08)\n        dC_dt = flow_complications - emergency_referral - (C / 0.12)\n        dP_dt = recovery_facility + recovery_complications + recovery_home - flow_postpartum_exit\n        \n        return [dW_dt, dA_dt, dD_dt, dP_dt, dC_dt]\n\n    @classmethod\n    def simulate(cls, district_data: Dict[str, Any], scenario_id: str = \"baseline\", horizon_months: int = 36):\n        monthly_births = district_data[\"annual_births\"] / 12.0\n        \n        # Parameter configuration based on scenario\n        params = {\n            \"annual_births\": district_data[\"annual_births\"],\n            \"avg_distance_km\": district_data.get(\"avg_distance_emonc_km\", 25.0),\n            \"phase2_delay_hours\": district_data.get(\"avg_travel_time_hours\", 3.2),\n            \"road_quality\": 0.5,\n            \"quality_factor\": 0.65,\n            \"affordability\": 0.55,\n            \"community_trust\": 0.72,\n            \"baseline_complication_rate\": 0.15,\n            \"tba_referral_boost\": 1.0\n        }\n        \n        if scenario_id == \"scenario_a\": # Moto-ambulance\n            params[\"phase2_delay_hours\"] = 0.9\n            params[\"road_quality\"] = 0.85\n        elif scenario_id == \"scenario_b\": # Fee elimination\n            params[\"affordability\"] = 0.95\n        elif scenario_id == \"scenario_c\": # TBA training\n            params[\"tba_referral_boost\"] = 1.8\n            params[\"community_trust\"] = 0.88\n        elif scenario_id == \"scenario_d\": # Combined\n            params[\"phase2_delay_hours\"] = 0.9\n            params[\"road_quality\"] = 0.85\n            params[\"affordability\"] = 0.95\n            params[\"tba_referral_boost\"] = 1.8\n            params[\"community_trust\"] = 0.92\n            \n        # Initial states\n        y0 = [\n            monthly_births * 1.08 * 7.5,\n            monthly_births * 0.7 * 3.5,\n            monthly_births * 0.6 * (2.0 / 30.0),\n            monthly_births * 1.4,\n            monthly_births * 0.15 * (3.0 / 30.0)\n        ]\n        \n        t_span = (0, horizon_months)\n        t_eval = np.linspace(0, horizon_months, horizon_months + 1)\n        \n        solution = solve_ivp(\n            fun=cls.ode_system,\n            t_span=t_span,\n            y0=y0,\n            args=(params,),\n            t_eval=t_eval,\n            method=\"RK45\"\n        )\n        \n        trajectories = []\n        for i, t in enumerate(solution.t):\n            trajectories.append({\n                \"time_month\": int(t),\n                \"pregnant_women\": round(float(solution.y[0][i])),\n                \"in_anc\": round(float(solution.y[1][i])),\n                \"in_facility_delivery\": round(float(solution.y[2][i])),\n                \"in_postpartum\": round(float(solution.y[3][i])),\n                \"with_complications\": round(float(solution.y[4][i])),\n            })\n            \n        return {\n            \"scenario_id\": scenario_id,\n            \"trajectories\": trajectories,\n            \"converged\": solution.success\n        }\n"
    }
