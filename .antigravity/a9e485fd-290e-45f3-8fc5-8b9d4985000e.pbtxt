        }
        lines {
          text: "      const flowS1toS2 = (pregnantWomen / 3.5) * (ancCoverageRate / Math.max(0.1, baseANC1Rate));"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      const flowS1toTerm = pregnantWomen / 7.5;"
