          text: "        rCol = Math.min(255, Math.round(rCol * 1.4 + 90));"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        gCol = Math.round(gCol * 0.45);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        bCol = Math.round(bCol * 0.35);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
