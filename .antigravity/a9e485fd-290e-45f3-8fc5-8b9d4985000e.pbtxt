  file_change {
    absolute_path_uri: "file:///src/components/CodeArchitectureView.tsx"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "  return (\n    <div className=\"space-y-6\">\n      \n      {/* Header Banner */}\n      <div className=\"bg-slate-900/90 border border-slate-800 rounded-xl p-5 shadow-sm\">\n        <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n          <div>\n            <div className=\"flex items-center space-x-2\">\n              <span className=\"px-2 py-0.5 text-xs font-bold rounded bg-teal-500/20 text-teal-300 border border-teal-500/30\">\n                FULL-STACK MONOREPO REPOSITORY\n              </span>\n              <h2 className=\"text-base font-bold text-white\">\n                Python FastAPI, PostGIS Database Schema & System Dynamics ODE Engine\n              </h2>\n            </div>\n            <p className=\"text-xs text-slate-400 mt-1\">\n              Inspect backend mathematical models, database DDL, and containerized deployment manifests.\n            </p>\n          </div>\n        </div>\n      </div>\n\n      {/* Code Browser Grid */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-4 gap-6\">\n        \n        {/* Left 1 Col: File Directory Tree */}\n        <div className=\"bg-slate-900/90 border border-slate-800 rounded-xl p-4 shadow-sm space-y-3\">\n          <div className=\"flex items-center space-x-2 text-xs font-bold text-slate-300 border-b border-slate-800 pb-2\">\n            <FolderTree className=\"w-4 h-4 text-teal-400\" />\n            <span>Repository Manifest</span>\n          </div>\n\n          <div className=\"space-y-1 text-xs\">\n            {Object.keys(fileContents).map((filePath) => {\n              const isSelected = selectedFile === filePath;\n              return (\n                <button\n                  key={filePath}\n                  onClick={() => setSelectedFile(filePath)}\n                  className={`w-full text-left px-2.5 py-2 rounded-lg transition flex items-center space-x-2 ${\n                    isSelected \n                      ? \'bg-teal-500/20 text-teal-300 border border-teal-500/40 font-semibold\' \n                      : \'text-slate-400 hover:text-slate-200 hover:bg-slate-800/60\'\n                  }`}\n                >\n                  <FileCode className=\"w-3.5 h-3.5 shrink-0\" />\n                  <span className=\"truncate\">{filePath}</span>\n                </button>\n              );\n            })}\n          </div>\n        </div>\n\n        {/* Right 3 Cols: Code Inspector View */}\n        <div className=\"lg:col-span-3 bg-slate-900/90 border border-slate-800 rounded-xl p-5 shadow-sm space-y-3\">\n          <div className=\"flex items-center justify-between border-b border-slate-800 pb-3\">\n            <div>\n              <span className=\"font-mono text-xs font-bold text-teal-300\">{selectedFile}</span>\n              <p className=\"text-xs text-slate-400 mt-0.5\">{fileContents[selectedFile]?.description}</p>\n            </div>\n\n            <button\n              onClick={handleCopy}\n              className=\"flex items-center space-x-1 px-3 py-1.5 rounded bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-medium border border-slate-700 transition\"\n            >\n              {copied ? <Check className=\"w-3.5 h-3.5 text-emerald-400\" /> : <Copy className=\"w-3.5 h-3.5\" />}\n              <span>{copied ? \'Copied\' : \'Copy Code\'}</span>\n            </button>\n          </div>\n\n          <div className=\"bg-slate-950 p-4 rounded-xl border border-slate-800 font-mono text-xs text-slate-300 overflow-x-auto max-h-[500px]\">\n            <pre>{fileContents[selectedFile]?.content}</pre>\n          </div>\n        </div>\n\n      </div>\n\n    </div>\n  );"
