        }
        lines {
          text: "        "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        flow_direct_facility = (W / 7.5) * (1.0 - anc_propensity) * (facility_propensity * 0.6)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        flow_direct_home = (W / 7.5) * (1.0 - anc_propensity) * (1.0 - facility_propensity * 0.6)"
