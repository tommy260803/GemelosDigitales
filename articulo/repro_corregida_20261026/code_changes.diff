+    figure.add_annotation(x=0, y=-0.19, xref='paper', yref='paper', xanchor='left', yanchor='top', showarrow=False,
+                          text='<br>'.join(lines + [source]), align='left', font=dict(size=11, color='#334155'))
+    st.plotly_chart(figure, use_container_width=True)
+    st.caption(f"Interpretation: {interpretation} {source}")
+    st.download_button('Download figure (PNG 600 dpi)', render_plotly_png_600(figure, title, interpretation),
