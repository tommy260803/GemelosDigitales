+def show_explained_table(dataframe, title, interpretation, key):
+    """Show a table and provide a CSV with its reading guide."""
+    st.dataframe(dataframe, use_container_width=True, hide_index=True)
+    st.caption(f"Interpretation: {interpretation} Source: deterministic maternal-health digital twin simulation; not observed outcomes.")
+    notes = f"# {title}\n# Interpretation: {interpretation}\n# Source: deterministic maternal-health digital twin simulation; not observed outcomes.\n"
