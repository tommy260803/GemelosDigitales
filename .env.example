# =========================================================
# MATERNAL HEALTH DIGITAL TWIN: ENVIRONMENT VARIABLES
# =========================================================

# GEMINI_API_KEY: Required for Gemini AI API calls.
# Optional if you only use the System Dynamics engine.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODELS: Optional comma-separated fallback chain for the AI copilot.
# When one model's daily quota is exhausted, the next one is used automatically.
# GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-2.5-flash

# GROQ_API_KEY: Optional fallback provider for the AI copilot
# (used automatically when all Gemini model quotas are exhausted).
# GROQ_API_KEY="MY_GROQ_API_KEY"

# AGENT_TIME_BUDGET_SECONDS: Max seconds the LangGraph agent may run per
# question before it stops and synthesizes an answer from gathered data.
# AGENT_TIME_BUDGET_SECONDS=75

# APP_URL: The URL where this application is hosted.
APP_URL="http://localhost:3000"

# PostgreSQL Configuration
POSTGRES_DB=maternal_twin_db
POSTGRES_USER=twin_admin
POSTGRES_PASSWORD="secure_twin_password_2026"

# Express Server Port (default: 3000)
PORT=3000
